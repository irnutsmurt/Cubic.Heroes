diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 7e8d80f7..4948cab3 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -269,6 +269,7 @@ typedef struct vk_state {
     int              bc_ok;           /* textureCompressionBC enabled       */
     int              depth_bounds_ok; /* depthBounds enabled                */
     int              depth_clamp_ok;  /* depthClamp enabled                 */
+    int              bias_unorm;      /* depth bias in 2^-24 steps on float depth */
     int              gpl_ok;          /* graphics pipeline libraries, fast linking and extended dynamic state
                                          enabled (PS3RECOMP_VK_GPL=1, when the device has all of them) */
     int              gpl_core_eds;    /* the dynamic state is Vulkan 1.3's core commands (no extension) */
@@ -6400,6 +6401,37 @@ static int vk_init_all(u32 width, u32 height, const char* title)
                    core_eds ? "Vulkan 1.3" : "extension");
         }
     }
+    /* A device without D24_UNORM_S8 (AMD's) gives a native renderer's depth surfaces a float format, whose
+     * constant depth bias is a step of the primitive's largest depth (2^(e-23)) -- not the RSX's one 2^-24 step,
+     * and far larger once a depth clamp lets depths pass 1. VK_EXT_depth_bias_control's least-representable-value
+     * representation forced to UNORM, exact, gives the 2^-24 step on any format (rsx_vk_bias_unorm). It needs
+     * vkGetPhysicalDeviceFeatures2: a Vulkan 1.1 instance. */
+    const char* bias_exts[8];
+    VkPhysicalDeviceDepthBiasControlFeaturesEXT dbc = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DEPTH_BIAS_CONTROL_FEATURES_EXT };
+    if (s_vk.api >= VK_API_VERSION_1_1 && vk_has_device_extension(s_vk.phys, VK_EXT_DEPTH_BIAS_CONTROL_EXTENSION_NAME)) {
+        VkFormatProperties d24;
+        pvkGetPhysicalDeviceFormatProperties(s_vk.phys, VK_FORMAT_D24_UNORM_S8_UINT, &d24);
+        PFN_vkGetPhysicalDeviceFeatures2 bf2 =
+            (PFN_vkGetPhysicalDeviceFeatures2)pvkGetInstanceProcAddr(s_vk.instance, "vkGetPhysicalDeviceFeatures2");
+        if (!(d24.optimalTilingFeatures & VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT) && bf2) {
+            VkPhysicalDeviceFeatures2 f2 = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &dbc };
+            bf2(s_vk.phys, &f2);
+            if (dbc.depthBiasControl && dbc.leastRepresentableValueForceUnormRepresentation && dbc.depthBiasExact) {
+                uint32_t n = 0;
+                for (uint32_t i = 0; i < dci.enabledExtensionCount && n < 7; i++)
+                    bias_exts[n++] = dci.ppEnabledExtensionNames[i];
+                bias_exts[n++] = VK_EXT_DEPTH_BIAS_CONTROL_EXTENSION_NAME;
+                dbc.floatRepresentation = VK_FALSE;
+                dbc.pNext = (void*)dci.pNext;
+                dci.pNext = &dbc;
+                dci.enabledExtensionCount = n;
+                dci.ppEnabledExtensionNames = bias_exts;
+                s_vk.bias_unorm = 1;
+                VK_LOG("depth bias: 2^-24 steps on the float depth surfaces (VK_EXT_depth_bias_control)\n");
+            }
+        }
+    }
     VK_CHECK(pvkCreateDevice(s_vk.phys, &dci, NULL, &s_vk.device), "vkCreateDevice");
     if (vk_load_device_functions()) return -1;
     vk_pcache_open();
@@ -6982,6 +7014,7 @@ int rsx_vk_gpl_core_eds(void) { return s_vk.gpl_core_eds; }
 
 /* Whether the device was created with depthClamp (a native renderer's pipelines may ask for it). */
 int rsx_vk_depth_clamp_ok(void) { return s_vk.depth_clamp_ok; }
+int rsx_vk_bias_unorm(void) { return s_vk.bias_unorm; }
 
 /* Whether the device was created with samplerAnisotropy (a native renderer's samplers may ask for it). */
 int rsx_vk_aniso_ok(void) { return s_vk.aniso_ok; }
