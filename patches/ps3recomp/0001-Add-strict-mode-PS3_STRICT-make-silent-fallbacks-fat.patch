From de239a8bcdb5ee77b1852ab52474e3493d2165d7 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Thu, 29 Oct 2026 15:37:55 -0700
Subject: [PATCH 01/28] Add strict mode (PS3_STRICT): make silent fallbacks
 fatal

Unresolved NIDs, garbage/unresolved indirect calls, calls to unlifted
functions, unknown syscalls, SPU interpreter entry, SPU branches to
unlifted code and SPU threads with no code each call ps3_strict_fail(),
which names the violation and aborts. PS3_STRICT=0 (default) keeps the
permissive bring-up behaviour; -DPS3RECOMP_STRICT_DEFAULT=1 flips it.
---
 include/ps3emu/ps3_strict.h     | 39 +++++++++++++++++++++++++++++++++
 runtime/platform/ps3_strict.c   | 33 ++++++++++++++++++++++++++++
 runtime/ppu/ppu_hle.cpp         |  4 ++++
 runtime/ppu/ppu_loader.cpp      | 22 ++++++++++++++++++-
 runtime/spu/spu_channels.c      |  8 ++++++-
 runtime/spu/spu_interp.c        |  4 ++++
 runtime/syscalls/lv2_register.c |  5 +++++
 7 files changed, 113 insertions(+), 2 deletions(-)
 create mode 100644 include/ps3emu/ps3_strict.h
 create mode 100644 runtime/platform/ps3_strict.c

diff --git a/include/ps3emu/ps3_strict.h b/include/ps3emu/ps3_strict.h
new file mode 100644
index 0000000..129fa3e
--- /dev/null
+++ b/include/ps3emu/ps3_strict.h
@@ -0,0 +1,39 @@
+/*
+ * ps3_strict.h -- strict mode: every silent fallback becomes fatal.
+ *
+ * By default the runtime keeps a title running past problems it cannot
+ * answer: an unregistered import returns CELL_OK, an indirect call to an
+ * address with no lifted function logs and returns, an unknown syscall logs
+ * "(stub)", SPU code the lifter never saw runs in the SPU interpreter, and an
+ * SPU thread with no lifted image "completes" with status 0. That is useful
+ * for bring-up and fatal for a port that must prove it runs only recompiled
+ * code: the defect surfaces hours later as a wrong value.
+ *
+ * PS3_STRICT=1 turns each of those into ps3_strict_fail(): one line naming
+ * the kind and the detail, the caller's own context dump where it has one,
+ * then abort() so the platform crash handler records the host state.
+ * PS3_STRICT=0 restores the permissive behaviour. A build can choose the
+ * default with -DPS3RECOMP_STRICT_DEFAULT=1.
+ */
+#ifndef PS3EMU_PS3_STRICT_H
+#define PS3EMU_PS3_STRICT_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Nonzero when strict mode is on (cached after the first call). */
+int ps3_strict(void);
+
+/* Report a strict-mode violation and abort. `kind` is a short stable tag
+ * (e.g. "unresolved-nid") that tests and log scrapers match on. */
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((noreturn, format(printf, 2, 3)))
+#endif
+void ps3_strict_fail(const char* kind, const char* fmt, ...);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3EMU_PS3_STRICT_H */
diff --git a/runtime/platform/ps3_strict.c b/runtime/platform/ps3_strict.c
new file mode 100644
index 0000000..7341d20
--- /dev/null
+++ b/runtime/platform/ps3_strict.c
@@ -0,0 +1,33 @@
+/* Strict mode -- see include/ps3emu/ps3_strict.h. */
+#include "ps3emu/ps3_strict.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifndef PS3RECOMP_STRICT_DEFAULT
+#define PS3RECOMP_STRICT_DEFAULT 0
+#endif
+
+int ps3_strict(void)
+{
+    static int s_strict = -1;
+    if (s_strict < 0) {
+        const char* e = getenv("PS3_STRICT");
+        s_strict = e && *e ? (e[0] != '0') : PS3RECOMP_STRICT_DEFAULT;
+    }
+    return s_strict;
+}
+
+void ps3_strict_fail(const char* kind, const char* fmt, ...)
+{
+    va_list ap;
+    fflush(stdout);
+    fprintf(stderr, "[strict] FATAL %s: ", kind);
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "\n[strict] PS3_STRICT=0 runs past this (bring-up only)\n");
+    fflush(stderr);
+    abort();
+}
