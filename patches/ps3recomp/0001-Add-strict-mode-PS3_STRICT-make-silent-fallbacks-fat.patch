 #include "ps3emu/ps3_ftrace.h"   /* PS3_FTRACE timeline */
 #include "ps3emu/milestone.h"   /* ps3_ms / ps3_msf -- boot milestone log */     /* ppu_context, func decls, ppu_recomp_register */
@@ -2935,6 +2936,12 @@ static void ps3_indirect_call_impl(ppu_context* ctx)
         { static int _nv=-1; if(_nv<0){ const char* e=getenv("PPU_NOOP_BAD_VCALL"); _nv=e?1:0; }
           if(_nv && ((tgt & 3u)!=0u || tgt < 0x10000u || tgt >= 0x40000000u)) _invalid = true; }
         if (_invalid) {
+            if (ps3_strict()) {
+                ppu_dump_guest_stack(ctx, "strict-garbage-vcall");
+                ps3_strict_fail("garbage-indirect-call",
+                                "target 0x%08X is not code (this=0x%08X lr=0x%08X tid=%llu)", tgt,
+                                (uint32_t)ctx->gpr[3], (uint32_t)ctx->lr, (unsigned long long)ctx->thread_id);
+            }
             static int _gn = 0;
             if (PS3_LOG_FIRST(_gn, 12)) fprintf(stderr, "[ppu] garbage vcall -> 0x%08X this=0x%08X (uninit/stale object) -- no-op, r3=0\n", tgt, (uint32_t)ctx->gpr[3]);
 #ifdef _WIN32
@@ -2980,6 +2987,12 @@ static void ps3_indirect_call_impl(ppu_context* ctx)
         }
         return;   /* don't spam the log on a tight retry loop */
     }
+    if (ps3_strict()) {
+        ppu_log_host_chain("strict-unresolved-indirect");
+        ppu_dump_guest_stack(ctx, "strict-unresolved-indirect");
+        ps3_strict_fail("unresolved-indirect-call", "no lifted function at 0x%08X (lr=0x%08X tid=%llu)",
+                        cur, (uint32_t)ctx->lr, (unsigned long long)ctx->thread_id);
+    }
     last = cur; streak = 0;
     fprintf(stderr, "[ppu] unresolved indirect call -> 0x%08X (tid=%llu lr=0x%08X)\n",
             (uint32_t)ctx->ctr, (unsigned long long)ctx->thread_id, (uint32_t)ctx->lr);
@@ -3158,7 +3171,11 @@ static void ps3_indirect_call_impl(ppu_context* ctx)
  * continue (the result is undefined, but it won't crash the link). */
 extern "C" void ppu_unlifted_stub(uint64_t addr, ppu_context* ctx)
 {
-    (void)ctx;
+    if (ps3_strict()) {
+        ppu_dump_guest_stack(ctx, "strict-unlifted");
+        ps3_strict_fail("unlifted-function", "call to 0x%08X, which the lifter did not emit (lr=0x%08X)",
+                        (uint32_t)addr, (uint32_t)ctx->lr);
+    }
     static int logged = 0;
     if (logged < 20) {
         fprintf(stderr, "[ppu] call to unlifted function 0x%08X\n", (uint32_t)addr);
@@ -3485,6 +3502,9 @@ extern "C" void lv2_syscall(ppu_context* ctx)
         }
         static int logged = 0;
         if (logged < 30) {
+            if (ps3_strict())
+                ps3_strict_fail("unknown-syscall", "lv2 syscall %llu has no implementation (lr=0x%08X)",
+                                (unsigned long long)num, (uint32_t)ctx->lr);
             fprintf(stderr, "[ppu] lv2_syscall %llu (stub)\n", (unsigned long long)num);
             logged++;
         }
