+/* Pop one event from queue `queue_id` for a host-side consumer (the lv2 SPU
+ * thread receive-event service). block=0 polls once. While blocking, *abort
+ * is checked every few milliseconds and a nonzero value ends the wait.
+ * Returns CELL_OK (event in *out), CELL_EBUSY (block=0 and empty),
+ * CELL_ESRCH (no such queue), CELL_ECANCELED (queue cancelled or destroyed)
+ * or 1 (aborted). */
+int sys_event_queue_pop_host(uint32_t queue_id, sys_event_t* out, int block,
+                             volatile int* abort);
+/* The queue's lv2 type (SYS_PPU_QUEUE / SYS_SPU_QUEUE), or 0 if it does not exist. */
+int sys_event_queue_type(uint32_t queue_id);
+
