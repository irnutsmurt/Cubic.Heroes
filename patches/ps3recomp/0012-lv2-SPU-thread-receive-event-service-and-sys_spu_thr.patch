 #include <string.h>
 #include <stdlib.h>               /* getenv */
-#include "ps3emu/log_first.h"
+#include "ps3emu/log_first.h"
 
 /* Recorded by sys_spu_thread_initialize (lv2_register.c): the SPURS kernel
  * context EA the title's SPU task runtime is dispatched against. */
@@ -930,6 +930,54 @@ int64_t sys_event_port_disconnect(ppu_context* ctx)
 
 /* Public helper for non-syscall callers: push an event into a queue by
  * ID. Returns 0 on success, -1 if the queue is unknown/inactive or full. */
+int sys_event_queue_type(uint32_t queue_id)
+{
+    if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX) return 0;
+    const sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    return q->active ? q->type : 0;
+}
+
+int sys_event_queue_pop_host(uint32_t queue_id, sys_event_t* out, int block,
+                             volatile int* abort)
+{
+    if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX) return (int)CELL_ESRCH;
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active) return (int)CELL_ESRCH;
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+    while (block && q->count == 0 && q->active && !q->cancelled && !(abort && *abort))
+        SleepConditionVariableCS(&q->not_empty, &q->lock, 5);
+#else
+    pthread_mutex_lock(&q->lock);
+    while (block && q->count == 0 && q->active && !q->cancelled && !(abort && *abort)) {
+        struct timespec ts;
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_nsec += 5 * 1000 * 1000;
+        if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+        pthread_cond_timedwait(&q->not_empty, &q->lock, &ts);
+    }
+#endif
+    int rc;
+    if (q->count > 0 && q->active) {
+        *out = q->buffer[q->head];
+        q->head = (q->head + 1) % q->capacity;
+        q->count--;
+        rc = (int)CELL_OK;
+    } else if (!q->active || q->cancelled) {
+        rc = (int)CELL_ECANCELED;
+    } else if (abort && *abort) {
+        rc = 1;
+    } else {
+        rc = (int)CELL_EBUSY;
+    }
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+    return rc;
+}
+
 int sys_event_queue_push_by_id(uint32_t queue_id,
                                uint64_t source, uint64_t data1,
                                uint64_t data2,  uint64_t data3)
