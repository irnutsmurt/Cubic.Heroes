+/* The same for position-independent code lifted with spu_lifter.py
+ * --relocatable at its link address `link_lsa`: a GET from content_ea into
+ * ANY local-store address makes it resident, displaced by lsa - link_lsa.
+ * The code segments are given at link addresses and are verified at the
+ * displaced ones. FMOD's SPU mixer loads its codec and DSP plugins this way,
+ * wherever it has room. Returns 1 on success. */
+int spu_overlay_register_relocatable(uint32_t content_ea, uint32_t link_lsa,
+    uint32_t span, int image_id, const spu_overlay_code_segment* code,
+    unsigned count);
