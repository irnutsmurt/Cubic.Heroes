                         continue;
@@ -2183,6 +2219,12 @@ void spu_overlay_note_get(spu_context* ctx, uint32_t ea, const uint8_t* ls, uint
                     ctx->resident_code[slot].image_id = o->image_id;
                     ctx->resident_code[slot].verify_state = o->code ? SPU_OVERLAY_PENDING : 0;
                     ctx->resident_code[slot].source_index = i;
+                    ctx->resident_code[slot].reloc = o->reloc;
+                    ctx->resident_code[slot].reloc_delta = o->reloc ? lsa - o->load_lsa : 0;
+                    { static int _n = 0; if (o->reloc && PS3_LOG_FIRST(_n, 64))
+                        fprintf(stderr, "[spu-ovl] img=%d relocatable image %d src=0x%08X -> LS 0x%05X "
+                                "(link 0x%05X, delta 0x%05X)\n", ctx->image_id, o->image_id, ea, lsa,
+                                o->load_lsa, lsa - o->load_lsa); }
                     spu_dcache_residency_changed(ctx);
