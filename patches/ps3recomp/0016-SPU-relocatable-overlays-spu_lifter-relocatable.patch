         uint32_t base = ctx->resident_code[slot].lsa;
@@ -2172,8 +2207,9 @@ void spu_overlay_note_get(spu_context* ctx, uint32_t ea, const uint8_t* ls, uint
         if (hit) {
             if (o->span) {
