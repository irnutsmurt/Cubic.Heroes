-/* SDK ABI: cellSpursQueueSize(CellSpursQueue*, unsigned int* size): the number of entries in the queue.
- *
- * Without a handler the import was unresolved: it returned CELL_OK without writing *size, so a title that waits for a
- * queue to drain (QueueSize, then a short sleep while the size is above zero) read stale stack and waited out its whole
- * retry budget every frame. The occupancy is the ring's: W0 (+0x00) the pop index, W1 (+0x04) the push index, both
- * normalised (~v marks an operation in progress) and running modulo 2*W3 (+0x0C, the depth), the same model
- * cellSpursQueuePushBody uses. A queue with no depth was never initialised. */
-s32 cellSpursQueueSize(u64 queue_ea, u64 size_ea)
+/* One push (to_queue = 1) or pop under the lock: 1 done, 0 full/empty. */
+static int sq_move(u32 q, u32 data, int to_queue)
 {
-    if (!queue_ea || !size_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
-    if (queue_ea & 0x7F)       return CELL_SPURS_TASK_ERROR_ALIGN;
-
-    uint32_t q   = (uint32_t)queue_ea;
-    int32_t  w0  = (int32_t)vm_read32(q + 0x00);
-    int32_t  w1  = (int32_t)vm_read32(q + 0x04);
-    int32_t  mod = (int32_t)vm_read32(q + 0x0C);
-    if (mod <= 0) return CELL_SPURS_TASK_ERROR_INVAL;
-
-    int32_t  pop  = (w0 < 0) ? ~w0 : w0;
-    int32_t  push = (w1 < 0) ? ~w1 : w1;
-    uint32_t n    = (uint32_t)((pop > push) ? push - pop + 2 * mod : push - pop);
-    vm_write32((uint32_t)size_ea, n);
+    extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
+    extern void spu_coh_notify_write(uint32_t);
+    spu_lockline_lock();
+    const s32 w0 = (s32)vm_read32(q + 0x00), w1 = (s32)vm_read32(q + 0x04);
+    const s32 depth = (s32)vm_read32(q + 0x0C), size = (s32)vm_read32(q + 0x08);
+    const u32 buf = (u32)vm_read64(q + 0x10);
+    const s32 n0 = sq_norm(w0), n1 = sq_norm(w1);
+    const s32 count = (n0 > n1) ? n1 - n0 + 2 * depth : n1 - n0;
+    int done = 0;
+    if (to_queue && count < depth && w1 >= 0) {
+        const s32 slot = n1 >= depth ? n1 - depth : n1;
+        memcpy(vm_base + buf + (u32)(slot * size), vm_base + data, (size_t)size);
+        __atomic_thread_fence(__ATOMIC_RELEASE);
+        vm_write32(q + 0x04, (u32)((n1 + 1) % (2 * depth)));
+        done = 1;
+    } else if (!to_queue && count > 0 && w0 >= 0) {
+        const s32 slot = n0 >= depth ? n0 - depth : n0;
+        memcpy(vm_base + data, vm_base + buf + (u32)(slot * size), (size_t)size);
+        vm_write32(q + 0x00, (u32)((n0 + 1) % (2 * depth)));
+        done = 1;
+    }
+    if (done) spu_coh_notify_write(q);
+    spu_lockline_unlock();
+    if (done) {
+        if (to_queue) sq_wake_head(q, 0x20, 0x40);   /* an SPU waiting to pop */
+        else          sq_wake_head(q, 0x30, 0x50);   /* an SPU waiting to push */
+    }
+    return done;
+}
 
-    static int _n = 0;
-    if (_n < 8 || (n && _n < 64))
-        printf("[cellSpurs] QueueSize(q=0x%08X) -> %u (pop=%d push=%d mod=%d)\n", q, n, pop, push, mod);
-    _n++;
-    return CELL_OK;
+static s32 sq_ppu_op(u64 queue_ea, u64 data_ea, u32 isBlocking, int to_queue)
+{
+    const u32 q = (u32)queue_ea, data = (u32)data_ea;
+    if (!q || !data) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if ((q & 0x7F) || (data & 0xF)) return CELL_SPURS_TASK_ERROR_ALIGN;
+    const u32 dir = vm_read32(q + 0x1C);
+    if (dir != (to_queue ? 2u : 1u)) return SQ_PERM;      /* PPU pushes PPU2SPU, pops SPU2PPU */
+    for (unsigned spin = 0;; spin++) {
+        if (sq_move(q, data, to_queue)) return CELL_OK;
+        if (!isBlocking) return SQ_AGAIN;
+        if (spin < 64) Sleep(0); else Sleep(1);          /* wait for the SPU side */
+    }
 }
 
 /* SDK ABI: cellSpursQueuePushBody(CellSpursQueue*, const void* buffer, bool isBlocking) */
 s32 cellSpursQueuePushBody(u64 queue_ea, u64 data_ea, u32 isBlocking)
 {
-    /* SPURS_QUEUE_PUSH=1 -- EXPERIMENT, off by default.
-     *
