+    const u32 tid = vm_base[q + tid_off + 1];
+    u32 taskset = (u32)vm_read64(q + 0x70);
+    (void)wid_off;
+    if (!taskset) {
+        ps3_strict_fail("spurs-queue", "queue 0x%08X: a waiter but no taskset", q);
+        return;
