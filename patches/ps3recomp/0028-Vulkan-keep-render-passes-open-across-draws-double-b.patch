+/* Open a batch: like vk_begin, but a batch left in flight by the last flush
+ * may still be running. Every batched operation opens with a barrier against
+ * all earlier work on the queue, which orders it after that batch on the GPU;
+ * the CPU need not wait. */
+static int vk_begin_batch(void)
+{
+    VK_CHECK(pvkResetCommandBuffer(s_vk.cmd, 0), "vkResetCommandBuffer");
+    VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+                                    .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+    VK_CHECK(pvkBeginCommandBuffer(s_vk.cmd, &bi), "vkBeginCommandBuffer");
+    if (s_vk.present_order) { vk_cmd_after_everything(s_vk.cmd); s_vk.present_order = 0; }
+    return 0;
+}
