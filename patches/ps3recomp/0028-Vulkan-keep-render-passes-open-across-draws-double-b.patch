 /* A full execution and memory dependency on everything submitted before
  * this command buffer, the present's copy included. */
+/* VK_DRAW_BATCH: the render pass the last batched draw left open. Draws into
+ * the same framebuffer that sample none of its images continue it: within one
+ * render pass Vulkan already orders their attachment writes, blending and
+ * depth (rasterization order), so neither the per-draw full barrier nor a
+ * fresh render pass is needed. Anything else recorded into the batch -- a
+ * clear, a copy, an upload, the flush itself -- closes it first. */
+static struct { int open; VkFramebuffer fb; } s_rp;
+static void vk_rp_close(void)
