 libs/input/cellPad.c            |   4 +-
 libs/video/rsx_shader_spirv.cpp |  13 ++--
 libs/video/rsx_vulkan_backend.c | 112 +++++++++++++++++++++-----------
 runtime/ppu/ppu_loader.cpp      |  16 ++++-
 5 files changed, 129 insertions(+), 51 deletions(-)

