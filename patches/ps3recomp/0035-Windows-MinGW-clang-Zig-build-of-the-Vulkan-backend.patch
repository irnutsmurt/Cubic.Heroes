+    string(SUBSTRING "${_spv_id}" 0 23 _spv_id)
+    set_property(SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_shader_spirv.cpp"
+                 APPEND PROPERTY COMPILE_DEFINITIONS "RSX_SPIRV_TRANSLATOR_ID=\"${_spv_id}\"")
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+                 "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_shader_spirv.cpp"
+                 "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_shader_spirv.h")
 endif()
 
