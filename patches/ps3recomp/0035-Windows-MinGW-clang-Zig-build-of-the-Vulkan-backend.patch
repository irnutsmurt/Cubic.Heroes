+#ifdef _WIN32
+/* The few POSIX calls this file makes, on Win32: the loader by LoadLibrary,
+ * two locks as SRW locks, a monotonic clock from the performance counter.
+ * Backend-local names, so MinGW's own pthread headers cannot clash. */
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+typedef SRWLOCK vk_mutex_t;
+static inline void vk_mutex_init(vk_mutex_t* m)    { InitializeSRWLock(m); }
+static inline void vk_mutex_lock(vk_mutex_t* m)    { AcquireSRWLockExclusive(m); }
+static inline void vk_mutex_unlock(vk_mutex_t* m)  { ReleaseSRWLockExclusive(m); }
+static inline void vk_mutex_destroy(vk_mutex_t* m) { (void)m; }
+static inline void vk_monotonic(struct timespec* t)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER n;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&n);
+    t->tv_sec = (time_t)(n.QuadPart / f.QuadPart);
+    t->tv_nsec = (long)((n.QuadPart % f.QuadPart) * 1000000000LL / f.QuadPart);
+}
+static void* vk_lib_open(const char* name) { return (void*)LoadLibraryA(name); }
+static void* vk_lib_sym(void* lib, const char* name) { return (void*)GetProcAddress((HMODULE)lib, name); }
+static void vk_lib_close(void* lib) { FreeLibrary((HMODULE)lib); }
+static const char* vk_lib_error(void) { static char b[32]; snprintf(b, sizeof b, "error %lu", (unsigned long)GetLastError()); return b; }
+#define VK_LOADER_NAMES { "vulkan-1.dll" }
+#else
+#include <dlfcn.h>
+#include <pthread.h>
+typedef pthread_mutex_t vk_mutex_t;
+static inline void vk_mutex_init(vk_mutex_t* m)    { pthread_mutex_init(m, NULL); }
+static inline void vk_mutex_lock(vk_mutex_t* m)    { pthread_mutex_lock(m); }
+static inline void vk_mutex_unlock(vk_mutex_t* m)  { pthread_mutex_unlock(m); }
+static inline void vk_mutex_destroy(vk_mutex_t* m) { pthread_mutex_destroy(m); }
+static inline void vk_monotonic(struct timespec* t) { clock_gettime(CLOCK_MONOTONIC, t); }
+static void* vk_lib_open(const char* name) { return dlopen(name, RTLD_NOW | RTLD_LOCAL); }
+static void* vk_lib_sym(void* lib, const char* name) { return dlsym(lib, name); }
+static void vk_lib_close(void* lib) { dlclose(lib); }
+static const char* vk_lib_error(void) { return dlerror(); }
+#define VK_LOADER_NAMES { "libvulkan.so.1", "libvulkan.so" }
+#endif
 
