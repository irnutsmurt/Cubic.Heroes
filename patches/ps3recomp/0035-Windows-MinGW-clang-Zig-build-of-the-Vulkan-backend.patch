diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 2fd4b36..20055e3 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -632,12 +632,26 @@ static uint32_t samp_stack_guest(HANDLE h, const CONTEXT* c)
 {
     (void)h;
     const uintptr_t* sp = (const uintptr_t*)c->Rsp;
+#if defined(_MSC_VER)
     for (int i = 0; i < 512; i++) {          /* 4 KB of stack */
         uintptr_t v;
         __try { v = sp[i]; } __except (1) { return 0; }
         uint32_t g = samp_lookup(v);
         if (g) return g;
     }
+#else
+    /* No SEH outside MSVC mode (MinGW): read only as far as the committed,
+     * readable region the stack pointer is in. */
+    MEMORY_BASIC_INFORMATION mbi;
+    if (!VirtualQuery(sp, &mbi, sizeof mbi) || mbi.State != MEM_COMMIT ||
+        !(mbi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)))
+        return 0;
+    const uintptr_t end = (uintptr_t)mbi.BaseAddress + mbi.RegionSize;
+    for (int i = 0; i < 512 && (uintptr_t)(sp + i + 1) <= end; i++) {   /* 4 KB of stack */
+        uint32_t g = samp_lookup(sp[i]);
+        if (g) return g;
+    }
+#endif
     return 0;
 }
 
