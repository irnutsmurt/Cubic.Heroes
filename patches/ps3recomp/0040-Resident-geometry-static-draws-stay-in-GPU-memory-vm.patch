 libs/network/cellHttp.c         |   2 +
 libs/video/rsx_draw_engine.c    | 344 ++++++++++++++++++++++++++++++--
 libs/video/rsx_draw_engine.h    |  13 ++
 libs/video/rsx_vulkan_backend.c | 161 +++++++++++++--
 runtime/memory/vm_watch.c       | 171 ++++++++++++++++
 runtime/memory/vm_watch.h       |  52 +++++
 runtime/syscalls/sys_fs.c       |   3 +
 8 files changed, 721 insertions(+), 28 deletions(-)
 create mode 100644 runtime/memory/vm_watch.c
 create mode 100644 runtime/memory/vm_watch.h

