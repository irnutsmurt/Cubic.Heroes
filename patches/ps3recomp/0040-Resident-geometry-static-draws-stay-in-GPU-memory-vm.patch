index 0000000..3d56a41
--- /dev/null
+++ b/runtime/memory/vm_watch.c
@@ -0,0 +1,171 @@
+#include "vm_watch.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+
+extern uint8_t* vm_base;
+
+#define VW_PAGE_SHIFT  12
+#define VW_PAGE        ((size_t)1 << VW_PAGE_SHIFT)
+#define VW_SPAN        ((uint64_t)1 << 32)            /* the guest's 32-bit space */
+#define VW_PAGES       ((size_t)(VW_SPAN >> VW_PAGE_SHIFT))
+#define VW_BLOCK_SHIFT 4u                             /* 16 pages: 64 KB blocks */
+#define VW_HOT         16u                            /* writes after which a page stays unwatched */
+
+static struct {
+    int avail;                  /* -1 not set up yet */
+    volatile LONG epoch;
+    volatile LONG* page;        /* per page: the epoch of its last write seen */
+    volatile LONG* block;       /* per 64 KB block: the newest of its pages' epochs */
+    volatile char* prot;        /* per page: 1 while it is read-only for us */
+    unsigned char* writes;      /* per page: writes seen, up to VW_HOT */
+    SRWLOCK lock;               /* protection changes and their bookkeeping */
+} s_vw = { -1 };
+
+/* Lock held. Writable first, then the new epoch, and both before the faulting
+ * store runs again: a consumer that read the epoch before this sees the newer
+ * one; one that reads it after finds the page unprotected and protects it
+ * again before it reads. */
+static void vw_written_locked(size_t pg)
+{
+    DWORD old;
+    s_vw.prot[pg] = 0;
+    VirtualProtect(vm_base + (pg << VW_PAGE_SHIFT), VW_PAGE, PAGE_READWRITE, &old);
+    const LONG e = InterlockedIncrement(&s_vw.epoch);
+    s_vw.page[pg] = e;
+    if (s_vw.block[pg >> VW_BLOCK_SHIFT] < e) s_vw.block[pg >> VW_BLOCK_SHIFT] = e;
+    if (s_vw.writes[pg] < VW_HOT) s_vw.writes[pg]++;
+    MemoryBarrier();
+}
+
+static LONG CALLBACK vw_fault(EXCEPTION_POINTERS* ep)
+{
+    const EXCEPTION_RECORD* r = ep->ExceptionRecord;
+    if (r->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || r->NumberParameters < 2 ||
+        r->ExceptionInformation[0] != 1)                     /* writes only */
+        return EXCEPTION_CONTINUE_SEARCH;
+    const uintptr_t a = (uintptr_t)r->ExceptionInformation[1], b = (uintptr_t)vm_base;
+    if (a < b || (uint64_t)(a - b) >= VW_SPAN) return EXCEPTION_CONTINUE_SEARCH;
+    const size_t pg = (size_t)(a - b) >> VW_PAGE_SHIFT;
+    AcquireSRWLockExclusive(&s_vw.lock);
+    const int ours = s_vw.prot[pg];
+    if (ours) vw_written_locked(pg);
+    ReleaseSRWLockExclusive(&s_vw.lock);
+    if (ours) return EXCEPTION_CONTINUE_EXECUTION;
+    /* Another thread's fault on the same page released it meanwhile. Anything
+     * else (an uncommitted page, a real crash) is for the next handler. */
+    MEMORY_BASIC_INFORMATION mbi;
+    if (VirtualQuery((void*)a, &mbi, sizeof mbi) && mbi.State == MEM_COMMIT &&
+        mbi.Protect == PAGE_READWRITE)
+        return EXCEPTION_CONTINUE_EXECUTION;
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+int vm_watch_available(void)
+{
+    if (s_vw.avail < 0) {
+        s_vw.avail = 0;
+        InitializeSRWLock(&s_vw.lock);
+        if (vm_base) {
+            s_vw.page   = (volatile LONG*)calloc(VW_PAGES, sizeof(LONG));
+            s_vw.block  = (volatile LONG*)calloc(VW_PAGES >> VW_BLOCK_SHIFT, sizeof(LONG));
+            s_vw.prot   = (volatile char*)calloc(VW_PAGES, 1);
+            s_vw.writes = (unsigned char*)calloc(VW_PAGES, 1);
+            /* First in line: ahead of the host's demand-commit handler, which
+             * would otherwise make a watched page writable unseen. */
+            s_vw.avail = s_vw.page && s_vw.block && s_vw.prot && s_vw.writes &&
+                         AddVectoredExceptionHandler(1, vw_fault) != NULL;
+        }
+    }
+    return s_vw.avail;
+}
+
+static int vw_pages(const void* p, size_t n, size_t* lo, size_t* hi)
+{
+    const uintptr_t a = (uintptr_t)p, b = (uintptr_t)vm_base;
+    if (!n || a < b || (uint64_t)(a - b) + n > VW_SPAN) return 0;
+    *lo = (size_t)(a - b) >> VW_PAGE_SHIFT;
+    *hi = (size_t)(((uint64_t)(a - b) + n - 1) >> VW_PAGE_SHIFT) + 1u;
+    return 1;
+}
+
+int vm_watch(const void* p, size_t n, uint64_t* since)
+{
+    size_t lo, hi;
+    if (!vm_watch_available() || !vw_pages(p, n, &lo, &hi)) return 0;
+    *since = (uint32_t)s_vw.epoch;              /* before any protection: see vw_written_locked */
+    int ok = 1;
+    AcquireSRWLockExclusive(&s_vw.lock);
+    for (size_t pg = lo; pg < hi && ok;) {
+        if (s_vw.prot[pg]) { pg++; continue; }
+        if (s_vw.writes[pg] >= VW_HOT) { ok = 0; break; }
+        size_t end = pg + 1;
+        while (end < hi && !s_vw.prot[end] && s_vw.writes[end] < VW_HOT) end++;
+        DWORD old;
+        if (!VirtualProtect(vm_base + (pg << VW_PAGE_SHIFT), (end - pg) << VW_PAGE_SHIFT, PAGE_READONLY, &old)) {
+            ok = 0;
+            break;
+        }
+        memset((void*)(s_vw.prot + pg), 1, end - pg);
+        pg = end;
+    }
+    ReleaseSRWLockExclusive(&s_vw.lock);
+    return ok;
+}
+
+uint64_t vm_watch_epoch(void) { return (uint32_t)s_vw.epoch; }
+
+int vm_watch_clean_since(const void* p, size_t n, uint64_t since)
+{
+    size_t lo, hi;
+    if (s_vw.avail != 1 || !vw_pages(p, n, &lo, &hi)) return 0;
+    /* Blocks first: only a block written since needs its pages looked at. */
+    for (size_t b = lo >> VW_BLOCK_SHIFT; b <= (hi - 1u) >> VW_BLOCK_SHIFT; b++) {
+        if ((uint64_t)(uint32_t)s_vw.block[b] <= since) continue;
+        const size_t p0 = (b << VW_BLOCK_SHIFT) > lo ? b << VW_BLOCK_SHIFT : lo;
+        const size_t p1 = ((b + 1u) << VW_BLOCK_SHIFT) < hi ? (b + 1u) << VW_BLOCK_SHIFT : hi;
+        for (size_t pg = p0; pg < p1; pg++)
+            if ((uint64_t)(uint32_t)s_vw.page[pg] > since) return 0;
+    }
+    return 1;
+}
+
+void vm_watch_release(const void* p, size_t n)
+{
+    size_t lo, hi;
+    if (s_vw.avail != 1 || !vw_pages(p, n, &lo, &hi)) return;
+    AcquireSRWLockExclusive(&s_vw.lock);
+    for (size_t pg = lo; pg < hi; pg++)
+        if (s_vw.prot[pg]) vw_written_locked(pg);
+    ReleaseSRWLockExclusive(&s_vw.lock);
+}
+
+void vm_watch_reset(void)
+{
+    if (s_vw.avail != 1) return;
+    AcquireSRWLockExclusive(&s_vw.lock);
+    for (size_t pg = 0; pg < VW_PAGES;) {
+        if (!s_vw.prot[pg]) { pg++; continue; }
+        size_t end = pg + 1;
+        while (end < VW_PAGES && s_vw.prot[end]) end++;
+        DWORD old;
+        VirtualProtect(vm_base + (pg << VW_PAGE_SHIFT), (end - pg) << VW_PAGE_SHIFT, PAGE_READWRITE, &old);
+        memset((void*)(s_vw.prot + pg), 0, end - pg);
+        pg = end;
+    }
+    ReleaseSRWLockExclusive(&s_vw.lock);
+}
+
+#else  /* no write watching here yet: callers validate their own way */
+
+int vm_watch_available(void) { return 0; }
+int vm_watch(const void* p, size_t n, uint64_t* since) { (void)p; (void)n; (void)since; return 0; }
+uint64_t vm_watch_epoch(void) { return 0; }
+int vm_watch_clean_since(const void* p, size_t n, uint64_t since) { (void)p; (void)n; (void)since; return 0; }
+void vm_watch_release(const void* p, size_t n) { (void)p; (void)n; }
+void vm_watch_reset(void) {}
+
+#endif
diff --git a/runtime/memory/vm_watch.h b/runtime/memory/vm_watch.h
new file mode 100644
index 0000000..53af641
--- /dev/null
+++ b/runtime/memory/vm_watch.h
@@ -0,0 +1,52 @@
+/*
+ * vm_watch -- which guest pages were written since a point in time, without
+ * reading them and at no cost while nothing is written.
+ *
+ * A watched page is made read-only. The first write to it, from any thread
+ * (lifted PPU code, SPU DMA, the FIFO walker, the host's own memcpy), faults
+ * into a vectored handler that gives the page a new epoch and makes it
+ * writable again, and the write goes ahead. A consumer takes the epoch when
+ * it starts reading a range (vm_watch) and later asks whether any page of the
+ * range has a newer one (vm_watch_clean_since). Writes the host makes from
+ * the kernel -- a file read straight into guest memory -- would fail on a
+ * read-only page instead of faulting, so those paths call vm_watch_release
+ * first. A page written over and over is left unwatched (the caller then
+ * validates its own way). Windows for now; elsewhere vm_watch_available() is
+ * 0. The consumers (vm_watch, clean_since) run on one thread, the FIFO
+ * walker; the handler and vm_watch_release run on any.
+ */
+#ifndef VM_WATCH_H
+#define VM_WATCH_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int vm_watch_available(void);
+
+/* Watch [p, p+n) from now on. *since is the epoch to compare against later:
+ * read the range only after this returns. 0 when it cannot be watched. */
+int vm_watch(const void* p, size_t n, uint64_t* since);
+
+/* The current epoch: a page written after this shows a later one. */
+uint64_t vm_watch_epoch(void);
+
+/* 1 when no page of [p, p+n) was written after `since`. */
+int vm_watch_clean_since(const void* p, size_t n, uint64_t since);
+
+/* The host is about to write [p, p+n) from outside this process's own
+ * instructions (the kernel filling a read): count it as written and make the
+ * watched pages in it writable. Any thread; a no-op when nothing is watched. */
+void vm_watch_release(const void* p, size_t n);
+
+/* Stop watching everything (the consumer dropped what it read). */
+void vm_watch_reset(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
