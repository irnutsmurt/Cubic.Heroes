diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index e26a8e2..c475e82 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -17,6 +17,7 @@
 #include "rsx_restart_cuts.h"
 #include "rsx_vertex_formats.h"
 #include "rsx_vp_decompiler.h"
+#include "../../runtime/memory/vm_watch.h"
 
 #include <stdio.h>
 #include <stdlib.h>
@@ -217,6 +218,15 @@ static struct {
 static char s_vs_hlsl[256 * 1024];
 static char s_ps_hlsl[256 * 1024];
 
+/* Guest ranges one resident geometry entry was read from: its index runs and
+ * its vertex arrays (eng_geom_*). */
+#define ENG_GEOM_RANGES 8u
+typedef struct { const u8* p; u32 n; u64 since; } eng_geom_range;
+/* Why a draw could not become resident (RSX_GEOM_CACHE_STATS): more source
+ * ranges than ENG_GEOM_RANGES, a range outside the watched arena, an
+ * attribute without a stable source range, an index run not readable whole. */
+static unsigned long long s_geom_why[4];
+
 /* The draw accumulator: one BEGIN_END group's batches, references and cuts. */
 static struct {
     eng_batch arr[ENG_MAX_BATCHES];
@@ -252,6 +262,12 @@ static struct {
     const u8* inl;
     u32 inl_bytes;
     u32 inline_dropped_at_begin;
+
+    /* Building resident geometry: dc_fetch watches each guest range before
+     * it reads it and records it here; cleared when one cannot be watched. */
+    int geom_watch;
+    u32 n_geom_ranges;
+    eng_geom_range geom_range[ENG_GEOM_RANGES];
 } dc;
 
 /* ---- guest memory -------------------------------------------------------- */
@@ -2272,6 +2288,19 @@ static int dc_reserve_indices(u32 count)
     return 1;
 }
 
+/* Resident geometry being built: watch a guest range before reading it, so a
+ * write after this point is one the entry will see (vm_watch.h). */
+static void dc_geom_watch(const u8* p, u32 n)
+{
+    if (!dc.geom_watch) return;
+    for (u32 i = 0; i < dc.n_geom_ranges; i++)
+        if (p >= dc.geom_range[i].p && p + n <= dc.geom_range[i].p + dc.geom_range[i].n) return;
+    if (dc.n_geom_ranges == ENG_GEOM_RANGES) { s_geom_why[0]++; dc.geom_watch = 0; return; }
+    u64 since;
+    if (!vm_watch(p, n, &since)) { s_geom_why[1]++; dc.geom_watch = 0; return; }
+    dc.geom_range[dc.n_geom_ranges++] = (eng_geom_range){ p, n, since };
+}
+
 /* Turn this group's batches into a reference list, recording a CUT rather
  * than fetching a phantom vertex wherever the restart sentinel appears, then
  * collapse repeated references and fetch each unique vertex once.
@@ -2306,6 +2335,21 @@ static void dc_fetch(const rsx_vertex_layout_plan* layout, int allow_remap)
         /* The index array's location field is a DMA selector, not the
          * rsx_dsp location enum: 0 selects local memory. */
         const u32 ia_loc = ia.location ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL;
+        /* Resident geometry: one range over every batch's indices (they all
+         * index one buffer), watched before any of them is read. */
+        if (dc.geom_watch) {
+            u64 lo = ~0ull, hi = 0;
+            for (u32 b = 0; b < dc.n_idx; b++) {
+                const u64 s = (u64)ia.offset + (u64)dc.idx[b].first * esz;
+                const u64 e = s + (u64)dc.idx[b].count * esz;
+                if (s < lo) lo = s;
+                if (e > hi) hi = e;
+            }
+            const u8* run = (hi > lo && hi <= 0x100000000ull && hi - lo <= (64u << 20))
+                ? eng_guest_ptr(NULL, ia_loc, (u32)lo, (u32)(hi - lo)) : NULL;
+            if (run) dc_geom_watch(run, (u32)(hi - lo));
+            else { s_geom_why[3]++; dc.geom_watch = 0; }
+        }
 
         for (u32 b = 0; b < dc.n_idx && dc.fetch_ok; b++) {
             const u32 first = dc.idx[b].first, count = dc.idx[b].count;
@@ -2320,6 +2364,7 @@ static void dc_fetch(const rsx_vertex_layout_plan* layout, int allow_remap)
                     dc.fetch_ok = 0;
                 continue;
             }
+            if (dc.geom_watch) { s_geom_why[3]++; dc.geom_watch = 0; }
             for (u32 i = 0; i < count && dc.fetch_ok; i++) {
                 const u8* p = run ? run + (size_t)i * esz
                     : eng_guest_ptr(NULL, ia_loc, ia.offset + (first + i) * esz, esz);
@@ -2355,6 +2400,33 @@ static void dc_fetch(const rsx_vertex_layout_plan* layout, int allow_remap)
     rsx_vertex_fetch_plan_init(&dc.fetch_plan, &g.rsx, layout, eng_guest_ptr, NULL);
     rsx_vertex_fetch_plan_set_inline(&dc.fetch_plan, &g.rsx, dc.inl, dc.inl_bytes);
     rsx_vertex_fetch_plan_prepare(&dc.fetch_plan, dc.refs, dc.n_refs);
+    /* The source range of every attribute, as the vertex cache hashes it,
+     * merged where they overlap or lie within 64 KB (interleaved arrays span
+     * one buffer), each watched before the fetch below reads it. */
+    if (dc.geom_watch) {
+        const u8* lo[RSX_DSP_NUM_VERTEX_ATTR];
+        const u8* hi[RSX_DSP_NUM_VERTEX_ATTR];
+        u32 nr = 0;
+        for (u32 slot = 0; slot < layout->count; slot++) {
+            const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[layout->attrs[slot]];
+            if (!f->desc.type || !f->desc.size) continue;
+            if (!f->stable_base || f->stable_last < f->stable_first) {
+                s_geom_why[2]++; dc.geom_watch = 0; nr = 0; break;
+            }
+            const u8* b = f->stable_base;
+            const u8* e = b + (size_t)(f->stable_last - f->stable_first) * f->stride + f->elem_size;
+            u32 k = nr++;
+            for (; k && lo[k - 1] > b; k--) { lo[k] = lo[k - 1]; hi[k] = hi[k - 1]; }
+            lo[k] = b; hi[k] = e;
+        }
+        for (u32 r = 0; r < nr && dc.geom_watch;) {
+            const u8* b = lo[r];
+            const u8* e = hi[r];
+            for (r++; r < nr && lo[r] <= e + 0x10000; r++)
+                if (hi[r] > e) e = hi[r];
+            dc_geom_watch(b, (u32)(e - b));
+        }
+    }
     dc.n_verts = dc.n_refs;
     dc.vdata = rsx_vertex_fetch_cached(&dc.fetch_plan, dc.refs, dc.n_refs);
     if (dc.vdata) return;
@@ -2370,6 +2442,201 @@ static void dc_fetch(const rsx_vertex_layout_plan* layout, int allow_remap)
     dc.vdata = dc.verts;
 }
 
+/* ---- resident geometry --------------------------------------------------- */
+
+/* The fetch above, the reference collapse and the topology rebuild turn a
+ * draw's guest index and vertex arrays into one converted vertex block and a
+ * 32-bit index list. A title redraws the same static meshes frame after
+ * frame: 3D Dot Game Heroes' ~500 draws a frame hit the vertex cache every
+ * time with no change, and re-reading, re-hashing and re-copying them into
+ * the batch ring was ~9 ms of the FIFO walker's ~21 ms frame. Here the result
+ * lives in GPU memory (the backend's geom_*) under a key of the registers it
+ * was built from -- primitive, layout, vertex arrays and where they resolve,
+ * index array, the draw's ranges -- and is drawn from there while vm_watch
+ * reports none of the guest pages it was read from written. A write is
+ * recorded the moment it happens, by whichever thread makes it (the page
+ * faults once), and any write a draw depends on came before the walker read
+ * the draw; a written range rebuilds the entry at its next draw, and a draw
+ * rebuilt again and again (ENG_GEOM_DYNAMIC) is left on the copy path.
+ * RSX_GEOM_CACHE=0 turns it off; RSX_GEOM_CACHE_STATS=1 reports every 5 s;
+ * RSX_GEOM_CACHE_CHECK=1 rebuilds every hit as well and compares (slow: it
+ * proves the write tracking misses nothing). Windows only for now: it needs
+ * vm_watch_available(). */
+#define ENG_GEOM_SLOTS     8192u                 /* power of two */
+#define ENG_GEOM_MAX_BYTES (16u << 20)           /* larger draws keep the copy path */
+
+/* Rebuilt this often after writes, a draw's geometry is the title's dynamic
+ * kind (rewritten every frame or so): it stays on the copy path, unwatched. */
+#define ENG_GEOM_DYNAMIC 4u
+
+typedef struct {
+    u64 key;
+    u32 geom;                  /* backend handle; 0 for a dynamic draw */
+    u32 n_verts, n_draw;
+    u8  used, dynamic;
+    u16 rebuilds;
+    u8  indexed, n_ranges;
+    u64 checked;               /* the write epoch the ranges were last found clean at */
+    u64 check;                 /* RSX_GEOM_CACHE_CHECK: hash of what was uploaded */
+    eng_geom_range r[ENG_GEOM_RANGES];
+} eng_geom;
+
+static eng_geom* s_geom;
+static u32 s_geom_live;
+static struct { int on, stats, check; double t0;
+                unsigned long long look, hit, rebuilt, fresh, skip, missed, resets, dyn; } s_gs = { -1 };
+
+static int eng_geom_on(void)
+{
+    if (s_gs.on < 0) {
+        const char* e = getenv("RSX_GEOM_CACHE");
+        s_gs.stats = getenv("RSX_GEOM_CACHE_STATS") != NULL;
+        s_gs.check = getenv("RSX_GEOM_CACHE_CHECK") != NULL;
+        s_gs.on = !(e && *e == '0') && g.be->geom_create && g.be->geom_reset && g.be->draw_geom &&
+                  vm_watch_available();
+        if (s_gs.on && !(s_geom = (eng_geom*)calloc(ENG_GEOM_SLOTS, sizeof *s_geom))) s_gs.on = 0;
+        if (s_gs.stats)
+            fprintf(stderr, "[geom] resident geometry %s\n", s_gs.on ? "on"
+                    : (e && *e == '0') ? "off (RSX_GEOM_CACHE=0)" : "off (no backend support or no write watch)");
+    }
+    return s_gs.on;
+}
+
+static void eng_geom_report(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const double now = ts.tv_sec + ts.tv_nsec * 1e-9;
+    if (!s_gs.t0) s_gs.t0 = now;
+    if (now - s_gs.t0 < 5.0) return;
+    fprintf(stderr, "[geom] %.1f s: %llu draws, %llu resident, %llu rebuilt after a write, %llu new, "
+            "%llu dynamic, %llu too big; %u entries, %llu resets; not kept: %llu ranges, "
+            "%llu unwatched, %llu unstable, %llu index%s\n", now - s_gs.t0, s_gs.look, s_gs.hit,
+            s_gs.rebuilt, s_gs.fresh, s_gs.dyn, s_gs.skip, s_geom_live, s_gs.resets, s_geom_why[0],
+            s_geom_why[1], s_geom_why[2], s_geom_why[3],
+            s_gs.check ? (s_gs.missed ? " -- CHECK: MISSED WRITES" : " (check: no misses)") : "");
+    s_gs.look = s_gs.hit = s_gs.rebuilt = s_gs.fresh = s_gs.skip = s_gs.dyn = 0;
+    memset(s_geom_why, 0, sizeof s_geom_why);
+    s_gs.t0 = now;
+}
+
+/* Everything the fetch and the rebuild depend on besides guest memory. */
+static u64 eng_geom_key(u32 prim, const rsx_vertex_layout_plan* layout)
+{
+    u64 k = eng_fnv1a(&prim, sizeof prim, 1469598103934665603ull);
+    k = eng_fnv1a(layout, sizeof *layout, k);
+    k = eng_fnv1a(&dc.n_arr, sizeof dc.n_arr, k);
+    k = eng_fnv1a(dc.arr, dc.n_arr * (u32)sizeof dc.arr[0], k);
+    k = eng_fnv1a(&dc.n_idx, sizeof dc.n_idx, k);
+    k = eng_fnv1a(dc.idx, dc.n_idx * (u32)sizeof dc.idx[0], k);
+    const u32 regs[3] = { rsx_dsp_vertex_data_base_offset(&g.rsx), rsx_dsp_reg(&g.rsx, 0x1FC0),
+                          rsx_dsp_vertex_data_base_index(&g.rsx) };
+    k = eng_fnv1a(regs, sizeof regs, k);
+    for (u32 s = 0; s < layout->count; s++) {
+        const u32 a = layout->attrs[s];
+        rsx_dsp_vertex_attr d;
+        float def[4];
+        rsx_dsp_get_vertex_attr(&g.rsx, a, &d);
+        rsx_dsp_vertex_default(&g.rsx, a, def);
+        const u32 v[6] = { d.type, d.size, d.stride, d.frequency, d.offset, d.location };
+        /* Where the array resolves now: a remapped IO page is other memory. */
+        const void* host = (d.type && d.size) ? eng_guest_ptr(NULL, d.location, d.offset, 1) : NULL;
+        k = eng_fnv1a(v, sizeof v, k);
+        k = eng_fnv1a(def, sizeof def, k);
+        k = eng_fnv1a(&host, sizeof host, k);
+    }
+    if (dc.n_idx) {
+        rsx_dsp_index_array ia;
+        rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 v[5] = { ia.offset, ia.location, (u32)ia.is_u32,
+                           (u32)rsx_dsp_restart_index_enabled(&g.rsx, ia.is_u32),
+                           rsx_dsp_restart_index(&g.rsx) };
+        const void* host = eng_guest_ptr(NULL, ia.location ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL,
+                                         ia.offset, 1);
+        k = eng_fnv1a(v, sizeof v, k);
+        k = eng_fnv1a(&host, sizeof host, k);
+    }
+    return k;
+}
+
+static eng_geom* eng_geom_slot(u64 key)
+{
+    u32 i = (u32)key & (ENG_GEOM_SLOTS - 1u);
+    while (s_geom[i].used && s_geom[i].key != key) i = (i + 1u) & (ENG_GEOM_SLOTS - 1u);
+    return &s_geom[i];
+}
+
+/* Unwritten since it was read? */
+static int eng_geom_valid(eng_geom* e)
+{
+    const u64 now = vm_watch_epoch();
+    if (e->checked == now) return 1;
+    for (u32 r = 0; r < e->n_ranges; r++)
+        if (!vm_watch_clean_since(e->r[r].p, e->r[r].n, e->r[r].since)) return 0;
+    e->checked = now;
+    return 1;
+}
+
+/* Every entry dropped and the backend's memory reused. What this draw just
+ * watched is forgotten with the rest, so its caller does not store it. */
+static void eng_geom_flush(void)
+{
+    g.be->geom_reset(g.be->user);
+    memset(s_geom, 0, ENG_GEOM_SLOTS * sizeof *s_geom);
+    s_geom_live = 0;
+    vm_watch_reset();
+    s_gs.resets++;
+}
+
+static u64 eng_geom_hash(const void* verts, u64 vbytes, const u32* idx, u32 n_idx)
+{
+    u64 h = eng_fnv1a(&vbytes, sizeof vbytes, 1469598103934665603ull);
+    for (u64 at = 0; at < vbytes; at += 0x10000u)    /* eng_fnv1a takes a u32 length */
+        h = eng_fnv1a((const u8*)verts + at, (u32)(vbytes - at < 0x10000u ? vbytes - at : 0x10000u), h);
+    return idx ? eng_fnv1a(idx, n_idx * 4u, h) : h;
+}
+
+/* A draw whose memory cannot be watched (too many ranges, a page written over
+ * and over): remembered as dynamic, so its next draws skip the attempt. */
+static void eng_geom_mark_dynamic(u64 key)
+{
+    eng_geom* e = eng_geom_slot(key);
+    if (!e->used) {
+        if (s_geom_live + 1u > ENG_GEOM_SLOTS / 2u) return;
+        s_geom_live++;
+        e->rebuilds = 0;
+    }
+    e->used = 1;
+    e->dynamic = 1;
+    e->key = key;
+    e->geom = 0;
+}
+
+/* Upload what dc_fetch and the rebuild produced and remember it. Returns the
+ * backend handle, or 0 when the draw stays on the copy path this time. */
+static u32 eng_geom_store(u64 key, int indexed, u32 n_draw, u32 stride)
+{
+    const u64 vbytes = (u64)dc.n_verts * stride, ibytes = indexed ? (u64)n_draw * 4u : 0;
+    if (vbytes + ibytes > ENG_GEOM_MAX_BYTES) { s_gs.skip++; return 0; }
+    eng_geom* e = eng_geom_slot(key);
+    if (!e->used && s_geom_live + 1u > ENG_GEOM_SLOTS / 2u) { eng_geom_flush(); return 0; }
+    const u32 h = g.be->geom_create(g.be->user, dc.vdata, (u32)vbytes,
+                                    indexed ? g.indices : NULL, indexed ? n_draw : 0);
+    if (!h) { eng_geom_flush(); return 0; }
+    if (!e->used) { s_geom_live++; e->rebuilds = 0; }
+    e->used = 1;
+    e->key = key;
+    e->geom = h;
+    e->n_verts = dc.n_verts;
+    e->n_draw = n_draw;
+    e->indexed = (u8)indexed;
+    e->n_ranges = (u8)dc.n_geom_ranges;
+    memcpy(e->r, dc.geom_range, sizeof e->r);
+    e->checked = 0;
+    e->check = s_gs.check ? eng_geom_hash(dc.vdata, vbytes, indexed ? g.indices : NULL, n_draw) : 0;
+    return h;
+}
+
 /* ---- sink ---------------------------------------------------------------- */
 
 static void sink_begin(void* user, const rsx_dispatch* r, u32 prim)
@@ -3100,17 +3367,50 @@ static void sink_end(void* user, const rsx_dispatch* r)
 
     rsx_vertex_layout_plan layout;
     eng_vertex_layout(&layout);
-    dc_fetch(&layout, rebuild);
-    if (!dc.n_verts || !dc.fetch_ok) return;
+
+    /* Resident geometry: built from the same registers out of guest memory
+     * nobody wrote since, the draw's geometry is already in GPU memory and
+     * nothing is fetched. Otherwise dc_fetch watches what it reads, and the
+     * result is stored below. */
+    eng_geom* gm = NULL;
+    u64 gkey = 0;
+    dc.geom_watch = 0;
+    dc.n_geom_ranges = 0;
+    if (!dc.n_immediate && !dc.inl_bytes && eng_geom_on()) {
+        if (s_gs.stats) eng_geom_report();
+        s_gs.look++;
+        gkey = eng_geom_key(prim, &layout);
+        gm = eng_geom_slot(gkey);
+        int watch = 1;
+        if (!gm->used) { s_gs.fresh++; gm = NULL; }
+        else if (gm->dynamic) { s_gs.dyn++; gm = NULL; watch = 0; }
