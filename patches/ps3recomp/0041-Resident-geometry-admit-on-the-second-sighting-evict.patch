-/* Every entry dropped and the backend's memory reused. What this draw just
- * watched is forgotten with the rest, so its caller does not store it. */
-static void eng_geom_flush(void)
+/* Give an entry's GPU memory back (the backend reuses it once the GPU is done
+ * with it). */
+static void eng_geom_drop_gpu(eng_geom* e)
+{
+    if (e->geom) g.be->geom_release(g.be->user, e->geom);
+    s_geom_bytes -= e->bytes;
+    e->geom = 0;
+    e->bytes = 0;
+}
+
+/* Remove one entry. Linear probing: the entries after it in its cluster that
+ * could live earlier move back, so every lookup still finds its key. */
+static void eng_geom_erase(eng_geom* e)
+{
+    const u32 mask = ENG_GEOM_SLOTS - 1u;
+    eng_geom_drop_gpu(e);
+    u32 i = (u32)(e - s_geom), j = i;
+    for (;;) {
+        j = (j + 1u) & mask;
+        if (!s_geom[j].used) break;
+        const u32 home = (u32)s_geom[j].key & mask;
+        /* j may move to the hole at i unless its home lies cyclically in (i, j]. */
+        const int stays = i <= j ? (home > i && home <= j) : (home > i || home <= j);
+        if (!stays) { s_geom[i] = s_geom[j]; i = j; }
+    }
+    memset(&s_geom[i], 0, sizeof s_geom[i]);
+    s_geom_live--;
+}
+
+static int eng_geom_age_cmp(const void* a, const void* b)
 {
-    g.be->geom_reset(g.be->user);
-    memset(s_geom, 0, ENG_GEOM_SLOTS * sizeof *s_geom);
-    s_geom_live = 0;
-    vm_watch_reset();
-    s_gs.resets++;
+    const u32 x = ((const u32*)a)[0], y = ((const u32*)b)[0];
+    return x < y ? 1 : x > y ? -1 : 0;                  /* oldest first */
+}
+
+/* Room by dropping the entries drawn longest ago (see ENG_GEOM_MIN_AGE).
+ * Returns how many went; 0 when everything is in use. */
+static u32 eng_geom_evict(void)
+{
+    u32 (*c)[2] = (u32 (*)[2])malloc((size_t)s_geom_live * sizeof *c);   /* age, key's slot */
+    u64* keys = (u64*)malloc((size_t)s_geom_live * sizeof *keys);
+    if (!c || !keys) { free(c); free(keys); return 0; }
+    u32 n = 0;
+    for (u32 i = 0; i < ENG_GEOM_SLOTS; i++)
+        if (s_geom[i].used && g.frames - s_geom[i].last_use >= ENG_GEOM_MIN_AGE) {
+            c[n][0] = g.frames - s_geom[i].last_use;
+            c[n][1] = i;
+            n++;
+        }
+    qsort(c, n, sizeof *c, eng_geom_age_cmp);
+    const u32 take = n < s_geom_live / 4u + 1u ? n : s_geom_live / 4u + 1u;
+    for (u32 k = 0; k < take; k++) keys[k] = s_geom[c[k][1]].key;   /* erasing moves entries */
+    for (u32 k = 0; k < take; k++) {
+        eng_geom* e = eng_geom_slot(keys[k]);
+        if (e->used && e->key == keys[k]) eng_geom_erase(e);
+    }
+    free(c);
+    free(keys);
+    s_gs.evicted += take;
+    return take;
 }
 
