+/* SPU_TASKPROF=<secs>: where an async task's wall time goes, per image,
+ * printed every <secs>: waiting for its thread to start, setting up its
+ * local store (alloc, ELF load, context), running, and the rest. */
+static double spu_taskprof_now(void)
+{ struct timespec t; timespec_get(&t, TIME_UTC); return t.tv_sec + t.tv_nsec * 1e-9; }
+static void spu_taskprof_add(int image, double disp, double enter, double r0, double r1, double done)
+{
+    static int secs = -1;
+    if (secs < 0) { const char* e = getenv("SPU_TASKPROF"); secs = e ? atoi(e) : 0; }
+    if (!secs || !disp) return;
+    static double acc[64][4], last; static unsigned cnt[64];
+#ifdef _WIN32
+    static SRWLOCK lk = SRWLOCK_INIT; AcquireSRWLockExclusive(&lk);
+#else
+    static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER; pthread_mutex_lock(&lk);
+#endif
+    const unsigned k = (unsigned)image & 63u;
+    acc[k][0] += enter - disp; acc[k][1] += r0 - enter; acc[k][2] += r1 - r0; acc[k][3] += done - r1; cnt[k]++;
+    if (!last) last = done;
+    if (done - last >= secs) {
+        for (unsigned i = 0; i < 64; i++) if (cnt[i])
+            fprintf(stderr, "[taskprof] image=%u n=%u avg us: start %.1f setup %.1f run %.1f rest %.1f\n",
+                    i, cnt[i], acc[i][0] / cnt[i] * 1e6, acc[i][1] / cnt[i] * 1e6,
+                    acc[i][2] / cnt[i] * 1e6, acc[i][3] / cnt[i] * 1e6);
+        memset(acc, 0, sizeof acc); memset(cnt, 0, sizeof cnt); last = done;
+    }
+#ifdef _WIN32
+    ReleaseSRWLockExclusive(&lk);
+#else
+    pthread_mutex_unlock(&lk);
+#endif
+}
