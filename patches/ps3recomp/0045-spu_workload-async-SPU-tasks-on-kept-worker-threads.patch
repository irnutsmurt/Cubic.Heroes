+/* ---- Worker pool for async tasks --------------------------------------------
+ * A task used to get a host thread of its own, created at dispatch and gone
+ * when it returned. 3D Dot Game Heroes runs ~2,000 Bullet physics tasks a
+ * second while a cut tuft's debris settles, created on its main thread, which
+ * then polls for their results: ~116 us before each started (SPU_TASKPROF),
+ * and the creates on the main thread, took the frame rate under 40.
+ *
+ * Now a task goes to an idle worker, and a new worker is made only when none
+ * is idle -- so as many tasks run at once as before (a task may block in
+ * WAIT_SIGNAL until another one signals it), and the threads are kept.
+ * Starting a task fell to ~4 us and running one from 361 to 122 us (a fresh
+ * thread ran cold), and the burst from ~40 to 51-56 fps (tests/scripts/
+ * grass_cut.drive). Kept threads also show up in DIAG_PROF, which samples
+ * the threads alive when it starts. Running tasks on the dispatching thread
+ * instead hangs the game: these tasks wait on one another.
+ * Image 22 (the cri task) still gets a thread per task: its EXIT handling
+ * counts calls per thread (spu_channels.c). SPU_POOL=0 is the old way. */
+#define SPU_POOL_MAX 256          /* past this, a thread per task again */
+static spu_async_job *s_pool_head, *s_pool_tail;
+static unsigned s_pool_idle, s_pool_pending, s_pool_threads;
+#ifdef _WIN32
+static SRWLOCK s_pool_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_pool_cv = CONDITION_VARIABLE_INIT;
+#define POOL_LOCK()   AcquireSRWLockExclusive(&s_pool_lock)
+#define POOL_UNLOCK() ReleaseSRWLockExclusive(&s_pool_lock)
+#define POOL_WAIT()   SleepConditionVariableSRW(&s_pool_cv, &s_pool_lock, INFINITE, 0)
+#define POOL_WAKE()   WakeConditionVariable(&s_pool_cv)
+#else
+static pthread_mutex_t s_pool_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_pool_cv = PTHREAD_COND_INITIALIZER;
+#define POOL_LOCK()   pthread_mutex_lock(&s_pool_lock)
+#define POOL_UNLOCK() pthread_mutex_unlock(&s_pool_lock)
+#define POOL_WAIT()   pthread_cond_wait(&s_pool_cv, &s_pool_lock)
+#define POOL_WAKE()   pthread_cond_signal(&s_pool_cv)
+#endif
+
+#ifdef _WIN32
+static DWORD WINAPI spu_pool_worker(LPVOID unused)
+#else
+static void* spu_pool_worker(void* unused)
+#endif
+{
+    (void)unused;
+    ps3_thread_name("spu job");
+#ifdef _WIN32
+    { ULONG g = 256 * 1024; SetThreadStackGuarantee(&g); }   /* as spu_async_thread */
+    ULONG_PTR lo, hi; GetCurrentThreadStackLimits(&lo, &hi);
+#endif
+    for (;;) {
+        POOL_LOCK();
+        while (!s_pool_head) { s_pool_idle++; POOL_WAIT(); s_pool_idle--; }
+        spu_async_job* j = s_pool_head;
+        s_pool_head = (spu_async_job*)j->next;
+        if (!s_pool_head) s_pool_tail = NULL;
+        s_pool_pending--;
+        POOL_UNLOCK();
+        spu_async_run(j);
+#ifdef _WIN32
+        /* What a task's thread did when it ended: nothing on this stack may
+         * stay in the lock-line reserver set for the next task. */
+        { extern void spu_coh_forget_range(uintptr_t, uintptr_t);
+          spu_coh_forget_range((uintptr_t)lo, (uintptr_t)hi);
+          spu_mfc_forget_range((uintptr_t)lo, (uintptr_t)hi); }
+#endif
+    }
+#ifdef _WIN32
+    return 0;
+#else
+    return NULL;
+#endif
+}
+
+/* 1: queued for a worker. 0: the caller gives the task a thread of its own. */
+static int spu_pool_submit(spu_async_job* j)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SPU_POOL"); on = !(e && e[0] == '0'); }
+    if (!on || j->image_id == 22) return 0;
+    POOL_LOCK();
+    /* An idle worker for this task too, or a new one. Workers waking from an
+     * earlier wake still count as idle, so this can spawn one more than
+     * needed now and then; it is never one too few. */
+    const int spawn = s_pool_idle <= s_pool_pending;
+    if (spawn && s_pool_threads >= SPU_POOL_MAX) { POOL_UNLOCK(); return 0; }
+    j->next = NULL;
+    if (s_pool_tail) s_pool_tail->next = j; else s_pool_head = j;
+    s_pool_tail = j;
+    s_pool_pending++;
+    if (spawn) s_pool_threads++;
+    else POOL_WAKE();
+    POOL_UNLOCK();
+    if (!spawn) return 1;
+#ifdef _WIN32
+    /* The same 256 MB stack reservation as a task's own thread (below). */
+    HANDLE th = CreateThread(NULL, 256u << 20, spu_pool_worker, NULL,
+                             STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
+    if (th) { CloseHandle(th); return 1; }
+#else
+    pthread_t th; pthread_attr_t attr; pthread_attr_init(&attr);
+    int prc = pthread_attr_setstacksize(&attr, 256u << 20) == 0
+            ? pthread_create(&th, &attr, spu_pool_worker, NULL) : EINVAL;
+    pthread_attr_destroy(&attr);
+    if (prc != 0) prc = pthread_create(&th, NULL, spu_pool_worker, NULL);
+    if (prc == 0) { pthread_detach(th); return 1; }
+#endif
+    /* No worker could be made: the task is queued and runs when one frees. */
+    POOL_LOCK(); s_pool_threads--; POOL_UNLOCK();
+    return 1;
+}
