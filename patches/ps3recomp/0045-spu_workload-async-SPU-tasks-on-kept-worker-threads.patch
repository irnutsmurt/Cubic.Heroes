+ * lock were 65 MB in a three-minute session -- the starvation the SPURS job
+ * path's per-job lines were quietened for (spu_workload_dispatch_job). */
+static int spu_task_log(void)
+{
+    static int all = -1;
+    static unsigned n;   /* racy, and only ever a few lines off */
+    if (all < 0) all = getenv("SPU_TASK_LOG") ? 1 : 0;
+    return all || n++ < 48;
+}
