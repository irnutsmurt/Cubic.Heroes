From ddb60d74a4e2e482a44c7d7ee8c56d3393dfe035 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Sat, 31 Oct 2026 10:27:06 -0700
Subject: [PATCH 51/53] spu_workload: async SPU task runs in the PS3_FTRACE
 timeline

A span for every async task run (kind 16, PS3_FT_SPU_TASK): the host
thread, the lifted image, and the wait from dispatch to start. With the
flip requests and the PPU's syscalls already in the trace, a frame's
physics can be laid against the frame: 3D Dot Game Heroes' Bullet step
is two BulletCD runs in parallel, then ~24 BulletSolver phases of three
tasks, each phase sequenced by the PPU, and a slow frame runs 2-6 such
steps to catch up (the repo's tests/phys_frames.py tabulates it).
---
 include/ps3emu/ps3_ftrace.h | 2 ++
 runtime/spu/spu_workload.c  | 7 +++++++
 2 files changed, 9 insertions(+)

diff --git a/include/ps3emu/ps3_ftrace.h b/include/ps3emu/ps3_ftrace.h
index 84065d2..acec8c4 100644
--- a/include/ps3emu/ps3_ftrace.h
+++ b/include/ps3emu/ps3_ftrace.h
@@ -58,6 +58,8 @@ enum ps3_ft_kind {
                               * complete; who = render passes, a = depth resolves | colour copies << 16,
                               * b = 1 present / 0 flush */
     PS3_FT_HLE         = 15, /* who = PPU tid, a = NID, b = guest lr: an HLE import call */
+    PS3_FT_SPU_TASK    = 16, /* an async SPU task's run on a host thread: who = host tid,
+                              * a = lifted image, b = us from its dispatch to its start */
 };
 
 #if defined(_MSC_VER)
diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index b6d1141..6390bb7 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -14,6 +14,7 @@
 #include <string.h>
 #include "ps3emu/log_first.h"
 #include "ps3emu/ps3_strict.h"
+#include "ps3emu/ps3_ftrace.h"
 #ifdef _WIN32
 #include <windows.h>
 #else
@@ -407,6 +408,7 @@ typedef struct {
     uint32_t            taskset_ea;   /* captured race-free at dispatch (globals get clobbered) */
     uint32_t            taskid;
     double              t_disp;       /* SPU_TASKPROF: when it was dispatched */
+    uint64_t            ft_disp;      /* PS3_FTRACE: when it was dispatched */
     void*               next;         /* the worker pool's queue */
 } spu_async_job;
 
@@ -745,6 +747,7 @@ static void spu_taskprof_add(int image, double disp, double enter, double r0, do
 static void spu_async_run(spu_async_job* j)
 {
     const double t_enter = j->t_disp ? spu_taskprof_now() : 0;
+    const uint64_t ft_enter = j->ft_disp ? ps3_ft_now() : 0;
     double t_r0 = 0, t_r1 = 0;
     spu_taskset_mark(j->taskset_ea, j->taskid, 1);
     /* Persistent per-taskset LS: acquire (+serialize) the taskset's LS, or fall
@@ -1105,6 +1108,9 @@ static void spu_async_run(spu_async_job* j)
 #endif
     }
     if (t_r1) spu_taskprof_add(j->image_id, j->t_disp, t_enter, t_r0, t_r1, spu_taskprof_now());
+    if (ft_enter)
+        ps3_ft_span(PS3_FT_SPU_TASK, (uint32_t)GetCurrentThreadId(), (uint32_t)j->image_id,
+                    (uint32_t)((ft_enter - j->ft_disp) / 1000u), ft_enter, ps3_ft_now());
     free(j);
 }
 
@@ -1746,6 +1752,7 @@ int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
     j->fn = fn; j->image_id = image_id;
     { static int prof = -1; if (prof < 0) prof = getenv("SPU_TASKPROF") ? 1 : 0;
       j->t_disp = prof ? spu_taskprof_now() : 0; }
+    j->ft_disp = PS3_FT_ON() ? ps3_ft_now() : 0;
     /* Capture the taskset+taskid NOW (PPU thread, right after cellSpursCreateTask
      * set the globals for THIS task). Reading them later in the async thread races
      * the next CreateTask overwriting the single-slot globals -- with two audio
-- 
