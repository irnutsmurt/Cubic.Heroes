From 9adcedf4ec20349d362be9eff13567b01ed94f09 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Sat, 31 Oct 2026 10:41:39 -0700
Subject: [PATCH] cellSpurs: SPURS_SNAP, guest memory around a task pair

SPURS_SNAP=<first entry>:<second entry>:<n>[:<prefix>] writes guest memory
(committed pages below 0x20000000) to <prefix>pre.bin when the n-th task
with the first entry and argument word 0 == 0 is created, and to
<prefix>post.bin when the next task with the second entry is -- before a
Bullet step's first collision task and after its last. Everything a task
reads and everything it changed, to take it apart offline: how 3D Dot
Game Heroes' BulletCD task lays out its pairs, objects, shapes and
manifolds came from two such snapshots. Windows only.
---
 libs/spurs/cellSpurs.c | 56 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 9193cb6..598ed5c 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -1005,6 +1005,61 @@ s32 cellSpursTasksetAttributeSetName(CellSpursTasksetAttribute* attr,
  * on this thread; cellSpursCreateTask registers it before the task can run. */
 static _Thread_local u32 s_pending_exit_ct;
 
+/* SPURS_SNAP=<first entry>:<second entry>:<n>[:<prefix>] (hex, hex,
+ * decimal; Windows): guest memory written to <prefix>pre.bin when the n-th task with
+ * the first entry and argument word 0 == 0 is created, and to <prefix>post.bin
+ * when the next task with the second entry is -- before a Bullet step's first
+ * collision task and after its last, to take the tasks apart offline.
+ * Committed pages below 0x20000000, as records: u32 ea, u32 size, bytes. */
+static void spurs_snap_write(const char* path)
+{
+#ifdef _WIN32
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    unsigned long long total = 0;
+    for (uint32_t ea = 0x10000u; ea < 0x20000000u; ) {
+        MEMORY_BASIC_INFORMATION mbi;
+        if (!VirtualQuery(vm_base + ea, &mbi, sizeof mbi)) break;
+        uint64_t len = (uint64_t)((uintptr_t)mbi.BaseAddress + mbi.RegionSize - (uintptr_t)(vm_base + ea));
+        if (ea + len > 0x20000000u) len = 0x20000000u - ea;
+        if (mbi.State == MEM_COMMIT && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD))) {
+            const uint32_t l32 = (uint32_t)len;
+            fwrite(&ea, 4, 1, f); fwrite(&l32, 4, 1, f); fwrite(vm_base + ea, 1, l32, f);
+            total += len;
+        }
+        ea += (uint32_t)len;
+    }
+    fclose(f);
+    fprintf(stderr, "[spurs-snap] wrote %s (%llu MB)\n", path, total >> 20);
+#else
+    (void)path;
+#endif
+}
+
+static void spurs_snap_on_create(uint32_t entry, const uint32_t arg[4])
+{
+    static int on = -1, state;
+    static unsigned first, second, n, seen;
+    static char pfx[512];
+    if (on < 0) {
+        const char* e = getenv("SPURS_SNAP");
+        on = e && sscanf(e, "%x:%x:%u", &first, &second, &n) == 3;
+        const char* p = e ? strchr(e, ':') : NULL;
+        if (p) p = strchr(p + 1, ':');
+        if (p) p = strchr(p + 1, ':');
+        snprintf(pfx, sizeof pfx, "%s", p ? p + 1 : "snap_");
+    }
+    if (!on || state == 2) return;
+    char path[600];
+    if (state == 0 && entry == first && arg[0] == 0 && ++seen == n) {
+        fprintf(stderr, "[spurs-snap] pre: entry 0x%X arg %08X %08X %08X %08X\n", entry, arg[0], arg[1], arg[2], arg[3]);
+        snprintf(path, sizeof path, "%spre.bin", pfx); spurs_snap_write(path); state = 1;
+    } else if (state == 1 && entry == second) {
+        fprintf(stderr, "[spurs-snap] post: entry 0x%X arg %08X %08X %08X %08X\n", entry, arg[0], arg[1], arg[2], arg[3]);
+        snprintf(path, sizeof path, "%spost.bin", pfx); spurs_snap_write(path); state = 2;
+    }
+}
+
 s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
                         void* elf, void* context, u32 sizeContext,
                         u32 lsPattern_ea, u32 argument_ea)
@@ -1085,6 +1140,7 @@ s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
             { extern void spu_taskset2_set_exit(uint32_t, uint32_t, int, uint32_t);
               spu_taskset2_set_exit(taskset_ea, i, 0, 0); }   /* fresh entry for a recycled id */
             spu_taskset_set_exit_container(taskset_ea, i, s_pending_exit_ct);
+            spurs_snap_on_create((uint32_t)(uintptr_t)elf, task_arg);
             spurs_taskset_add_task(taskset_ea, i, (uint64_t)elf_ea,
                                    (uint64_t)context_ea, task_arg, task_lsp);
             /* Bridge to the image-22 dispatch so build_context uses this taskset+task. */
-- 
