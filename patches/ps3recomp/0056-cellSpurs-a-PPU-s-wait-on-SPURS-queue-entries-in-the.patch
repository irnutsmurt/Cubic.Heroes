From 06d6545bdebecaa4aa021218f64142c14991ebfe Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Sat, 31 Oct 2026 11:41:41 -0700
Subject: [PATCH] cellSpurs: a PPU's wait on SPURS queue entries in the frame
 trace

PS3_FT_QUEUE_WAIT (kind 17): from the first cellSpursQueuePopBody that
found a queue empty to the next one that took an entry, from whichever
queue, with the number of pops tried. Titles poll without blocking --
3D Dot Game Heroes polls its three Bullet slots' output queues in turn
for every phase of a step -- and each try is far too short to show as an
HLE span, so the main thread's real dependency on its SPU tasks was not
in the timeline at all.

With it, a slow fight frame (25-34 ms) splits into ~1.3 Bullet steps,
6.3 ms of task execution (collision 2.2, solver 4.1), 0.15 ms of gaps
between phases, and 5.4 ms of the main thread waiting.
---
 include/ps3emu/ps3_ftrace.h |  3 +++
 libs/spurs/cellSpurs.c      | 29 ++++++++++++++++++++++++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/include/ps3emu/ps3_ftrace.h b/include/ps3emu/ps3_ftrace.h
index 7c8c11f..9cfcc4c 100644
--- a/include/ps3emu/ps3_ftrace.h
+++ b/include/ps3emu/ps3_ftrace.h
@@ -62,6 +62,9 @@ enum ps3_ft_kind {
     PS3_FT_HLE         = 15, /* who = PPU tid, a = NID, b = guest lr: an HLE import call */
     PS3_FT_SPU_TASK    = 16, /* an async SPU task's run on a host thread: who = host tid,
                               * a = lifted image, b = us from its dispatch to its start */
+    PS3_FT_QUEUE_WAIT  = 17, /* a PPU waiting on a SPURS queue entry, from the first pop that
+                              * found it empty to the one that took one: who = PPU tid,
+                              * a = the queue it popped, b = pops tried */
 };
 
 #if defined(_MSC_VER)
diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 598ed5c..21f82ef 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -17,6 +17,8 @@
 #include "spurs_taskset.h"  /* REAL BE CellSpursTaskset layout builders (fork Option-B) */
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_base (guest mem) */
 #include "ps3emu/ps3_tprof.h"    /* PS3_TPROF: in-process samples of the SPU workers */
+#include "ps3emu/ps3_ftrace.h"   /* PS3_FTRACE: PPU waits on queue entries */
+#include "../../runtime/ppu/ppu_context.h"   /* g_active_ctx's thread id, for those spans */
 #include <stdio.h>
 #include <stdlib.h>   /* getenv -- an implicit decl returns int, truncating the pointer */
 #include <string.h>
@@ -3112,6 +3114,30 @@ static int sq_move(u32 q, u32 data, int to_queue)
     return done;
 }
 
+/* PS3_FTRACE: a PPU's wait for an entry to pop, as one span (PS3_FT_QUEUE_WAIT)
+ * from the first pop that found a queue empty to the next one that took an
+ * entry, from whichever queue. Titles poll without blocking, round the queues
+ * they wait on -- 3D Dot Game Heroes polls its three Bullet slots' output
+ * queues in turn -- and each try is far too short to show as an HLE span. */
+static _Thread_local uint64_t s_sq_wait_t0;
+static _Thread_local u32 s_sq_wait_polls;
+
+static void sq_ppu_wait_note(u32 q, int got)
+{
+    if (!PS3_FT_ON()) return;
+    if (got) {
+        if (s_sq_wait_t0) {
+            extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+            ps3_ft_span(PS3_FT_QUEUE_WAIT, g_active_ctx ? (uint32_t)g_active_ctx->thread_id : 0, q,
+                        s_sq_wait_polls, s_sq_wait_t0, ps3_ft_now());
+        }
+        s_sq_wait_t0 = 0;
+    } else {
+        if (!s_sq_wait_t0) { s_sq_wait_t0 = ps3_ft_now(); s_sq_wait_polls = 0; }
+        s_sq_wait_polls++;
+    }
+}
+
 static s32 sq_ppu_op(u64 queue_ea, u64 data_ea, u32 isBlocking, int to_queue)
 {
     const u32 q = (u32)queue_ea, data = (u32)data_ea;
@@ -3120,7 +3146,8 @@ static s32 sq_ppu_op(u64 queue_ea, u64 data_ea, u32 isBlocking, int to_queue)
     const u32 dir = vm_read32(q + 0x1C);
     if (dir != (to_queue ? 2u : 1u)) return SQ_PERM;      /* PPU pushes PPU2SPU, pops SPU2PPU */
     for (unsigned spin = 0;; spin++) {
-        if (sq_move(q, data, to_queue)) return CELL_OK;
+        if (sq_move(q, data, to_queue)) { if (!to_queue) sq_ppu_wait_note(q, 1); return CELL_OK; }
+        if (!to_queue) sq_ppu_wait_note(q, 0);
         if (!isBlocking) return SQ_AGAIN;
         if (spin < 64) Sleep(0); else Sleep(1);          /* wait for the SPU side */
     }
