diff --git a/libs/misc/photo_util.h b/libs/misc/photo_util.h
new file mode 100644
index 0000000..c4ffe18
--- /dev/null
+++ b/libs/misc/photo_util.h
@@ -0,0 +1,105 @@
+/*
+ * ps3recomp - shared helpers of the photo utilities (cellPhotoExport,
+ * cellPhotoImport, cellPhotoDecode)
+ *
+ * The XMB's photo column is a folder on the host: <PS3_HDD0_ROOT>/photo, where
+ * the console keeps it (/dev_hdd0/photo). Export copies a title's picture
+ * there, import copies one back out, decode reads one. Guest paths on
+ * /dev_hdd0 and /dev_hdd1 resolve the way ppu_fs.cpp resolves them
+ * ($PS3_HDD0_ROOT, $PS3_HDD1_ROOT); other devices are not served here.
+ */
+
+#ifndef PS3RECOMP_PHOTO_UTIL_H
+#define PS3RECOMP_PHOTO_UTIL_H
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#  include <direct.h>
+#  define photo_mkdir(p) _mkdir(p)
+#else
+#  define photo_mkdir(p) mkdir((p), 0777)
+#endif
+
+extern uint8_t* vm_base;
+
+/* A guest string, copied out (NUL-terminated within cap). */
+static inline void photo_guest_str(char* out, size_t cap, uint32_t ea)
+{
+    size_t i = 0;
+    if (ea && vm_base)
+        for (; i + 1 < cap && vm_base[ea + i]; i++) out[i] = (char)vm_base[ea + i];
+    out[i] = '\0';
+}
+
+/* Host path of a guest /dev_hdd0 or /dev_hdd1 path; 0 when it is elsewhere. */
+static inline int photo_host_path(char* out, size_t cap, const char* guest)
+{
+    const char* root = NULL;
+    if (!strncmp(guest, "/dev_hdd0/", 10)) root = getenv("PS3_HDD0_ROOT");
+    else if (!strncmp(guest, "/dev_hdd1/", 10)) root = getenv("PS3_HDD1_ROOT");
+    if (!root || !*root) return 0;
+    snprintf(out, cap, "%s/%s", root, guest + 10);
+    for (char* p = out; *p; p++) if (*p == '\\') *p = '/';
+    return 1;
+}
+
+/* Every missing directory of path, the last component included. */
+static inline void photo_mkdirs(const char* path)
+{
+    char p[1024];
+    snprintf(p, sizeof p, "%s", path);
+    for (char* c = p + 1; *c; c++)
+        if (*c == '/' && c[-1] != ':') { *c = '\0'; photo_mkdir(p); *c = '/'; }
+    photo_mkdir(p);
+}
+
+/* The photo column's folder, created on first use; 0 without PS3_HDD0_ROOT. */
+static inline int photo_library_dir(char* out, size_t cap)
+{
+    const char* root = getenv("PS3_HDD0_ROOT");
+    if (!root || !*root) return 0;
+    snprintf(out, cap, "%s/photo", root);
+    for (char* p = out; *p; p++) if (*p == '\\') *p = '/';
+    photo_mkdirs(out);
+    return 1;
+}
+
+static inline int photo_copy_file(const char* from, const char* to)
+{
+    FILE* in = fopen(from, "rb");
+    if (!in) return 0;
+    FILE* out = fopen(to, "wb");
+    if (!out) { fclose(in); return 0; }
+    char buf[65536];
+    size_t n;
+    int ok = 1;
+    while ((n = fread(buf, 1, sizeof buf, in)) > 0)
+        if (fwrite(buf, 1, n, out) != n) { ok = 0; break; }
+    fclose(in);
+    if (fclose(out) != 0) ok = 0;
+    return ok;
+}
+
+static inline void photo_write32(uint32_t ea, uint32_t v)
+{
+    vm_base[ea] = (uint8_t)(v >> 24); vm_base[ea + 1] = (uint8_t)(v >> 16);
+    vm_base[ea + 2] = (uint8_t)(v >> 8); vm_base[ea + 3] = (uint8_t)v;
+}
+static inline void photo_write16(uint32_t ea, uint16_t v)
+{
+    vm_base[ea] = (uint8_t)(v >> 8); vm_base[ea + 1] = (uint8_t)v;
+}
+static inline uint32_t photo_read32(uint32_t ea)
+{
+    return (uint32_t)vm_base[ea] << 24 | (uint32_t)vm_base[ea + 1] << 16 | (uint32_t)vm_base[ea + 2] << 8 | vm_base[ea + 3];
+}
+static inline uint16_t photo_read16(uint32_t ea)
+{
+    return (uint16_t)(vm_base[ea] << 8 | vm_base[ea + 1]);
+}
+
+#endif /* PS3RECOMP_PHOTO_UTIL_H */
