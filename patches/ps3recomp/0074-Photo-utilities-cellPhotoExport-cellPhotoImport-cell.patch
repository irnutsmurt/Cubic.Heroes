@@ -0,0 +1,40 @@
+/*
+ * ps3recomp - cellPhotoDecode HLE (cellPhotoDecodeUtil)
+ *
+ * The photo decode utility: a picture file (one cellPhotoImport copied out,
+ * say) decoded into the title's buffer. Initialize and Finalize answer
+ * through the title's finish callback; FromFile returns at once.
+ */
+
+#ifndef PS3RECOMP_CELL_PHOTO_DECODE_H
+#define PS3RECOMP_CELL_PHOTO_DECODE_H
+
+#include "ps3emu/ps3types.h"
+#include "ps3emu/error_codes.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CELL_PHOTO_DECODE_ERROR_BUSY         0x8002C901
+#define CELL_PHOTO_DECODE_ERROR_INTERNAL     0x8002C902
+#define CELL_PHOTO_DECODE_ERROR_PARAM        0x8002C903
+#define CELL_PHOTO_DECODE_ERROR_ACCESS_ERROR 0x8002C904
+#define CELL_PHOTO_DECODE_ERROR_INITIALIZE   0x8002C905
+#define CELL_PHOTO_DECODE_ERROR_DECODE       0x8002C906
+
+/* funcFinish: a guest OPD called as funcFinish(s32 result, void* userdata). */
+s32 cellPhotoDecodeInitialize(u32 version, u32 container1, u32 container2, u32 funcFinish, u32 userdata);
+s32 cellPhotoDecodeInitialize2(u32 version, u32 container2, u32 funcFinish, u32 userdata);
+s32 cellPhotoDecodeFinalize(u32 funcFinish, u32 userdata);
+/* set_param: CellPhotoDecodeSetParam { void* dstBuffer; u16 width, height;
+ * void* reserved1, reserved2 } -- the buffer holds width x height RGBA pixels.
+ * return_param: CellPhotoDecodeReturnParam { u16 width, height; void*
+ * reserved1, reserved2 } -- the size the picture was decoded at. */
+s32 cellPhotoDecodeFromFile(u32 srcHddDir, u32 srcHddFile, u32 set_param, u32 return_param);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_CELL_PHOTO_DECODE_H */
