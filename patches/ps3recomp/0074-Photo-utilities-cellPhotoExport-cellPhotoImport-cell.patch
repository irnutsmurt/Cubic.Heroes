+                const char* dot = strrchr(base, '.');
+                photo_write32(sub + 0, (u32)w);
+                photo_write32(sub + 4, (u32)h);
+                photo_write32(sub + 8, dot && (dot[1] == 'p' || dot[1] == 'P') ? CELL_PHOTO_IMPORT_FT_PNG
+                                                                                : CELL_PHOTO_IMPORT_FT_JPEG);
+                photo_write32(sub + 12, 0);   /* no rotation */
+            }
+        }
+    }
+    printf("[cellPhotoImport] Import(dst=%s): %s\n", dst_dir,
+           result == CELL_PHOTO_IMPORT_RET_OK ? pick : result == CELL_PHOTO_IMPORT_RET_CANCEL ? "nothing picked (cancel)" : "failed");
+    const u64 args[8] = { (u64)(s64)result, fd, userdata, 0, 0, 0, 0, 0 };
+    return cellSysutilQueueGuestCallbackArgs(funcFinish, args);
+}
 
