diff --git a/libs/misc/cellPhotoDecode.c b/libs/misc/cellPhotoDecode.c
new file mode 100644
index 0000000..2227221
--- /dev/null
+++ b/libs/misc/cellPhotoDecode.c
@@ -0,0 +1,84 @@
+/*
+ * ps3recomp - cellPhotoDecode HLE (cellPhotoDecodeUtil)
+ *
+ * FromFile decodes a JPEG or PNG (stb_image, compiled in cellPngDec.c) into
+ * the title's buffer as RGBA, scaled down to fit the buffer's size with its
+ * aspect kept when it is larger, and reports the size it was decoded at. The
+ * rest of the buffer is left as it was.
+ */
+
+#include "cellPhotoDecode.h"
+#include "../system/cellSysutil.h"
+#include "photo_util.h"
+#include "../codec/stb_image.h"
+
+static int s_initialized = 0;
+
+static s32 finish(u32 funcFinish, s32 result, u32 userdata)
+{
+    if (!funcFinish) return (s32)CELL_PHOTO_DECODE_ERROR_PARAM;
+    const u64 args[8] = { (u64)(s64)result, userdata, 0, 0, 0, 0, 0, 0 };
+    return cellSysutilQueueGuestCallbackArgs(funcFinish, args);
+}
+
+s32 cellPhotoDecodeInitialize(u32 version, u32 container1, u32 container2, u32 funcFinish, u32 userdata)
+{
+    (void)container1; (void)container2;
+    printf("[cellPhotoDecode] Initialize(version=%u)\n", version);
+    if (!funcFinish) return (s32)CELL_PHOTO_DECODE_ERROR_PARAM;
+    s_initialized = 1;
+    return finish(funcFinish, CELL_OK, userdata);
+}
+
+s32 cellPhotoDecodeInitialize2(u32 version, u32 container2, u32 funcFinish, u32 userdata)
+{
+    return cellPhotoDecodeInitialize(version, 0, container2, funcFinish, userdata);
+}
+
+s32 cellPhotoDecodeFinalize(u32 funcFinish, u32 userdata)
+{
+    printf("[cellPhotoDecode] Finalize()\n");
+    if (!funcFinish) return (s32)CELL_PHOTO_DECODE_ERROR_PARAM;
+    s_initialized = 0;
+    return finish(funcFinish, CELL_OK, userdata);
+}
+
+s32 cellPhotoDecodeFromFile(u32 srcHddDir, u32 srcHddFile, u32 set_param, u32 return_param)
+{
+    if (!srcHddDir || !srcHddFile || !set_param || !return_param) return (s32)CELL_PHOTO_DECODE_ERROR_PARAM;
+    if (!s_initialized) return (s32)CELL_PHOTO_DECODE_ERROR_INITIALIZE;
+    char dir[1024], file[256], guest[1300], path[1600];
+    photo_guest_str(dir, sizeof dir, srcHddDir);
+    photo_guest_str(file, sizeof file, srcHddFile);
+    snprintf(guest, sizeof guest, "%s/%s", dir, file);
+    if (!photo_host_path(path, sizeof path, guest)) return (s32)CELL_PHOTO_DECODE_ERROR_ACCESS_ERROR;
+
+    const u32 dst = photo_read32(set_param);
+    const int bw = photo_read16(set_param + 4), bh = photo_read16(set_param + 6);
+    if (!dst || !bw || !bh) return (s32)CELL_PHOTO_DECODE_ERROR_PARAM;
+    int w = 0, h = 0, comp = 0;
+    unsigned char* px = stbi_load(path, &w, &h, &comp, 4);
+    if (!px) {
+        printf("[cellPhotoDecode] FromFile(%s): cannot decode\n", guest);
+        return (s32)CELL_PHOTO_DECODE_ERROR_DECODE;
+    }
+    /* Fit inside bw x bh, aspect kept; nearest sample (a photo shown in a
+     * title's frame, not resampled for print). */
+    int ow = w, oh = h;
+    if (ow > bw || oh > bh) {
+        if ((long long)w * bh > (long long)h * bw) { ow = bw; oh = (int)((long long)h * bw / w); }
+        else { oh = bh; ow = (int)((long long)w * bh / h); }
+        if (ow < 1) ow = 1;
+        if (oh < 1) oh = 1;
+    }
+    for (int y = 0; y < oh; y++) {
+        const unsigned char* row = px + (size_t)(y * h / oh) * w * 4;
+        uint8_t* out = vm_base + dst + (size_t)y * bw * 4;
+        for (int x = 0; x < ow; x++) memcpy(out + x * 4, row + (size_t)(x * w / ow) * 4, 4);
+    }
+    stbi_image_free(px);
+    photo_write16(return_param, (uint16_t)ow);
+    photo_write16(return_param + 2, (uint16_t)oh);
+    printf("[cellPhotoDecode] FromFile(%s): %dx%d into %dx%d at %dx%d\n", guest, w, h, bw, bh, ow, oh);
+    return CELL_OK;
+}
