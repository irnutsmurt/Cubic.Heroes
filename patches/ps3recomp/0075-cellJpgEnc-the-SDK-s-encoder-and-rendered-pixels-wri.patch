+/* For a library that reads pixels the title rendered -- cellJpgEnc encoding
+ * the display buffer 3D Dot Game Heroes' SNAPSHOT draws into. The engine
+ * renders on the host GPU, so those pixels are not in guest memory until
+ * written back: store the engine's pixels of the rectangle at guest address
+ * ea (RSX local memory, or main memory the RSX has mapped) into guest memory,
+ * as a 2D transfer reading it would (nv3089_engine_read). It drives the
+ * engine, so it takes the FIFO walker's lock, as the poll path does. pitch in
+ * bytes; w and h in 32-bit pixels. Nothing happens without the engine or for
+ * an address the RSX does not see. */
+void cellGcm_guest_read_surface(u32 ea, u32 pitch, u32 w, u32 h)
+{
+    if (!rsx_draw_engine_enabled() || !pitch || !w || !h) return;
+    u32 location, offset;
+    if (ea >= s_config.localAddress && ea - s_config.localAddress < s_config.localSize) {
+        location = RSX_LOCATION_LOCAL;
+        offset = ea - s_config.localAddress;
+    } else {
+        const u32 page = ea >> 20;
+        if (page >= 65536 || s_io_address_table[page] == 0xFFFF) return;
+        location = RSX_LOCATION_MAIN;
+        offset = ((u32)s_io_address_table[page] << 20) | (ea & 0xFFFFF);
+    }
+    AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    rsx_draw_engine_guest_read(location, offset, pitch, w, h);
+    ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
+}
