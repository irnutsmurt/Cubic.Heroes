+ *   CellPngEncResource    { void* memAddr; u32 memSize; s32 ppuThreadPriority,
+ *                           spuThreadPriority }
+ *   CellPngEncPicture     { u32 width, height, pitchWidth, colorSpace,
+ *                           bitDepth; b8 packedPixel (+3); void* pictureAddr;
+ *                           u64 userData }
+ *   CellPngEncEncodeParam { b8 enableSpu (+3); u32 encodeColorSpace,
+ *                           compressionLevel, filterType; void*
+ *                           ancillaryChunkList; u32 ancillaryChunkNum }
+ *   CellPngEncOutputParam { u32 location; const char* streamFileName;
+ *                           void* streamAddr; u32 limitSize }
+ *   CellPngEncStreamInfo  { u32 state, location; const char* streamFileName;
+ *                           void* streamAddr; u32 limitSize, streamSize,
+ *                           processedLine (+pad); u64 userData } */
+s32 cellPngEncQueryAttr(u32 config, u32 attr);
+s32 cellPngEncOpen(u32 config, u32 resource, u32 handle);
+s32 cellPngEncOpenEx(u32 config, u32 resource, u32 handle);
+s32 cellPngEncWaitForInput(u32 handle, u32 block);
+s32 cellPngEncEncodePicture(u32 handle, u32 picture, u32 encodeParam, u32 outputParam);
+s32 cellPngEncWaitForOutput(u32 handle, u32 streamInfoNum, u32 block);
+s32 cellPngEncGetStreamInfo(u32 handle, u32 streamInfo);
+s32 cellPngEncReset(u32 handle);
+s32 cellPngEncClose(u32 handle);
 
 #ifdef __cplusplus
 }
