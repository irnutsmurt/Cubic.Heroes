From d01e86423d97443def6721edb0e8f562c569d0f5 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Mon, 2 Nov 2026 03:27:01 -0800
Subject: [PATCH] cellPngEnc: the SDK's encoder

cellPngEnc was a placeholder with made-up functions. Now QueryAttr, Open,
OpenEx, WaitForInput, EncodePicture, WaitForOutput, GetStreamInfo, Reset
and Close, laid out as 3D Dot Game Heroes fills them (the same shape as
cellJpgEnc): an 8-bit grayscale, grayscale+alpha, RGB, RGBA or ARGB picture
is encoded at once (stb_image_write, still compiled here) in the output
colour space asked for, into a file or a guest buffer, with a rendered
picture written back from the GPU first (cellGcm_guest_read_surface).

The game's dot editor saves a character's icon this way; its SAVE stopped
at cellPngEncOpen. It now writes the icon and DATA.EDT as edit data.
---
 libs/codec/cellPngEnc.c | 297 +++++++++++++++++++++-------------------
 libs/codec/cellPngEnc.h |  94 +++++++------
 2 files changed, 209 insertions(+), 182 deletions(-)

diff --git a/libs/codec/cellPngEnc.c b/libs/codec/cellPngEnc.c
index b7760d5..e47c4db 100644
--- a/libs/codec/cellPngEnc.c
+++ b/libs/codec/cellPngEnc.c
@@ -1,183 +1,204 @@
 /*
- * ps3recomp - cellPngEnc HLE implementation
+ * ps3recomp - cellPngEnc HLE
  *
- * Real PNG encoding via stb_image_write.h.
- * Converts raw pixel data (ARGB/RGBA/grayscale) to PNG format in memory.
+ * An encode runs inside EncodePicture: the picture (8 bits a channel:
+ * grayscale, grayscale+alpha, RGB, RGBA or ARGB, rows pitchWidth bytes apart)
+ * is written as a PNG in the title's output colour space -- grayscale,
+ * grayscale+alpha, RGB or RGBA -- to its output: a file (a /dev_hdd0 or
+ * /dev_hdd1 path, resolved as ppu_fs.cpp does) or a guest buffer of limitSize
+ * bytes. WaitForOutput then has one stream waiting and GetStreamInfo
+ * describes it. 3D Dot Game Heroes' dot editor saves a character this way.
  */
 
 #include "cellPngEnc.h"
-#include <stdio.h>
-#include <string.h>
-#include <stdlib.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
-#include "../guest_struct.h"   /* GUEST_EA, guest_struct_load/store */
+#include "../misc/photo_util.h"
+#include "../video/cellGcmSys.h"   /* cellGcm_guest_read_surface */
 
-/* stb_image_write for PNG encoding */
+/* stb_image_write, compiled here for the runtime (cellJpgEnc uses it too). */
 #define STB_IMAGE_WRITE_IMPLEMENTATION
 #define STBIW_ASSERT(x)
 #include "stb_image_write.h"
 
-/* Internal state */
+#define PNGENC_HANDLES 4
 
 typedef struct {
-    int in_use;
-    CellPngEncParam param;
-} PngEncHandle;
+    int open;
+    int pending;           /* a stream waiting for GetStreamInfo */
+    u32 location, file_name_ea, stream_addr, limit_size, stream_size, lines;
+    s32 status;            /* the encode's result */
+} PngEnc;
 
-static PngEncHandle s_handles[CELL_PNGENC_HANDLE_MAX];
+static PngEnc s_enc[PNGENC_HANDLES + 1];   /* handles 1..PNGENC_HANDLES */
 
-/* stb callback: write PNG data to a growing buffer */
-typedef struct {
-    u8* data;
-    u32 size;
-    u32 capacity;
-} PngWriteContext;
-
-static void png_write_callback(void* context, void* data, int size)
+static PngEnc* enc_of(u32 handle)
 {
-    PngWriteContext* ctx = (PngWriteContext*)context;
-    if (ctx->size + (u32)size > ctx->capacity) {
-        u32 new_cap = ctx->capacity * 2;
-        if (new_cap < ctx->size + (u32)size)
-            new_cap = ctx->size + (u32)size + 4096;
-        u8* new_data = (u8*)realloc(ctx->data, new_cap);
-        if (!new_data) return;
-        ctx->data = new_data;
-        ctx->capacity = new_cap;
-    }
-    memcpy(ctx->data + ctx->size, data, (size_t)size);
-    ctx->size += (u32)size;
+    return handle >= 1 && handle <= PNGENC_HANDLES && s_enc[handle].open ? &s_enc[handle] : NULL;
 }
 
-/* API */
-
-s32 cellPngEncQueryAttr(const CellPngEncParam* param, u32* workMemSize)
+s32 cellPngEncQueryAttr(u32 config, u32 attr)
 {
-    (void)param;
-    if (!workMemSize) return (s32)CELL_PNGENC_ERROR_INVALID_ARGUMENT;
-    vm_write32((u32)(uintptr_t)workMemSize, (u32)1024 * 1024); /* 1 MB */
+    if (!config || !attr) return (s32)CELL_PNGENC_ERROR_ARG;
+    photo_write32(attr + 0x0, 0x10000);   /* memSize: the title's work area, unused here */
+    vm_base[attr + 0x4] = 4;              /* cmdQueueDepth */
+    photo_write32(attr + 0x8, 0x00010000);
+    photo_write32(attr + 0xC, 0);
     return CELL_OK;
 }
 
-s32 cellPngEncCreate(const CellPngEncParam* param, CellPngEncHandle* handle)
+s32 cellPngEncOpen(u32 config, u32 resource, u32 handle)
 {
-    printf("[cellPngEnc] Create(%ux%u, colorSpace=%u)\n",
-           param ? vm_read32(GUEST_EA(param) + (u32)offsetof(CellPngEncParam, width)) : 0,
-           param ? vm_read32(GUEST_EA(param) + (u32)offsetof(CellPngEncParam, height)) : 0,
-           param ? vm_read32(GUEST_EA(param)
-                             + (u32)offsetof(CellPngEncParam, colorSpace)) : 0);
-    if (!param || !handle)
-        return (s32)CELL_PNGENC_ERROR_INVALID_ARGUMENT;
-
-    for (int i = 0; i < CELL_PNGENC_HANDLE_MAX; i++) {
-        if (!s_handles[i].in_use) {
-            memset(&s_handles[i], 0, sizeof(PngEncHandle));
-            s_handles[i].in_use = 1;
-            guest_struct_load(&s_handles[i].param, GUEST_EA(param),
-                              (u32)sizeof(s_handles[i].param));
-            vm_write32((u32)(uintptr_t)handle, (u32)i);
+    if (!config || !resource || !handle) return (s32)CELL_PNGENC_ERROR_ARG;
+    for (u32 h = 1; h <= PNGENC_HANDLES; h++)
+        if (!s_enc[h].open) {
+            memset(&s_enc[h], 0, sizeof s_enc[h]);
+            s_enc[h].open = 1;
+            photo_write32(handle, h);
+            printf("[cellPngEnc] Open(max %ux%u) -> %u\n", photo_read32(config), photo_read32(config + 4), h);
             return CELL_OK;
         }
-    }
-    return (s32)CELL_PNGENC_ERROR_OUT_OF_MEMORY;
+    return (s32)CELL_PNGENC_ERROR_FATAL;
 }
 
-s32 cellPngEncDestroy(CellPngEncHandle handle)
+s32 cellPngEncOpenEx(u32 config, u32 resource, u32 handle)
 {
-    printf("[cellPngEnc] Destroy(%u)\n", handle);
-    if (handle >= CELL_PNGENC_HANDLE_MAX || !s_handles[handle].in_use)
-        return (s32)CELL_PNGENC_ERROR_INVALID_ARGUMENT;
-    s_handles[handle].in_use = 0;
-    return CELL_OK;
+    return cellPngEncOpen(config, resource, handle);
 }
 
-s32 cellPngEncEncode(CellPngEncHandle handle, const void* inputData,
-                       CellPngEncOutputInfo* outputInfo)
+s32 cellPngEncWaitForInput(u32 handle, u32 block)
 {
-    if (handle >= CELL_PNGENC_HANDLE_MAX || !s_handles[handle].in_use)
-        return (s32)CELL_PNGENC_ERROR_INVALID_ARGUMENT;
-    if (!inputData || !outputInfo)
-        return (s32)CELL_PNGENC_ERROR_INVALID_ARGUMENT;
-
-    PngEncHandle* h = &s_handles[handle];
-    u32 w = h->param.width;
-    u32 h_px = h->param.height;
-
-    /* Determine channel count from color space */
-    int channels;
-    switch (h->param.colorSpace) {
-    case CELL_PNGENC_COLOR_SPACE_ARGB:
-    case CELL_PNGENC_COLOR_SPACE_RGBA:
-        channels = 4;
-        break;
-    case CELL_PNGENC_COLOR_SPACE_GRAYSCALE_A:
-        channels = 2;
-        break;
-    case CELL_PNGENC_COLOR_SPACE_GRAYSCALE:
-    default:
-        channels = 1;
-        break;
-    }
-
-    printf("[cellPngEnc] Encode(%ux%u, %d channels)\n", w, h_px, channels);
+    (void)block;
+    return enc_of(handle) ? CELL_OK : (s32)CELL_PNGENC_ERROR_ARG;
+}
 
-    /* For ARGB input, we need to swizzle to RGBA for stb */
-    const u8* src = (const u8*)inputData;
-    u8* rgba_buf = NULL;
+typedef struct { u32 addr, limit, used; int overflow; } BufOut;
+static void buf_write(void* context, void* data, int size)
+{
+    BufOut* o = (BufOut*)context;
+    if (o->used + (u32)size > o->limit) { o->overflow = 1; return; }
+    memcpy(vm_base + o->addr + o->used, data, (size_t)size);
+    o->used += (u32)size;
+}
+typedef struct { FILE* f; u32 used; } FileOut;
+static void file_write(void* context, void* data, int size)
+{
+    FileOut* o = (FileOut*)context;
+    o->used += (u32)fwrite(data, 1, (size_t)size, o->f);
+}
 
-    if (h->param.colorSpace == CELL_PNGENC_COLOR_SPACE_ARGB && channels == 4) {
-        rgba_buf = (u8*)malloc(w * h_px * 4);
-        if (!rgba_buf) return (s32)CELL_PNGENC_ERROR_OUT_OF_MEMORY;
-        for (u32 i = 0; i < w * h_px; i++) {
-            rgba_buf[i * 4 + 0] = src[i * 4 + 1]; /* R */
-            rgba_buf[i * 4 + 1] = src[i * 4 + 2]; /* G */
-            rgba_buf[i * 4 + 2] = src[i * 4 + 3]; /* B */
-            rgba_buf[i * 4 + 3] = src[i * 4 + 0]; /* A */
+s32 cellPngEncEncodePicture(u32 handle, u32 picture, u32 encodeParam, u32 outputParam)
+{
+    PngEnc* e = enc_of(handle);
+    if (!e || !picture || !encodeParam || !outputParam) return (s32)CELL_PNGENC_ERROR_ARG;
+    if (e->pending) return (s32)CELL_PNGENC_ERROR_BUSY;
+    const u32 w = photo_read32(picture), h = photo_read32(picture + 4), pitch = photo_read32(picture + 8);
+    const u32 cs = photo_read32(picture + 12), depth = photo_read32(picture + 16);
+    const u32 src = photo_read32(picture + 24);
+    const u32 in_bpp = cs == CELL_PNGENC_COLOR_SPACE_GRAYSCALE ? 1 : cs == CELL_PNGENC_COLOR_SPACE_GRAYSCALE_ALPHA ? 2
+                     : cs == CELL_PNGENC_COLOR_SPACE_RGB ? 3
+                     : (cs == CELL_PNGENC_COLOR_SPACE_RGBA || cs == CELL_PNGENC_COLOR_SPACE_ARGB) ? 4 : 0;
+    if (!w || !h || !src || !in_bpp || (depth && depth != 8) || pitch < w * in_bpp)
+        return (s32)CELL_PNGENC_ERROR_ARG;
+    const u32 ocs = photo_read32(encodeParam + 4);
+    const int comp = ocs == CELL_PNGENC_COLOR_SPACE_GRAYSCALE ? 1 : ocs == CELL_PNGENC_COLOR_SPACE_GRAYSCALE_ALPHA ? 2
+                   : ocs == CELL_PNGENC_COLOR_SPACE_RGBA ? 4 : 3;
+
+    /* A picture the title rendered is on the host GPU until written back. */
+    if (in_bpp == 4) cellGcm_guest_read_surface(src, pitch, w, h);
+    unsigned char* px = (unsigned char*)malloc((size_t)w * h * comp);
+    if (!px) return (s32)CELL_PNGENC_ERROR_FATAL;
+    for (u32 y = 0; y < h; y++) {
+        const uint8_t* row = vm_base + src + (size_t)y * pitch;
+        unsigned char* out = px + (size_t)y * w * comp;
+        for (u32 x = 0; x < w; x++, out += comp) {
+            const uint8_t* p = row + (size_t)x * in_bpp;
+            uint8_t r, g, b, a = 0xFF;
+            if (in_bpp <= 2) { r = g = b = p[0]; if (in_bpp == 2) a = p[1]; }
+            else if (cs == CELL_PNGENC_COLOR_SPACE_ARGB) { a = p[0]; r = p[1]; g = p[2]; b = p[3]; }
+            else { r = p[0]; g = p[1]; b = p[2]; if (in_bpp == 4) a = p[3]; }
+            if (comp <= 2) { out[0] = (uint8_t)((r * 77 + g * 150 + b * 29) >> 8); if (comp == 2) out[1] = a; }
+            else { out[0] = r; out[1] = g; out[2] = b; if (comp == 4) out[3] = a; }
         }
-        src = rgba_buf;
     }
 
-    /* Encode to PNG in memory */
-    PngWriteContext ctx = {0};
-    ctx.capacity = w * h_px * channels + 4096;
-    ctx.data = (u8*)malloc(ctx.capacity);
-    if (!ctx.data) {
-        free(rgba_buf);
-        return (s32)CELL_PNGENC_ERROR_OUT_OF_MEMORY;
+    e->location = photo_read32(outputParam);
+    e->file_name_ea = photo_read32(outputParam + 4);
+    e->stream_addr = photo_read32(outputParam + 8);
+    e->limit_size = photo_read32(outputParam + 12);
+    e->stream_size = 0;
+    e->lines = h;
+    e->status = CELL_OK;
+    if (e->location == CELL_PNGENC_LOCATION_FILE) {
+        char guest[1024], path[1400];
+        photo_guest_str(guest, sizeof guest, e->file_name_ea);
+        FileOut o = { NULL, 0 };
+        if (photo_host_path(path, sizeof path, guest)) {
+            char dir[1400];
+            snprintf(dir, sizeof dir, "%s", path);
+            char* slash = strrchr(dir, '/');
+            if (slash) { *slash = '\0'; photo_mkdirs(dir); }
+            o.f = fopen(path, "wb");
+        }
+        if (!o.f) e->status = (s32)CELL_PNGENC_ERROR_STREAM_FILE_OPEN;
+        else {
+            stbi_write_png_to_func(file_write, &o, (int)w, (int)h, comp, px, (int)(w * comp));
+            fclose(o.f);
+            e->stream_size = o.used;
+        }
+        printf("[cellPngEnc] EncodePicture(%ux%u at 0x%08X, color space %u -> %u) -> %s, %u bytes\n", w, h, src, cs, ocs,
+               guest, e->stream_size);
+    } else {
+        BufOut o = { e->stream_addr, e->limit_size, 0, 0 };
+        stbi_write_png_to_func(buf_write, &o, (int)w, (int)h, comp, px, (int)(w * comp));
+        e->stream_size = o.used;
+        if (o.overflow) e->status = (s32)CELL_PNGENC_ERROR_STREAM_OVERFLOW;
+        printf("[cellPngEnc] EncodePicture(%ux%u at 0x%08X, color space %u -> %u) -> buffer, %u bytes%s\n", w, h, src,
+               cs, ocs, o.used, o.overflow ? " (overflow)" : "");
     }
+    free(px);
+    e->pending = 1;
+    return CELL_OK;
+}
 
-    int stride = (int)(w * channels);
-    int result = stbi_write_png_to_func(png_write_callback, &ctx,
-                                         (int)w, (int)h_px, channels, src, stride);
-
-    free(rgba_buf);
-
-    if (!result) {
-        free(ctx.data);
-        return (s32)CELL_PNGENC_ERROR_FATAL;
-    }
+s32 cellPngEncWaitForOutput(u32 handle, u32 streamInfoNum, u32 block)
+{
+    (void)block;
+    PngEnc* e = enc_of(handle);
+    if (!e || !streamInfoNum) return (s32)CELL_PNGENC_ERROR_ARG;
+    photo_write32(streamInfoNum, e->pending ? 1 : 0);
+    return e->pending ? CELL_OK : (s32)CELL_PNGENC_ERROR_EMPTY;
+}
 
-    /* The encoded bytes have nowhere to go. CellPngEncOutputInfo.outputData is a
-     * pointer the TITLE reads, and what we have is a host malloc -- writing it
-     * would hand the guest an address it cannot touch (and the old code leaked
-     * the buffer besides). Report the size and a null pointer, which the caller
-     * can at least test.
-     *
-     * ponytail: the real API hands the encoder a destination buffer at open
-     * time; wire that through cellPngEncOpen and the data has somewhere to land.
-     */
-    u32 out_ea = GUEST_EA(outputInfo);
-    vm_write32(out_ea + (u32)offsetof(CellPngEncOutputInfo, outputData), 0);
-    vm_write32(out_ea + (u32)offsetof(CellPngEncOutputInfo, outputSize), ctx.size);
-    free(ctx.data);
-    printf("[cellPngEnc] Encode complete: %u bytes\n", ctx.size);
+s32 cellPngEncGetStreamInfo(u32 handle, u32 streamInfo)
+{
+    PngEnc* e = enc_of(handle);
+    if (!e || !streamInfo) return (s32)CELL_PNGENC_ERROR_ARG;
+    if (!e->pending) return (s32)CELL_PNGENC_ERROR_EMPTY;
+    photo_write32(streamInfo + 0x00, (u32)e->status);
+    photo_write32(streamInfo + 0x04, e->location);
+    photo_write32(streamInfo + 0x08, e->file_name_ea);
+    photo_write32(streamInfo + 0x0C, e->stream_addr);
+    photo_write32(streamInfo + 0x10, e->limit_size);
+    photo_write32(streamInfo + 0x14, e->stream_size);
+    photo_write32(streamInfo + 0x18, e->lines);
+    photo_write32(streamInfo + 0x20, 0);
+    photo_write32(streamInfo + 0x24, 0);
+    e->pending = 0;
+    return CELL_OK;
+}
 
+s32 cellPngEncReset(u32 handle)
+{
+    PngEnc* e = enc_of(handle);
+    if (!e) return (s32)CELL_PNGENC_ERROR_ARG;
+    e->pending = 0;
     return CELL_OK;
 }
 
-s32 cellPngEncReset(CellPngEncHandle handle)
+s32 cellPngEncClose(u32 handle)
 {
-    if (handle >= CELL_PNGENC_HANDLE_MAX || !s_handles[handle].in_use)
-        return (s32)CELL_PNGENC_ERROR_INVALID_ARGUMENT;
+    PngEnc* e = enc_of(handle);
+    if (!e) return (s32)CELL_PNGENC_ERROR_ARG;
+    e->open = 0;
+    printf("[cellPngEnc] Close(%u)\n", handle);
     return CELL_OK;
 }
diff --git a/libs/codec/cellPngEnc.h b/libs/codec/cellPngEnc.h
index 2990a18..bf55836 100644
--- a/libs/codec/cellPngEnc.h
+++ b/libs/codec/cellPngEnc.h
@@ -1,8 +1,10 @@
 /*
  * ps3recomp - cellPngEnc HLE
  *
- * PNG encoding: converts raw pixel data to PNG format.
- * Stub — encoder handles are tracked but no actual encoding occurs.
+ * The PNG encoder, the same shape as cellJpgEnc: open an encoder, hand it a
+ * picture with an output (a file or a buffer), wait for the output, read its
+ * stream info. Encoding is done at once here (stb_image_write, whose
+ * implementation this module compiles for the runtime).
  */
 
 #ifndef PS3RECOMP_CELL_PNGENC_H
@@ -15,51 +17,55 @@
 extern "C" {
 #endif
 
-/* Error codes */
-#define CELL_PNGENC_ERROR_NOT_INITIALIZED     0x80611201
-#define CELL_PNGENC_ERROR_INVALID_ARGUMENT    0x80611202
-#define CELL_PNGENC_ERROR_OUT_OF_MEMORY       0x80611203
-#define CELL_PNGENC_ERROR_NOT_SUPPORTED       0x80611204
-#define CELL_PNGENC_ERROR_FATAL               0x80611205
+#define CELL_PNGENC_ERROR_ARG              0x80611291
+#define CELL_PNGENC_ERROR_SEQ              0x80611292
+#define CELL_PNGENC_ERROR_BUSY             0x80611293
+#define CELL_PNGENC_ERROR_EMPTY            0x80611294
+#define CELL_PNGENC_ERROR_RESET            0x80611295
+#define CELL_PNGENC_ERROR_FATAL            0x80611296
+#define CELL_PNGENC_ERROR_STREAM_ABORT     0x806112A1
+#define CELL_PNGENC_ERROR_STREAM_SKIP      0x806112A2
+#define CELL_PNGENC_ERROR_STREAM_OVERFLOW  0x806112A3
+#define CELL_PNGENC_ERROR_STREAM_FILE_OPEN 0x806112A4
 
-/* Constants */
-#define CELL_PNGENC_HANDLE_MAX   4
+#define CELL_PNGENC_COLOR_SPACE_GRAYSCALE       1
+#define CELL_PNGENC_COLOR_SPACE_RGB             2
+#define CELL_PNGENC_COLOR_SPACE_PALETTE         4
+#define CELL_PNGENC_COLOR_SPACE_GRAYSCALE_ALPHA 9
+#define CELL_PNGENC_COLOR_SPACE_RGBA            10
+#define CELL_PNGENC_COLOR_SPACE_ARGB            20
 
-/* Color space */
-#define CELL_PNGENC_COLOR_SPACE_ARGB         0
-#define CELL_PNGENC_COLOR_SPACE_RGBA         1
-#define CELL_PNGENC_COLOR_SPACE_GRAYSCALE    2
-#define CELL_PNGENC_COLOR_SPACE_GRAYSCALE_A  3
+#define CELL_PNGENC_LOCATION_FILE   0
+#define CELL_PNGENC_LOCATION_BUFFER 1
 
-/* Compression level */
-#define CELL_PNGENC_COMPRESS_DEFAULT   6
-#define CELL_PNGENC_COMPRESS_NONE      0
-#define CELL_PNGENC_COMPRESS_BEST      9
-
-/* Types */
-typedef u32 CellPngEncHandle;
-
-typedef struct CellPngEncParam {
-    u32 width;
-    u32 height;
-    u32 colorSpace;
-    u32 compressionLevel;
-    u32 reserved[4];
-} CellPngEncParam;
-
-typedef struct CellPngEncOutputInfo {
-    void* outputData;
