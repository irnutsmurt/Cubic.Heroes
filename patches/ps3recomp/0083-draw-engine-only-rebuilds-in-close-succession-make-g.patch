From fe0ab63485bb2eaa183ee4a34905618560574822 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Mon, 2 Nov 2026 14:48:31 -0800
Subject: [PATCH 83/85] draw engine: only rebuilds in close succession make
 geometry dynamic

With rebuilds up to 60 frames apart counting toward dynamic, a load that
rewrites an area several times within a second while drawing it still made
parts of the scene dynamic now and then, and their retry waits doubled at
every load: in 3D Dot Game Heroes, over 17 TITLE -> CONTINUE cycles, 22k,
then 76k, then 158k draws per 5 s on the copy path.

Now only rebuilds within 8 frames of each other count, and an entry that is
drawn valid ENG_GEOM_DYNAMIC_RETRY frames after its last rebuild starts its
backoff over.
---
 libs/video/rsx_draw_engine.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index a677b17..1ed3327 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -2600,9 +2600,15 @@ static void dc_fetch(const rsx_vertex_layout_plan* layout, int allow_remap)
  * title that reloads an area into the same memory rewrites its static geometry
  * once per load. Counted over an entry's whole life, as they were, 3D Dot
  * Game Heroes' fourth TITLE -> CONTINUE made the whole scene dynamic for good
- * and the walker's drain went from ~5 to ~15 ms a frame (frames of 33 ms). */
+ * and the walker's drain went from ~5 to ~15 ms a frame (frames of 33 ms).
+ * With rebuilds up to 60 frames apart counting, a load that rewrites an area
+ * several times within a second while drawing it still made parts of the
+ * scene dynamic now and then, and their retry waits doubled at every load:
+ * after ~10 reloads 76k, then 158k draws per 5 s were on the copy path. Only
+ * rewrites in close succession count now, and an entry that stays valid for
+ * ENG_GEOM_DYNAMIC_RETRY frames after a retry starts its backoff over. */
 #define ENG_GEOM_DYNAMIC        4u
-#define ENG_GEOM_DYNAMIC_FRAMES 60u
+#define ENG_GEOM_DYNAMIC_FRAMES 8u
 #define ENG_GEOM_DYNAMIC_RETRY  600u
 
 /* RSX_GEOM_DYNAMIC_LIFETIME=1: rebuilds counted over an entry's life and
@@ -3713,6 +3719,8 @@ static void sink_end(void* user, const rsx_dispatch* r)
         } else {
             gm->last_use = g.frames;
             s_gs.hit++;
+            if (gm->dyn_tries && g.frames - gm->last_rebuild > ENG_GEOM_DYNAMIC_RETRY)
+                gm->dyn_tries = 0;   /* settled for good: a later run of rebuilds starts the backoff over */
         }
         dc.geom_watch = gm == NULL && watch;
     }
