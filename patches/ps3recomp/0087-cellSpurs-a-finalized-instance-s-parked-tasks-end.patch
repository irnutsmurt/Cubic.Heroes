index 8989f9c..e5988f0 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -771,12 +771,16 @@ void spu_workload_native_register(int image_id, spu_native_task_fn run, spu_nati
     __atomic_store_n(&s_native[image_id].run, run, __ATOMIC_RELEASE);
