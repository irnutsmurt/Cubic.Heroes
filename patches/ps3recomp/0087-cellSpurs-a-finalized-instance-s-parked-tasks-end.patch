From efd70db4a111380db0a83f09cb9184bb58b0bcc5 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Mon, 2 Nov 2026 18:38:12 -0800
Subject: [PATCH 87/88] cellSpurs: a finalized instance's parked tasks end

On hardware cellSpursFinalize takes the instance's SPU group down with its
tasks. Here a task parked in WAIT_SIGNAL is a host thread blocked on the
signal condition, and nothing woke it: a title that builds an instance per
load (3D Dot Game Heroes, an Edge zlib task per area load) left one parked
task per load -- a pool worker and a parked-table slot each (26 workers
after ten trips; the table has 64 slots).

A task notes its instance's address and how many times that address has
been finalized when it starts; Finalize bumps the count and wakes the
parked; a task whose instance is gone halts out of WAIT_SIGNAL and leaves
the taskset's memory alone (the next instance may be using it).
SPURS_FINALIZE_KEEP_TASKS=1 keeps the old behaviour. The SPU pool logs each
worker it starts.
---
 libs/spurs/cellSpurs.c     |  6 +++
 runtime/spu/spu_channels.c |  4 ++
 runtime/spu/spu_workload.c | 98 +++++++++++++++++++++++++++++++++++++-
 3 files changed, 106 insertions(+), 2 deletions(-)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 9e514d2..a45606d 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -613,6 +613,12 @@ s32 cellSpursFinalize(CellSpurs* spurs)
     __atomic_store_n(&si->ea, 0, __ATOMIC_RELEASE);
     si->stopping = 0;
     ReleaseSRWLockExclusive(&si->lock);
+    /* Its tasks still parked in WAIT_SIGNAL end (spu_workload.c).
+     * SPURS_FINALIZE_KEEP_TASKS=1 leaves them parked, as before, for A/B. */
+    { static int keep = -1;
+      if (keep < 0) keep = getenv("SPURS_FINALIZE_KEEP_TASKS") ? 1 : 0;
+      extern void spu_spurs_finalized(uint32_t spurs_ea);
+      if (!keep) spu_spurs_finalized(ea); }
     return CELL_OK;
 }
 
diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index 5bbca72..0457bf1 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -2446,6 +2446,10 @@ void spu_spurs_taskset_syscall(spu_context* ctx)   /* non-static: also called by
             spu_taskset_wait_signal(ts, tid);
             spu_taskset_parked_del(ts, tid);
             yz_lockstep_block_end(ctx);
+            /* Its SPURS instance was finalized while it waited: the task ends
