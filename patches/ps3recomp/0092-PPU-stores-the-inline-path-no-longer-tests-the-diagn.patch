From 90f76c8a49674258666a564e5f05f5251cbafd63 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Tue, 3 Nov 2026 18:27:57 -0800
Subject: [PATCH] PPU stores: the inline path no longer tests the diagnostic
 store watches

Every inline guest store tested (g_barrier_sync_watch | g_null_sweep_hi)
before the SPU reservation bitmap: two loads through .refptr indirection and
an OR on each of the ~780,000 store sites. Both globals can become non-zero
only through a diagnostic named in the environment at start-up: SPU_ATOM_EA
arms the barrier watch (from an SPU thread, at its first atomic) and
PS3_NULL_SWEEP lets the null-page sweep rise. Those two now join PPU_WVAL,
PPU_WWATCH and PT in the start-up list that sends every store out of line
(vm_inline_st_ok = 0), where both are read on each store -- exact for a
function that runs long and for an arming from another thread. Without them
both stay 0 for the whole run, so the inline test is dropped. The SPU
coherence bitmap check and its slow path are unchanged.

Measured (3D Dot Game Heroes, river fight, uncapped, process held to one
logical CPU per core, 8 runs against 7, ABBA order): ordinary frames
7.93 -> 7.41 ms (-6.6%), main-thread busy -7.4%, permutation p = 0.0014.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/ppu/ppu_loader.cpp |  7 ++++++-
 tools/ppu_lifter.py        | 15 +++++++--------
 2 files changed, 13 insertions(+), 9 deletions(-)

diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 876ca89..4b7f9d1 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -1700,7 +1700,12 @@ static struct VmInlineInit {
         int d = 0;
         for (int i = 0; vars[i]; i++) if (getenv(vars[i])) d = 1;
         vm_inline_ok = !d;
-        static const char* const svars[] = { "PPU_WVAL", "PPU_WWATCH", "PT", 0 };
+        /* SPU_ATOM_EA arms g_barrier_sync_watch (from an SPU thread, at its
+         * first atomic) and PS3_NULL_SWEEP lets g_null_sweep_hi rise: with
+         * either set, every store goes out of line, where both are read on
+         * each store. Without them both stay 0 for the whole run, so the
+         * inline stores need not test them. */
+        static const char* const svars[] = { "PPU_WVAL", "PPU_WWATCH", "PT", "SPU_ATOM_EA", "PS3_NULL_SWEEP", 0 };
         int sd = 0;
         for (int i = 0; svars[i]; i++) if (getenv(svars[i])) sd = 1;
         vm_inline_st_ok = !sd;
diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index f8d9a4e..40c2e63 100644
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -167,12 +167,12 @@ extern uint32_t ppu_hle_inject_base;
 /* Inline guest-store fast paths, the store side of the loads below: every
  * lifted store was an out-of-line call, about a fifth of God of War HD's main
  * thread. A store the out-of-line path treats specially still goes there:
- * anything outside the inline range, any armed store diagnostic (vm_inline_st_ok,
- * the barrier watch, a null-page sweep), and a store to a line an SPU holds a
+ * anything outside the inline range, any store diagnostic the run was started
+ * with (vm_inline_st_ok: PPU_WVAL, PPU_WWATCH, and SPU_ATOM_EA and
+ * PS3_NULL_SWEEP, the only ways the barrier watch and the null-page sweep
+ * arm -- so they are not tested here), and a store to a line an SPU holds a
  * reservation on, which has to take the lock-line lock and raise the
  * lost-reservation event. */
-extern uint32_t             g_barrier_sync_watch;
-extern uint32_t             g_null_sweep_hi;
 extern const unsigned char* g_spu_coh_bits;   /* SPU-reserved lines, NULL until the first */
 #ifdef __cplusplus
 }
@@ -182,8 +182,8 @@ extern const unsigned char* g_spu_coh_bits;   /* SPU-reserved lines, NULL until
  * tell apart from these globals, so code that reads them directly reloads
  * all of them after every store. Each lifted function takes one copy at entry
  * (PPU_MM_SNAP, emitted by the lifter) and its loads and stores use that.
- * What can change while a function runs -- the SPU reservation bitmap and the
- * store watches -- is still read from the globals.
+ * What can change while a function runs -- the SPU reservation bitmap -- is
+ * still read from the global.
  *
  * The copy holds the inline range as one span from 0x10000: not the null
  * page, not the raw SPU windows from 0xE0000000, nothing past the end of the
@@ -216,8 +216,7 @@ static inline int vm_mm_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
 }
 static inline int vm_mm_st_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
 {
-    if (!__builtin_expect(vm_mm_in(m->st_span, ea, n), 1) ||
-        __builtin_expect((g_barrier_sync_watch | g_null_sweep_hi) != 0, 0))
+    if (!__builtin_expect(vm_mm_in(m->st_span, ea, n), 1))
         return 0;
     const unsigned char* bits = g_spu_coh_bits;
     if (bits) { const uint32_t line = ea >> 7; if ((bits[line >> 3] >> (line & 7)) & 1u) return 0; }
-- 
