From 578c9aa9965f462ed27901476e56459e8e5d3f08 Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Wed, 4 Nov 2026 12:01:12 -0800
Subject: [PATCH 96/96] PPU memory model: published once before the guest's
 entry; stores keep the reservation bitmap's address

Every lifted function's PPU_MM_SNAP read five globals, each through a
.refptr indirection, and recomputed the inline span. Every inline store then
loaded g_spu_coh_bits through another indirection, tested it for NULL and
indexed the SPU reservation bitmap; a guest store may alias any global, so
the compiler reloaded that pointer after each one.

All of the snapshot's inputs -- vm_base, ppu_vm_size, the inject base, the
inline switches -- are fixed before the guest's entry. ppu_run now computes
the model once just before calling it (ppu_mm_publish, logged), and
PPU_MM_SNAP copies g_ppu_mm. Until then g_ppu_mm is all zero: spans of 0, so
a lifted function run that early sends every access out of line. Code outside
lifted functions (vm_*_inl) still computes a fresh model per access.

The snapshot also holds the bitmap's address, g_spu_coh_map: the bitmap from
the start of the run (spu_coherency.c), never NULL and never moved. Its bits
are still read on every store, so a reservation taken while a function runs
is seen as before; before the first reservation they are all clear, which
closes the stale-NULL window g_spu_coh_bits had. The out-of-line paths keep
g_spu_coh_bits.

Measured (3D Dot Game Heroes, uncapped, real audio, normal scheduling, 5
river fights and 3 exploration runs a side): main-thread busy time in combat
frames 6.92 -> 6.22 ms (-10%, p = 0.008) and its p99 11.36 -> 9.74 ms; light
and moderate debris frames -11% and -16% (p <= 0.03); exploration 6.60 ->
5.56 ms (-16%, p = 0.1, the least a 3 v 3 test can give). Combat frames now
run at the display's 144 Hz (FIFO presentation); exploration is held by the
render side. Static: a lifted chunk 4.2% fewer instructions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/ppu/ppu_loader.cpp   | 22 +++++++++++++++++++++
 runtime/spu/spu_coh_bitmap.h |  5 +++++
 runtime/spu/spu_coherency.c  |  6 ++++++
 tools/ppu_lifter.py          | 38 ++++++++++++++++++++++++++++--------
 4 files changed, 63 insertions(+), 8 deletions(-)

diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 4b7f9d1..2695f46 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -1712,6 +1712,25 @@ static struct VmInlineInit {
     }
 } s_vm_inline_init;
 
+#ifdef PPU_MM_GLOBAL
+/* The lifted functions' memory model (ppu_recomp.h's ppu_mm; each function's
+ * PPU_MM_SNAP copies it). Every input -- vm_base, ppu_vm_size, the inject
+ * base, the inline switches, the reservation bitmap's address -- is fixed
+ * before the guest's entry, so ppu_run computes it once just before calling
+ * it. Until then it is all zero: spans of 0, every access out of line.
+ * Threads that run guest code start after it (or are given guest code to run
+ * after it), and the fence orders it ahead of anything they are handed. */
+extern "C" ppu_mm g_ppu_mm = {};
+static void ppu_mm_publish(void)
+{
+    g_ppu_mm = ppu_mm_compute();
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    fprintf(stderr, "[ppu] memory model: base %p, loads to 0x%08llX, stores to 0x%08llX, poll word 0x%08X\n",
+            (void*)g_ppu_mm.vb, (unsigned long long)(0x10000 + g_ppu_mm.ld_span),
+            (unsigned long long)(0x10000 + g_ppu_mm.st_span), g_ppu_mm.poll);
+}
+#endif
+
 uint8_t  vm_read8 (uint64_t a) { if (vm_oob((uint32_t)a,1)) return 0; vm_hotmap((uint32_t)a,1);
     if ((uint32_t)a < 0x10000u) ppu_null_read_report((uint32_t)a, 1, __builtin_return_address(0));
 #ifdef VM_SAMPLE_READS
@@ -4264,6 +4283,9 @@ extern "C" int ppu_run(uint32_t entry_opd, uint32_t stack_top)
     fprintf(stderr, "[ppu] run: code 0x%08X, toc 0x%08X, sp 0x%08X\n", code, toc, (uint32_t)ctx.gpr[1]);
     g_active_ctx = &ctx;
     ppu_resv_register(&ctx);   /* main/entry thread: join the reservation set too */
+#ifdef PPU_MM_GLOBAL
+    ppu_mm_publish();
+#endif
     fn(&ctx);
     while (g_trampoline_fn) { void (*tf)(void*) = g_trampoline_fn; g_trampoline_fn = 0; tf(&ctx); }
     return 0;
diff --git a/runtime/spu/spu_coh_bitmap.h b/runtime/spu/spu_coh_bitmap.h
index 79bffe7..ff2d1d4 100644
--- a/runtime/spu/spu_coh_bitmap.h
+++ b/runtime/spu/spu_coh_bitmap.h
@@ -33,6 +33,11 @@ extern "C" {
  * publishes it on the first reservation and only ever sets bits. */
 SPU_COH_SHARED const unsigned char* g_spu_coh_bits = 0;
 
+/* The same bitmap from the start of the run, for code that keeps its address
+ * (the lifted functions' snapshot, ppu_recomp.h): defined in spu_coherency.c,
+ * never NULL. */
+extern const unsigned char* const g_spu_coh_map;
+
 static inline int spu_coh_line_reserved(uint32_t addr)
 {
     const unsigned char* bits = g_spu_coh_bits;
diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
index ed2bcf5..c4d01b7 100644
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -122,6 +122,12 @@ void spu_lockline_unlock(void) { if (pthread_mutex_unlock(&g_lockline)) abort();
 
 static unsigned char s_coh_bitmap[SPU_COH_BITMAP_SZ];
 
+/* The bitmap's address for the lifted code's inline stores (ppu_recomp.h's
+ * ppu_mm): set from the start, so a function's snapshot can hold it however
+ * long the function runs. Its bits are read on every store, as through
+ * g_spu_coh_bits; before the first reservation they are all clear. */
+const unsigned char* const g_spu_coh_map = s_coh_bitmap;
+
 /* g_spu_coh_bits (spu_coh_bitmap.h) stays NULL until the first GETLLAR
  * anywhere. That keeps the PPU fast path off the bitmap entirely for a title
  * that runs no SPU code, and keeps every existing test that stores through
diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index aeb3152..4f4630d 100644
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -174,6 +174,10 @@ extern uint32_t ppu_hle_inject_base;
  * reservation on, which has to take the lock-line lock and raise the
  * lost-reservation event. */
 extern const unsigned char* g_spu_coh_bits;   /* SPU-reserved lines, NULL until the first */
+/* The same bitmap from the start of the run (spu_coherency.c): never NULL and
+ * never moved, so a function's snapshot can hold its address while the bits
+ * themselves are read on every store. */
+extern const unsigned char* const g_spu_coh_map;
 #ifdef __cplusplus
 }
 #endif
@@ -182,8 +186,8 @@ extern const unsigned char* g_spu_coh_bits;   /* SPU-reserved lines, NULL until
  * tell apart from these globals, so code that reads them directly reloads
  * all of them after every store. Each lifted function takes one copy at entry
  * (PPU_MM_SNAP, emitted by the lifter) and its loads and stores use that.
- * What can change while a function runs -- the SPU reservation bitmap -- is
- * still read from the global.
+ * What can change while a function runs -- the SPU reservation bitmap's bits
+ * -- is read from the bitmap on each store; the copy holds only its address.
  *
  * The copy holds the inline range as one span from 0x10000: not the null
  * page, not the raw SPU windows from 0xE0000000, nothing past the end of the
@@ -191,18 +195,35 @@ extern const unsigned char* g_spu_coh_bits;   /* SPU-reserved lines, NULL until
  * one compare. The range is the old checks' or narrower. The one address
  * they also turned away, the gcm ref-poll word, is only special to vm_read32,
  * so only the 32-bit load still tests it. */
-typedef struct ppu_mm { uint8_t* vb; int64_t ld_span, st_span; uint32_t poll; } ppu_mm;
-static inline ppu_mm ppu_mm_take(void)
+typedef struct ppu_mm { uint8_t* vb; const unsigned char* coh; int64_t ld_span, st_span; uint32_t poll; } ppu_mm;
+static inline ppu_mm ppu_mm_compute(void)
 {
     const uint32_t hi = (ppu_vm_size != 0 && ppu_vm_size < 0xE0000000u) ? ppu_vm_size : 0xE0000000u;
     const int64_t span = hi > 0x10000u ? (int64_t)(hi - 0x10000u) : 0;
     ppu_mm m;
     m.vb = vm_base;
+    m.coh = g_spu_coh_map;
     m.ld_span = vm_inline_ok ? span : 0;
     m.st_span = (vm_inline_ok && vm_inline_st_ok) ? span : 0;
     m.poll = ppu_hle_inject_base + 0x2008u;   /* the gcm ref-poll word: vm_read32 */
     return m;
 }
+/* Every input above is fixed before the guest's entry, so the runtime
+ * computes the model once there (ppu_mm_publish, ppu_loader.cpp) and a lifted
+ * function's PPU_MM_SNAP copies g_ppu_mm -- one load per field instead of
+ * five globals, each through an indirection, and the arithmetic. Until it is
+ * published g_ppu_mm is all zero: spans of 0, so a lifted function run that
+ * early sends every access out of line. Code outside lifted functions
+ * (vm_*_inl below) computes a fresh one per access, as before. */
+#define PPU_MM_GLOBAL 1
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern ppu_mm g_ppu_mm;
+#ifdef __cplusplus
+}
+#endif
+static inline ppu_mm ppu_mm_take(void) { return ppu_mm_compute(); }
 /* [ea, ea + n) inside [0x10000, 0x10000 + span). Below 0x10000 the 32-bit
  * subtraction wraps past any span. Signed, so span - n is computed once per
  * function and a span of 0 still turns everything away. */
@@ -218,8 +239,8 @@ static inline int vm_mm_st_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
 {
     if (!__builtin_expect(vm_mm_in(m->st_span, ea, n), 1))
         return 0;
-    const unsigned char* bits = g_spu_coh_bits;
-    if (bits) { const uint32_t line = ea >> 7; if ((bits[line >> 3] >> (line & 7)) & 1u) return 0; }
+    const uint32_t line = ea >> 7;
+    if ((m->coh[line >> 3] >> (line & 7)) & 1u) return 0;
     return 1;
 }
 static inline uint8_t vm_read8_mm(const ppu_mm* m, uint64_t a)
@@ -614,8 +635,9 @@ extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
 } while(0)
 
 /* Each lifted function opens with PPU_MM_SNAP; its loads and stores use that
- * copy of the memory model (ppu_mm in ppu_recomp.h). */
-#define PPU_MM_SNAP const ppu_mm _mm = ppu_mm_take(); (void)_mm;
+ * copy of the memory model (ppu_mm in ppu_recomp.h: the one the runtime
+ * published before the guest's entry, g_ppu_mm). */
+#define PPU_MM_SNAP const ppu_mm _mm = g_ppu_mm; (void)_mm;
 #ifndef PPU_NO_INLINE_LOADS
 #undef vm_read8
 #undef vm_read16
