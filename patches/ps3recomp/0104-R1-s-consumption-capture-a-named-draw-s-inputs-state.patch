+/* In vk_eng_draw_from, when everything the draw binds is known. */
+static void vk_r1_note_draw(const vk_eng_pipe* P, rsx_topology topology, const void* vertices,
+                            const vk_geom_ent* res, u32 vertex_count, u32 stride, const u32* indices,
+                            u32 index_count, const VkViewport* vp, const VkRect2D* sc, u32 vsb, u32 psb)
+{
+    FILE* f = s_r1c.desc;
+    if (!f) return;
+    vk_eng_pinfo pi;
+    if (vk_eng_variant_info(P, (u32)topology - 1u, &pi)) return;
+    /* Vertices and indices as the GPU reads them. */
+    const VkDeviceSize vbytes = (VkDeviceSize)vertex_count * stride;
+    const u8* vsrc = res ? (const u8*)s_geom.chunk[res->blk.chunk].ptr + res->voff : (const u8*)vertices;
+    const u8* isrc = res ? (const u8*)s_geom.chunk[res->blk.chunk].ptr + res->ioff : (const u8*)indices;
+    if (vsrc) vk_r1_write("vertices.bin", vsrc, (size_t)vbytes);
+    if (index_count && isrc) vk_r1_write("indices.bin", isrc, (size_t)index_count * 4u);
+    vk_r1_write("vs_constants.bin", vk_eng_ucpu(), vsb);
+    vk_r1_write("ps_constants.bin", vk_eng_ucpu() + s_g.ps_off, psb);
+    fprintf(f, "  \"programs_match_pipeline\": %s,\n",
+            (P->vs_hash == s_r1c.vs_hash && P->ps_hash == s_r1c.ps_hash) ? "true" : "false");
+    fprintf(f, "  \"constants\": {\"vertex\": {\"binding\": %u, \"file\": \"vs_constants.bin\", \"bytes\": %u}, "
+               "\"fragment\": {\"binding\": %u, \"file\": \"ps_constants.bin\", \"bytes\": %u}},\n",
+            RSX_SPIRV_VPCONST_BINDING, vsb, RSX_SPIRV_PSCONST_BINDING, psb);
+    fprintf(f, "  \"vertex_input\": {\"stride\": %u, \"rate\": %d, \"attributes\": [",
+            pi.vb.stride, (int)pi.vb.inputRate);
+    for (u32 a = 0; a < pi.vi.vertexAttributeDescriptionCount; a++)
+        fprintf(f, "%s{\"location\": %u, \"format\": %d, \"offset\": %u}", a ? ", " : "",
+                pi.va[a].location, (int)pi.va[a].format, pi.va[a].offset);
+    fprintf(f, "]},\n");
+    fprintf(f, "  \"draw\": {\"topology\": %d, \"vertex_count\": %u, \"vertices\": \"vertices.bin\", "
+               "\"index_count\": %u, \"index_type\": %d%s},\n",
+            (int)pi.ia.topology, vertex_count, index_count, (int)VK_INDEX_TYPE_UINT32,
+            index_count ? ", \"indices\": \"indices.bin\"" : "");
+    fprintf(f, "  \"rasterization\": {\"polygon_mode\": %d, \"cull_mode\": %d, \"front_face\": %d, "
+               "\"depth_bias_enable\": %d, \"depth_bias_constant\": %.9g, \"depth_bias_slope\": %.9g, "
+               "\"line_width\": %.9g, \"samples\": %d},\n",
+            (int)pi.ras.polygonMode, (int)pi.ras.cullMode, (int)pi.ras.frontFace, (int)pi.ras.depthBiasEnable,
+            s_e2.depth_bias[0], s_e2.depth_bias[1], pi.ras.lineWidth, (int)pi.ms.rasterizationSamples);
+    fprintf(f, "  \"depth_stencil\": {\"depth_test\": %d, \"depth_write\": %d, \"depth_compare\": %d, "
+               "\"stencil_test\": %d, \"depth_bounds_test\": %d, \"stencil_reference\": %u, "
+               "\"front\": [%d, %d, %d, %d, %u, %u], \"back\": [%d, %d, %d, %d, %u, %u]},\n",
+            (int)pi.ds.depthTestEnable, (int)pi.ds.depthWriteEnable, (int)pi.ds.depthCompareOp,
+            (int)pi.ds.stencilTestEnable, (int)pi.ds.depthBoundsTestEnable, s_e2.stencil_ref & 0xFFu,
+            (int)pi.ds.front.failOp, (int)pi.ds.front.passOp, (int)pi.ds.front.depthFailOp,
+            (int)pi.ds.front.compareOp, pi.ds.front.compareMask, pi.ds.front.writeMask,
+            (int)pi.ds.back.failOp, (int)pi.ds.back.passOp, (int)pi.ds.back.depthFailOp,
+            (int)pi.ds.back.compareOp, pi.ds.back.compareMask, pi.ds.back.writeMask);
+    fprintf(f, "  \"blend\": {\"constants\": [%.9g, %.9g, %.9g, %.9g], \"attachments\": [",
+            s_e2.blend_color[0], s_e2.blend_color[1], s_e2.blend_color[2], s_e2.blend_color[3]);
+    for (u32 a = 0; a < pi.cb.attachmentCount; a++) {
+        const VkPipelineColorBlendAttachmentState* b = &pi.cba[a];
+        fprintf(f, "%s{\"enable\": %d, \"src_color\": %d, \"dst_color\": %d, \"color_op\": %d, "
+                   "\"src_alpha\": %d, \"dst_alpha\": %d, \"alpha_op\": %d, \"write_mask\": %u}",
+                a ? ", " : "", (int)b->blendEnable, (int)b->srcColorBlendFactor, (int)b->dstColorBlendFactor,
+                (int)b->colorBlendOp, (int)b->srcAlphaBlendFactor, (int)b->dstAlphaBlendFactor,
+                (int)b->alphaBlendOp, (unsigned)b->colorWriteMask);
+    }
+    fprintf(f, "]},\n");
+    fprintf(f, "  \"viewport\": [%.9g, %.9g, %.9g, %.9g, %.9g, %.9g],\n  \"scissor\": [%d, %d, %u, %u],\n",
+            vp->x, vp->y, vp->width, vp->height, vp->minDepth, vp->maxDepth,
+            sc->offset.x, sc->offset.y, sc->extent.width, sc->extent.height);
+    s_r1c.noted = 1;
+}
+
+/* After the draw: the existing renderer's output. */
+static void vk_r1_after_draw(void)
+{
+    if (!s_r1c.armed) return;
+    s_r1c.armed = 0;
+    FILE* f = s_r1c.desc;
+    s_r1c.desc = NULL;
+    if (!f) return;
+    if (!s_r1c.noted) {
+        fprintf(f, "  \"error\": \"the draw was not recorded\"\n}\n");
+        fclose(f);
+        VK_LOG("r1: %s: the draw was not recorded\n", s_r1c.m.name);
+        return;
+    }
+    vk_eng_flush_sync();
+    const vk_eng_obj* rt = vk_eng_get(s_r1c.rt, VK_ENG_COLOR);
+    u64 bytes = 0;
+    if (rt) vk_r1_image(rt, "target_after.bin", &bytes);
+    fprintf(f, "  \"reference_output\": {\"file\": \"target_after.bin\", \"bytes\": %llu}\n}\n",
+            (unsigned long long)bytes);
+    fclose(f);
+    fprintf(stderr, "[r1] %s: written to %s\n", s_r1c.m.name, s_r1c.path);
+}
