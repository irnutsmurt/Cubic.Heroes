+++ b/libs/video/rsx_draw_engine.c
@@ -2076,7 +2076,9 @@ typedef struct eng_prog_params {
 } eng_prog_params;
 
 /* The guest pair as HLSL; vi and fi as the decompilers return them (> 0
- * made, < 0 not). Every guest pipeline the engine makes goes through here. */
+ * made, < 0 not). Every guest pipeline the engine makes goes through here,
+ * and so does R1's capture, so the text it records is the text a pipeline is
+ * made from. */
 static void eng_programs_text(const eng_prog_params* p, char* vs, u32 vs_size, char* ps, u32 ps_size,
                               int* vi_out, int* fi_out, u32* nconst_out)
 {
@@ -2105,6 +2107,168 @@ static void eng_programs_text(const eng_prog_params* p, char* vs, u32 vs_size, c
     *vi_out = vi; *fi_out = fi;
 }
 
+/* ---- R1's consumption capture (docs/NATIVE_PORT.md section 5) -----------
+ * Development only, off unless DOTHEROES_R1_DIR, DOTHEROES_R1_AT and
+ * DOTHEROES_R1_DRAWS are set. DOTHEROES_R1_DRAWS=<name>=<target>/<fp>/<n>,...
+ * names draws by colour target A's offset in guest memory (* for any), the
+ * fragment program's offset, and which such draw of the frame it is, e.g.
+ * pass3=02DD0000/018F0380/1. In the first frame that begins DOTHEROES_R1_AT
+ * seconds after the process started, each named draw goes to the backend's
+ * capture_next_draw (rsx_vulkan_backend.c writes <dir>/<name>/) with the
+ * microcode the engine read for it -- after every queued write to it had
+ * landed -- and its programs' HLSL and conversion parameters. */
+enum { ENG_R1_MAX = 4 };
+static struct {
+    int on;                                /* -1 unread, 0 off, 1 armed */
+    double at;
+    char dir[512];
+    int n;
+    struct { char name[24]; u32 rt, fp, occ, seen; int any_rt, done; } k[ENG_R1_MAX];
+    int waiting;                           /* the time came: the next frame is the one */
+    u32 frame;                             /* the frame captured */
+    int active;
+    int pending;                           /* the key of the draw being captured, or -1 */
+    eng_prog_params pp;                    /* its programs' parameters */
+    char vs[16384], ps[65536];
+    u32 nconst; int vi, fi;
+    rsx_fp_shadow_desc shadow[RSX_DSP_NUM_TEXTURES];
+    u8 gamma[RSX_DSP_NUM_TEXTURES], expand[RSX_DSP_NUM_TEXTURES];
+    u32 unnorm[RSX_DSP_NUM_TEXTURES][3];
+    int have_programs;
+} s_r1 = { .on = -1, .pending = -1 };
+
+/* Seconds since the process was created: the clock DOTHEROES_R1_AT names
+ * (port/native/render/r1_observe.cpp reads the same one). */
+static double eng_r1_seconds(void)
+{
+#ifdef _WIN32
+    FILETIME c, e, k, u, now;
+    GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u);
+    GetSystemTimeAsFileTime(&now);
+    const unsigned long long a = ((unsigned long long)c.dwHighDateTime << 32) | c.dwLowDateTime;
+    const unsigned long long b = ((unsigned long long)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    return (double)(b - a) * 1e-7;
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec + ts.tv_nsec * 1e-9;
+#endif
+}
+
+static void eng_r1_read(void)
+{
+    s_r1.on = 0;
+    const char* dir = getenv("DOTHEROES_R1_DIR");
+    const char* at = getenv("DOTHEROES_R1_AT");
+    const char* dr = getenv("DOTHEROES_R1_DRAWS");
+    if (!dir || !*dir || !at || !*at || !dr || !*dr) return;
+    snprintf(s_r1.dir, sizeof s_r1.dir, "%s", dir);
+    s_r1.at = atof(at);
+    for (const char* p = dr; *p && s_r1.n < ENG_R1_MAX; ) {
+        char name[24] = "", rt[16] = "", fp[16] = "";
+        unsigned occ = 1;
+        if (sscanf(p, "%23[^=]=%15[^/]/%15[^/]/%u", name, rt, fp, &occ) != 4) break;
+        snprintf(s_r1.k[s_r1.n].name, sizeof s_r1.k[s_r1.n].name, "%s", name);
+        s_r1.k[s_r1.n].any_rt = rt[0] == '*';
+        s_r1.k[s_r1.n].rt = (u32)strtoul(rt, NULL, 16);
+        s_r1.k[s_r1.n].fp = (u32)strtoul(fp, NULL, 16);
+        s_r1.k[s_r1.n].occ = occ ? occ : 1u;
+        s_r1.n++;
+        const char* c = strchr(p, ',');
+        if (!c) break;
+        p = c + 1;
+    }
+    if (s_r1.n) s_r1.on = 1;
+    fprintf(stderr, "[r1] consumption capture: %d draw(s), from %.1f s, into %s\n", s_r1.n, s_r1.at, s_r1.dir);
+}
+
+/* At a draw: is it one the capture names? Sets s_r1.pending. */
+static void eng_r1_match(const rsx_dsp_surface* sf)
+{
+    s_r1.pending = -1;
+    if (s_r1.on < 0) eng_r1_read();
+    if (s_r1.on <= 0) return;
+    if (!s_r1.active) {
+        if (!s_r1.waiting) {
+            if (eng_r1_seconds() < s_r1.at) return;
+            s_r1.waiting = 1; s_r1.frame = g.frames + 1u;   /* the next whole frame */
+        }
+        if (g.frames != s_r1.frame) return;
+        s_r1.active = 1;
+        fprintf(stderr, "[r1] capturing frame %u at %.3f s\n", s_r1.frame, eng_r1_seconds());
+    }
+    if (g.frames != s_r1.frame) {       /* that frame is over */
+        for (int i = 0; i < s_r1.n; i++)
+            if (!s_r1.k[i].done)
+                fprintf(stderr, "[r1] %s: not found in frame %u (%u draws matched the program)\n",
+                        s_r1.k[i].name, s_r1.frame, s_r1.k[i].seen);
+        s_r1.on = 0;
+        return;
+    }
+    u32 fp_loc = 0;
+    const u32 fp_off = rsx_dsp_fragment_program(&g.rsx, &fp_loc);
+    for (int i = 0; i < s_r1.n; i++) {
+        if (s_r1.k[i].done) continue;
+        if (fp_off != s_r1.k[i].fp) continue;
+        if (!s_r1.k[i].any_rt && sf->color_offset[0] != s_r1.k[i].rt) continue;
+        if (++s_r1.k[i].seen != s_r1.k[i].occ) continue;
+        s_r1.pending = i;
+        s_r1.have_programs = 0;
+        return;
+    }
+}
+
+static void eng_r1_note_programs(const eng_prog_params* p)
+{
+    s_r1.pp = *p;
+    memcpy(s_r1.shadow, p->shadow, sizeof s_r1.shadow);
+    memcpy(s_r1.gamma, p->gamma_masks, sizeof s_r1.gamma);
+    memcpy(s_r1.expand, p->expand_masks, sizeof s_r1.expand);
+    memcpy(s_r1.unnorm, p->unnorm_dim, sizeof s_r1.unnorm);
+    s_r1.nconst = 0;
+    eng_programs_text(p, s_r1.vs, sizeof s_r1.vs, s_r1.ps, sizeof s_r1.ps, &s_r1.vi, &s_r1.fi, &s_r1.nconst);
+    s_r1.have_programs = s_r1.vi > 0 && s_r1.fi > 0;
+}
+
+/* Just before the named draw goes to the backend. */
+static void eng_r1_hand_over(const rsx_dsp_surface* sf)
+{
+    const int i = s_r1.pending;
+    s_r1.pending = -1;
+    if (i < 0) return;
+    s_r1.k[i].done = 1;
+    if (!g.be->capture_next_draw || !s_r1.have_programs) {
+        fprintf(stderr, "[r1] %s: %s\n", s_r1.k[i].name,
+                !g.be->capture_next_draw ? "the backend cannot capture" : "programs not remade");
+        return;
+    }
+    extern u32 s_fifo_getoff_pub(void);   /* cellGcmSys.c: the walker's offset */
+    u32 fp_loc = 0;
+    const u32 fp_off = rsx_dsp_fragment_program(&g.rsx, &fp_loc);
+    rsx_be_capture c = {
+        .dir = s_r1.dir, .name = s_r1.k[i].name, .frame = s_r1.frame, .fifo_get = s_fifo_getoff_pub(),
+        .rt_offset = sf->color_offset[0], .rt_location = sf->color_location[0],
+        .fp_offset = fp_off, .fp_location = fp_loc,
+        .fp_ucode = s_r1.pp.fp_uc, .fp_bytes = s_r1.pp.fp_size,
+        .vp_ucode = s_r1.pp.vp_uc, .vp_bytes = s_r1.pp.vp_bytes,
+        .vs_hlsl = s_r1.vs, .ps_hlsl = s_r1.ps,
+        .fp_ctrl = s_r1.pp.fp_ctrl, .cube_mask = s_r1.pp.cube_mask, .vol_mask = s_r1.pp.vol_mask,
+        .vtex_mask = s_r1.pp.vtex_mask, .layout_mask = s_r1.pp.layout_mask,
+        .vp_branch_bits = s_r1.pp.vp_branch_bits, .ucp = s_r1.pp.ucp,
+        .srgb_output = s_r1.pp.srgb_output, .alpha_test = s_r1.pp.alpha_test,
+        .alpha_func = s_r1.pp.alpha_func, .unnorm_mask = s_r1.pp.unnorm_mask,
+        .wpos_x = s_r1.pp.wpos_scaled ? s_r1.pp.wpos[0] : 1u,
+        .wpos_y = s_r1.pp.wpos_scaled ? s_r1.pp.wpos[1] : 1u,
+        .shadow_mask = s_r1.pp.shadow_mask, .gamma_units = s_r1.pp.gamma_units,
+        .expand_units = s_r1.pp.expand_units, .nconst = s_r1.nconst,
+        .shadow = s_r1.shadow, .shadow_bytes = sizeof s_r1.shadow };
+    memcpy(c.unnorm_dim, s_r1.unnorm, sizeof c.unnorm_dim);
+    memcpy(c.gamma_masks, s_r1.gamma, sizeof c.gamma_masks);
+    memcpy(c.expand_masks, s_r1.expand, sizeof c.expand_masks);
+    fprintf(stderr, "[r1] %s: frame %u, draw at FIFO 0x%08X, target 0x%08X, fp 0x%08X\n",
+            c.name, c.frame, c.fifo_get, c.rt_offset, c.fp_offset);
+    g.be->capture_next_draw(g.be->user, &c);
+}
+
 static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
                             const rsx_be_render_state* rs,
                             rsx_be_format rt_fmt, u32 rt_count, int* out_fixed,
@@ -2254,6 +2418,9 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
         .expand_units = expand_units, .wpos = { wpos_grid[0], wpos_grid[1] }, .wpos_scaled = wpos_scaled,
         .shadow = shadow, .gamma_masks = gamma_masks, .expand_masks = expand_masks,
         .unnorm_dim = (const u32 (*)[3])unnorm_dim };
+    /* R1's capture: the programs of the draw it names, made again here even
+     * when the pipeline is cached, with the parameters that made them. */
+    if (s_r1.pending >= 0 && !fixed) eng_r1_note_programs(&pp);
 
     u32 slot = eng_pipeline_slot(key);
     for (; g.pipeline_index[slot]; slot = (slot + 1u) & (ENG_PIPELINE_INDEX - 1u)) {
@@ -3790,6 +3957,7 @@ static void sink_end(void* user, const rsx_dispatch* r)
     rsx_dsp_viewport vp;
     rsx_dsp_get_surface(&g.rsx, &sf);
     rsx_dsp_get_viewport(&g.rsx, &vp);
+    if (s_r1.on) eng_r1_match(&sf);   /* R1's capture: off unless asked for */
     const u32 zslot = eng_zdepth_get(sf.zeta_location, sf.zeta_offset,
                                      sf.clip_w, sf.clip_h);
 
@@ -4011,6 +4179,7 @@ static void sink_end(void* user, const rsx_dispatch* r)
     }
 
     const u32 uploaded = indexed ? dc.n_verts : n_draw;
+    if (s_r1.pending >= 0) eng_r1_hand_over(&sf);
     if (geom)
         g.be->draw_geom(g.be->user, topology, geom, uploaded, layout.stride, indexed ? n_draw : 0);
     else
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
index cbc450d..11cbda4 100644
--- a/libs/video/rsx_draw_engine.h
+++ b/libs/video/rsx_draw_engine.h
@@ -120,6 +120,7 @@ typedef struct rsx_be_render_state {
 /* ---- the backend interface ---------------------------------------------- */
 
 #define RSX_BE_HAS_COLOR_SNAPSHOT 1
+struct rsx_be_capture;
 typedef struct rsx_draw_backend {
     void* user;
 
@@ -314,8 +315,38 @@ typedef struct rsx_draw_backend {
                                      float depth_value, u8 stencil,
                                      u32 x, u32 y, u32 w, u32 h);
 
+    /* Optional, development: R1's consumption capture (rsx_draw_engine.c,
+     * DOTHEROES_R1_*). Called just before a draw the capture names, with what
+     * the engine knows of it; the backend records that draw's inputs, state
+     * and output around it, in GPU order, and writes them out. */
+    void (*capture_next_draw)(void* user, const struct rsx_be_capture* c);
+
 } rsx_draw_backend;
 
+/* What the engine hands capture_next_draw: the draw's guest provenance, the
+ * programs as the GPU will run them (the microcode the engine read after
+ * every queued write had landed, and the HLSL it made of it), and the
+ * conversion parameters it made it with, so a tool can make the same HLSL
+ * from the same microcode again. Pointers are valid during the call. */
+typedef struct rsx_be_capture {
+    const char* dir;                 /* where the backend writes */
+    const char* name;                /* the capture's name: <dir>/<name>/ */
+    u32 frame;                       /* the engine's frame (flips presented) */
+    u32 fifo_get;                    /* the walker's command offset at the draw */
+    u32 rt_offset, rt_location;      /* colour target A in guest memory */
+    u32 fp_offset, fp_location;      /* the fragment program in guest memory */
+    const u8* fp_ucode; u32 fp_bytes;
+    const u8* vp_ucode; u32 vp_bytes;
+    const char* vs_hlsl; const char* ps_hlsl;
+    /* the conversion parameters (rsx_draw_engine.c eng_programs_text) */
+    u32 fp_ctrl, cube_mask, vol_mask, vtex_mask, layout_mask, vp_branch_bits, ucp;
+    u32 srgb_output, alpha_test, alpha_func, unnorm_mask, wpos_x, wpos_y, shadow_mask;
+    u32 gamma_units, expand_units, nconst;
+    u32 unnorm_dim[16][3];
+    u8  gamma_masks[16], expand_masks[16];
+    const void* shadow; u32 shadow_bytes;   /* rsx_fp_shadow_desc[16] */
+} rsx_be_capture;
+
 /* ---- the engine --------------------------------------------------------- */
 
 /* Register the backend the engine drives. Passing NULL unregisters it. */
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index cf7a944..e8bf3be 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -3410,8 +3410,17 @@ typedef struct vk_eng_pipe {
     u32                 cube_mask;       /* TextureCube units: the split set layout */
     VkPipeline          variant[VK_ENG_TOPOLOGIES];
     u8                  failed;          /* topologies the driver would not build: not asked again */
+    u64                 vs_hash, ps_hash; /* of the HLSL it was made from (R1's capture checks it) */
 } vk_eng_pipe;
 
+/* FNV-1a: the pipelines' HLSL hashes (vk_eng_pipe) and R1's check of them. */
+static u64 vk_r1_fnv(const void* p, size_t n)
+{
+    u64 h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; i++) { h ^= ((const u8*)p)[i]; h *= 1099511628211ull; }
+    return h;
+}
+
 static vk_eng_pipe s_epipe[VK_ENG_MAX_PIPE];
 
 static struct {
@@ -3814,6 +3823,8 @@ static u32 vk_eng_pipeline_create(void* user, const char* vs_hlsl, const char* p
         pvkDestroyShaderModule(s_vk.device, P->vs, NULL); memset(P, 0, sizeof *P); return 0;
     }
     P->rs = *rs;
+    P->vs_hash = vk_r1_fnv(vs_hlsl, strlen(vs_hlsl));
+    P->ps_hash = vk_r1_fnv(ps_hlsl, strlen(ps_hlsl));
     P->nslots = layout->count;
     P->stride = vertex_stride;
     P->rt_count = rt_count;
@@ -3837,8 +3848,8 @@ static void vk_eng_pipeline_release(void* user, u32 pipeline)
     if (s_e2.pipeline == pipeline) s_e2.pipeline = 0;
 }
 
-/* A pipeline variant's create info, filled in one place: what vk_eng_variant
- * builds, readable without building it. */
+/* A pipeline variant's create info: what vk_eng_variant builds, and what R1's
+ * consumption capture writes down (vk_r1_*), from one place. */
 typedef struct vk_eng_pinfo {
     VkPipelineShaderStageCreateInfo        st[2];
     VkVertexInputBindingDescription        vb;
@@ -4869,6 +4880,276 @@ static void vk_skip(const char* why, u32 pipeline)
 
 /* One draw, its geometry either passed in (vertices, indices) and copied into
  * the batch, or resident (`res`) and bound where it lies. */
+#ifndef _WIN32
+#include <sys/stat.h>
+#endif
+/* ---- R1's consumption capture (docs/NATIVE_PORT.md section 5) ------------
+ * Development only: rsx_draw_engine.c's DOTHEROES_R1_DRAWS names a draw and
+ * calls capture_next_draw just before handing it over. Around that draw:
+ *  - before: everything recorded so far is submitted and waited for, then
+ *    each texture the draw binds and its colour target are copied to host
+ *    memory, their content as the draw sees it;
+ *  - the draw is recorded as always (vk_eng_draw_from), and what it binds is
+ *    written down as Vulkan values: the pipeline's create info
+ *    (vk_eng_variant_info), constants, vertices, viewport, scissor and the
+ *    dynamic state;
+ *  - after: it is submitted and waited for, and the target copied again: the
+ *    existing renderer's output for that draw.
+ * Into <dir>/<name>/: desc.json, in native terms only, and the files it
+ * names. Game data: keep it local. */
+static struct {
+    int armed, noted;
+    char path[700];
+    rsx_be_capture m;                 /* the engine's description; its pointers are not kept */
+    u32 rt, tex[RSX_BE_MAX_TEXTURES], tex_mask;
+    rsx_be_sampler_desc samp[RSX_BE_MAX_TEXTURES];
+    u64 vs_hash, ps_hash;             /* of the HLSL the engine made again */
+    FILE* desc;                       /* desc.json, open from capture_next_draw on */
+} s_r1c;
+
+static int vk_r1_write(const char* file, const void* p, size_t n)
+{
+    char path[800];
+    snprintf(path, sizeof path, "%s/%s", s_r1c.path, file);
+    FILE* f = fopen(path, "wb");
+    if (!f) return -1;
+    const size_t w = n ? fwrite(p, 1, n, f) : 0;
+    fclose(f);
+    return w == n ? 0 : -1;
+}
+
+/* An engine object's pixels, every level and layer, to <file>: copied on the
+ * queue after everything submitted before (the caller has waited for it). */
+static int vk_r1_image(const vk_eng_obj* o, const char* file, u64* out_bytes)
+{
+    const vk_eng_obj* src = o;
+    if (o->kind == VK_ENG_VIEW) src = &s_eobj[o->surface];     /* a view samples its surface */
+    const u32 mips = src->kind == VK_ENG_TEXTURE ? (src->mips ? src->mips : 1u) : 1u;
+    const u32 layers = src->cube ? 6u : 1u;
+    VkBufferImageCopy rg[16 * 6];
+    VkDeviceSize total = 0;
+    u32 n = 0;
+    for (u32 l = 0; l < layers; l++)
+        for (u32 m = 0; m < mips && n < 16u * 6u; m++) {
+            const u32 w = src->w >> m ? src->w >> m : 1u, h = src->h >> m ? src->h >> m : 1u;
+            const VkDeviceSize bytes = src->block ? (VkDeviceSize)((w + 3) / 4) * ((h + 3) / 4) * src->block
+                                                  : (VkDeviceSize)w * h * src->bpp;
+            rg[n++] = (VkBufferImageCopy){ .bufferOffset = total,
+                .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, m, l, 1 },
+                .imageExtent = { w, h, 1 } };
+            total += (bytes + 15u) & ~(VkDeviceSize)15u;
+        }
+    vk_buffer b = { 0 };
+    if (!total || vk_create_host_buffer(&b, total, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) return -1;
+    if (vk_begin()) { vk_destroy_buffer(&b); return -1; }
+    vk_cmd_after_everything(s_vk.cmd);   /* the writes of earlier submissions, made visible */
+    pvkCmdCopyImageToBuffer(s_vk.cmd, src->im.img, VK_IMAGE_LAYOUT_GENERAL, b.buf, n, rg);
+    vk_submit_and_wait();
+    if (!b.coherent) vk_invalidate(&b);
+    const int r = vk_r1_write(file, b.ptr, (size_t)total);
+    vk_destroy_buffer(&b);
+    if (out_bytes) *out_bytes = total;
+    return r;
+}
+
+static void vk_r1_image_json(FILE* f, const char* key, const vk_eng_obj* o, const char* file, u64 bytes)
+{
+    const vk_eng_obj* src = o->kind == VK_ENG_VIEW ? &s_eobj[o->surface] : o;
+    const VkComponentMapping map = o->kind == VK_ENG_COLOR ? (VkComponentMapping){ 0 }
+                                                           : vk_remap(o->remap, o->rsx_fmt);
+    fprintf(f, "  \"%s\": {\"width\": %u, \"height\": %u, \"format\": %d, \"view_format\": %d, "
+               "\"levels\": %u, \"layers\": %u, \"bytes_per_texel\": %u, \"bytes_per_block\": %u, "
+               "\"swizzle\": [%d, %d, %d, %d], \"file\": \"%s\", \"bytes\": %llu}",
+            key, src->w, src->h, (int)src->fmt, (int)o->fmt,
+            src->kind == VK_ENG_TEXTURE ? (src->mips ? src->mips : 1u) : 1u, src->cube ? 6u : 1u,
+            src->bpp, src->block, (int)map.r, (int)map.g, (int)map.b, (int)map.a, file,
+            (unsigned long long)bytes);
+}
