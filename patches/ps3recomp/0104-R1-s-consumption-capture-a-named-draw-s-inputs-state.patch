+/* The engine's hand-over: before the draw. */
+static void vk_eng_capture_next_draw(void* user, const rsx_be_capture* c)
+{
+    (void)user;
+    if (s_r1c.armed) return;
+    snprintf(s_r1c.path, sizeof s_r1c.path, "%s/%s", c->dir, c->name);
+#ifdef _WIN32
+    CreateDirectoryA(c->dir, NULL);
+    CreateDirectoryA(s_r1c.path, NULL);
+#else
+    mkdir(c->dir, 0755); mkdir(s_r1c.path, 0755);
+#endif
+    s_r1c.m = *c;
+    s_r1c.rt = s_eng_bound.nrt ? s_eng_bound.rt[0] : 0;
+    memcpy(s_r1c.tex, s_e2.tex, sizeof s_r1c.tex);
+    memcpy(s_r1c.samp, s_e2.samp, sizeof s_r1c.samp);
+    s_r1c.tex_mask = s_e2.tex_mask;
+    vk_r1_write("fp.ucode", c->fp_ucode, c->fp_bytes);
+    vk_r1_write("vp.ucode", c->vp_ucode, c->vp_bytes);
+    vk_r1_write("vs.hlsl", c->vs_hlsl, strlen(c->vs_hlsl));
+    vk_r1_write("ps.hlsl", c->ps_hlsl, strlen(c->ps_hlsl));
+    vk_r1_write("shadow.bin", c->shadow, c->shadow_bytes);
+    s_r1c.vs_hash = vk_r1_fnv(c->vs_hlsl, strlen(c->vs_hlsl));
+    s_r1c.ps_hash = vk_r1_fnv(c->ps_hlsl, strlen(c->ps_hlsl));
+    /* The SPIR-V the pipeline's modules are made of: the same translation
+     * (vk_eng_translate), of the same text. */
+    for (int st = 0; st < 2; st++) {
+        u32 words = 0;
+        if (!rsx_hlsl_to_spirv(st ? c->ps_hlsl : c->vs_hlsl, st ? RSX_SHADER_STAGE_FRAGMENT : RSX_SHADER_STAGE_VERTEX,
+                               s_g.spv, VK_SPV_WORDS, &words, s_g.log, sizeof s_g.log) && words)
+            vk_r1_write(st ? "fs.spv" : "vs.spv", s_g.spv, (size_t)words * 4u);
+    }
+    /* Before: all earlier work done, then the inputs and the target as the
+     * draw will see them. */
+    vk_eng_flush_sync();
+    char path[800];
+    snprintf(path, sizeof path, "%s/desc.json", s_r1c.path);
+    s_r1c.desc = fopen(path, "w");
+    if (!s_r1c.desc) return;
+    FILE* f = s_r1c.desc;
+    fprintf(f, "{\n  \"r1_pass_description\": 0,\n  \"name\": \"%s\",\n", c->name);
+    fprintf(f, "  \"provenance\": {\"frame\": %u, \"fifo_get\": %u, \"rt_offset\": %u, \"rt_location\": %u, "
+               "\"fp_offset\": %u, \"fp_location\": %u, \"fp_ucode\": \"fp.ucode\", \"vp_ucode\": \"vp.ucode\", "
+               "\"note\": \"guest addresses and microcode, for provenance and the asset conversion only\"},\n",
+            c->frame, c->fifo_get, c->rt_offset, c->rt_location, c->fp_offset, c->fp_location);
+    fprintf(f, "  \"conversion\": {\"fp_ctrl\": %u, \"cube_mask\": %u, \"vol_mask\": %u, \"vtex_mask\": %u, "
+               "\"layout_mask\": %u, \"vp_branch_bits\": %u, \"ucp\": %u, \"srgb_output\": %u, \"alpha_test\": %u, "
+               "\"alpha_func\": %u, \"unnorm_mask\": %u, \"wpos\": [%u, %u], \"shadow_mask\": %u, "
+               "\"gamma_units\": %u, \"expand_units\": %u, \"nconst\": %u, \"shadow\": \"shadow.bin\", "
+               "\"gamma_masks\": [",
+            c->fp_ctrl, c->cube_mask, c->vol_mask, c->vtex_mask, c->layout_mask, c->vp_branch_bits, c->ucp,
+            c->srgb_output, c->alpha_test, c->alpha_func, c->unnorm_mask, c->wpos_x, c->wpos_y,
+            c->shadow_mask, c->gamma_units, c->expand_units, c->nconst);
+    for (int u = 0; u < 16; u++) fprintf(f, "%s%u", u ? ", " : "", c->gamma_masks[u]);
+    fprintf(f, "], \"expand_masks\": [");
+    for (int u = 0; u < 16; u++) fprintf(f, "%s%u", u ? ", " : "", c->expand_masks[u]);
+    fprintf(f, "], \"unnorm_dim\": [");
+    for (int u = 0; u < 16; u++)
+        fprintf(f, "%s[%u, %u, %u]", u ? ", " : "", c->unnorm_dim[u][0], c->unnorm_dim[u][1], c->unnorm_dim[u][2]);
+    fprintf(f, "], \"vs_hlsl\": \"vs.hlsl\", \"ps_hlsl\": \"ps.hlsl\"},\n");
+    fprintf(f, "  \"shaders\": {\"vertex\": \"vs.spv\", \"fragment\": \"fs.spv\", \"entry\": \"main\"},\n");
+    /* The textures the draw binds, every unit (the descriptor array has 16). */
+    fprintf(f, "  \"textures\": [");
+    int first = 1;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!((s_r1c.tex_mask >> u) & 1u) || !s_r1c.tex[u] || s_r1c.tex[u] >= VK_ENG_MAX_OBJ) continue;
+        const vk_eng_obj* o = &s_eobj[s_r1c.tex[u]];
+        if (o->kind != VK_ENG_TEXTURE && o->kind != VK_ENG_COLOR && o->kind != VK_ENG_VIEW) continue;
+        char file[32]; snprintf(file, sizeof file, "tex%u.bin", u);
+        u64 bytes = 0;
+        vk_r1_image(o, file, &bytes);
+        const rsx_be_sampler_desc* d = &s_r1c.samp[u];
+        float min_lod = d->min_lod, max_lod = d->mip_present ? d->max_lod : d->min_lod;
+        if (max_lod < min_lod) max_lod = min_lod;
+        fprintf(f, "%s\n   {\"unit\": %u, \"binding\": %u, \"sampler_binding\": %u, \"cube\": %d,\n",
+                first ? "" : ",", u, RSX_SPIRV_TEXTURE_BINDING, RSX_SPIRV_SAMPLER_BINDING, (int)o->cube);
+        vk_r1_image_json(f, "image", o, file, bytes);
+        fprintf(f, ",\n    \"sampler\": {\"mag_filter\": %d, \"min_filter\": %d, \"mipmap_mode\": %d, "
+                   "\"address\": [%d, %d, %d], \"min_lod\": %.9g, \"max_lod\": %.9g, \"border_color\": %d}}",
+                d->mag_linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST,
+                d->min_linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST,
+                d->mip_linear ? VK_SAMPLER_MIPMAP_MODE_LINEAR : VK_SAMPLER_MIPMAP_MODE_NEAREST,
+                (int)vk_gcm_wrap(d->wrap_s), (int)vk_gcm_wrap(d->wrap_t), (int)vk_gcm_wrap(d->wrap_r),
+                min_lod, max_lod, (int)VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK);
+        first = 0;
+    }
+    fprintf(f, "\n  ],\n");
+    const vk_eng_obj* rt = vk_eng_get(s_r1c.rt, VK_ENG_COLOR);
+    if (rt) {
+        u64 bytes = 0;
+        vk_r1_image(rt, "target_before.bin", &bytes);
+        vk_r1_image_json(f, "target", rt, "target_before.bin", bytes);
+        fprintf(f, ",\n");
+    }
+    s_r1c.armed = 1; s_r1c.noted = 0;
+}
