new file mode 100644
index 0000000..41b5e0e
--- /dev/null
+++ b/libs/video/rsx_vulkan_bridge.h
@@ -0,0 +1,65 @@
+/*
+ * ps3recomp - the Vulkan backend's bridge to a native renderer beside it
+ *
+ * Development only (the port's docs/NATIVE_R3.md): with DOTHEROES_PPFX_NATIVE=1
+ * the device is made with a second queue of the graphics family, and a
+ * native renderer running on its own thread renders into images of its own on
+ * it. These functions let that renderer use the same device, and take the
+ * engine's copy of a colour surface at an exact point of the command stream:
+ * called on the walker's thread from an rsx_engine_bridge callback, a copy is
+ * recorded right there, and a semaphore given to rsx_vk_bridge_signal is
+ * signalled by the submission that carries it.
+ */
+#ifndef PS3RECOMP_RSX_VULKAN_BRIDGE_H
+#define PS3RECOMP_RSX_VULKAN_BRIDGE_H
+
+#ifndef VK_NO_PROTOTYPES
+#define VK_NO_PROTOTYPES
+#endif
+#include <vulkan/vulkan.h>
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct rsx_vk_bridge_dev {
+    VkInstance instance;
+    VkPhysicalDevice phys;
+    VkDevice device;
+    u32 queue_family;
+    VkQueue queue;          /* the native renderer's: a second queue of the family ... */
+    int shared_queue;       /* ... or, when the family has one, the backend's own */
+    PFN_vkGetInstanceProcAddr get_instance_proc;
+    PFN_vkGetDeviceProcAddr get_device_proc;
+} rsx_vk_bridge_dev;
+
+/* 0 and the device, once the backend has made it with the bridge asked for. */
+int rsx_vk_bridge_device(rsx_vk_bridge_dev* out);
+
+/* Held around every submission to the native queue: vkDeviceWaitIdle needs all
+ * queues of the device, and the backend takes the same lock for it. */
+void rsx_vk_bridge_queue_lock(void);
+void rsx_vk_bridge_queue_unlock(void);
+
+/* Walker thread only, from an rsx_engine_bridge callback: the engine's colour
+ * surface `handle`, w x h of it, copied here in the stream into `dst` (an
+ * image in VK_IMAGE_LAYOUT_GENERAL of the surface's format), or into a
+ * buffer at `off`. Ordered after every earlier write, and every later write
+ * after it. 0 when recorded. */
+int rsx_vk_bridge_copy_image(u32 handle, VkImage dst, u32 w, u32 h);
+int rsx_vk_bridge_copy_buffer(u32 handle, VkBuffer dst, VkDeviceSize off, u32 w, u32 h);
+
+/* Signal `sem` (binary) with the submission of what is recorded so far. */
+int rsx_vk_bridge_signal(VkSemaphore sem);
+
+/* Submit the open batch now, its signals with it. */
+void rsx_vk_bridge_flush(void);
+
+/* Semaphores signalled so far, and how many did not fit (dropped: a bug). */
+unsigned long long rsx_vk_bridge_signals(unsigned long long* lost);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3RECOMP_RSX_VULKAN_BRIDGE_H */
