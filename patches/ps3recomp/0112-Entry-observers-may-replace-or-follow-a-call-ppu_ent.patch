-                      "void ppu_entry_observe(uint32_t addr, ppu_context* ctx);", "#endif"]
+                      "int ppu_entry_observe(uint32_t addr, ppu_context* ctx);",
+                      "void ppu_exit_observe(uint32_t addr, ppu_context* ctx);",
+                      "extern int g_ppu_obs_store;",
+                      "void ppu_obs_store(uint64_t ea, uint32_t bytes);",
+                      "#ifdef __cplusplus", "}", "#endif",
+                      "#define PPU_OBS_ST(n, a) (g_ppu_obs_store ? ppu_obs_store((uint64_t)(a), (n)) : (void)0)",
+                      "#endif",
+                      f"static void {func.name}__body(ppu_context* ctx);"]
         uses_sjlj = any("ps3_sjlj_longjmp(" in bl or "_sjf.arm(" in bl for bl in func.body_lines)
         if uses_sjlj:
             lines.append('#include "ppu_sjlj.h"   /* --sjlj: guest setjmp/longjmp */')
-        lines.append(f"void {weak}{func.name}(ppu_context* ctx) {{")
-        lines.append("    PPU_MM_SNAP")
         if observed:
-            lines.append(f"    if (g_ppu_entry_observe) ppu_entry_observe(0x{func.start_addr:08X}u, ctx);  "
-                         f"/* entry observer */")
+            a = f"0x{func.start_addr:08X}u"
+            lines += [f"void {weak}{func.name}(ppu_context* ctx) {{",
+                      "    if (g_ppu_entry_observe) {  /* entry observer */",
+                      f"        const int _ob = ppu_entry_observe({a}, ctx);",
+                      "        if (_ob == 1) return;",
+                      f"        if (_ob == 2) {{ {func.name}__body(ctx); DRAIN_TRAMPOLINE(ctx); "
+                      f"ppu_exit_observe({a}, ctx); return; }}",
+                      "    }",
+                      f"    {func.name}__body(ctx);",
+                      "}",
+                      f"static void {func.name}__body(ppu_context* ctx) {{"]
+        else:
+            lines.append(f"void {weak}{func.name}(ppu_context* ctx) {{")
+        lines.append("    PPU_MM_SNAP")
         if hook:
             lines.append(f"    if ({hook[1]}) {{ {hook[0]}(ctx); return; }}  "
                          f"/* entry hook 0x{func.start_addr:08X} */")
         if any("_sjf.arm(" in bl for bl in func.body_lines):
             lines.append("    ps3_sjlj_frame _sjf;")
         for bline in _fuse_cr(func.body_lines):
+            if observed:
