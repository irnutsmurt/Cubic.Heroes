     return 0;
 }
@@ -435,6 +452,41 @@ static void gcm_report_write(u32 ea, u64 ts, u32 val)
     vm_write32(ea + 8u, val);
     vm_write32(ea + 12u, 0u);
 }
+/* A host renderer's report (the port's R6: real occlusion counts): written
+ * when its GPU has the result, as the RSX writes one -- {timer, value, 0} at
+ * the report area of `location` (the pad last); and a report's 16 bytes
+ * copied to IO offset `io` (cellGcmSetTransferReportData's copy), the pad
+ * word last. The timer is the reports' own clock. */
+u64 cellGcm_report_timestamp_pub(void);
+void cellGcm_report_write_pub(u32 index, u32 location, u32 value)
+{
+    const u32 ea = gcm_report_ea(index, location);
+    if (!ea) return;
+    const u64 ts = cellGcm_report_timestamp_pub();
+    vm_write32(ea, (u32)(ts >> 32));
+    vm_write32(ea + 4u, (u32)ts);
+    vm_write32(ea + 8u, value);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    vm_write32(ea + 12u, 0u);
+}
+int cellGcm_report_copy_pub(u32 index, u32 location, u32 io_out, u32 count)
+{
+    const u32 ea = gcm_io2ea(io_out);
+    if (!ea) return 0;
+    for (u32 k = 0; k < count; k++) {
+        const u32 src = gcm_report_ea(index + k, location);
+        if (!src) return 0;
+        const u32 d = ea + 16u * k;
+        vm_write32(d, vm_read32(src));
+        vm_write32(d + 4u, vm_read32(src + 4u));
+        vm_write32(d + 8u, vm_read32(src + 8u));
+        __atomic_thread_fence(__ATOMIC_RELEASE);
+        vm_write32(d + 12u, vm_read32(src + 12u));
+    }
+    return 1;
+}
+u32 cellGcm_io2ea_pub(u32 io) { return gcm_io2ea(io); }
