+/* A native renderer presenting its own frames (the port's R6,
+ * docs/NATIVE_R6.md): in three steps on its thread, with the present mutex
+ * held from the first to the last.
+ *   _prepare   completes the previous present (its copy, readback and
+ *              window present: the GPU is done reading the target) and
+ *              returns the offscreen target the window is presented from
+ *              (an image in GENERAL, the frame's size), for the native
+ *              renderer to blit its frame into on its own queue;
+ *   _submit    the present's own submission -- the readback copy (unless
+ *              PS3RECOMP_VK_READBACK=0) -- waiting on `wait`, which the
+ *              native submission with the blit signals;
+ *   finishing  the window present: rsx_vulkan_backend_present_finish, on the
+ *              host's present thread (or at once, when `finish_now`).
+ * The engine's own present is not used for those frames. */
+int rsx_vk_bridge_present_prepare(VkImage* target, u32* w, u32* h)
+{
+    if (!s_vk.device || !s_vk.color.img) return -1;
+    vk_mutex_lock(&s_vk.present_mu);
+    vk_present_complete_locked();
+    *target = s_vk.color.img; *w = s_vk.width; *h = s_vk.height;
+    return 0;
+}
+
+void rsx_vk_bridge_present_submit(VkSemaphore wait, int finish_now)
+{
+    VkCommandBuffer cb = s_vk.present_cmd;
+    if (pvkResetCommandBuffer(cb, 0) == VK_SUCCESS) {
+        VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+                                        .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+        if (pvkBeginCommandBuffer(cb, &bi) == VK_SUCCESS) {
+            s_vk.present_wait = wait;
+            const int split = s_vk.present_split;
+            s_vk.present_split = !finish_now;
+            const int eng = s_vk.eng_active;
+            s_vk.eng_active = 1;   /* vk_present_record_end: leave the finish to the caller */
+            vk_present_record_end(cb);
+            s_vk.eng_active = eng;
+            s_vk.present_split = split;
+            if (finish_now) vk_present_complete_locked();
+        }
+    }
+    vk_mutex_unlock(&s_vk.present_mu);
+}
+
+/* The prepare taken, nothing to present after all: the mutex back. */
+void rsx_vk_bridge_present_cancel(void) { vk_mutex_unlock(&s_vk.present_mu); }
+
 u32 rsx_vulkan_backend_presented_center(void)
 {
     return s_vk.presented ? (0xFF000000u | s_vk.last_center) : 0u;
@@ -6021,9 +6117,30 @@ long long rsx_vk_bridge_signal(VkSemaphore sem, int* used)
     for (u32 k = 0; k < s_br.n; k++)
         if (s_br.cmd[k] == s_vk.cmd) { const long long o = s_br.ord[k]; vk_mutex_unlock(&s_vk.queue_mu); return o; }
     if (!sem) { vk_mutex_unlock(&s_vk.queue_mu); return -1; }
+    if (!s_eb_pending) {
+        /* Nothing recorded in the open command buffer (the engine has drawn
+         * nothing since its last submission, or copies are submitted at once):
+         * no later submission need ever come to carry the signal -- once the
+         * engine draws nothing, none does -- and a native batch waiting on it
+         * would wait for the walker, which may be waiting on the native side
+         * (a handback). Submitted alone: a signal operation orders after
+         * everything submitted to the queue before it. */
+        VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                            .signalSemaphoreCount = 1, .pSignalSemaphores = &sem };
+        if (pvkQueueSubmit(s_vk.queue, 1, &si, VK_NULL_HANDLE) == VK_SUCCESS) {
+            const long long o = s_br.attached++;
+            s_br.signalled++;
+            s_br.alone++;
+            if (used) *used = 1;
+            vk_mutex_unlock(&s_vk.queue_mu);
+            return o;
+        }
+        s_br.lost++;
+        vk_mutex_unlock(&s_vk.queue_mu);
+        return -2;
+    }
     if (s_br.n == VK_BR_SIGNALS) { s_br.lost++; vk_mutex_unlock(&s_vk.queue_mu); return -2; }
-    /* the open batch's command buffer; a synchronous copy was submitted
-     * already, so its signal goes with the next one */
+    /* the open batch's command buffer: its submission carries the signal */
     const long long o = s_br.attached++;
     s_br.sem[s_br.n] = sem; s_br.cmd[s_br.n] = s_vk.cmd; s_br.ord[s_br.n] = o; s_br.n++;
