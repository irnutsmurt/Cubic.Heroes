From 4c22c24685f6016e2902c3bd830a13aac9a6aadf Mon Sep 17 00:00:00 2001
From: dotheroes <dotheroes@localhost>
Date: Fri, 6 Nov 2026 09:02:57 -0800
Subject: [PATCH] R7: a native front end, and a build without the RSX command
 path

For a host renderer that takes every command-writing libgcm call at its
entry, so that nothing is ever written into the title's ring (the port's
docs/NATIVE_R7.md):

- cellGcm_set_native_frontend: no FIFO walker. A flip is requested
  without a marker and completes once the host has executed it
  (cellGcm_native_flip_executed, the walker's half; the next tick, or at
  once in the benchmark mode); `get` answers `put` on a guest read of it
  (vm_read32, control+4); `ref`, labels and reports are the host's to write
  (cellGcm_native_ref, cellGcm_label_write_pub / _read_pub,
  cellGcm_report_write_pub); the ring-full callback recycles without
  waiting, counted. Inert unless a host sets it.
- PS3RECOMP_NATIVE_GRAPHICS (CMake, off by default): the runtime built
  without the command path -- rsx_commands.c, rsx_dispatch.c,
  rsx_draw_engine.c, rsx_live_draw*.c and the null and D3D12 backends left
  out; cellGcmSys.c (the walker, the 2D engines, the resync, the ref queue,
  the frame trace, the flip marker, the ring limit and lap wrap, the SPU
  put hook), rsx_vulkan_backend.c (the fixed-function and register-file
  draw paths, the pipeline cache, the bridge's copies into the engine's
  stream), rsx_vertex_compact.c (the fetch plan read from the register file,
  inline arrays) and ppu_loader.cpp's walker diagnostics compiled with
  PS3RECOMP_RSX_COMMAND_PATH=0. Kept: the system API, the Vulkan device,
  window, swapchain and present, shader, texture and vertex-format
  translation. The present-only backend clears its target on the present's
  own command buffer and still reads the SPIR-V cache.
- rsx_topology.c: the draw engine's topology expansion moved out unchanged,
  so a native renderer has it without the engine.
- gen_hle_nids.py --define NAME=VALUE: #if NAME blocks decided, so a build
  that compiles functions out does not register them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                  |  19 ++++
 libs/video/cellGcmSys.c         | 148 ++++++++++++++++++++++++++++++++
 libs/video/rsx_draw_engine.c    | 136 +----------------------------
 libs/video/rsx_draw_engine.h    |   7 +-
 libs/video/rsx_topology.c       | 141 ++++++++++++++++++++++++++++++
 libs/video/rsx_topology.h       |  20 +++++
 libs/video/rsx_vertex_compact.c |   4 +
 libs/video/rsx_vulkan_backend.c |  83 +++++++++++++++++-
 runtime/ppu/ppu_loader.cpp      |  11 +++
 tools/gen_hle_nids.py           |  54 +++++++++++-
 10 files changed, 479 insertions(+), 144 deletions(-)
 create mode 100644 libs/video/rsx_topology.c
 create mode 100644 libs/video/rsx_topology.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 79fa174..31518b8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -75,6 +75,20 @@ if(PS3RECOMP_RSX_VULKAN)
                  "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_shader_spirv.h")
 endif()
 
+# A native graphics build (the port's R7, docs/NATIVE_R7.md there): the
+# title's graphics are a host renderer's, made from its libgcm calls at their
+# entry, so nothing here reads a command stream. The FIFO walker and the 2D
+# engines in cellGcmSys.c, the method decoder and RSX state (rsx_commands.c),
+# the register file (rsx_dispatch.c), the draw engine, the live-draw path and
+# the backends' drawing are left out; what stays is the system API (cellGcm's
+# memory, display buffers, flips, labels and reports as the host writes them),
+# the Vulkan device and present, and asset translation (shaders, textures,
+# vertex formats, topology).
+option(PS3RECOMP_NATIVE_GRAPHICS "Build without the RSX command path (a native renderer draws)" OFF)
+if(PS3RECOMP_NATIVE_GRAPHICS)
+    list(FILTER HLE_SOURCES EXCLUDE REGEX "/libs/video/(rsx_commands|rsx_dispatch|rsx_draw_engine|rsx_live_draw|rsx_live_draw_config|rsx_null_backend|rsx_d3d12_backend)\\.c$")
+endif()
+
 # The Metal backend is Objective-C and Apple-only, so it is added explicitly
 # rather than globbed. It needs no platform #ifdef of its own as a result.
 if(APPLE)
@@ -203,6 +217,11 @@ if(PS3RECOMP_RSX_VULKAN)
     target_link_libraries(ps3recomp_runtime PUBLIC ${CMAKE_DL_LIBS})
     message(STATUS "  Vulkan:       RSX backend enabled (rsx_vulkan_backend.c, headers in ${PS3RECOMP_VULKAN_INCLUDE_DIR})")
 endif()
+if(PS3RECOMP_NATIVE_GRAPHICS)
+    # PUBLIC: the port's sources select their native-only paths on it too
+    target_compile_definitions(ps3recomp_runtime PUBLIC PS3RECOMP_RSX_COMMAND_PATH=0)
+    message(STATUS "  Graphics:     native only -- no RSX command path (walker, decoder, draw engine, backend drawing)")
+endif()
 
 # cellVdec decodes H.264 / MPEG-2 through FFmpeg when this is on. libavcodec
 # is loaded at run time (dlopen / LoadLibrary), never linked, so building needs
diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 7191ae7..f9f9d98 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -8,14 +8,29 @@
  * Actual rendering is handled elsewhere -- this module just tracks state.
  */
 
+/* PS3RECOMP_RSX_COMMAND_PATH (default 1): the FIFO walker, the 2D engines and
+ * the hand-over to the method decoder and draw engine. 0 (a native graphics
+ * build, PS3RECOMP_NATIVE_GRAPHICS): none of it -- the host renderer does the
+ * title's graphics from its libgcm calls (the native front end above). */
+#ifndef PS3RECOMP_RSX_COMMAND_PATH
+#define PS3RECOMP_RSX_COMMAND_PATH 1
+#endif
+#if PS3RECOMP_RSX_COMMAND_PATH
 #include "rsx_live_draw.h"
 #include "rsx_draw_engine.h"
+#endif
+#ifndef RSX_LOCATION_LOCAL
+#define RSX_LOCATION_LOCAL 0   /* rsx_dispatch.h's */
+#define RSX_LOCATION_MAIN  1
+#endif
 #include "cellGcmSys.h"
 #include "../../runtime/platform/win32_compat.h"
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write32 (translate + byte-swap, OOB-safe) */
 #include "../../runtime/memory/vm.h"    /* VM_HLE_INJECT_BASE */
 #include "../../runtime/spu/spu_coherency.h" /* the blit row copy's reservation bookkeeping */
+#if PS3RECOMP_RSX_COMMAND_PATH
 #include "rsx_commands.h"                    /* rsx_state, rsx_process_command_buffer */
+#endif
 #include "../../include/ps3emu/guest_call.h" /* g_ps3_guest_caller for direct handler dispatch */
 #include "../../include/ps3emu/ps3_ftrace.h"  /* PS3_FTRACE timeline */
 #include "../../include/ps3emu/osd.h"         /* the frame-rate readout's frame times (PS3_OSD_FPS) */
@@ -215,6 +230,29 @@ static volatile int s_flip_immediate;
 void cellGcm_set_flip_immediate(int on) { s_flip_immediate = on; }
 int cellGcm_flip_immediate(void) { return s_flip_immediate; }
 
+/* A native front end (the port's R7, docs/NATIVE_R7.md): a host renderer that
+ * takes every command-writing libgcm call at its entry, so nothing is ever
+ * written into the title's ring and no FIFO walker runs. What the walker did
+ * for the title's synchronisation the host does itself, in its own order:
+ *   - a flip is requested without a marker (no word in the ring) and
+ *     completes once the host has executed it: cellGcm_native_flip_executed,
+ *     the walker's half of the flip (the next tick then completes it);
+ *   - `get` answers `put` on every guest read of it: the ring has nothing
+ *     to consume (the host counts any word written into it);
+ *   - `ref`, labels and reports are written by the host (cellGcm_native_ref,
+ *     cellGcm_label_write_pub, cellGcm_report_write_pub) at the stage the
+ *     RSX would write them: when the command is consumed (ref, the front
+ *     end's labels) or when the work before it has completed (back-end
+ *     labels, reports);
+ *   - a ring-full callback (never expected) recycles without waiting.
+ * Set once by the host before the title's first flip; never cleared. */
+static volatile int s_gcm_native_fe;
+static volatile u32 s_native_fe_recycles, s_native_fe_get_polls;
+void cellGcm_set_native_frontend(int on) { s_gcm_native_fe = on; }
+int cellGcm_native_frontend(void) { return s_gcm_native_fe; }
+u32 cellGcm_native_fe_recycles(void) { return s_native_fe_recycles; }
+u32 cellGcm_native_fe_get_polls(void) { return s_native_fe_get_polls; }
+
 static int gcm_flip_executed_take(void)
 {
     const u32 r = s_fifo_flips_reached;
@@ -243,11 +281,26 @@ int cellGcm_take_flip_pending(void)
 static void gcm_set_current_display_buffer(u32 bufferId)
 {
     s_current_display_buffer_id = bufferId;
+#if PS3RECOMP_RSX_COMMAND_PATH
     if (rsx_draw_engine_enabled())
         rsx_draw_engine_note_flip(bufferId);
+#endif
 }
 
 
+/* The native front end's half of a flip (what the walker does at the
+ * marker): the buffer becomes the displayed one and the flip counts as
+ * executed; the next tick completes it (at once in the benchmark mode). */
+void cellGcmTickFlip(void);
+void cellGcm_native_flip_executed(u32 bufferId)
+{
+    if (bufferId < CELL_GCM_MAX_DISPLAY_BUFFER_NUM) gcm_set_current_display_buffer(bufferId);
+    s_flip_pending = 1;
+    s_flip_request_count++;
+    if (s_fifo_flips_reached != s_fifo_flips_queued) s_fifo_flips_reached++;
+    if (s_flip_immediate) cellGcmTickFlip();
+}
+
 /* The RSX puts its 3D state back to the reset values at a flip, and a title
  * may count on that: one sets ZSTENCIL_CLEAR_VALUE to 0 for a single clear
  * and never writes it again, so its later depth clears are to the far plane
@@ -256,6 +309,7 @@ static void gcm_set_current_display_buffer(u32 bufferId)
  * of the method stream, at the flip's place in it.
  * TODO: the rest of the reset image; this is the one register a title has
  * been seen to depend on. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 static void gcm_fifo_flip_resets_state(rsx_state* state)
 {
     const u32 m = NV4097_SET_ZSTENCIL_CLEAR_VALUE, v = RSX_DSP_ZSTENCIL_CLEAR_RESET;
@@ -263,6 +317,7 @@ static void gcm_fifo_flip_resets_state(rsx_state* state)
     if (rsx_live_draw_enabled())   rsx_live_draw_method(m, v);
     if (rsx_draw_engine_enabled()) rsx_draw_engine_method(m, v);
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* Configuration */
 static CellGcmConfig s_config;
@@ -531,6 +586,32 @@ static u32 s_labels[CELL_GCM_MAX_LABEL_COUNT];
 #define GCM_CONTROL_GUEST_ADDR (VM_HLE_INJECT_BASE + 0x2000u)
 static u32 fr_put(void) { return vm_read32(GCM_CONTROL_GUEST_ADDR + 0); }
 
+/* The native front end (above): `ref` as the host's consumer passes a
+ * reference command; `get` = `put` on a guest read (vm_read32 calls this for
+ * control+4 while the front end is native); a label's value. */
+void cellGcm_native_ref(u32 value)
+{
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    vm_write32(GCM_CONTROL_GUEST_ADDR + 8, value);
+}
+void cellGcm_get_on_poll(void)
+{
+    if (!s_gcm_native_fe) return;
+    s_native_fe_get_polls++;
+    vm_write32(GCM_CONTROL_GUEST_ADDR + 4, vm_read32(GCM_CONTROL_GUEST_ADDR + 0));
+}
+void cellGcm_label_write_pub(u32 index, u32 value)
+{
+    if (index >= CELL_GCM_MAX_LABEL_COUNT) return;
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    vm_write32(VM_HLE_INJECT_BASE + index * 0x10u, value);
+}
+u32 cellGcm_label_read_pub(u32 index)
+{
+    return index < CELL_GCM_MAX_LABEL_COUNT ? vm_read32(VM_HLE_INJECT_BASE + index * 0x10u) : 0u;
+}
+u32 cellGcm_control_ea_pub(void) { return GCM_CONTROL_GUEST_ADDR; }
+
 /* Synthetic guest code EA for the FIFO command-buffer-full callback. The title's
  * inline gcmReserve calls context->callback(context, count) when `current` nears
  * `end`; we point the context's callback OPD at this EA and register it in the
@@ -726,11 +807,13 @@ s32 cellGcmInit(u32 cmdSize, u32 ioSize, u32 ioAddress)
      * an SPU never tells libgcm where that stream is, so the write is the only
      * evidence of it -- see gcm_note_spu_put. Costs one NULL check per SPU DMA
      * for titles that do not. */
+#if PS3RECOMP_RSX_COMMAND_PATH
     { extern void (*g_spu_put_hook)(u32 ea, u32 size);
       void gcm_note_spu_put(u32 ea, u32 size);       /* defined with the walker */
       void gcm_forget_spu_blocks(void);
       gcm_forget_spu_blocks();
       g_spu_put_hook = gcm_note_spu_put; }
+#endif
 
     s_gcm_initialized = 1;
     return CELL_OK;
@@ -1377,6 +1460,7 @@ static struct {
 /* Morton/Z-order offset for an NV309E swizzled surface: interleave the low
  * min(l2w,l2h) bits of x and y, then append the remaining bits of the larger
  * dimension above them. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 static u32 nv309e_swz(u32 x, u32 y, u32 l2w, u32 l2h)
 {
     u32 n = l2w < l2h ? l2w : l2h, off = 0;
@@ -1761,6 +1845,7 @@ static void gcm_2d_method(u32 subch, u32 method, u32 data)
         printf("[cellGcmSys] FIFO subch %u method 0x%04X (unhandled 2D engine)\n",
                subch, method);
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* Present gate for the ticker: a flip is ready once the drain has consumed
  * everything up to put. The guest blocks in its own WaitFlip right after
@@ -1799,6 +1884,7 @@ static volatile u32 s_ref_qhead = 0, s_ref_qtail = 0;   /* single producer+consu
  * a title spinning on ctrl->ref waits forever with no indication why. Tokyo
  * Jungle did exactly this -- get left the 1 MB ring for IO 0x00F00000, which it
  * never mapped, while put sat at 0x604. Stop at the bad word and say so. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 static void gcm_fifo_bad_branch(const char* kind, u32 target, u32 word)
 {
     static int n = 0;
@@ -2150,6 +2236,7 @@ static SRWLOCK s_ref_pub_lock = SRWLOCK_INIT;
 
 void cellGcm_ref_on_poll(void)
 {
+    if (s_gcm_native_fe) return;   /* the host writes ref itself */
     /* Pace: leave each published value observable for >= ~200us of spins
      * (equality-waiters at any poll rate see every value; still ~5000/s so
      * loading's fence storms clear in seconds, not minutes). */
@@ -2396,6 +2483,18 @@ void cellGcm_rsx_process_fifo(void)
             ps3_ft_span(PS3_FT_DRAIN, 0, s_ft_sema_t0 ? 1u : 0u, 0, ft_t0, t1);
     }
 }
+#else
+/* No walker: the ref register is the host's (cellGcm_native_ref); a poll of
+ * it has nothing queued to publish. */
+volatile long long g_gcm_ref_pub_count = 0;
+unsigned long long ps3_qpc_us(void)
+{
+    static LARGE_INTEGER f; if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    LARGE_INTEGER n; QueryPerformanceCounter(&n);
+    return (unsigned long long)(n.QuadPart / (f.QuadPart / 1000000));
+}
+void cellGcm_ref_on_poll(void) {}
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* For a library that reads pixels the title rendered -- cellJpgEnc encoding
  * the display buffer 3D Dot Game Heroes' SNAPSHOT draws into. The engine
@@ -2422,6 +2521,9 @@ void cellGcm_guest_read_surface(u32 ea, u32 pitch, u32 w, u32 h)
         /* outside the walker's lock: the host renderer's work may wait for the walker's */
         if (loc != ~0u && s_guest_read_hook(loc, off, pitch, w, h)) return;
     }
+#if !PS3RECOMP_RSX_COMMAND_PATH
+    }   /* no engine: the host renderer's hook above, or nothing */
+#else
     if (!rsx_draw_engine_enabled()) return;
     u32 location, offset;
     if (ea >= s_config.localAddress && ea - s_config.localAddress < s_config.localSize) {
@@ -2437,11 +2539,13 @@ void cellGcm_guest_read_surface(u32 ea, u32 pitch, u32 w, u32 h)
     rsx_draw_engine_guest_read(location, offset, pitch, w, h);
     ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* The methods rsx_process_method acts on beyond its own rsx_state: the notify
  * and semaphore DMA contexts, the notify write, the back-end label offset and
  * label writes, and SET_REFERENCE (g_rsx_last_reference). Everything else only
  * updates state for a vtable backend. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 static int gcm_legacy_method_has_effect(u32 m)
 {
     switch (m) {
@@ -3487,6 +3591,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
     gcm_ref_publish_one();
     ReleaseSRWLockExclusive(&s_ref_pub_lock);
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* FIFO command-buffer-full callback body. The title's inline gcmReserve calls
  * context->callback(context, count) (routed here via the synthetic OPD) when the
@@ -3514,6 +3619,7 @@ u32 cellGcm_ea2io_pub(u32 ea) { return gcm_ea2io(ea); }
  * wait until the title has that much room, as long as the walker keeps
  * moving (2 s without progress, or 60 s in all, hands the title the rest of
  * the ring: the trade the full recycle below makes). Guest thread only. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 static void gcm_ring_limit_raise(u32 ctx_ea, u32 need)
 {
     const u32 begin = vm_read32(ctx_ea + 0x0), cur = vm_read32(ctx_ea + 0x8);
@@ -3626,6 +3732,7 @@ static int gcm_wrap_into_lap(u32 ctx_ea, u32 begin, u32 current, u32 io_begin, u
     s_lap_waited[why]++;
     return 0;
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 void cellGcm_fifo_recycle_n(u32 ctx_ea, u32 count);
 void cellGcm_fifo_recycle(u32 ctx_ea) { cellGcm_fifo_recycle_n(ctx_ea, 0); }
@@ -3635,6 +3742,15 @@ void cellGcm_fifo_recycle(u32 ctx_ea) { cellGcm_fifo_recycle_n(ctx_ea, 0); }
 void cellGcm_fifo_recycle_n(u32 ctx_ea, u32 count)
 {
     if (!ctx_ea) return;
+#if PS3RECOMP_RSX_COMMAND_PATH
+    if (s_gcm_native_fe)
+#endif
+    {   /* nothing consumes the ring: back to its start, no jump, no wait (counted) */
+        s_native_fe_recycles++;
+        vm_write32(ctx_ea + 0x8, vm_read32(ctx_ea + 0x0));
+        return;
+    }
+#if PS3RECOMP_RSX_COMMAND_PATH
     /* The room a raise or a new lap leaves the title: GCM_RING_LIMIT_ROOM, or
      * with GCM_WRAP_LAP=1 the reserve that called, if that is more. */
     u32 need = GCM_RING_LIMIT_ROOM;
@@ -3725,6 +3841,7 @@ void cellGcm_fifo_recycle_n(u32 ctx_ea, u32 count)
                 vm_read32(GCM_CONTROL_GUEST_ADDR + 0),
                 vm_read32(GCM_CONTROL_GUEST_ADDR + 4),
                 g_gcm_fifo_drained_ea, spins);
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 }
 
 /* A host that brings its backend up on another thread -- a frame clock that
@@ -3733,6 +3850,7 @@ void cellGcm_fifo_recycle_n(u32 ctx_ea, u32 count)
  * no scanout, and every flip presents whatever surface happens to be bound:
  * Twisted Metal on Linux showed an offscreen target instead of its composited
  * display buffer. rsx_draw_engine_init calls this to catch up. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 void cellGcm_replay_display_buffers_to_engine(void)
 {
     for (u32 i = 0; i < CELL_GCM_MAX_DISPLAY_BUFFER_NUM; i++)
@@ -3742,6 +3860,7 @@ void cellGcm_replay_display_buffers_to_engine(void)
                                                s_display_buffers[i].width,
                                                s_display_buffers[i].height);
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* NID: 0xDC09357E */
 s32 cellGcmSetDisplayBuffer(u32 bufferId, u32 offset, u32 pitch,
@@ -3762,10 +3881,12 @@ s32 cellGcmSetDisplayBuffer(u32 bufferId, u32 offset, u32 pitch,
     /* Tell the live engine too, or it has no registered scanout to present and
      * falls back to whatever surface happens to be current. Display buffers are
      * always in RSX local memory (location 0). */
+#if PS3RECOMP_RSX_COMMAND_PATH
     if (rsx_live_draw_enabled())
         rsx_live_draw_set_display_buffer(bufferId, 0, offset, pitch, width, height);
     if (rsx_draw_engine_enabled())
         rsx_draw_engine_set_display_buffer(bufferId, 0, offset, pitch, width, height);
+#endif
 
     return CELL_OK;
 }
@@ -3894,6 +4015,7 @@ s32 cellGcmSetFlipCommand(u32 bufferId) { return gcm_flip_request(bufferId, 0);
  * at ctx->current instead; the drain stops at it and fires the flip there,
  * exactly as it does for the 0xFEAD words a statically-linked libgcm emits.
  * Returns 0 when there is no room or ctx is not a mapped command buffer. */
+#if PS3RECOMP_RSX_COMMAND_PATH
 static int gcm_flip_into_fifo(u32 ctx, u32 bufferId)
 {
     if (!ctx || bufferId >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM ||
@@ -3959,6 +4081,7 @@ static int gcm_flip_into_fifo(u32 ctx, u32 bufferId)
     vm_write32(ctx + 8, cur + 4);
     return 1;
 }
+#endif  /* PS3RECOMP_RSX_COMMAND_PATH */
 
 /* cellGcmSetFlip(context, buffer_id) — immediate flip request. PSL1GHT's
  * gcmSetFlip import (NID 0xDC09357E) lands here; without it vkcube's flip was
@@ -4753,9 +4876,20 @@ s32 cellGcmSetDefaultFifoSize(u32 size)
 /* NID: 0x21397818 */
 s32 _cellGcmSetFlipCommand(void* ctx, u32 bufferId)
 {
+#if PS3RECOMP_RSX_COMMAND_PATH
+    if (s_gcm_native_fe)
+#endif
+    {   /* no marker: the host executes the flip (cellGcm_native_flip_executed) */
+        if (bufferId >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM || !s_display_buffer_set[bufferId])
+            return CELL_GCM_ERROR_INVALID_VALUE;
+        s_fifo_flips_queued++;
+        return gcm_flip_request(bufferId, 1);
+    }
+#if PS3RECOMP_RSX_COMMAND_PATH
     if (gcm_flip_into_fifo((u32)(uintptr_t)ctx, bufferId))
         return gcm_flip_request(bufferId, 1);
     return cellGcmSetFlipCommand(bufferId);
+#endif
 }
 
 /* NID: 0xD8F88E1A */
@@ -4771,6 +4905,17 @@ s32 _cellGcmSetFlipCommandWithWaitLabel(void* ctx, u32 bufferId,
                                         u32 labelIndex, u32 labelValue)
 {
     const u32 c = (u32)(uintptr_t)ctx;
+#if PS3RECOMP_RSX_COMMAND_PATH
+    if (s_gcm_native_fe)
+#endif
+    {   /* the wait is the host's (it executes flips in order); no words */
+        if (bufferId >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM || !s_display_buffer_set[bufferId])
+            return CELL_GCM_ERROR_INVALID_VALUE;
+        (void)labelIndex; (void)labelValue;
+        s_fifo_flips_queued++;
