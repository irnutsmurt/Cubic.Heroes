From efc05a6224b0a42c7f3eaa886b59bca2907a0c1c Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Fri, 6 Nov 2026 15:56:55 -0800
Subject: [PATCH 117/118] PAD_FILE: a hold for wall time on the trace's clock,
 each press recorded

A test drive's timed hold (`echo 0x0010 1 1000 > pad.txt`) was measured with
GetTickCount64, which advances in ~15.6 ms steps on Windows: a 1 s hold was
anything from ~984 to ~1016 ms, and a walk's length varied with it at any
frame rate (3D Dot Game Heroes' "shorter uncapped walk"). The hold is now
timed with ps3_ft_now (the performance counter), and each press goes to the
frame trace (PS3_FT_PAD: the reads that carried its buttons, first to first
without) and to the log with its count of reads. PAD_FILE only; play input
is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/ps3emu/ps3_ftrace.h |  4 ++++
 libs/input/cellPad.c        | 26 ++++++++++++++++++++++----
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/include/ps3emu/ps3_ftrace.h b/include/ps3emu/ps3_ftrace.h
index 525c184..f1e3bd6 100644
--- a/include/ps3emu/ps3_ftrace.h
+++ b/include/ps3emu/ps3_ftrace.h
@@ -126,6 +126,10 @@ enum ps3_ft_kind {
                               * per mille | the mean busy per mille of the logical processors
                               * outside its core << 16. Busy: 1 - idle cycles / TSC cycles, any
                               * process (QueryIdleProcessorCycleTimeEx); group 0 only */
+    PS3_FT_PAD         = 27, /* a test's PAD_FILE press as the title's pad reads saw it: from
+                              * the read that first carried the buttons to the first that did
+                              * not; who = 1 a hold for wall time / 2 for a count of reports,
+                              * a = the buttons, b = the hold asked for, ms (1) or reports (2) */
 };
 
 #if defined(_MSC_VER)
diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index f505eea..0f552db 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -20,6 +20,7 @@
 #include "../../runtime/platform/win32_compat.h"   /* GetTickCount64 on POSIX */
 #include "../../runtime/ppu/ppu_memory.h"   /* GUEST_PTR, vm_write*: guest EA -> host */
 #include "ps3emu/log_first.h"
+#include "ps3emu/ps3_ftrace.h"   /* PAD_FILE's holds: the trace clock and PS3_FT_PAD */
 
 /* PAD_CLOCK=flips: PAD_SCRIPT and PAD_STICK times count guest flips instead of
  * wall-clock seconds. A loaded machine runs a title at a third of its usual
@@ -1034,13 +1035,21 @@ skip_inject: ;
      *                            # long hold; the default is 40)
      *   echo 0x0010 1 1500 > pad.txt  # UP for 1.5 s of wall time, however
      *                            # many reports that is (frame-rate tests)
+     *
+     * A hold for wall time is measured with the trace's clock (the performance
+     * counter, ns): GetTickCount64 advances in ~15.6 ms steps on Windows, which
+     * made a 1 s hold anything from ~984 to ~1016 ms -- a walk's length varied
+     * by that much, at any frame rate. Each press's reads, first with the
+     * buttons to first without, go to the frame trace (PS3_FT_PAD) and the log.
      */
     { static int s_pf = -1; static char pf_path[512];
-      static unsigned held_mask = 0; static int held_n = 0; static unsigned long long held_until = 0;
+      static unsigned held_mask = 0; static int held_n = 0; static uint64_t held_until = 0;
+      static uint64_t held_t0 = 0; static long held_ask = 0; static unsigned held_reads = 0;
       if (s_pf < 0) { const char* e = getenv("PAD_FILE");
                       s_pf = (e && *e) ? 1 : 0;
                       if (s_pf) { strncpy(pf_path, e, sizeof pf_path - 1); pf_path[sizeof pf_path - 1] = 0; } }
       if (s_pf && port_no == 0) {
+          const uint64_t now = ps3_ft_now();
           if (held_n <= 0) {
               FILE* f = fopen(pf_path, "rb");
               if (f) {
@@ -1051,8 +1060,9 @@ skip_inject: ;
                       int n = (int)strtol(rest, &rest, 0);
                       const long ms = strtol(rest, 0, 0);
                       held_until = 0;
-                      if (m && ms > 0) { held_until = GetTickCount64() + (unsigned long long)ms; n = 1; }
+                      if (m && ms > 0) { held_until = now + (uint64_t)ms * 1000000ull; n = 1; }
                       if (m) { held_mask = m; held_n = n > 0 ? n : 40;
+                               held_t0 = now; held_ask = held_until ? ms : held_n; held_reads = 0;
                                printf("[cellPad] PAD_FILE press 0x%04X\n", m); fflush(stdout); }
                   }
                   fclose(f);
@@ -1060,9 +1070,17 @@ skip_inject: ;
               }
           }
           if (held_n > 0) {
-              if (held_until) {
-                  if (GetTickCount64() >= held_until) { held_n = 0; held_until = 0; }
+              const int timed = held_until != 0;
+              if (timed) {
+                  if (now >= held_until) { held_n = 0; held_until = 0; }
               } else if (data->len > 0) held_n--;
+              if (held_n > 0) held_reads++;
+              else {
+                  ps3_ft_span(PS3_FT_PAD, timed ? 1 : 2, held_mask, (uint32_t)held_ask, held_t0, now);
+                  printf("[cellPad] PAD_FILE release 0x%04X: %.3f ms, %u reads with it (asked %ld %s)\n", held_mask,
+                         (double)(now - held_t0) / 1e6, held_reads, held_ask, timed ? "ms" : "reports");
+                  fflush(stdout);
+              }
           }
           if (held_n > 0) {
               data->button[CELL_PAD_BTN_OFFSET_DIGITAL1] |= (u16)(held_mask & 0xFF);
-- 
2.56.0.windows.3

