-    memset(q, 0, sizeof(*q));
+    /* The waiter primitives are initialised once, the first time the slot is
+     * used (q_reset_begin): a zeroed CRITICAL_SECTION is not a valid one, and
+     * the first EnterCriticalSection on it faults writing near offset 0x24 of
+     * a null internal pointer -- which is how YDKJ's FMOD audio thread died
+     * the moment it was finally given a real queue to block on. */
+    q_reset_begin(slot);
     q->active   = 1;
     q->key      = key;
     q->capacity = size;
     q->type     = SYS_PPU_QUEUE;
-
-    /* The waiter primitives MUST be initialised here too. memset+fields is
-     * not enough: a zeroed CRITICAL_SECTION is not a valid one, and the
-     * first EnterCriticalSection on it faults writing near offset 0x24 of a
-     * null internal pointer -- which is exactly how YDKJ's FMOD audio thread
-     * died the moment it was finally given a real queue to block on. */
-#ifdef _WIN32
-    InitializeCriticalSection(&q->lock);
-    InitializeConditionVariable(&q->not_empty);
-#else
-    pthread_mutex_init(&q->lock, NULL);
-    pthread_cond_init(&q->not_empty, NULL);
-#endif
+    q_reset_end(slot);
 
     evt_table_unlock();
 
@@ -165,7 +277,7 @@ int64_t sys_event_queue_create(ppu_context* ctx)
     }
 
     sys_event_queue_info* q = &g_sys_event_queues[slot];
-    memset(q, 0, sizeof(*q));
+    q_reset_begin(slot);
     q->active   = 1;
     q->key      = key;
     q->capacity = size;
@@ -197,13 +309,7 @@ int64_t sys_event_queue_create(ppu_context* ctx)
         memcpy(q->name, attr_raw + 8, 8);
     }
 
-#ifdef _WIN32
-    InitializeCriticalSection(&q->lock);
-    InitializeConditionVariable(&q->not_empty);
-#else
-    pthread_mutex_init(&q->lock, NULL);
-    pthread_cond_init(&q->not_empty, NULL);
-#endif
+    q_reset_end(slot);
 
     uint32_t queue_id = (uint32_t)(slot + 1);
     if (id_out_addr != 0) {
@@ -217,6 +323,7 @@ int64_t sys_event_queue_create(ppu_context* ctx)
 int64_t sys_event_queue_destroy(ppu_context* ctx)
 {
     uint32_t queue_id = LV2_ARG_U32(ctx, 0);
+    uint32_t mode     = LV2_ARG_U32(ctx, 1);   /* SYS_EVENT_QUEUE_DESTROY_FORCE: wake the waiters */
 
     if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX)
         return getenv("YDKJ_EVT_LENIENT") ? CELL_OK : (int64_t)(int32_t)CELL_ESRCH;  /* idempotent teardown */
@@ -229,15 +336,42 @@ int64_t sys_event_queue_destroy(ppu_context* ctx)
         return getenv("YDKJ_EVT_LENIENT") ? CELL_OK : (int64_t)(int32_t)CELL_ESRCH;  /* idempotent teardown */
     }
 
+    const int slot = (int)queue_id - 1;
 #ifdef _WIN32
-    DeleteCriticalSection(&q->lock);
+    EnterCriticalSection(&q->lock);
 #else
-    pthread_cond_destroy(&q->not_empty);
-    pthread_mutex_destroy(&q->lock);
+    pthread_mutex_lock(&q->lock);
 #endif
-
+    const int waiting = s_q_blocked[slot];
+    if (waiting && mode != SYS_EVENT_QUEUE_DESTROY_FORCE) {
+#ifdef _WIN32
+        LeaveCriticalSection(&q->lock);
+#else
+        pthread_mutex_unlock(&q->lock);
+#endif
+        evt_table_unlock();
+        static int said = 0;
+        if (PS3_LOG_FIRST(said, 8))
+            fprintf(stderr, "[evt] queue_destroy q=%u mode=%u: %d thread(s) waiting -> EBUSY (lv2)\n",
+                    queue_id, mode, waiting);
+        return (int64_t)(int32_t)CELL_EBUSY;
+    }
+    s_q_gen[slot]++;           /* its waiters leave with ECANCELED */
     q->active = 0;
+#ifdef _WIN32
+    WakeAllConditionVariable(&q->not_empty);
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_cond_broadcast(&q->not_empty);
+    pthread_mutex_unlock(&q->lock);
+#endif
     evt_table_unlock();
+    if (waiting) {
+        static int said = 0;
+        if (PS3_LOG_FIRST(said, 8))
+            fprintf(stderr, "[evt] queue_destroy q=%u forced: %d waiting thread(s) woken with ECANCELED\n",
+                    queue_id, waiting);
+    }
     return CELL_OK;
 }
 
@@ -477,6 +611,7 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
 
 #ifdef _WIN32
     EnterCriticalSection(&q->lock);
+    const uint32_t gen = s_q_gen[queue_id - 1];   /* a destroy changes it: this wait is over */
 
     /* EVT_RECV_KICK=<qid>:<ms>: an infinite wait on that queue that sees
      * nothing for <ms> gets the last event pushed to the queue re-delivered.
@@ -487,8 +622,8 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
     if (s_kq < 0) { const char* e = getenv("EVT_RECV_KICK"); s_kq = 0;
         if (e) { s_kq = atoi(e); const char* c = strchr(e, ':'); s_kms = c ? (DWORD)atoi(c + 1) : 500; } }
