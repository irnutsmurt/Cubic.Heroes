From e2d18c991fc51b1872c077bf79f2e42a9295e0ee Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:15:40 -0800
Subject: [PATCH] Event queues and flags: locks that outlive a destroy, lv2's
 EBUSY and ECANCELED

sys_event_queue_destroy deleted the queue's critical section (and a create
memset the slot, lock included) while a thread could still be inside a wait
on it. 3D Dot Game Heroes waits on a queue with a 2 s timeout from one
thread while another destroys it as the dot editor opens; the waiter then
re-entered a deleted lock and the process died in ntdll (a write near 0x24).

The queues' and flags' locks and condition variables now live as long as the
process: initialised the first time a slot is used, never deleted, and a
create resets only the object's data, under its own lock. A queue's destroy
follows lv2: refused with EBUSY while threads wait, unless forced
(SYS_EVENT_QUEUE_DESTROY_FORCE), when the waiters are woken and return
ECANCELED; a generation per slot keeps a woken waiter from taking an event
of a new queue made in the same slot. An event flag with waiters is not
destroyed (EBUSY). The first few refused or forced destroys are logged with
their mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/syscalls/sys_event.c | 261 +++++++++++++++++++++++++++--------
 1 file changed, 203 insertions(+), 58 deletions(-)

diff --git a/runtime/syscalls/sys_event.c b/runtime/syscalls/sys_event.c
index 6cfb0d2..0552c13 100644
--- a/runtime/syscalls/sys_event.c
+++ b/runtime/syscalls/sys_event.c
@@ -9,6 +9,7 @@
 #include "../memory/vm.h"
 #include "../spu/spu_workload.h"   /* spu_elf_image_size, spu_workload_dispatch_async */
 #include <string.h>
+#include <stddef.h>               /* offsetof */
 #include <stdlib.h>               /* getenv */
 #include "ps3emu/log_first.h"
 
@@ -55,6 +56,124 @@ static void evt_table_unlock(void)
 #endif
 }
 
+/* The queues' and flags' locks and condition variables live as long as the
+ * process: initialised the first time their slot is used, never deleted, and a
+ * create resets only the object's data, under its own lock. A destroy used to
+ * DeleteCriticalSection (and a create to memset the lock) while a thread could
+ * still be inside a wait on it: 3D Dot Game Heroes' thread 6 waits on a queue
+ * with a 2 s timeout, the queue was destroyed as the dot editor opened, and
+ * when the wait ended the thread re-entered a deleted lock and the process
+ * died in ntdll (a write near 0x24). A queue's destroy now follows lv2: with
+ * threads waiting it is refused (EBUSY), unless forced
+ * (SYS_EVENT_QUEUE_DESTROY_FORCE), when they are woken and return ECANCELED.
+ * A destroyed queue's generation changes, so a waiter never takes an event
+ * from a new queue made in the same slot. A flag with threads waiting is not
+ * destroyed either (EBUSY), as lv2 has it. */
+#ifndef SYS_EVENT_QUEUE_DESTROY_FORCE
+#define SYS_EVENT_QUEUE_DESTROY_FORCE 1
+#endif
+static unsigned char s_q_sync[SYS_EVENT_QUEUE_MAX], s_f_sync[SYS_EVENT_FLAG_MAX];
+static uint32_t s_q_gen[SYS_EVENT_QUEUE_MAX];
+/* threads inside a wait on the object, counted under its lock */
+static int s_q_blocked[SYS_EVENT_QUEUE_MAX], s_f_blocked[SYS_EVENT_FLAG_MAX];
+
+/* The slot's object reset for a create, its lock held (q_reset_end lets it
+ * go). Called with the table lock held, so two creates never init one slot. */
+static void q_reset_begin(int slot)
+{
+    sys_event_queue_info* q = &g_sys_event_queues[slot];
+    if (!s_q_sync[slot]) {
+#ifdef _WIN32
+        InitializeCriticalSection(&q->lock);
+        InitializeConditionVariable(&q->not_empty);
+#else
+        pthread_mutex_init(&q->lock, NULL);
+        pthread_cond_init(&q->not_empty, NULL);
+#endif
+        s_q_sync[slot] = 1;
+    }
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+#else
+    pthread_mutex_lock(&q->lock);
+#endif
+    memset(q, 0, offsetof(sys_event_queue_info, lock));
+}
+static void q_reset_end(int slot)
+{
+    sys_event_queue_info* q = &g_sys_event_queues[slot];
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+}
+static void f_reset_begin(int slot)
+{
+    sys_event_flag_info* f = &g_sys_event_flags[slot];
+    if (!s_f_sync[slot]) {
+#ifdef _WIN32
+        InitializeCriticalSection(&f->lock);
+        InitializeConditionVariable(&f->cv);
+#else
+        pthread_mutex_init(&f->lock, NULL);
+        pthread_cond_init(&f->cv, NULL);
+#endif
+        s_f_sync[slot] = 1;
+    }
+#ifdef _WIN32
+    EnterCriticalSection(&f->lock);
+#else
+    pthread_mutex_lock(&f->lock);
+#endif
+    memset(f, 0, offsetof(sys_event_flag_info, lock));
+}
+static void f_reset_end(int slot)
+{
+    sys_event_flag_info* f = &g_sys_event_flags[slot];
+#ifdef _WIN32
+    LeaveCriticalSection(&f->lock);
+#else
+    pthread_mutex_unlock(&f->lock);
+#endif
+}
+/* A wait, counted in the object's waiters (its lock held). */
+#ifdef _WIN32
+static BOOL q_sleep(sys_event_queue_info* q, int slot, DWORD ms)
+{
+    s_q_blocked[slot]++;
+    const BOOL r = SleepConditionVariableCS(&q->not_empty, &q->lock, ms);
+    const DWORD err = GetLastError();
+    s_q_blocked[slot]--;
+    SetLastError(err);
+    return r;
+}
+static BOOL f_sleep(sys_event_flag_info* f, int slot, DWORD ms)
+{
+    s_f_blocked[slot]++;
+    const BOOL r = SleepConditionVariableCS(&f->cv, &f->lock, ms);
+    const DWORD err = GetLastError();
+    s_f_blocked[slot]--;
+    SetLastError(err);
+    return r;
+}
+#else
+static int q_cwait(sys_event_queue_info* q, int slot, const struct timespec* ts)
+{
+    s_q_blocked[slot]++;
+    const int r = ts ? pthread_cond_timedwait(&q->not_empty, &q->lock, ts) : pthread_cond_wait(&q->not_empty, &q->lock);
+    s_q_blocked[slot]--;
+    return r;
+}
+static int f_cwait(sys_event_flag_info* f, int slot, const struct timespec* ts)
+{
+    s_f_blocked[slot]++;
+    const int r = ts ? pthread_cond_timedwait(&f->cv, &f->lock, ts) : pthread_cond_wait(&f->cv, &f->lock);
+    s_f_blocked[slot]--;
+    return r;
+}
+#endif
+
 static void write_be32(uint32_t addr, uint32_t val)
 {
     uint32_t* p = (uint32_t*)vm_to_host(addr);
@@ -117,24 +236,17 @@ uint32_t sys_event_queue_create_direct(uint64_t key, int32_t size)
     if (slot < 0) { evt_table_unlock(); return 0; }
 
