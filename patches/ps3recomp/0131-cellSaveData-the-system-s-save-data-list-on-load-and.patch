+/* The list panel (ps3emu/osd.h, the save-data list): composed on the CPU when
+ * its revision or the window's size changes, copied into the middle of the
+ * window after the game's picture, as the message above. */
+static struct {
+    vk_buffer buf;
+    uint32_t  rev;
+    u32       w, h, scale;
+    int       fmt, failed;
+} s_olist;
+
+static void vk_osd_text(uint8_t* img, u32 bw, u32 bh, u32 x0, u32 y0, const char* s, u32 scale,
+                        uint8_t r, uint8_t g, uint8_t b)
+{
+    for (; *s; s++, x0 += 6 * scale) {
+        const uint8_t* gl = vk_osd_glyph(*s);
+        if (!gl) continue;
+        for (u32 gy = 0; gy < 7; gy++)
+            for (u32 gx = 0; gx < 5; gx++)
+                if (gl[gy] & (0x10u >> gx))
+                    for (u32 y = y0 + gy * scale; y < y0 + (gy + 1) * scale && y < bh; y++)
+                        for (u32 x = x0 + gx * scale; x < x0 + (gx + 1) * scale && x < bw; x++)
+                            vk_osd_px(img + ((size_t)y * bw + x) * 4, r, g, b);
+    }
+}
+
+static void vk_osd_list_draw(VkCommandBuffer cb, u32 idx)
+{
+    static ps3_osd_list_state L;
+    if (!__atomic_load_n(&g_ps3_osd_list.open, __ATOMIC_ACQUIRE)) return;
+    if (!s_vk.sc_osd || s_olist.failed || !ps3_osd_list_read(&L)) return;
+    const u32 W = s_vk.sc_extent.width, H = s_vk.sc_extent.height;
+    u32 scale = H >= 360 ? H / 360 : 1;
+    const u32 cols = PS3_OSD_LIST_COLS - 1, lines = L.nrows + 4;   /* the title, a gap, the rows, a gap, the prompts */
+    while (scale > 1 && ((cols * 6 + 12) * scale + 8 > W || (lines * 10 + 12) * scale + 8 > H)) scale--;
+    const u32 pad = 6 * scale, rowh = 10 * scale;
+    const u32 bw = cols * 6 * scale + 2 * pad, bh = lines * rowh + 2 * pad;
+    if (bw + 8 > W || bh + 8 > H) return;
+    if (L.rev != s_olist.rev || scale != s_olist.scale || s_vk.sc_osd != s_olist.fmt) {
+        const VkDeviceSize need = (VkDeviceSize)bw * bh * 4;
+        if (s_olist.buf.size < need) {
+            if (s_olist.buf.buf) vk_destroy_present_buffer(&s_olist.buf);
+            if (vk_create_host_buffer(&s_olist.buf, need, VK_BUFFER_USAGE_TRANSFER_SRC_BIT) != 0 || !s_olist.buf.coherent) {
+                if (s_olist.buf.buf) vk_destroy_present_buffer(&s_olist.buf);
+                s_olist.failed = 1;
+                VK_LOG("no coherent host buffer for the list panel; it stays off\n");
+                return;
+            }
+        }
+        uint8_t* img = (uint8_t*)s_olist.buf.ptr;
+        const u32 edge = scale;
+        for (u32 y = 0; y < bh; y++)
+            for (u32 x = 0; x < bw; x++) {
+                const int border = x < edge || y < edge || x >= bw - edge || y >= bh - edge;
+                const u32 row = y >= pad ? (y - pad) / rowh : 0;
+                const int sel = !border && y >= pad && row >= 2 && row - 2 >= L.sel0 && row - 2 < L.sel1;
+                if (border)   vk_osd_px(img + ((size_t)y * bw + x) * 4, 170, 170, 170);
+                else if (sel) vk_osd_px(img + ((size_t)y * bw + x) * 4, 44, 74, 130);
+                else          vk_osd_px(img + ((size_t)y * bw + x) * 4, 16, 16, 24);
+            }
+        vk_osd_text(img, bw, bh, pad, pad, L.title, scale, 255, 255, 255);
+        for (u32 i = 0; i < L.nrows; i++) {
+            const int sel = i >= L.sel0 && i < L.sel1;
+            vk_osd_text(img, bw, bh, pad, pad + (i + 2) * rowh + scale, L.rows[i], scale,
+                        sel ? 255 : 190, sel ? 255 : 190, sel ? 255 : 190);
+        }
+        vk_osd_text(img, bw, bh, pad, pad + (lines - 1) * rowh, L.foot, scale, 200, 200, 120);
+        s_olist.rev = L.rev; s_olist.scale = scale; s_olist.w = bw; s_olist.h = bh; s_olist.fmt = s_vk.sc_osd;
+    }
+    VkImageMemoryBarrier b = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = s_vk.sc_images[idx], .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+    };
+    pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          0, 0, NULL, 0, NULL, 1, &b);
+    VkBufferImageCopy region = {
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageOffset = { (int32_t)((W - bw) / 2), (int32_t)((H - bh) / 2), 0 }, .imageExtent = { bw, bh, 1 },
+    };
+    pvkCmdCopyBufferToImage(cb, s_olist.buf.buf, s_vk.sc_images[idx],
+                            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+    __atomic_store_n(&g_ps3_osd_list.drawn, L.rev, __ATOMIC_RELEASE);
+}
