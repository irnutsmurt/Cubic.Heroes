From 6436b9f1ebed0373813b47fbb4e43ad424d90e97 Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:50:39 -0800
Subject: [PATCH] SPU overlays: a native replacement for a relocatable
 overlay's functions

spu_overlay_set_native registers a port's function, called on an indirect branch
into a verified resident relocatable overlay with its image and the target's link
address; it returns 1 when it ran the call (pc set to the return, as SPU_RET
leaves it), 0 to run the lifted function. Unregistered, nothing changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/spu/spu_channels.c | 16 ++++++++++++++++
 runtime/spu/spu_context.h  |  6 ++++++
 2 files changed, 22 insertions(+)

diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index e02aa23..c246559 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -2704,6 +2704,9 @@ static int spu_smc_microstep(spu_context* ctx)
 }
 #endif /* PS3RECOMP_SPU_INTERPRETER */
 
+static spu_overlay_native_fn s_ovl_native;
+void spu_overlay_set_native(spu_overlay_native_fn fn) { s_ovl_native = fn; }
+
 void spu_indirect_branch(spu_context* ctx)
 {
     /* Real SPU bi/bisl mask the target to the 256 KB local store; the high bits
@@ -2712,6 +2715,19 @@ void spu_indirect_branch(spu_context* ctx)
      * and falls into branch-to-0. All lifted funcs live below SPU_LS_SIZE, so
      * masking is a no-op for already-valid targets. */
     ctx->pc &= SPU_LS_MASK;
+    /* A relocatable overlay's function the port runs natively (spu_overlay_set_native): only in a
+     * verified resident span, as the lifted lookup requires. */
+    if (s_ovl_native)
+        for (unsigned slot = 0; slot < 4; ++slot) {
+            const uint32_t base = ctx->resident_code[slot].lsa;
+            if (!ctx->resident_code[slot].reloc || !ctx->resident_code[slot].image_id ||
+                ctx->pc < base || ctx->pc - base >= ctx->resident_code[slot].size) continue;
+            if (ctx->resident_code[slot].verify_state && !spu_overlay_resident_verified(ctx, slot)) break;
+            const uint32_t delta = ctx->resident_code[slot].reloc_delta;
+            ctx->ls_reloc = delta;
+            if (s_ovl_native(ctx, ctx->resident_code[slot].image_id, ctx->pc - delta, delta)) return;
+            break;
+        }
     /* Interrupt-return register restore (see spu_drain.c spu_irq_regs_save):
      * the WWS handler's save/restore shim lives at unlifted top-of-LS, so we
      * enforce the preserve-all-registers hardware contract here -- the first
diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index 977b426..4a1e7e6 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -874,6 +874,12 @@ static inline int spu_channel_has_data(const spu_channel* ch)
 /* Indirect-branch dispatcher (spu_channels.c): resolves ctx->pc to a lifted
  * function in the active image and runs it. Referenced by SPU_RET/SPU_DRAIN. */
 void spu_indirect_branch(spu_context* ctx);
+/* A native replacement for functions of a relocatable overlay (a port's; the port's docs/AUDIO.md
+ * step A1): called on an indirect branch into a verified resident relocatable overlay with its image
+ * and the target's link address (lsa - delta); returns 1 when it ran the call (ctx->pc then the
+ * return address, as SPU_RET leaves it; or the thread halted), 0 to run the lifted function. */
+typedef int (*spu_overlay_native_fn)(spu_context* ctx, int image_id, uint32_t link, uint32_t delta);
+void spu_overlay_set_native(spu_overlay_native_fn fn);
 
 /* Pending cross-function transfer target; NULL when none. Thread-local: each
  * spu_context is pinned to one host thread for its lifetime. */
-- 
