+/* The last frame presented once more, with the overlays (ps3emu/osd.h
+ * g_ps3_osd_present_again): for a host dialog while the guest flips nothing.
+ * Any thread; under the present mutex, after a present in flight completes
+ * (vk_present_window reuses its command buffer). 1 when it presented. */
+static int vk_present_again(void)
+{
+    if (!s_vk.device || !s_vk.windowed || !s_vk.swapchain) return 0;
+    vk_mutex_lock(&s_vk.present_mu);
+    vk_present_complete_locked();
