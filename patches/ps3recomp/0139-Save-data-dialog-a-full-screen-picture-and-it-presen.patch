+/*
+ * The save-data screen (include/ps3emu/osd.h, ps3_osd_saves_state), composed on
+ * the CPU into a picture the size of the window: a dark full-screen background, a
+ * heading and a clock, the saves as large rows (the save's own ICON0.PNG on the
+ * left, aspect kept; its title, date and size, and its DETAIL lines), a distinct
+ * highlight on the selected row, thin separators, a scroll bar when the rows do
+ * not fit, the overwrite question as a box over the list, and the confirm and
+ * back prompts along the bottom in the player's prompt style.
+ *
+ * Everything drawn here is the runtime's or the title's: the text font and the
+ * prompt images are registered by the title (ps3_ui_set_font,
+ * ps3_ui_set_prompt_png; redistributable files of its own), the icons are the
+ * player's save data, and a prompt style without images is drawn from shapes.
+ * Nothing comes from PS3 firmware.
+ *
+ * Sizes are set for a 1280x720 screen and scaled by the window's height (the
+ * width scaled the same, the rows stretched to the window's width), so the screen
+ * reads the same in a small window and in fullscreen.
+ */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/stat.h>
+
+#include "../../include/ps3emu/osd.h"
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "../font/stb_truetype.h"
+
+#define STB_IMAGE_IMPLEMENTATION
+#define STB_IMAGE_STATIC
+#define STBI_ONLY_PNG
+#define STBI_NO_STDIO
+#include "../codec/stb_image.h"
+
+/* ---- the title's font and prompt images --------------------------------- */
+
+static struct {
+    const unsigned char* data;
+    stbtt_fontinfo       info;
+    int                  ok;
+} s_font;
+
+void ps3_ui_set_font(const void* ttf, size_t size)
+{
+    s_font.ok = 0;
+    if (!ttf || size < 64) return;
+    s_font.data = (const unsigned char*)ttf;
+    if (stbtt_InitFont(&s_font.info, s_font.data, stbtt_GetFontOffsetForIndex(s_font.data, 0)))
+        s_font.ok = 1;
+}
+
+int ps3_ui_have_font(void) { return s_font.ok; }
+
+typedef struct { const void* png; size_t size; int w, h; unsigned char* rgba; int tried; } UiImage;
+static UiImage s_prompt[PS3_UI_PROMPTS_N][2];
+
+void ps3_ui_set_prompt_png(int style, int button, const void* png, size_t size)
+{
+    if (style < 0 || style >= PS3_UI_PROMPTS_N || button < 0 || button > 1) return;
+    UiImage* im = &s_prompt[style][button];
+    if (im->rgba) stbi_image_free(im->rgba);
+    memset(im, 0, sizeof *im);
+    im->png = png;
+    im->size = size;
+}
+
+static const UiImage* prompt_image(int style, int button)
+{
+    UiImage* im = &s_prompt[style][button];
+    if (!im->png) return NULL;
+    if (!im->tried) {
+        int n = 0;
+        im->tried = 1;
+        im->rgba = stbi_load_from_memory((const stbi_uc*)im->png, (int)im->size, &im->w, &im->h, &n, 4);
+    }
+    return im->rgba ? im : NULL;
+}
+
+/* ---- the canvas --------------------------------------------------------- */
+
+typedef struct { uint8_t* p; int w, h, bgra; } Canvas;
+
+#define UI_RGB(r, g, b) (((uint32_t)(r) << 16) | ((uint32_t)(g) << 8) | (uint32_t)(b))
+
+static inline void px_blend(const Canvas* c, int x, int y, uint32_t rgb, int a)
+{
+    if ((unsigned)x >= (unsigned)c->w || (unsigned)y >= (unsigned)c->h || a <= 0) return;
+    if (a > 255) a = 255;
+    uint8_t* q = c->p + ((size_t)y * c->w + x) * 4;
+    int r = (int)(rgb >> 16) & 255, g = (int)(rgb >> 8) & 255, b = (int)rgb & 255;
+    if (c->bgra) { int t = r; r = b; b = t; }
+    q[0] = (uint8_t)((q[0] * (255 - a) + r * a + 127) / 255);
+    q[1] = (uint8_t)((q[1] * (255 - a) + g * a + 127) / 255);
+    q[2] = (uint8_t)((q[2] * (255 - a) + b * a + 127) / 255);
+    q[3] = 255;
+}
+
+static void fill_rect(const Canvas* c, int x0, int y0, int x1, int y1, uint32_t rgb, int a)
+{
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > c->w) x1 = c->w;
+    if (y1 > c->h) y1 = c->h;
+    for (int y = y0; y < y1; y++)
+        for (int x = x0; x < x1; x++) px_blend(c, x, y, rgb, a);
+}
+
+static float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+/* coverage of a pixel centre by a rounded rectangle (x0,y0)-(x1,y1), radius r */
+static float rrect_cov(float px, float py, float x0, float y0, float x1, float y1, float r)
+{
+    const float cx = (x0 + x1) * 0.5f, cy = (y0 + y1) * 0.5f;
+    const float hw = (x1 - x0) * 0.5f, hh = (y1 - y0) * 0.5f;
+    if (r > hw) r = hw;
+    if (r > hh) r = hh;
+    const float qx = fabsf(px - cx) - (hw - r), qy = fabsf(py - cy) - (hh - r);
+    const float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+    const float inside = (qx > qy ? qx : qy) < 0 ? (qx > qy ? qx : qy) : 0;
+    const float d = sqrtf(ox * ox + oy * oy) + inside - r;
+    return clampf(0.5f - d, 0.f, 1.f);
+}
+
+static void rrect(const Canvas* c, float x0, float y0, float x1, float y1, float r, uint32_t rgb, int a)
+{
+    const int ix0 = (int)floorf(x0), iy0 = (int)floorf(y0), ix1 = (int)ceilf(x1), iy1 = (int)ceilf(y1);
+    for (int y = iy0 < 0 ? 0 : iy0; y < iy1 && y < c->h; y++)
+        for (int x = ix0 < 0 ? 0 : ix0; x < ix1 && x < c->w; x++) {
+            const float cv = rrect_cov(x + 0.5f, y + 0.5f, x0, y0, x1, y1, r);
+            if (cv > 0) px_blend(c, x, y, rgb, (int)(a * cv + 0.5f));
+        }
+}
+
+/* an outline t wide inside the rounded rectangle */
+static void rrect_outline(const Canvas* c, float x0, float y0, float x1, float y1, float r, float t,
+                          uint32_t rgb, int a)
+{
+    const int ix0 = (int)floorf(x0), iy0 = (int)floorf(y0), ix1 = (int)ceilf(x1), iy1 = (int)ceilf(y1);
+    const float ri = r - t > 0 ? r - t : 0;
+    for (int y = iy0 < 0 ? 0 : iy0; y < iy1 && y < c->h; y++)
+        for (int x = ix0 < 0 ? 0 : ix0; x < ix1 && x < c->w; x++) {
+            const float px = x + 0.5f, py = y + 0.5f;
+            if (px > x0 + t + r && px < x1 - t - r && py > y0 + t + 1 && py < y1 - t - 1) continue;
+            const float cv = rrect_cov(px, py, x0, y0, x1, y1, r) - rrect_cov(px, py, x0 + t, y0 + t, x1 - t, y1 - t, ri);
+            if (cv > 0) px_blend(c, x, y, rgb, (int)(a * cv + 0.5f));
+        }
+}
+
+static void disc(const Canvas* c, float cx, float cy, float rad, uint32_t rgb, int a)
+{
+    rrect(c, cx - rad, cy - rad, cx + rad, cy + rad, rad, rgb, a);
+}
+
+static void ring(const Canvas* c, float cx, float cy, float rad, float t, uint32_t rgb, int a)
+{
+    for (int y = (int)(cy - rad - 1); y <= (int)(cy + rad + 1); y++)
+        for (int x = (int)(cx - rad - 1); x <= (int)(cx + rad + 1); x++) {
+            const float d = fabsf(hypotf(x + 0.5f - cx, y + 0.5f - cy) - (rad - t * 0.5f)) - t * 0.5f;
+            const float cv = clampf(0.5f - d, 0.f, 1.f);
+            if (cv > 0) px_blend(c, x, y, rgb, (int)(a * cv + 0.5f));
+        }
+}
+
+static void segment(const Canvas* c, float ax, float ay, float bx, float by, float t, uint32_t rgb, int a)
+{
+    const float minx = (ax < bx ? ax : bx) - t, maxx = (ax > bx ? ax : bx) + t;
+    const float miny = (ay < by ? ay : by) - t, maxy = (ay > by ? ay : by) + t;
+    const float dx = bx - ax, dy = by - ay, len2 = dx * dx + dy * dy;
+    for (int y = (int)miny; y <= (int)maxy; y++)
+        for (int x = (int)minx; x <= (int)maxx; x++) {
+            const float px = x + 0.5f - ax, py = y + 0.5f - ay;
+            float u = len2 > 0 ? (px * dx + py * dy) / len2 : 0;
+            u = clampf(u, 0.f, 1.f);
+            const float d = hypotf(px - u * dx, py - u * dy) - t * 0.5f;
+            const float cv = clampf(0.5f - d, 0.f, 1.f);
+            if (cv > 0) px_blend(c, x, y, rgb, (int)(a * cv + 0.5f));
+        }
+}
+
+/* an RGBA image fitted into a box, its aspect kept (bilinear), centred */
+static void draw_image_fit(const Canvas* c, const unsigned char* rgba, int iw, int ih,
+                           float bx, float by, float bw, float bh, int alpha)
+{
+    if (!rgba || iw <= 0 || ih <= 0 || bw < 1 || bh < 1) return;
+    const float sc = fminf(bw / iw, bh / ih);
+    const float dw = iw * sc, dh = ih * sc;
+    const float x0 = bx + (bw - dw) * 0.5f, y0 = by + (bh - dh) * 0.5f;
+    const int ix0 = (int)floorf(x0), iy0 = (int)floorf(y0), ix1 = (int)ceilf(x0 + dw), iy1 = (int)ceilf(y0 + dh);
+    for (int y = iy0; y < iy1; y++) {
+        if (y < 0 || y >= c->h) continue;
+        const float sy = clampf((y + 0.5f - y0) / sc - 0.5f, 0.f, (float)(ih - 1));
+        const int y_0 = (int)sy, y_1 = y_0 + 1 < ih ? y_0 + 1 : y_0;
+        const float fy = sy - y_0;
+        for (int x = ix0; x < ix1; x++) {
+            if (x < 0 || x >= c->w) continue;
+            const float sx = clampf((x + 0.5f - x0) / sc - 0.5f, 0.f, (float)(iw - 1));
+            const int x_0 = (int)sx, x_1 = x_0 + 1 < iw ? x_0 + 1 : x_0;
+            const float fx = sx - x_0;
+            const unsigned char* p00 = rgba + ((size_t)y_0 * iw + x_0) * 4;
+            const unsigned char* p01 = rgba + ((size_t)y_0 * iw + x_1) * 4;
+            const unsigned char* p10 = rgba + ((size_t)y_1 * iw + x_0) * 4;
+            const unsigned char* p11 = rgba + ((size_t)y_1 * iw + x_1) * 4;
+            float v[4];
+            for (int k = 0; k < 4; k++)
+                v[k] = (p00[k] * (1 - fx) + p01[k] * fx) * (1 - fy) + (p10[k] * (1 - fx) + p11[k] * fx) * fy;
+            /* edge pixels partly covered by the fitted rectangle */
+            const float cvx = clampf(fminf(x + 1 - x0, x0 + dw - x), 0.f, 1.f);
+            const float cvy = clampf(fminf(y + 1 - y0, y0 + dh - y), 0.f, 1.f);
+            const int a = (int)(v[3] * cvx * cvy * alpha / 255.f + 0.5f);
+            px_blend(c, x, y, UI_RGB((int)(v[0] + 0.5f), (int)(v[1] + 0.5f), (int)(v[2] + 0.5f)), a);
+        }
+    }
+}
+
+/* ---- text --------------------------------------------------------------- */
+
+typedef struct { int cp, px, w, h, xoff, yoff, used; unsigned char* bm; } Glyph;
+#define GLYPH_SLOTS 1024
+static Glyph s_glyphs[GLYPH_SLOTS];
+
+static const Glyph* glyph_get(int cp, int px)
+{
+    unsigned hsh = ((unsigned)cp * 2654435761u) ^ ((unsigned)px * 40503u);
+    for (int probe = 0; probe < 16; probe++) {
+        Glyph* g = &s_glyphs[(hsh + probe) % GLYPH_SLOTS];
+        if (g->used && g->cp == cp && g->px == px) return g;
+        if (!g->used) {
+            const float sc = stbtt_ScaleForPixelHeight(&s_font.info, (float)px);
+            g->bm = stbtt_GetCodepointBitmap(&s_font.info, 0, sc, cp, &g->w, &g->h, &g->xoff, &g->yoff);
+            g->cp = cp; g->px = px; g->used = 1;
+            return g;
+        }
+    }
+    /* the table is full around here: start again (sizes change when the window does) */
+    for (int i = 0; i < GLYPH_SLOTS; i++) {
+        if (s_glyphs[i].bm) stbtt_FreeBitmap(s_glyphs[i].bm, NULL);
+        memset(&s_glyphs[i], 0, sizeof s_glyphs[i]);
+    }
+    return glyph_get(cp, px);
+}
+
+/* the next codepoint of UTF-8 text; full-width forms read as their ASCII */
+static int utf8_next(const char** s)
+{
+    const unsigned char* p = (const unsigned char*)*s;
+    unsigned cp = *p++;
+    if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63u) << 12) | ((p[1] & 63u) << 6) | (p[2] & 63u); p += 3; }
+    else if (cp >= 0xE0 && p[0] && p[1])   { cp = ((cp & 15) << 12) | ((p[0] & 63u) << 6) | (p[1] & 63u); p += 2; }
+    else if (cp >= 0xC0 && p[0])           { cp = ((cp & 31) << 6) | (p[0] & 63u); p += 1; }
+    *s = (const char*)p;
+    if (cp == 0x3000) return ' ';
+    if (cp >= 0xFF01 && cp <= 0xFF5E) return (int)(cp - 0xFEE0);
+    return (int)cp;
+}
+
+static float text_width(const char* s, int px)
+{
+    if (!s_font.ok) return 0;
+    const float sc = stbtt_ScaleForPixelHeight(&s_font.info, (float)px);
+    float w = 0;
+    int prev = 0;
+    while (*s) {
+        const int cp = utf8_next(&s);
+        int adv, lsb;
+        stbtt_GetCodepointHMetrics(&s_font.info, cp, &adv, &lsb);
+        if (prev) w += sc * stbtt_GetCodepointKernAdvance(&s_font.info, prev, cp);
+        w += sc * adv;
+        prev = cp;
+    }
+    return w;
+}
+
+/* draws `s` with its baseline at y; returns the x after it. Text wider than
+ * maxw (when > 0) ends in an ellipsis. */
+static float draw_text(const Canvas* c, float x, float y, const char* s, int px, uint32_t rgb, int a, float maxw)
+{
+    if (!s_font.ok || !s) return x;
+    char buf[512];
+    if (maxw > 0 && text_width(s, px) > maxw) {
+        const float ell = text_width("\xE2\x80\xA6", px);
+        size_t n = 0;
+        const char* p = s;
+        float w = 0;
+        const float sc = stbtt_ScaleForPixelHeight(&s_font.info, (float)px);
+        while (*p) {
+            const char* q = p;
+            const int cp = utf8_next(&q);
+            int adv, lsb;
+            stbtt_GetCodepointHMetrics(&s_font.info, cp, &adv, &lsb);
+            if (w + sc * adv + ell > maxw || (size_t)(q - s) + 4 >= sizeof buf) break;
+            w += sc * adv;
+            p = q;
+        }
+        n = (size_t)(p - s);
+        while (n && s[n - 1] == ' ') n--;
+        memcpy(buf, s, n);
+        memcpy(buf + n, "\xE2\x80\xA6", 4);
+        s = buf;
+    }
+    const float sc = stbtt_ScaleForPixelHeight(&s_font.info, (float)px);
+    int prev = 0;
+    while (*s) {
+        const int cp = utf8_next(&s);
+        if (prev) x += sc * stbtt_GetCodepointKernAdvance(&s_font.info, prev, cp);
+        const Glyph* g = glyph_get(cp, px);
+        if (g && g->bm) {
+            const int gx = (int)floorf(x + 0.5f) + g->xoff, gy = (int)floorf(y + 0.5f) + g->yoff;
+            for (int j = 0; j < g->h; j++)
+                for (int i = 0; i < g->w; i++) {
+                    const int v = g->bm[j * g->w + i];
+                    if (v) px_blend(c, gx + i, gy + j, rgb, v * a / 255);
+                }
+        }
+        int adv, lsb;
+        stbtt_GetCodepointHMetrics(&s_font.info, cp, &adv, &lsb);
+        x += sc * adv;
+        prev = cp;
+    }
+    return x;
+}
+
+/* ---- the saves' icons --------------------------------------------------- */
+
+typedef struct { char path[512]; long long mtime, fsize; int w, h; unsigned char* rgba; unsigned last; } IconSlot;
+#define ICON_SLOTS 24
+static IconSlot s_icons[ICON_SLOTS];
+static unsigned s_icon_clock;
+
+static unsigned char* load_file(const char* path, size_t* n)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    const long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    unsigned char* b = (sz > 0 && sz < (16 << 20)) ? (unsigned char*)malloc((size_t)sz) : NULL;
+    if (b && fread(b, 1, (size_t)sz, f) != (size_t)sz) { free(b); b = NULL; }
+    fclose(f);
+    if (b) *n = (size_t)sz;
+    return b;
+}
+
+static const IconSlot* icon_get(const char* path)
+{
+    if (!path || !path[0]) return NULL;
+    struct stat st;
+    if (stat(path, &st) != 0) return NULL;
+    IconSlot* lru = &s_icons[0];
+    for (int i = 0; i < ICON_SLOTS; i++) {
+        IconSlot* s = &s_icons[i];
+        if (s->path[0] && !strcmp(s->path, path) && s->mtime == (long long)st.st_mtime && s->fsize == (long long)st.st_size) {
+            s->last = ++s_icon_clock;
+            return s->rgba ? s : NULL;
+        }
+        if (s->last < lru->last) lru = s;
+    }
+    if (lru->rgba) stbi_image_free(lru->rgba);
+    memset(lru, 0, sizeof *lru);
+    snprintf(lru->path, sizeof lru->path, "%s", path);
+    lru->mtime = (long long)st.st_mtime;
+    lru->fsize = (long long)st.st_size;
+    lru->last = ++s_icon_clock;
+    size_t n = 0;
+    unsigned char* b = load_file(path, &n);
+    if (b) {
+        int comp = 0;
+        lru->rgba = stbi_load_from_memory(b, (int)n, &lru->w, &lru->h, &comp, 4);
+        free(b);
+    }
+    return lru->rgba ? lru : NULL;
+}
+
+static struct { uint32_t gen; int w, h; unsigned char* rgba; } s_new_icon;
+
+static const unsigned char* new_icon(int* w, int* h)
+{
+    const ps3_osd_new_icon_state* ni = &g_ps3_osd_new_icon;
+    const uint32_t gen = __atomic_load_n(&ni->gen, __ATOMIC_ACQUIRE);
+    if (gen != s_new_icon.gen) {
+        if (s_new_icon.rgba) stbi_image_free(s_new_icon.rgba);
+        s_new_icon.rgba = NULL;
+        s_new_icon.gen = gen;
+        if (ni->size && ni->size <= PS3_OSD_NEW_ICON_MAX) {
+            int comp = 0;
+            s_new_icon.rgba = stbi_load_from_memory(ni->png, (int)ni->size, &s_new_icon.w, &s_new_icon.h, &comp, 4);
+        }
+    }
+    *w = s_new_icon.w; *h = s_new_icon.h;
+    return s_new_icon.rgba;
+}
+
+/* ---- the pieces of the screen ------------------------------------------- */
+
+/* colours */
+#define C_BG_TOP   UI_RGB(22, 23, 28)
+#define C_BG_BOT   UI_RGB(9, 9, 12)
+#define C_ROW      UI_RGB(38, 39, 45)
+#define C_ROW_SEL  UI_RGB(58, 72, 102)
+#define C_SEL_EDGE UI_RGB(214, 226, 255)
+#define C_TEXT     UI_RGB(240, 240, 242)
+#define C_TEXT_DIM UI_RGB(176, 178, 186)
+#define C_SEP      UI_RGB(255, 255, 255)
+#define C_TILE     UI_RGB(24, 25, 30)
+
+/* a prompt's button: size is the glyph's height; returns its width */
+static float draw_button(const Canvas* c, int style, int button, float x, float cy, float size)
+{
+    const UiImage* im = prompt_image(style, button);
+    if (im) {
+        const float w = size * im->w / (float)im->h;
+        draw_image_fit(c, im->rgba, im->w, im->h, x, cy - size * 0.5f, w, size, 255);
+        return w;
+    }
+    const float r = size * 0.5f, cx = x + r;
+    switch (style) {
+    case PS3_UI_PROMPTS_PLAYSTATION:
+        disc(c, cx, cy, r, UI_RGB(236, 236, 238), 255);
+        if (button == 0) {
+            const float k = r * 0.42f;
+            segment(c, cx - k, cy - k, cx + k, cy + k, size * 0.11f, UI_RGB(58, 110, 205), 255);
+            segment(c, cx - k, cy + k, cx + k, cy - k, size * 0.11f, UI_RGB(58, 110, 205), 255);
+        } else {
+            ring(c, cx, cy, r * 0.52f, size * 0.1f, UI_RGB(214, 64, 58), 255);
+        }
+        return size;
+    case PS3_UI_PROMPTS_XBOX:
+    case PS3_UI_PROMPTS_SWITCH: {
+        /* the button that does it, by its label on that pad: Xbox A/B; on a
+         * Switch pad the confirm (bottom) button is B and back (right) is A */
+        const char* l = style == PS3_UI_PROMPTS_XBOX ? (button == 0 ? "A" : "B") : (button == 0 ? "B" : "A");
+        const uint32_t col = style == PS3_UI_PROMPTS_SWITCH ? UI_RGB(60, 60, 66)
+                             : button == 0 ? UI_RGB(46, 150, 68) : UI_RGB(200, 54, 46);
+        disc(c, cx, cy, r, col, 255);
+        const int px = (int)(size * 0.62f);
+        draw_text(c, cx - text_width(l, px) * 0.5f, cy + px * 0.36f, l, px, UI_RGB(255, 255, 255), 255, 0);
+        return size;
+    }
+    default: {   /* a key */
+        const char* l = button == 0 ? "Enter" : "Esc";
+        const int px = (int)(size * 0.5f);
+        const float w = text_width(l, px) + size * 0.6f;
+        rrect(c, x, cy - r, x + w, cy + r, size * 0.18f, UI_RGB(232, 232, 236), 255);
+        rrect_outline(c, x, cy - r, x + w, cy + r, size * 0.18f, size * 0.06f, UI_RGB(150, 150, 160), 255);
+        draw_text(c, x + size * 0.3f, cy + px * 0.36f, l, px, UI_RGB(30, 30, 34), 255, 0);
+        return w;
+    }
+    }
+}
+
+/* the prompts, right-aligned to `right`, centred on cy; returns their left edge */
+static float draw_prompts(const Canvas* c, const ps3_osd_saves_state* S, int with_ok, float right, float cy, float s)
+{
+    const int px = (int)(20 * s);
+    const float bsz = 30 * s, gap = 10 * s, between = 34 * s;
+    float w = 0;
+    /* measure: [button] label  [button] label */
+    for (int b = with_ok ? 0 : 1; b < 2; b++) {
+        const char* l = b == 0 ? S->ok_label : S->back_label;
+        float bw = bsz;
+        const UiImage* im = prompt_image((int)S->prompts, b);
+        if (im) bw = bsz * im->w / (float)im->h;
+        else if (S->prompts == PS3_UI_PROMPTS_KEYBOARD)
+            bw = text_width(b == 0 ? "Enter" : "Esc", (int)(bsz * 0.5f)) + bsz * 0.6f;
+        w += bw + gap + text_width(l, px) + (b == 0 ? between : 0);
+    }
+    float x = right - w;
+    const float left = x;
+    for (int b = with_ok ? 0 : 1; b < 2; b++) {
+        x += draw_button(c, (int)S->prompts, b, x, cy, bsz) + gap;
+        x = draw_text(c, x, cy + px * 0.36f, b == 0 ? S->ok_label : S->back_label, px, C_TEXT, 255, 0);
+        x += b == 0 ? between : 0;
+    }
+    return left;
+}
+
+/* a generic tile where a save has no icon (or the title gave none for a new save) */
+static void draw_tile(const Canvas* c, float x, float y, float w, float h, float s, int plus)
+{
+    rrect(c, x, y, x + w, y + h, 4 * s, C_TILE, 255);
+    rrect_outline(c, x, y, x + w, y + h, 4 * s, fmaxf(1.f, s), UI_RGB(90, 92, 102), 255);
+    const float cx = x + w * 0.5f, cy = y + h * 0.5f, k = h * 0.22f, t = fmaxf(2.f, 5 * s);
+    if (plus) {
+        segment(c, cx - k, cy, cx + k, cy, t, UI_RGB(170, 172, 182), 255);
+        segment(c, cx, cy - k, cx, cy + k, t, UI_RGB(170, 172, 182), 255);
+    } else {   /* a plain save-data card */
+        rrect_outline(c, cx - k * 1.1f, cy - k, cx + k * 1.1f, cy + k, 3 * s, t * 0.6f, UI_RGB(130, 132, 142), 255);
+        segment(c, cx - k * 0.6f, cy - k * 0.35f, cx + k * 0.6f, cy - k * 0.35f, t * 0.6f, UI_RGB(130, 132, 142), 255);
+        segment(c, cx - k * 0.6f, cy + k * 0.15f, cx + k * 0.3f, cy + k * 0.15f, t * 0.6f, UI_RGB(130, 132, 142), 255);
+    }
+}
+
+/* one save's row content (the panel drawn by the caller): its icon and its text */
+static void draw_entry(const Canvas* c, const ps3_osd_save_entry* e, float x, float y, float w, float h, float s, int sel)
+{
+    const float tw = 256 * s, th = 141 * s;
+    const float ix = x + 18 * s, iy = y + (h - th) * 0.5f;
+    const IconSlot* ic = e->is_new ? NULL : icon_get(e->icon);
+    int nw = 0, nh = 0;
+    const unsigned char* nrgba = e->is_new ? new_icon(&nw, &nh) : NULL;
+    if (ic) {
+        fill_rect(c, (int)ix, (int)iy, (int)(ix + tw), (int)(iy + th), UI_RGB(0, 0, 0), 255);
+        draw_image_fit(c, ic->rgba, ic->w, ic->h, ix, iy, tw, th, 255);
+    } else if (nrgba) {
+        fill_rect(c, (int)ix, (int)iy, (int)(ix + tw), (int)(iy + th), UI_RGB(0, 0, 0), 255);
+        draw_image_fit(c, nrgba, nw, nh, ix, iy, tw, th, 255);
+    } else {
+        draw_tile(c, ix, iy, tw, th, s, e->is_new);
+    }
+    rrect_outline(c, ix - 1, iy - 1, ix + tw + 1, iy + th + 1, 2 * s, fmaxf(1.f, s), sel ? C_SEL_EDGE : UI_RGB(70, 72, 80),
+                  sel ? 200 : 255);
+    const float tx = ix + tw + 28 * s, maxw = x + w - tx - 20 * s;
+    const uint32_t fg = C_TEXT, dim = C_TEXT_DIM;
+    if (e->is_new) {
+        draw_text(c, tx, y + h * 0.5f + 9 * s, e->title, (int)(26 * s), fg, 255, maxw);
+        return;
+    }
+    float by = y + 38 * s;
+    draw_text(c, tx, by, e->title, (int)(23 * s), fg, 255, maxw);
+    by += 26 * s;
+    char meta[96];
+    snprintf(meta, sizeof meta, "%s%s%s", e->date, e->date[0] && e->size[0] ? "     " : "", e->size);
+    draw_text(c, tx, by, meta, (int)(17 * s), dim, 255, maxw);
+    by += 31 * s;
+    for (int i = 0; i < PS3_OSD_SAVES_LINES && by < y + h - 6 * s; i++) {
+        if (!e->lines[i][0]) continue;
+        draw_text(c, tx, by, e->lines[i], (int)(19 * s), fg, 235, maxw);
+        by += 24 * s;
+    }
+}
+
+long ps3_osd_saves_clock(void)
+{
+    return (long)(time(NULL) / 60);
+}
+
+/* the first row shown: kept across posts so the list scrolls only as far as the
+ * selection needs; back to the top when a screen closes */
+static int s_top;
+
+void ps3_osd_saves_reset(void) { s_top = 0; }
+
+int ps3_osd_saves_compose(const ps3_osd_saves_state* S, uint8_t* img, uint32_t W, uint32_t H, int bgra)
+{
+    if (!s_font.ok || !img || W < 64 || H < 64) return 0;
+    const Canvas cv = { img, (int)W, (int)H, bgra };
+    const Canvas* c = &cv;
+    const float s = fminf(H / 720.f, W / 1280.f * 1.25f);   /* a narrow window scales by its width */
+
+    /* the background: a dark vertical gradient over the whole window */
+    for (uint32_t y = 0; y < H; y++) {
+        const float t = (float)y / (float)(H - 1);
+        const int r = (int)(22 + (9 - 22) * t), g = (int)(23 + (9 - 23) * t), b = (int)(28 + (12 - 28) * t);
+        uint8_t* q = img + (size_t)y * W * 4;
+        for (uint32_t x = 0; x < W; x++, q += 4) {
+            q[0] = (uint8_t)(bgra ? b : r); q[1] = (uint8_t)g; q[2] = (uint8_t)(bgra ? r : b); q[3] = 255;
+        }
+    }
+
+    const float mx = 72 * s;
+    /* the heading and the clock */
+    draw_text(c, mx, 78 * s, S->heading, (int)(36 * s), C_TEXT, 255, W - 2 * mx - 260 * s);
+    {
+        char clk[48];
+        const time_t now = time(NULL);
+        const struct tm* lt = localtime(&now);
+        clk[0] = 0;
+        if (lt) strftime(clk, sizeof clk, "%m/%d/%Y  %H:%M", lt);
+        const int px = (int)(20 * s);
+        draw_text(c, W - mx - text_width(clk, px), 74 * s, clk, px, C_TEXT_DIM, 255, 0);
+    }
+    fill_rect(c, (int)mx, (int)(102 * s), (int)(W - mx), (int)(102 * s) + (int)fmaxf(1.f, s), C_SEP, 70);
+
+    /* the rows */
+    const float top = 118 * s, bottom = H - 76 * s, rh = 172 * s;
+    const int n = (int)S->n;
+    int vis = (int)((bottom - top) / rh);
+    if (vis < 1) vis = 1;
+    const int cur = n ? ((int)S->cur < n ? (int)S->cur : n - 1) : 0;
+    if (cur < s_top) s_top = cur;
+    if (cur >= s_top + vis) s_top = cur - vis + 1;
+    if (s_top > n - vis) s_top = n - vis > 0 ? n - vis : 0;
+    if (s_top < 0) s_top = 0;
+    const float scroll_w = n > vis ? 16 * s : 0;
+    const float rx0 = mx, rx1 = W - mx - scroll_w;
+    if (!n) {
+        const int px = (int)(24 * s);
+        const char* msg = S->empty[0] ? S->empty : "There is no saved data.";
+        draw_text(c, (W - text_width(msg, px)) * 0.5f, (top + bottom) * 0.5f, msg, px, C_TEXT_DIM, 255, W - 2 * mx);
+    }
+    for (int i = s_top; i < n && i < s_top + vis; i++) {
+        const float y = top + (i - s_top) * rh;
+        const int sel = i == cur && !S->confirm;
+        if (sel) {
+            rrect(c, rx0 - 3 * s, y + 1 * s, rx1 + 3 * s, y + rh - 1 * s, 9 * s, C_SEL_EDGE, 34);   /* the glow */
+            rrect(c, rx0, y + 4 * s, rx1, y + rh - 4 * s, 7 * s, C_ROW_SEL, 255);
+            rrect_outline(c, rx0, y + 4 * s, rx1, y + rh - 4 * s, 7 * s, fmaxf(1.5f, 2 * s), C_SEL_EDGE, 235);
+        } else {
+            rrect(c, rx0, y + 4 * s, rx1, y + rh - 4 * s, 7 * s, C_ROW, 255);
+        }
+        draw_entry(c, &S->e[i], rx0, y + 4 * s, rx1 - rx0, rh - 8 * s, s, sel);
+        if (i + 1 < n && i + 1 < s_top + vis)   /* a thin separator between rows */
+            fill_rect(c, (int)(rx0 + 12 * s), (int)(y + rh), (int)(rx1 - 12 * s), (int)(y + rh) + (int)fmaxf(1.f, s * 0.75f),
+                      C_SEP, 55);
+    }
+    if (n > vis) {   /* the scroll bar */
+        const float bx = W - mx - 5 * s, by0 = top + 4 * s, by1 = top + vis * rh - 4 * s;
+        rrect(c, bx, by0, bx + 4 * s, by1, 2 * s, C_SEP, 40);
+        const float tl = (by1 - by0) * vis / n, ty = by0 + (by1 - by0 - tl) * s_top / (float)(n - vis);
+        rrect(c, bx, ty, bx + 4 * s, ty + tl, 2 * s, C_SEP, 170);
+    }
+
+    /* the bottom bar */
+    fill_rect(c, (int)mx, (int)(H - 64 * s), (int)(W - mx), (int)(H - 64 * s) + (int)fmaxf(1.f, s), C_SEP, 70);
+    if (!S->confirm)
+        draw_prompts(c, S, n > 0, W - mx, H - 32 * s, s);
+
+    /* the overwrite question: the list dimmed, a box with the save it would replace */
+    if (S->confirm && n) {
+        fill_rect(c, 0, 0, (int)W, (int)H, UI_RGB(0, 0, 0), 150);
+        const float bw = fminf(W - 2 * mx, 940 * s), bh = 330 * s;
+        const float bx = (W - bw) * 0.5f, by = (H - bh) * 0.5f;
+        rrect(c, bx, by, bx + bw, by + bh, 10 * s, UI_RGB(30, 31, 37), 255);
+        rrect_outline(c, bx, by, bx + bw, by + bh, 10 * s, fmaxf(1.f, 1.5f * s), UI_RGB(140, 150, 175), 255);
+        const char* q = S->question[0] ? S->question : "Overwrite this save data?";
+        draw_text(c, bx + 32 * s, by + 52 * s, q, (int)(25 * s), C_TEXT, 255, bw - 64 * s);
+        rrect(c, bx + 24 * s, by + 72 * s, bx + bw - 24 * s, by + 72 * s + 172 * s, 7 * s, C_ROW, 255);
+        draw_entry(c, &S->e[cur], bx + 24 * s, by + 72 * s, bw - 48 * s, 172 * s, s, 0);
+        draw_prompts(c, S, 1, bx + bw - 32 * s, by + bh - 36 * s, s);
+    }
+    return 1;
+}
