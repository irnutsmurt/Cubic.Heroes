+
+/* Keys a host dialog reads beside the pad: Esc and Backspace go back (Circle).
+ * The window does not quit on Esc while a dialog is open (rsx_vulkan_backend.c). */
+u32 cellPad_ui_keys(void)
+{
+#if PAD_BACKEND_SDL2
+    if (!SDL_WasInit(SDL_INIT_VIDEO) || !SDL_GetKeyboardFocus()) return 0;
+    int n = 0;
+    const Uint8* ks = SDL_GetKeyboardState(&n);
+    if (ks && ((SDL_SCANCODE_ESCAPE < n && ks[SDL_SCANCODE_ESCAPE]) || (SDL_SCANCODE_BACKSPACE < n && ks[SDL_SCANCODE_BACKSPACE]))) {
+        s_ui_device = 0;
+        return CELL_PAD_CTRL_CIRCLE;
+    }
+#elif defined(_WIN32)
+    if (!pad_host_window_focused()) return 0;
+    if ((GetAsyncKeyState(VK_ESCAPE) & 0x8000) || (GetAsyncKeyState(VK_BACK) & 0x8000)) {
+        s_ui_device = 0;
+        return CELL_PAD_CTRL_CIRCLE;
+    }
+#endif
+    return 0;
+}
