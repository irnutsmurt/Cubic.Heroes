+/* UTF-8 for the full-screen picture: full-width forms as their ASCII, case kept,
+ * and a label's colon ("NAME:", "TIME：") spaced as " : ". Other characters are
+ * kept; the font draws what it has. */
+static void ui_fold(const char* in, char* out, size_t cap)
+{
+    size_t o = 0;
+    int label = 1, spaced = 0;   /* still in the leading capitals; a colon spaced already */
+    const unsigned char* p = (const unsigned char*)in;
+    while (*p && o + 8 < cap) {
+        unsigned cp = *p++;
+        if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63u) << 12) | ((p[1] & 63u) << 6) | (p[2] & 63u); p += 3; }
+        else if (cp >= 0xE0 && p[0] && p[1])   { cp = ((cp & 15) << 12) | ((p[0] & 63u) << 6) | (p[1] & 63u); p += 2; }
+        else if (cp >= 0xC0 && p[0])           { cp = ((cp & 31) << 6) | (p[0] & 63u); p += 1; }
+        if (cp == 0x3000) cp = ' ';
+        else if (cp >= 0xFF01 && cp <= 0xFF5E) cp -= 0xFEE0;
+        if (cp == '\r' || cp == '\n' || cp < 32) continue;
+        if (cp == ':' && label && !spaced && o) {
+            while (o && out[o - 1] == ' ') o--;
+            memcpy(out + o, " : ", 3); o += 3;
+            spaced = 1;
+            while (*p == ' ') p++;
+            continue;
+        }
+        if (!((cp >= 'A' && cp <= 'Z') || cp == ' ' || cp == '_')) label = 0;
+        if (cp < 0x80) out[o++] = (char)cp;
+        else if (cp < 0x800) { out[o++] = (char)(0xC0 | (cp >> 6)); out[o++] = (char)(0x80 | (cp & 63)); }
+        else if (cp < 0x10000) { out[o++] = (char)(0xE0 | (cp >> 12)); out[o++] = (char)(0x80 | ((cp >> 6) & 63)); out[o++] = (char)(0x80 | (cp & 63)); }
+        else { out[o++] = (char)(0xF0 | (cp >> 18)); out[o++] = (char)(0x80 | ((cp >> 12) & 63)); out[o++] = (char)(0x80 | ((cp >> 6) & 63)); out[o++] = (char)(0x80 | (cp & 63)); }
+    }
+    if (*p && o + 4 <= cap) { memcpy(out + o, "\xE2\x80\xA6", 3); o += 3; }   /* cut short: an ellipsis */
+    out[o] = 0;
+}
+
+/* a save directory's size as the PS3 shows it: every file, in kilobytes of 1000 bytes, rounded up */
+static void ui_dir_size(const char* dir, char* out, size_t cap)
+{
+    unsigned long long total = 0;
+#ifdef _WIN32
+    char search[1100];
+    snprintf(search, sizeof search, "%s\\*", dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h != INVALID_HANDLE_VALUE) {
+        do {
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+                total += ((unsigned long long)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+        } while (FindNextFileA(h, &fd));
+        FindClose(h);
+    }
+#else
+    DIR* dp = opendir(dir);
+    if (dp) {
+        struct dirent* de;
+        while ((de = readdir(dp)) != NULL) {
+            char full[1100];
+            struct stat st;
+            snprintf(full, sizeof full, "%s/%s", dir, de->d_name);
+            if (de->d_name[0] != '.' && stat(full, &st) == 0 && S_ISREG(st.st_mode)) total += (unsigned long long)st.st_size;
+        }
+        closedir(dp);
+    }
+#endif
+    if (!total) { out[0] = 0; return; }
+    snprintf(out, cap, "%llu KB", (total + 999) / 1000);
+}
