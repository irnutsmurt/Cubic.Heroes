diff --git a/include/ps3emu/osd.h b/include/ps3emu/osd.h
index 6a248b9..45a9090 100644
--- a/include/ps3emu/osd.h
+++ b/include/ps3emu/osd.h
@@ -12,6 +12,7 @@
 #ifndef PS3EMU_OSD_H
 #define PS3EMU_OSD_H
 
+#include <stddef.h>
 #include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
@@ -279,6 +280,106 @@ static inline int ps3_osd_list_read(ps3_osd_list_state* out)
     return __atomic_load_n(&s->seq, __ATOMIC_ACQUIRE) == a && out->open;
 }
 
+/* The save-data screen: the same dialog (cellSaveData.c) drawn as a full-screen
+ * picture in place of the panel above -- a heading, the saves as rows with their
+ * ICON0.PNG, title, date and size and DETAIL lines, the selection, the overwrite
+ * question, and the confirm and back prompts in the player's prompt style. It is
+ * composed on the CPU at the window's size by libs/video/osd_saves.c, which needs
+ * a font the title registers (ps3_ui_set_font); without one the panel above is
+ * drawn. The dialog posts both; a backend draws one and stores its revision in
+ * `drawn`. Text is UTF-8. */
+#define PS3_OSD_SAVES_MAX   64
+#define PS3_OSD_SAVES_LINES 4
+
+typedef struct {
+    char     title[64];                       /* SUB_TITLE, else TITLE */
+    char     date[40], size[16];              /* when it was written, its size ("281 KB") */
+    char     lines[PS3_OSD_SAVES_LINES][96];  /* DETAIL's lines */
+    char     icon[512];                       /* its ICON0.PNG, or "" */
+    uint32_t is_new;                          /* the title's new-save row */
+} ps3_osd_save_entry;
+
+enum { PS3_UI_PROMPTS_KEYBOARD = 0, PS3_UI_PROMPTS_PLAYSTATION, PS3_UI_PROMPTS_XBOX, PS3_UI_PROMPTS_SWITCH,
+       PS3_UI_PROMPTS_N };
+
+typedef struct {
+    uint32_t seq;                             /* odd while a post is being written */
+    uint32_t open, rev, drawn;
+    uint32_t n, cur;                          /* the rows and the selected one */
+    uint32_t confirm;                         /* 1: the overwrite question, about row `cur` */
+    uint32_t prompts;                         /* PS3_UI_PROMPTS_* */
+    char     heading[64];                     /* "Load Save", "Save Game"... */
+    char     empty[96];                       /* shown when there are no rows */
+    char     question[96];                    /* the overwrite question */
+    char     ok_label[24], back_label[24];    /* the prompts' words */
+    ps3_osd_save_entry e[PS3_OSD_SAVES_MAX];
+} ps3_osd_saves_state;
+
+PS3_OSD_SHARED ps3_osd_saves_state g_ps3_osd_saves = { 0 };
+
+/* The title's icon for its new-save row (a PNG, from the title's own memory),
+ * set before the screen opens and unchanged while it is open. */
+#define PS3_OSD_NEW_ICON_MAX (256 * 1024)
+typedef struct { uint32_t size, gen; uint8_t png[PS3_OSD_NEW_ICON_MAX]; } ps3_osd_new_icon_state;
+PS3_OSD_SHARED ps3_osd_new_icon_state g_ps3_osd_new_icon = { 0 };
+
+/* Post or replace the screen (copied); returns its revision. */
+static inline uint32_t ps3_osd_saves_post(const ps3_osd_saves_state* in)
+{
+    ps3_osd_saves_state* s = &g_ps3_osd_saves;
+    const uint32_t seq = __atomic_add_fetch(&s->seq, 1, __ATOMIC_ACQ_REL);   /* odd: being written */
+    /* everything from `n` on; seq, open, rev and drawn are this function's and the backend's */
+    memcpy(&s->n, &in->n, sizeof *s - offsetof(ps3_osd_saves_state, n));
+    if (s->n > PS3_OSD_SAVES_MAX) s->n = PS3_OSD_SAVES_MAX;
+    s->open = 1;
+    const uint32_t rev = ++s->rev;
+    __atomic_store_n(&s->seq, seq + 1, __ATOMIC_RELEASE);
+    return rev;
+}
+
+static inline void ps3_osd_saves_close(void)
+{
+    ps3_osd_saves_state* s = &g_ps3_osd_saves;
+    __atomic_add_fetch(&s->seq, 1, __ATOMIC_ACQ_REL);
+    s->open = 0;
+    s->rev++;
+    __atomic_add_fetch(&s->seq, 1, __ATOMIC_RELEASE);
+}
+
+/* The screen as a consistent copy; 0 when closed or being written. */
+static inline int ps3_osd_saves_read(ps3_osd_saves_state* out)
+{
+    const ps3_osd_saves_state* s = &g_ps3_osd_saves;
+    const uint32_t a = __atomic_load_n(&s->seq, __ATOMIC_ACQUIRE);
+    if (a & 1) return 0;
+    memcpy(out, s, sizeof *out);
+    return __atomic_load_n(&s->seq, __ATOMIC_ACQUIRE) == a && out->open;
+}
+
+/* libs/video/osd_saves.c. The font and the prompt images are the title's
+ * (redistributable; nothing of the PS3's): kept by the caller, not copied.
+ * button: 0 confirm, 1 back. */
+void ps3_ui_set_font(const void* ttf, size_t size);
+void ps3_ui_set_prompt_png(int style, int button, const void* png, size_t size);
+int  ps3_ui_have_font(void);
+/* Compose the screen at w x h (4 bytes a pixel; BGRA when bgra, else RGBA).
+ * 1 when composed, 0 when it cannot be (no font). */
+int  ps3_osd_saves_compose(const ps3_osd_saves_state* s, uint8_t* img, uint32_t w, uint32_t h, int bgra);
+/* The minute the screen's clock shows (it is recomposed when this changes). */
+long ps3_osd_saves_clock(void);
+/* A screen closed: the next one starts at its first rows. */
+void ps3_osd_saves_reset(void);
+
+/* Window presents, for a host dialog. The overlays above are drawn in the
+ * window's presents, and those follow the guest's flips: a title that calls
+ * the save dialog from its render thread (3D Dot Game Heroes' in-game SAVE)
+ * flips nothing until the dialog returns, so nothing would draw it. The
+ * backend counts its presents here and sets present_again (the last frame
+ * presented once more, with the overlays); the dialog calls it while the
+ * count stands still. */
+PS3_OSD_SHARED volatile uint32_t g_ps3_osd_presents = 0;
+PS3_OSD_SHARED int (*g_ps3_osd_present_again)(void) = 0;
+
 #ifdef __cplusplus
 }
 #endif
