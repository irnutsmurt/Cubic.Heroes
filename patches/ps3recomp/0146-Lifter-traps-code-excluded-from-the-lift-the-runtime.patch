diff --git a/tools/test_ppu_traps.py b/tools/test_ppu_traps.py
new file mode 100644
index 0000000..0594443
--- /dev/null
+++ b/tools/test_ppu_traps.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""--traps end to end: code excluded from the lift is not in the output, and every way of reaching it is stopped.
+
+A made-up PPU program (assembled here; no game) -- entries that call two excluded functions directly, through
+CTR, through a function pointer in guest memory, by a tail call, into the middle of one, and by running off
+their end into one; and a normal call that must still work -- is lifted with --traps naming the excluded range,
+then:
+  1. the source: neither excluded body is there (their constants absent), each is a call of ppu_trap, the range
+     is registered, the normal function's body is there;
+  2. the lifter refuses what would attach to excluded code or cut a function: an entry hook inside the range,
+     a function that runs into it;
+  3. built against the real runtime/ppu/ppu_loader.cpp (runtime/ppu/tests/test_ppu_traps.cpp) and run once per
+     scenario: each excluded path ends the run with the trap's report naming the address reached, and the
+     normal call returns 42.
+
+  python tools/test_ppu_traps.py        (CXX: the C++ compiler, default c++; e.g. "zig c++ -target x86_64-windows-gnu")
+"""
+import json
+import os
+import re
+import shlex
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+BASE, END = 0x10000, 0x20200
+X1, X2 = 0x20000, 0x20100   # the excluded functions
+WHAT = "TEST excluded"
+
+
+def li(rd, imm): return 0x38000000 | rd << 21 | (imm & 0xFFFF)
+def lis(rd, imm): return 0x3C000000 | rd << 21 | (imm & 0xFFFF)
+def ori(ra, rs, imm): return 0x60000000 | rs << 21 | ra << 16 | (imm & 0xFFFF)
+def mtctr(rs): return 0x7C0903A6 | rs << 21
+def lwz(rd, d, ra): return 0x80000000 | rd << 21 | ra << 16 | (d & 0xFFFF)
+BCTRL, BLR = 0x4E800421, 0x4E800020
+def bl(pc, t): return 0x48000001 | ((t - pc) & 0x03FFFFFC)
+def b(pc, t): return 0x48000000 | ((t - pc) & 0x03FFFFFC)
+
+
+def program():
+    """{start: [words]} and the function list"""
+    f = {
+        0x10000: [bl(0x10000, X1), BLR],                                      # direct
+        0x10010: [lis(12, 2), ori(12, 12, 0x0100), mtctr(12), BCTRL, BLR],    # ctr -> X2
+        0x10030: [lwz(12, 0, 3), mtctr(12), BCTRL, BLR],                      # pointer: [r3] = X1
+        0x10050: [b(0x10050, X1)],                                            # tail
+        0x10060: [lis(12, 2), ori(12, 12, 0x0108), mtctr(12), BCTRL, BLR],   # middle of X2
+        0x100A0: [bl(0x100A0, 0x100C0), BLR],                                 # normal
+        0x100C0: [li(3, 42), BLR],
+        0x1FFF8: [li(3, 5), li(4, 6)],                                        # runs off its end into X1
+        X1: [li(3, 0x777), BLR],
+        X2: [li(3, 0x778), li(4, 0x779), li(5, 0x77A), BLR],
+    }
+    blob = bytearray(END - BASE)
+    for start, words in f.items():
+        for k, w in enumerate(words):
+            struct.pack_into(">I", blob, start - BASE + 4 * k, w)
+    funcs = [{"start": hex(s), "end": hex(s + 4 * len(w))} for s, w in sorted(f.items())]
+    return bytes(blob), funcs
+
+
+def lift(tmp, funcs, extra=()):
+    blob, _ = program()
+    (tmp / "prog.bin").write_bytes(blob)
+    (tmp / "funcs.json").write_text(json.dumps(funcs))
+    (tmp / "traps.json").write_text(json.dumps({"traps": [{"lo": hex(X1), "hi": hex(END), "what": WHAT}]}))
+    out = tmp / "out"
+    r = subprocess.run([sys.executable, str(ROOT / "tools/ppu_lifter.py"), str(tmp / "prog.bin"), "--raw",
+                        "--base", hex(BASE), "--functions", str(tmp / "funcs.json"), "--traps", str(tmp / "traps.json"),
+                        "--output", str(out), "--single-file", "--source-name", "ppu_recomp.cpp", *extra],
+                       capture_output=True, text=True)
+    return r, out
+
+
+def main():
+    fails = []
+
+    def check(ok, what):
+        print(("PASS: " if ok else "FAIL: ") + what)
+        if not ok:
+            fails.append(what)
+
+    with tempfile.TemporaryDirectory(prefix="ppu-traps-") as tmp:
+        tmp = Path(tmp)
+        _, funcs = program()
+        r, out = lift(tmp, funcs)
+        if r.returncode:
+            sys.stderr.write(r.stdout[-2000:] + r.stderr[-2000:])
+            raise SystemExit("FAIL: the lift")
+        src = (out / "ppu_recomp.cpp").read_text()
+        body = lambda a: re.search(r"void func_%08X\(ppu_context\* ctx\) \{(.*?)\n\}" % a, src, re.S)
+        for a, consts in ((X1, ("0x777", "1911")), (X2, ("0x778", "0x779", "0x77A", "1912", "1913", "1914"))):
+            m = body(a)
+            check(m is not None and f'ppu_trap(0x{a:08X}u, "{WHAT}", ctx);' in m.group(1)
+                  and m.group(1).count(";") == 1, f"func_{a:08X} is only its trap")
+            check(not any(re.search(r"\b%s\b" % c, src) for c in consts), f"nothing of func_{a:08X}'s body in the source")
+        check(f'{{ 0x{X1:08X}u, 0x{END:08X}u, "{WHAT}" }}' in src and "ppu_trap_ranges_register(" in src,
+              "the excluded range is registered")
+        m = body(0x100C0)
+        check(m is not None and "(0x2A)" in m.group(1), "the normal function is lifted (li r3,42 there)")
+        check("traps: 1 excluded range(s), 2 function(s) lifted as traps" in r.stdout, "the lift reports the traps")
+
+        # 2. refusals
+        (tmp / "hooks.json").write_text(json.dumps({"entry_hooks": [{"addr": hex(X1), "host": "h", "guard": "g"}]}))
+        r2, _ = lift(tmp / "", funcs, ("--insn-patches", str(tmp / "hooks.json")))
+        check(r2.returncode != 0 and "entry hook in excluded code" in (r2.stdout + r2.stderr),
+              "an entry hook in the excluded range is refused")
+        bad = [dict(e) for e in funcs]
+        for e in bad:
+            if int(e["start"], 16) == 0x1FFF8:
+                e["end"] = hex(X1 + 8)   # a function that runs into the range
+        r3, _ = lift(tmp, bad)
+        check(r3.returncode != 0 and "runs into the excluded range" in (r3.stdout + r3.stderr),
+              "a function that runs into the excluded range is refused")
+
+        # 3. built against the real dispatcher, each scenario run
+        r, out = lift(tmp, funcs)   # the good lift again (the refused ones may have left files)
+        cxx = shlex.split(os.environ.get("CXX", "c++"))
+        exe = tmp / ("test_ppu_traps" + (".exe" if os.name == "nt" else ""))
+        flags = ["-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections"] + ([] if os.name == "nt" else ["-pthread", "-ldl"])
+        strict = tmp / "ps3_strict.o"   # C: compiled on its own
+        b_ = subprocess.run([*cxx, "-x", "c", "-O1", "-w", "-I" + str(ROOT / "include"), "-c",
+                             str(ROOT / "runtime/platform/ps3_strict.c"), "-o", str(strict)],
+                            capture_output=True, text=True)
+        cmd = [*cxx, "-std=c++17", "-O1", "-w", "-I" + str(out), "-I" + str(ROOT / "include"),
+               "-I" + str(ROOT / "runtime/platform"), "-I" + str(ROOT / "runtime/ppu"),
+               str(out / "ppu_recomp.cpp"), str(ROOT / "runtime/ppu/ppu_loader.cpp"),
+               str(ROOT / "runtime/ppu/tests/test_ppu_traps.cpp"), str(strict), *flags, "-o", str(exe)]
+        if not b_.returncode:
+            b_ = subprocess.run(cmd, capture_output=True, text=True)
+        if b_.returncode:
+            sys.stderr.write(b_.stdout[-3000:] + b_.stderr[-6000:])
+            raise SystemExit("FAIL: the test program did not build")
+        env = {k: v for k, v in os.environ.items() if not k.startswith(("PPU_", "PS3_", "PS3RECOMP_", "SPU_"))}
+        for scen, addr in (("direct", X1), ("ctr", X2), ("pointer", X1), ("tail", X1), ("middle", X2 + 8),
+                           ("fallthrough", X1)):
+            p = subprocess.run([str(exe), scen], env=env, capture_output=True, text=True, timeout=60)
+            want = f"TRAP: excluded code reached at 0x{addr:08X} ({WHAT}"
+            ok = p.returncode != 0 and want in p.stderr and "NO TRAP" not in p.stdout and "returned" not in p.stdout
+            check(ok, f"{scen}: the run ends at the trap for 0x{addr:08X}")
+            if not ok:
+                sys.stderr.write(p.stdout[-800:] + p.stderr[-1500:])
+        p = subprocess.run([str(exe), "normal"], env=env, capture_output=True, text=True, timeout=60)
+        check(p.returncode == 0 and "r3=42" in p.stdout and "TRAP" not in p.stderr, "normal: the call runs (r3 = 42)")
+        if p.returncode:
