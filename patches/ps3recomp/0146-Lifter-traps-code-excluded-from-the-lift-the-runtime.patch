 """
 
 SOURCE_PREAMBLE = """\
@@ -1402,6 +1418,38 @@ def load_entry_hooks(path: str) -> dict[int, tuple[str, str, bool]]:
     return out
 
 
+def load_traps(path: str) -> list[tuple[int, int, str]]:
+    """Read a --traps file:
+
+        {"traps": [{"lo": "0x0082F650", "hi": "0x00908584", "what": "FMOD",
+                    "note": "..."}, ...]}
+
+    -> [(lo, hi, what)], sorted: half-open guest address ranges whose code is not
+    lifted. Every function that starts in one is emitted as a trap (a call of
+    ppu_trap with its address and `what`: the run reports it and ends), and the
+    ranges are registered with the runtime, which treats any other address in
+    them the same way (a jump or a function pointer into the middle of excluded
+    code). The ranges must follow function boundaries: a lifted function that
+    runs into one, or a trapped one that runs out of it, is an error -- the
+    output would hold part of the excluded code, or lose code that is not."""
+    with open(path) as f:
+        spec = json.load(f)
+    out = []
+    for e in spec.get("traps", []):
+        lo, hi = int(str(e["lo"]), 0), int(str(e["hi"]), 0)
+        what = str(e.get("what", "excluded"))
+        if lo & 3 or hi & 3 or lo >= hi:
+            sys.exit(f"[ppu_lifter] {path}: bad trap range 0x{lo:08X}-0x{hi:08X}")
+        if not re.fullmatch(r"[A-Za-z0-9_ .+-]{1,40}", what):
+            sys.exit(f"[ppu_lifter] {path}: {what!r}: a trap's name is letters, digits, spaces and _.+- (40 at most)")
+        out.append((lo, hi, what))
+    out.sort()
+    for (a_lo, a_hi, _), (b_lo, b_hi, _) in zip(out, out[1:]):
+        if b_lo < a_hi:
+            sys.exit(f"[ppu_lifter] {path}: trap ranges 0x{a_lo:08X}-0x{a_hi:08X} and 0x{b_lo:08X}-0x{b_hi:08X} overlap")
+    return out
+
+
