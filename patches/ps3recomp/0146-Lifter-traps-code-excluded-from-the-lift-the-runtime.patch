diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 683fd56..898b34f 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -2537,15 +2537,62 @@ extern "C" uint32_t ppu_prof_resolve_host(void* ra)
     return lo ? g_inv[lo - 1].guest : 0;
 }
 
+/* --traps (tools/ppu_lifter.py): code excluded from the lift. The lifted program registers its excluded ranges
+ * (ppu_trap_ranges_register, from the file that holds its function table); each function starting in one was
+ * lifted as a call of ppu_trap, and a lookup of any other address in one -- an indirect call or a function pointer
+ * into the middle of excluded code, a thread or a callback entering it -- ends in ppu_trap as well: the address,
+ * what the range is, the caller and the guest's stack reported, then the run ends (ps3_fatal). Nothing of the
+ * excluded code exists to run in its place. */
+#ifndef PPU_RECOMP_HAS_TRAPS
+typedef struct { uint32_t lo, hi; const char* what; } ppu_trap_range;   /* a lift from before --traps */
+#endif
+static struct { const ppu_trap_range* r; unsigned n; } s_trap_sets[8];
+static unsigned s_trap_set_n;
+extern "C" int ppu_trap_ranges_register(const ppu_trap_range* ranges, unsigned count)
+{
+    if (s_trap_set_n >= 8) ps3_fatal("traps", "more than 8 images register excluded ranges");
+    s_trap_sets[s_trap_set_n].r = ranges;
+    s_trap_sets[s_trap_set_n].n = count;
+    s_trap_set_n++;
+    return 1;
+}
+static const char* ppu_trap_find(uint32_t a)
+{
+    for (unsigned i = 0; i < s_trap_set_n; i++)
+        for (unsigned k = 0; k < s_trap_sets[i].n; k++)
+            if (a >= s_trap_sets[i].r[k].lo && a < s_trap_sets[i].r[k].hi) return s_trap_sets[i].r[k].what;
+    return nullptr;
+}
+extern "C" void ppu_trap(uint32_t addr, const char* what, ppu_context* ctx)
+{
+    if (!ctx) ctx = g_active_ctx;
+    fflush(stdout);
+    fprintf(stderr, "[ppu] TRAP: excluded code reached at 0x%08X (%s; not lifted, --traps): lr=0x%08X r3=0x%08X tid=%llu\n",
+            addr, what ? what : "?", ctx ? (uint32_t)ctx->lr : 0u, ctx ? (uint32_t)ctx->gpr[3] : 0u,
+            ctx ? (unsigned long long)ctx->thread_id : 0ull);
+    ppu_log_host_chain("trap");
+    if (ctx) ppu_dump_guest_stack(ctx, "trap");
+    ps3_fatal("excluded-code", "0x%08X (%s) was excluded from the lift", addr, what ? what : "?");
+}
+/* a lookup that found no function: inside an excluded range that is the trap, not an unknown address */
+static ppu_fn ppu_lookup_miss(uint32_t a)
+{
+    if (__builtin_expect(s_trap_set_n != 0, 0)) {
+        const char* w = ppu_trap_find(a);
+        if (w) ppu_trap(a, w, nullptr);
+    }
+    return nullptr;
+}
+
 static ppu_fn ppu_lookup(uint32_t a)
 {
     uint32_t i = (a * 2654435761u) & PPU_HASH_MASK;
     for (uint32_t probes = 0; probes < PPU_HASH_SIZE; probes++) {
-        if (g_fn(i) == nullptr) return nullptr;
+        if (g_fn(i) == nullptr) return ppu_lookup_miss(a);
         if (g_addr(i) == a) return g_fn(i);
         i = (i + 1) & PPU_HASH_MASK;
     }
-    return nullptr;
+    return ppu_lookup_miss(a);
 }
 /* R8: the lifted code's call-site cache fills itself from this (PPU_ICALL) */
 extern "C" ppu_fn ps3_icall_lookup(uint32_t a) { return a ? ppu_lookup(a) : nullptr; }
diff --git a/runtime/ppu/tests/test_ppu_traps.cpp b/runtime/ppu/tests/test_ppu_traps.cpp
new file mode 100644
index 0000000..dc15885
--- /dev/null
+++ b/runtime/ppu/tests/test_ppu_traps.cpp
@@ -0,0 +1,86 @@
+// --traps (tools/ppu_lifter.py) end to end, no game: tools/test_ppu_traps.py lifts a made-up program in which
+// two functions are excluded, and builds this against the lift and the real ppu_loader.cpp. One scenario per
+// run (argv[1]), each an entry of the program started through ps3_indirect_call:
+//   direct       a `bl` to an excluded function
+//   ctr          an indirect call (mtctr; bctrl) to an excluded function
+//   pointer      an indirect call through a function pointer read from guest memory
+//   tail         a `b` (a tail call) to an excluded function
+//   middle       an indirect call into the middle of an excluded function (no function starts there)
+//   fallthrough  a function that runs off its end into an excluded one
+//   normal       a call to a function that is not excluded: it must run (r3 = 42)
+// A trap ends the run (ps3_fatal: abort) after its report; returning from an excluded entry is a failure.
+#include "ppu_recomp.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+uint8_t* vm_base;
+uint32_t ppu_hle_inject_base = 0x20000000;
+int spu_coh_is_reserved(uint32_t) { return 0; }
+void spu_coh_notify_write(uint32_t) { std::abort(); }
+void spu_lockline_lock(void) { std::abort(); }
+void spu_lockline_unlock(void) { std::abort(); }
+int spu_raw_reg_load(uint32_t, uint32_t*) { std::abort(); }
+void spu_raw_reg_store(uint32_t, uint32_t, unsigned) { std::abort(); }
+void cellGcm_ref_on_poll(void) { std::abort(); }
+uint64_t ppu_thread_register_main(void) { return 1; }
+void (*g_ppu_thread_entry_trampoline)(uint32_t, uint64_t, uint32_t, uint64_t);
+uint32_t ps3_hle_count(void) { return 0; }
+// the rest of the runtime ppu_loader.cpp refers to (the GCM front end, the syscalls, the memory mapper, the
+// milestone log): never reached by these scenarios
+void cellGcm_get_on_poll(void) { std::abort(); }
+volatile unsigned long g_gcm_drain_tid;
+uint32_t (*g_gcm_word_caller)(uint32_t ea);
+uint64_t (*g_gcm_word_writer)(uint32_t ea);
+int32_t g_ppu_primary_prio;
+extern const unsigned char* const g_spu_coh_map = nullptr;
+int lv2_try_syscall(ppu_context*) { std::abort(); }
+void ppu_prof_stamp(void*, unsigned) {}
+uint32_t ps3_mmapper_block_size(uint32_t) { std::abort(); }
+unsigned long long ps3_ms_now(void) { return 0; }
+void ps3_msf(const char*, ...) {}
+void ps3_stdio_init(void) {}
+uint32_t spu_registry_size(void) { return 0; }
+int spu_registry_entry(uint32_t, void**, uint32_t*) { return 0; }
+void sys_memory_set_image_query(uint64_t (*)(uint64_t, uint64_t)) {}
+int64_t sys_mmapper_allocate_address(ppu_context*) { std::abort(); }
+int64_t sys_mmapper_search_map_address(uint32_t, uint32_t, uint32_t*) { std::abort(); }
+void ppu_register_function(uint64_t addr, void (*fn)(ppu_context*));
+void ps3_indirect_call(ppu_context* ctx);
+}
+
+static void wr32(uint32_t ea, uint32_t v)
+{
+    vm_base[ea] = (uint8_t)(v >> 24);
+    vm_base[ea + 1] = (uint8_t)(v >> 16);
+    vm_base[ea + 2] = (uint8_t)(v >> 8);
+    vm_base[ea + 3] = (uint8_t)v;
+}
+
+int main(int argc, char** argv)
+{
+    static const struct { const char* name; uint32_t entry; } kScenarios[] = {
+        { "direct", 0x10000 }, { "ctr", 0x10010 }, { "pointer", 0x10030 }, { "tail", 0x10050 },
+        { "middle", 0x10060 }, { "fallthrough", 0x1FFF8 }, { "normal", 0x100A0 },
+    };
+    if (argc < 2) { std::fprintf(stderr, "usage: test_ppu_traps <scenario>\n"); return 2; }
+    uint32_t entry = 0;
+    for (const auto& s : kScenarios)
+        if (!std::strcmp(argv[1], s.name)) entry = s.entry;
+    if (!entry) { std::fprintf(stderr, "unknown scenario %s\n", argv[1]); return 2; }
+    vm_base = (uint8_t*)std::calloc(1, 0x100000);
+    wr32(0x40000, 0x20000);   // a function pointer to the first excluded function, in guest memory
+    for (uint64_t i = 0; i < function_table_count; i++)
+        ppu_register_function(function_table[i].addr, function_table[i].func);
+    static ppu_context ctx;
+    ctx.gpr[1] = 0x80000;     // a stack
+    ctx.gpr[3] = 0x40000;     // the pointer's address, for `pointer`
+    ctx.ctr = entry;
+    ps3_indirect_call(&ctx);
+    std::printf("returned: r3=%llu\n", (unsigned long long)ctx.gpr[3]);
+    if (!std::strcmp(argv[1], "normal")) return ctx.gpr[3] == 42 ? 0 : 1;
+    std::printf("NO TRAP: the excluded code was not stopped\n");
+    return 3;
+}
