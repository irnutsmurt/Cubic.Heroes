From f249e8621201dc45b306260bfc9fafd3bacd8a2c Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:18:54 -0800
Subject: [PATCH] build_spu_workloads: --exclude an image

--exclude IMAGE (repeatable): an embedded SPU image the title never runs in
the port -- the programs of a library whose PPU code is excluded from the
lift -- is neither lifted nor registered; a stale lift of it in --lifted is
removed, since a build compiles every <lifted>/<image>/spu_recomp.c it finds.
A name that is no extracted image is an error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/build_spu_workloads.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/tools/build_spu_workloads.py b/tools/build_spu_workloads.py
index 06faf98..d14d799 100644
--- a/tools/build_spu_workloads.py
+++ b/tools/build_spu_workloads.py
@@ -138,6 +138,9 @@ def main():
                          "spu_overlay_register_relocatable. Repeatable.")
     ap.add_argument("--constructor", action="store_true",
                     help="also emit an __attribute__((constructor)) that calls the register fn at startup")
+    ap.add_argument("--exclude", action="append", default=[], metavar="IMAGE",
+                    help="an image (its name, as the extraction names it) neither lifted nor registered: code "
+                         "the title will never run here (repeatable; a stale lift of it in --lifted is removed)")
     ap.add_argument("--relift", action="store_true", help="re-lift even if a prior lift exists")
     ap.add_argument("--skip-lift", action="store_true",
                     help="do not run the lifter; assume --lifted already populated (still fixes includes + emits registry)")
@@ -167,6 +170,18 @@ def main():
     elfs = sorted(glob.glob(os.path.join(args.images, "*.elf")))
     if not elfs:
         sys.exit(f"[build_spu_workloads] no *.elf in {args.images}")
+    if args.exclude:
+        names = {os.path.splitext(os.path.basename(e))[0]: e for e in elfs}
+        missing = sorted(set(args.exclude) - set(names))
+        if missing:
+            sys.exit(f"[build_spu_workloads] --exclude: no image {', '.join(missing)}")
+        for img in args.exclude:
+            stale = os.path.join(args.lifted, img)
+            if os.path.isdir(stale):
+                import shutil
+                shutil.rmtree(stale)   # a build compiles every <lifted>/<image>/spu_recomp.c it finds
+        elfs = [e for e in elfs if os.path.splitext(os.path.basename(e))[0] not in set(args.exclude)]
+        print(f"[build_spu_workloads] excluded {len(args.exclude)} image(s): neither lifted nor registered")
 
     reloc = {}
     for spec in args.relocatable:
-- 
