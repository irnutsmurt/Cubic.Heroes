     if (!attr) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
     CellSpursTaskAttribute* attr_h = GUEST_PTR(attr, CellSpursTaskAttribute*);
     /* Dump the raw attribute: our struct doesn't model lsPattern/argument, and
diff --git a/runtime/platform/ps3_census.c b/runtime/platform/ps3_census.c
new file mode 100644
index 0000000..623e755
--- /dev/null
+++ b/runtime/platform/ps3_census.c
@@ -0,0 +1,51 @@
+/* ps3_census (ps3emu/census.h): the machinery a native port means to retire, counted. */
+#include "ps3emu/census.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+void ps3_fatal(const char* kind, const char* fmt, ...);   /* ps3_strict.c */
+
+volatile long long g_ps3_census[PS3_CENSUS_KINDS];
+
+static const char* const k_names[PS3_CENSUS_KINDS] = {
+    "spu_atomic", "spu_watch", "ppu_coh_store", "spu_dma", "spu_mailbox", "spu_group", "spu_overlay",
+    "spurs_instance", "spurs_task", "native_decline",
+};
+static const char* const k_what[PS3_CENSUS_KINDS] = {
+    "SPU atomic (lock-line reservation)", "line watch armed", "PPU store to a line an SPU holds",
+    "SPU DMA transfer", "SPU mailbox or signal channel", "lv2 SPU thread group created",
+    "SPU overlay made resident", "SPURS instance initialised", "SPURS task created",
+    "native path declined (the lifted code runs)",
+};
+
+static int fatal_kind(int kind)
+{
+    const char* e = getenv("PS3_CENSUS_FATAL");
+    if (!e || !*e) return 0;
+    if (!strcmp(e, "all")) return 1;
+    const size_t n = strlen(k_names[kind]);
+    for (const char* p = e; (p = strstr(p, k_names[kind])) != NULL; p += n)
+        if ((p == e || p[-1] == ',') && (p[n] == 0 || p[n] == ',')) return 1;
+    return 0;
+}
+
+void ps3_census_first(int kind, unsigned a, unsigned b)
+{
+    if (kind < 0 || kind >= PS3_CENSUS_KINDS) return;
+    fprintf(stderr, "[census] first %s (%s): 0x%08X 0x%08X\n", k_what[kind], k_names[kind], a, b);
+    fflush(stderr);
+    if (fatal_kind(kind))
+        ps3_fatal("census", "%s used, which PS3_CENSUS_FATAL forbids (0x%08X 0x%08X)", k_names[kind], a, b);
+}
+
+void ps3_census_report(FILE* f)
+{
+    if (!f) f = stderr;
+    char line[512];
+    int p = snprintf(line, sizeof line, "[census]");
+    for (int k = 0; k < PS3_CENSUS_KINDS && p < (int)sizeof line - 40; k++)
+        p += snprintf(line + p, sizeof line - (size_t)p, " %s %lld", k_names[k],
+                      __atomic_load_n(&g_ps3_census[k], __ATOMIC_RELAXED));
+    fprintf(f, "%s\n", line);
+}
