From 7b6c5c132fa3a3395af720d2b4e585231622257e Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:48:36 -0800
Subject: [PATCH] Census: counters of the SPU machinery's use, reported at exit

ps3_census(kind, a, b) counts each use of a piece of the SPU environment --
atomics and reservations, line watches, coherent PPU stores, DMA, mailboxes,
thread groups, overlays, SPURS instances and tasks -- by kind and its first
arguments, and ps3_census_report prints the counts. native_decline is a
port's: a native implementation handing work back to the lifted code.
PS3_CENSUS_FATAL=<kind,...> makes a kind's first use fatal, with a report:
the assertion that a retired piece is not reached.
---
 include/ps3emu/census.h         | 59 +++++++++++++++++++++++++++++++++
 libs/spurs/cellSpurs.c          |  4 +++
 runtime/platform/ps3_census.c   | 51 ++++++++++++++++++++++++++++
 runtime/spu/spu_channels.c      | 12 +++++++
 runtime/spu/spu_coherency.c     |  3 ++
 runtime/syscalls/lv2_register.c |  2 ++
 6 files changed, 131 insertions(+)
 create mode 100644 include/ps3emu/census.h
 create mode 100644 runtime/platform/ps3_census.c

diff --git a/include/ps3emu/census.h b/include/ps3emu/census.h
new file mode 100644
index 0000000..57b1236
--- /dev/null
+++ b/include/ps3emu/census.h
@@ -0,0 +1,59 @@
+/*
+ * ps3_census: how often a run used each piece of the PS3 machinery a native port means to retire -- the SPU
+ * environment's atomics, line watches, DMA, mailboxes and signals, overlays, SPU thread groups, SPURS instances and
+ * tasks, and the PPU stores that found a line an SPU holds (the per-store coherence test's slow path). A port whose
+ * work is native should see none of them; the census says which still happen, over every run, so each can be
+ * retired only once nothing uses it.
+ *
+ * Each kind's first use is said once on stderr with what it was ("[census] first ..."), its count at exit
+ * (ps3_census_report). PS3_CENSUS_FATAL=<kind>[,<kind>...] (or "all") makes a kind's first use fatal: the
+ * assertion to turn on once the census has shown a kind unused, so a path no run has reached yet cannot use it
+ * unnoticed. The kinds' names: spu_atomic, spu_watch, ppu_coh_store, spu_dma, spu_mailbox, spu_group, spu_overlay,
+ * spurs_instance, spurs_task, native_decline.
+ *
+ * native_decline is the port's: a native implementation handing a piece of work back to the lifted SPU code or to
+ * SPURS (a case it does not cover). A port whose native paths cover everything the game can do never counts one;
+ * PS3_CENSUS_FATAL=native_decline is the assertion that it does not.
+ *
+ * The counters are relaxed atomics on paths a native run does not take; the hot paths that do run (the PPU's
+ * stores) reach them only in their slow branch.
+ */
+#ifndef PS3EMU_CENSUS_H
+#define PS3EMU_CENSUS_H
+
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    PS3_CENSUS_SPU_ATOMIC,      /* an SPU's GETLLAR, PUTLLC, PUTLLUC or PUTQLLUC: a = the command, b = the EA */
+    PS3_CENSUS_SPU_WATCH,       /* a line watch armed (a SPURS task's signal, an event flag): a = the EA */
+    PS3_CENSUS_PPU_COH_STORE,   /* a PPU store to a line an SPU holds: a = the line */
+    PS3_CENSUS_SPU_DMA,         /* an MFC transfer (GET, PUT, a list): a = the command, b = the EA */
+    PS3_CENSUS_SPU_MAILBOX,     /* an SPU mailbox or signal-notification channel: a = the channel */
+    PS3_CENSUS_SPU_GROUP,       /* an lv2 SPU thread group created: a = its threads */
+    PS3_CENSUS_SPU_OVERLAY,     /* an SPU overlay or relocatable image made resident: a = the image, b = the LS address */
+    PS3_CENSUS_SPURS_INSTANCE,  /* a SPURS instance initialised: a = its SPUs, b = its address */
+    PS3_CENSUS_SPURS_TASK,      /* a SPURS task created: a = its ELF's address */
+    PS3_CENSUS_NATIVE_DECLINE,  /* a native path handed work back to the lifted code: a = the path, b = the case */
+    PS3_CENSUS_KINDS
+};
+
+extern volatile long long g_ps3_census[PS3_CENSUS_KINDS];
+void ps3_census_first(int kind, unsigned a, unsigned b);
+
+static inline void ps3_census(int kind, unsigned a, unsigned b)
+{
+    if (__atomic_add_fetch(&g_ps3_census[kind], 1, __ATOMIC_RELAXED) == 1) ps3_census_first(kind, a, b);
+}
+
+/* every kind's count (the zeros too: a census says what was not used) */
+void ps3_census_report(FILE* f);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3EMU_CENSUS_H */
