index c41320a..47e531a 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -13,6 +13,7 @@
  */
 
 #include "ps3emu/ps3_strict.h"
+#include "ps3emu/census.h"   /* M6: the machinery a native port retires, counted */
 #include "spu_dma.h"
 #include "spu_coherency.h" /* lock-line lock + PPU-write coherence bitmap */
 #include "spu_helpers.h"   /* spu_splat_u32 / spu_ls_read128 (SMC microstep) */
@@ -1119,6 +1120,14 @@ static int channel_is_mfc(uint32_t ch)
  * ===========================================================================*/
 void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
 {
+    /* the census (ps3emu/census.h): only lifted SPU code writes channels -- the native tasks call the host directly */
+    if (channel == MFC_Cmd) {
+        const uint32_t c = value._u32[0] & 0xFF;
+        const int atomic = c == MFC_GETLLAR_CMD || c == MFC_PUTLLC_CMD || c == MFC_PUTLLUC_CMD || c == MFC_PUTQLLUC_CMD;
+        ps3_census(atomic ? PS3_CENSUS_SPU_ATOMIC : PS3_CENSUS_SPU_DMA, c, ctx->mfc_eal);
+    } else if (channel == SPU_WrOutMbox || channel == SPU_WrOutIntrMbox) {
+        ps3_census(PS3_CENSUS_SPU_MAILBOX, channel, value._u32[0]);
+    }
     /* SPU_CHHIST=1: which channels a job actually touches, and how often. A
      * worker that never issues an MFC command is either not being handed its
      * work descriptor or is waiting on a channel we never satisfy; the channel
@@ -1426,6 +1435,8 @@ u128 spu_rdch(spu_context* ctx, uint32_t channel)
         return spu_make_preferred_u32(v);
     }
 
+    if (channel == SPU_RdInMbox || channel == SPU_RdSigNotify1 || channel == SPU_RdSigNotify2)
+        ps3_census(PS3_CENSUS_SPU_MAILBOX, channel, 0);
     switch (channel) {
     case SPU_RdInMbox:
         if (ctx->rcv_evt_n > 0) { v = ctx->rcv_evt[ctx->rcv_evt_i++]; ctx->rcv_evt_n--; }
@@ -2396,6 +2407,7 @@ void spu_overlay_note_get(spu_context* ctx, uint32_t ea, const uint8_t* ls, uint
                     ctx->resident_code[slot].reloc = o->reloc;
                     ctx->resident_code[slot].reloc_delta = o->reloc ? lsa - o->load_lsa : 0;
                     if (o->image_id >= 0 && o->image_id < 64) __atomic_fetch_add(&s_ovl_loads[o->image_id], 1, __ATOMIC_RELAXED);
+                    ps3_census(PS3_CENSUS_SPU_OVERLAY, (unsigned)o->image_id, lsa);
                     { static int _n = 0; if (o->reloc && PS3_LOG_FIRST(_n, 64))
                         fprintf(stderr, "[spu-ovl] img=%d relocatable image %d src=0x%08X -> LS 0x%05X "
                                 "(link 0x%05X, delta 0x%05X)\n", ctx->image_id, o->image_id, ea, lsa,
diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
index c71e186..85c060b 100644
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -18,6 +18,7 @@
 #include <stdint.h>
 #include <stdio.h>
 #include "ps3emu/log_first.h"
+#include "ps3emu/census.h"
 
 #ifdef __cplusplus
 extern "C" {
@@ -200,6 +201,7 @@ void spu_coh_reserve(spu_context* ctx, uint32_t ea)
 void spu_coh_watch_add(spu_coh_watch* watch, uint32_t ea,
                        void (*wake)(void*), void* opaque)
 {
+    ps3_census(PS3_CENSUS_SPU_WATCH, ea, 0);
     /* Arming the existing bitmap makes PPU stores/CAS and MFC writes use
      * the same serialized commit/notify path as SPU reservations. */
     spu_coh_reserve(NULL, ea);
@@ -396,6 +398,7 @@ void spu_coh_notify_write_except(uint32_t ea, const void* self)
 void spu_coh_notify_write(uint32_t ea)
 {
     uint32_t line = ea & ~127u;
+    ps3_census(PS3_CENSUS_PPU_COH_STORE, line, 0);
     ppu_resv_break_line(ea);
     spu_coh_writer_fence();
     spu_coh_wake_watches(line);
