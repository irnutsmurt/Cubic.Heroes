From 159daa425ecbc94d193bdaf0d87eed860b3611af Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:48:36 -0800
Subject: [PATCH] cellPad: an SDL controller update of 50 ms or more reported,
 with its time

SDL2's Windows driver re-enumerates every input device under its joystick lock
after a device arrives or leaves anywhere on the system (about 0.3 s on a PC
with many); the game's pad poll and the window's event pump wait on that lock.
A poll that long is reported with the time since the first poll and the
system tick, so a freeze in a session can be matched to its cause.
---
 libs/input/cellPad.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 6bfcdc7..4ff169d 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -588,8 +588,21 @@ static int pad_sdl_family(SDL_GameController* gc)
 
 static void pad_poll_sdl2(void)
 {
+    /* SDL's controller update normally takes microseconds; after a device arrives or leaves anywhere on the system
+     * (SDL2's Windows driver re-arms detection 0.3 s and 2 s after each), it enumerates every input device under
+     * its joystick lock -- about 0.3 s on a PC with many -- and the window's event pump waits on the same lock. A
+     * poll that long is reported, with the time, so a freeze in a session can be matched to it. */
+    const unsigned long long t0 = pad_now_ms();
     SDL_GameControllerUpdate();
     pad_sdl_hotplug(0);
+    {
+        const unsigned long long took = pad_now_ms() - t0;
+        static unsigned long long boot;
+        if (!boot) boot = t0;
+        if (took >= 50)
+            fprintf(stderr, "[cellPad] SDL controller update took %llu ms at %.1f s (tick %llu; SDL re-enumerating input devices after a device change)\n",
+                    took, (double)(t0 - boot) / 1000.0, t0);
+    }
 
     for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
         SDL_GameController* gc = s_sdl_controllers[i];
-- 
