From eeec065f07e5f869718a856f58480ea5b617df17 Mon Sep 17 00:00:00 2001
From: giteaguy <73799093+irnutsmurt@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:40:52 -0800
Subject: [PATCH] cellPad: SDL's controllers polled on a thread of their own

SDL's controller update takes microseconds, except after a device arrives or
leaves anywhere on the system: SDL2's Windows driver then re-enumerates every
DirectInput and XInput device under its joystick lock (312 ms measured with 27
input devices), which the window's event pump takes too, and the title's
thread stopped in its pad read for that long. Every SDL joystick and controller
call is now one thread's: every 4 ms it sends the rumble the title asked for,
reads SDL and publishes each port's state; the title's reads copy the latest
and never call SDL, and the window's pump no longer updates joysticks
(SDL_HINT_AUTO_UPDATE_JOYSTICKS=0). Rumble is renewed only while the title
still reads its pad, so a hung title's motors still stop within the hold.
PAD_SDL_THREAD=0: SDL polled in the title's reads, as before. The XInput
backend is unchanged.
---
 libs/input/cellPad.c | 173 ++++++++++++++++++++++++++++++++++---------
 1 file changed, 139 insertions(+), 34 deletions(-)

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 4ff169d..60353f4 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -64,6 +64,7 @@ static double pad_clock(unsigned long long t0_ms)
 
 #if PAD_BACKEND_SDL2
   #include <SDL2/SDL.h>
+  #include "ps3emu/thread_name.h"
 #endif
 
 /* ---------------------------------------------------------------------------
@@ -114,6 +115,15 @@ static SDL_JoystickGUID    s_sdl_last_guid[PAD_MAX_HOST_PORTS];
 static int                 s_sdl_had[PAD_MAX_HOST_PORTS];
 static unsigned long long  s_sdl_scan_ms;   /* last device-list scan (pad_now_ms) */
 static int s_sdl_inited = 0;
+/* The pad thread (pad_sdl_thread): once it runs, every SDL joystick and controller call is its own. */
+static SDL_Thread*         s_pad_thread;
+static volatile int        s_pad_thread_stop;
+static PadHostState        s_pub_state[PAD_MAX_HOST_PORTS];   /* its latest reading of each port */
+static volatile char       s_pub_lock;                        /* s_pub_state and the rumble requests */
+static u16                 s_rumble_req_lo[PAD_MAX_HOST_PORTS], s_rumble_req_hi[PAD_MAX_HOST_PORTS];
+static int                 s_rumble_req[PAD_MAX_HOST_PORTS];  /* a request the thread has not sent yet */
+static volatile unsigned long long s_guest_poll_ms;           /* the guest's last pad read (the rumble's renewal) */
+static int SDLCALL pad_sdl_thread(void* arg);
 #endif
 
 /* A port with no device behind it: nothing pressed and both sticks CENTRED.
@@ -504,7 +514,6 @@ static void pad_sdl_close(int p, int gone)
     s_sdl_controllers[p] = NULL;
     s_sdl_ids[p] = -1;
     memset(&s_rumble[p], 0, sizeof s_rumble[p]);
-    pad_host_release(&s_host_state[p]);
 }
 
 /* Open every game controller SDL lists that no port has yet. */
@@ -586,7 +595,9 @@ static int pad_sdl_family(SDL_GameController* gc)
     }
