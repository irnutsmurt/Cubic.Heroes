diff --git a/include/ps3emu/guest_pause.h b/include/ps3emu/guest_pause.h
new file mode 100644
index 0000000..d436477
--- /dev/null
+++ b/include/ps3emu/guest_pause.h
@@ -0,0 +1,192 @@
+/*
+ * ps3_guest_pause -- the game held by its host (a port's in-game menu): every guest clock stands still while it
+ * is held (the timebase, sys_time_get_system_time, sys_time_get_current_time: their readings exclude the time
+ * held, so the game resumes exactly where it was, with no long frame), and the guest's render thread waits at
+ * its next flip request (cellGcmSys), so the game's frame loop stops between two frames. Its other threads run on
+ * but see no time pass. Header-only, one shared object (as ps3emu/osd.h); one writer (the port), any reader;
+ * the readers retry a torn read (seqlock).
+ */
+#ifndef PS3EMU_GUEST_PAUSE_H
+#define PS3EMU_GUEST_PAUSE_H
+
+#include <stdint.h>
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include <time.h>
+#  include <sched.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(_MSC_VER)
+#  define PS3_GUEST_PAUSE_SHARED __declspec(selectany)
+#else
+#  define PS3_GUEST_PAUSE_SHARED __attribute__((weak))
+#endif
+
+typedef struct {
+    uint32_t seq;        /* odd while being changed */
+    int      on;
+    uint64_t since_ns;   /* when the current hold began (on the clock below) */
+    uint64_t total_ns;   /* every earlier hold, added up */
+} ps3_guest_pause_state;
+
+PS3_GUEST_PAUSE_SHARED ps3_guest_pause_state g_ps3_guest_pause = { 0, 0, 0, 0 };
+
+static inline uint64_t ps3_guest_pause_now_ns(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)(c.QuadPart / f.QuadPart) * 1000000000ull +
+           (uint64_t)(c.QuadPart % f.QuadPart) * 1000000000ull / (uint64_t)f.QuadPart;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+#endif
+}
+
+/* A guest clock's speed-up (a port skipping its title's start-up logos: the original sequence, its clocks run
+ * `factor` times as fast until the port ends it): the time added so far, never decreasing. One writer. */
+typedef struct { uint32_t seq; int on; uint32_t factor; uint64_t since_ns, total_ns; } ps3_guest_warp_state;
+PS3_GUEST_PAUSE_SHARED ps3_guest_warp_state g_ps3_guest_warp = { 0, 0, 1, 0, 0 };
+
+static inline uint64_t ps3_guest_pause_now_ns(void);
+static inline uint64_t ps3_guest_ahead_ns(void)
+{
+    const ps3_guest_warp_state* w = &g_ps3_guest_warp;
+    for (;;) {
+        const uint32_t a = __atomic_load_n(&w->seq, __ATOMIC_ACQUIRE);
+        if (a & 1) continue;
+        const int on = __atomic_load_n(&w->on, __ATOMIC_RELAXED);
+        const uint32_t f = __atomic_load_n(&w->factor, __ATOMIC_RELAXED);
+        const uint64_t since = __atomic_load_n(&w->since_ns, __ATOMIC_RELAXED);
+        const uint64_t total = __atomic_load_n(&w->total_ns, __ATOMIC_RELAXED);
+        if (!on && !total) return 0;   /* the common case: never warped */
+        const uint64_t now = on ? ps3_guest_pause_now_ns() : 0;
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&w->seq, __ATOMIC_RELAXED) != a) continue;
+        return total + (on && now > since ? (now - since) * (f > 1 ? f - 1 : 0) : 0);
+    }
+}
+
+static inline void ps3_guest_warp_set(int on, uint32_t factor)
+{
+    ps3_guest_warp_state* w = &g_ps3_guest_warp;
+    if (!!on == !!__atomic_load_n(&w->on, __ATOMIC_ACQUIRE)) return;
+    const uint64_t now = ps3_guest_pause_now_ns();
+    __atomic_add_fetch(&w->seq, 1, __ATOMIC_ACQ_REL);
+    if (on) {
+        __atomic_store_n(&w->factor, factor > 1 ? factor : 1, __ATOMIC_RELAXED);
+        __atomic_store_n(&w->since_ns, now, __ATOMIC_RELAXED);
+    } else {
+        const uint64_t since = __atomic_load_n(&w->since_ns, __ATOMIC_RELAXED);
+        const uint32_t f = __atomic_load_n(&w->factor, __ATOMIC_RELAXED);
+        __atomic_store_n(&w->total_ns, __atomic_load_n(&w->total_ns, __ATOMIC_RELAXED) +
+                                       (now > since ? (now - since) * (f > 1 ? f - 1 : 0) : 0), __ATOMIC_RELAXED);
+    }
+    __atomic_store_n(&w->on, on ? 1 : 0, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&w->seq, 1, __ATOMIC_RELEASE);
+}
+
+/* The time held so far, to take off a guest clock's reading: never decreasing, so a held clock never runs back */
+static inline uint64_t ps3_guest_paused_ns(void)
+{
+    const ps3_guest_pause_state* s = &g_ps3_guest_pause;
+    for (;;) {
+        const uint32_t a = __atomic_load_n(&s->seq, __ATOMIC_ACQUIRE);
+        if (a & 1) continue;
+        const int on = __atomic_load_n(&s->on, __ATOMIC_RELAXED);
+        const uint64_t since = __atomic_load_n(&s->since_ns, __ATOMIC_RELAXED);
+        const uint64_t total = __atomic_load_n(&s->total_ns, __ATOMIC_RELAXED);
+        const uint64_t now = on ? ps3_guest_pause_now_ns() : 0;
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&s->seq, __ATOMIC_RELAXED) != a) continue;
+        return total + (on && now > since ? now - since : 0);
+    }
+}
+
+static inline int ps3_guest_paused(void) { return __atomic_load_n(&g_ps3_guest_pause.on, __ATOMIC_ACQUIRE); }
+
+/* the port: hold (1) or release (0) the game */
+static inline void ps3_guest_pause_set(int on)
+{
+    ps3_guest_pause_state* s = &g_ps3_guest_pause;
+    if (!!on == !!__atomic_load_n(&s->on, __ATOMIC_ACQUIRE)) return;
+    const uint64_t now = ps3_guest_pause_now_ns();
+    __atomic_add_fetch(&s->seq, 1, __ATOMIC_ACQ_REL);
+    if (on) {
+        __atomic_store_n(&s->since_ns, now, __ATOMIC_RELAXED);
+    } else {
+        const uint64_t since = __atomic_load_n(&s->since_ns, __ATOMIC_RELAXED);
+        __atomic_store_n(&s->total_ns, __atomic_load_n(&s->total_ns, __ATOMIC_RELAXED) + (now > since ? now - since : 0),
+                         __ATOMIC_RELAXED);
+    }
+    __atomic_store_n(&s->on, on ? 1 : 0, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&s->seq, 1, __ATOMIC_RELEASE);
+}
+
+/* the guest's render thread, at its flip request: waits while the game is held */
+static inline void ps3_guest_pause_wait(void)
+{
+    while (ps3_guest_paused()) {
+#ifdef _WIN32
+        Sleep(4);
+#else
+        struct timespec ts = { 0, 4000000 };
+        nanosleep(&ts, NULL);
+#endif
+    }
+}
+
+/* A host frame limiter at the flip request (a port's frame-rate setting): each frame's request waits for its
+ * deadline on the high-resolution clock -- a sleep to within 2 ms, then a yield -- so the limit holds evenly at any
+ * rate, never quantized to a vblank. 0: none. The deadlines resynchronize after a frame far behind. */
+PS3_GUEST_PAUSE_SHARED volatile uint64_t g_ps3_frame_period_ns = 0;
+
+static inline void ps3_frame_limit_set(uint64_t period_ns) { __atomic_store_n(&g_ps3_frame_period_ns, period_ns, __ATOMIC_RELEASE); }
+
+static inline void ps3_frame_limit_wait(void)
+{
+    static uint64_t next;
+    const uint64_t p = __atomic_load_n(&g_ps3_frame_period_ns, __ATOMIC_ACQUIRE);
+    if (!p) { next = 0; return; }
+    uint64_t now = ps3_guest_pause_now_ns();
+    if (!next || now > next + 4 * p || next > now + 4 * p) { next = now + p; return; }   /* (re)started, or far off */
+#ifdef _WIN32
+    /* a high-resolution waitable timer (Windows 10 1803 and later): a sleep to within a fraction of a millisecond,
+     * with no spinning; without it, Sleep to within 2 ms and then a yield */
+    static HANDLE timer = (HANDLE)-1;
+    if (timer == (HANDLE)-1) timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+    if (timer && now + 300000ull < next) {
+        LARGE_INTEGER due;
+        due.QuadPart = -(LONGLONG)((next - now - 200000ull) / 100ull);   /* 100 ns units, relative; 0.2 ms early */
+        if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE)) WaitForSingleObject(timer, INFINITE);
+        now = ps3_guest_pause_now_ns();
+    }
+#endif
+    while (now < next) {
+        const uint64_t left = next - now;
+#ifdef _WIN32
+        if (left > 2000000ull) Sleep((DWORD)((left - 1000000ull) / 1000000ull));
+        else SwitchToThread();
+#else
+        if (left > 2000000ull) { struct timespec ts = { 0, (long)(left - 1000000ull) }; nanosleep(&ts, NULL); }
+        else sched_yield();
+#endif
+        now = ps3_guest_pause_now_ns();
+    }
+    next += p;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3EMU_GUEST_PAUSE_H */
