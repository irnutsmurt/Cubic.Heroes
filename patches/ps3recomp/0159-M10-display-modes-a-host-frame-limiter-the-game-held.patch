 static void pad_poll_sdl2(void) { pad_sdl_read(s_host_state, 0); }
 
 #if PAD_BACKEND_SDL2
+/* M10.3: the keyboard's binding for each of the game's buttons (bit i of CELL_PAD_CTRL_*): an SDL scancode */
+static volatile int s_keymap[16] = {
+    SDL_SCANCODE_TAB, SDL_SCANCODE_3, SDL_SCANCODE_4, SDL_SCANCODE_RETURN,          /* Select, L3, R3, Start */
+    SDL_SCANCODE_UP, SDL_SCANCODE_RIGHT, SDL_SCANCODE_DOWN, SDL_SCANCODE_LEFT,
+    SDL_SCANCODE_1, SDL_SCANCODE_2, SDL_SCANCODE_Q, SDL_SCANCODE_W,                 /* L2, R2, L1, R1 */
+    SDL_SCANCODE_S, SDL_SCANCODE_X, SDL_SCANCODE_Z, SDL_SCANCODE_A };               /* Triangle, Circle, Cross, Square */
+static const int k_keymap_default[16] = {
+    SDL_SCANCODE_TAB, SDL_SCANCODE_3, SDL_SCANCODE_4, SDL_SCANCODE_RETURN, SDL_SCANCODE_UP, SDL_SCANCODE_RIGHT,
+    SDL_SCANCODE_DOWN, SDL_SCANCODE_LEFT, SDL_SCANCODE_1, SDL_SCANCODE_2, SDL_SCANCODE_Q, SDL_SCANCODE_W,
+    SDL_SCANCODE_S, SDL_SCANCODE_X, SDL_SCANCODE_Z, SDL_SCANCODE_A };
+
+/* a key (its SDL name, "Z", "Left Shift" ...) for one of the game's buttons; empty or unknown: the default. 1 when
+ * the name was known. */
+int cellPad_set_key_binding(int game_bit, const char* key_name)
+{
+    if (game_bit < 0 || game_bit > 15) return 0;
+    const SDL_Scancode sc = key_name && *key_name ? SDL_GetScancodeFromName(key_name) : SDL_SCANCODE_UNKNOWN;
+    __atomic_store_n(&s_keymap[game_bit], sc != SDL_SCANCODE_UNKNOWN ? (int)sc : k_keymap_default[game_bit], __ATOMIC_RELEASE);
+    return sc != SDL_SCANCODE_UNKNOWN;
+}
+
+const char* cellPad_key_binding_name(int game_bit)
+{
+    if (game_bit < 0 || game_bit > 15) return "";
+    return SDL_GetScancodeName((SDL_Scancode)__atomic_load_n(&s_keymap[game_bit], __ATOMIC_ACQUIRE));
+}
+
+/* a port's menu, binding a key: the first key held now (its SDL name), F1 and Escape left out; 0 when none */
+int cellPad_host_key_held(char* name, int n)
+{
+    if (!SDL_WasInit(SDL_INIT_VIDEO) || !SDL_GetKeyboardFocus()) return 0;
+    int count = 0;
+    const Uint8* ks = SDL_GetKeyboardState(&count);
+    for (int sc = 4; ks && sc < count; sc++)
+        if (ks[sc] && sc != SDL_SCANCODE_F1 && sc != SDL_SCANCODE_ESCAPE) {
+            snprintf(name, (size_t)n, "%s", SDL_GetScancodeName((SDL_Scancode)sc));
+            return name[0] != 0;
+        }
+    return 0;
+}
+
 /* Keyboard fallback with the SDL2 backend: the same key map as the XInput one above,
  * read from SDL's keyboard state while one of this process's SDL windows (the
  * Vulkan backend's, PS3RECOMP_VK_WINDOW=1) has keyboard focus. That window's
@@ -741,19 +782,12 @@ static void pad_poll_keyboard(void)
     PadHostState* hs = &s_host_state[0];
     u16 btns = 0;
     if (SDL_GetKeyboardFocus()) {
-        static const struct { SDL_Scancode sc; u16 btn; } map[] = {
-            { SDL_SCANCODE_UP,     CELL_PAD_CTRL_UP },      { SDL_SCANCODE_DOWN,  CELL_PAD_CTRL_DOWN },
-            { SDL_SCANCODE_LEFT,   CELL_PAD_CTRL_LEFT },    { SDL_SCANCODE_RIGHT, CELL_PAD_CTRL_RIGHT },
-            { SDL_SCANCODE_Z,      CELL_PAD_CTRL_CROSS },   { SDL_SCANCODE_X,     CELL_PAD_CTRL_CIRCLE },
-            { SDL_SCANCODE_A,      CELL_PAD_CTRL_SQUARE },  { SDL_SCANCODE_S,     CELL_PAD_CTRL_TRIANGLE },
-            { SDL_SCANCODE_Q,      CELL_PAD_CTRL_L1 },      { SDL_SCANCODE_W,     CELL_PAD_CTRL_R1 },
-            { SDL_SCANCODE_1,      CELL_PAD_CTRL_L2 },      { SDL_SCANCODE_2,     CELL_PAD_CTRL_R2 },
-            { SDL_SCANCODE_RETURN, CELL_PAD_CTRL_START },   { SDL_SCANCODE_TAB,   CELL_PAD_CTRL_SELECT },
-        };
         int n = 0;
         const Uint8* ks = SDL_GetKeyboardState(&n);
-        for (unsigned i = 0; ks && i < sizeof map / sizeof map[0]; i++)
-            if ((int)map[i].sc < n && ks[map[i].sc]) btns |= map[i].btn;
+        for (unsigned i = 0; ks && i < 16; i++) {
+            const int sc = __atomic_load_n(&s_keymap[i], __ATOMIC_RELAXED);
+            if (sc > 0 && sc < n && ks[sc]) btns |= (u16)(1u << i);
+        }
     }
     /* No focus: everything released, so a key held while switching away
      * does not stay down. */
@@ -939,6 +973,114 @@ static int SDLCALL pad_sdl_thread(void* arg)
 }
 #endif
 
+/* M10.2: a port's own shortcut (its in-game menu: L3+R3 held, say) kept from the game. The buttons of the chord
+ * (s_chord_mask) reach the game as they always did when pressed alone -- each held back for at most s_chord_ms
+ * when it goes down, in case the rest of the chord follows; when the whole chord is held, none of its buttons
+ * reaches the game until every one is released (the character editor's undo and redo, on L3 and R3 alone,
+ * still work; the chord never triggers them). */
+static volatile u32 s_chord_mask = 0;
+static volatile unsigned s_chord_ms = 120;
+static struct { int swallow; u32 pending, shown, pulse; unsigned long long since, pulse_until; } s_chord[PAD_MAX_HOST_PORTS];
+
+void cellPad_set_chord_guard(u32 mask, unsigned ms)
+{
+    s_chord_ms = ms;
+    __atomic_store_n(&s_chord_mask, mask, __ATOMIC_RELEASE);
+}
+
+static void pad_chord_filter(unsigned long long now)
+{
+    const u32 m = __atomic_load_n(&s_chord_mask, __ATOMIC_ACQUIRE);
+    if (!m) return;
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+        PadHostState* hs = &s_host_state[i];
+        const u32 held = hs->buttons & m;
+        if (held == m) s_chord[i].swallow = 1;               /* the whole chord: the shortcut's */
+        if (s_chord[i].swallow) {
+            if (!held) s_chord[i].swallow = 0;
+            hs->buttons &= ~m;
+            s_chord[i].pending = s_chord[i].shown = s_chord[i].pulse = 0;
+            continue;
+        }
+        const u32 fresh = held & ~s_chord[i].pending;
+        if (fresh && !s_chord[i].pending) s_chord[i].since = now;
+        s_chord[i].pending |= fresh;
+        /* a press released while still held back (a tap): given to the game afterwards, for 50 ms */
+        const u32 released = s_chord[i].pending & ~held;
+        if (released) {
+            const u32 never = released & ~s_chord[i].shown;
+            if (never) { s_chord[i].pulse |= never; s_chord[i].pulse_until = now + 50; }
+            s_chord[i].pending &= ~released;
+            s_chord[i].shown &= ~released;
