@@ -365,6 +365,17 @@ int  ps3_ui_have_font(void);
 /* Compose the screen at w x h (4 bytes a pixel; BGRA when bgra, else RGBA).
  * 1 when composed, 0 when it cannot be (no font). */
 int  ps3_osd_saves_compose(const ps3_osd_saves_state* s, uint8_t* img, uint32_t w, uint32_t h, int bgra);
+/* M10.2: the screen's drawing for a port's own menu -- the same font, shapes and prompts. A canvas: w x h pixels of
+ * 4 bytes (BGRA when bgra). Colours 0xRRGGBB, a the opacity (0-255); text at baseline y, px high; a prompt's
+ * button 0 confirm, 1 back, size its height; text and buttons return their width. */
+typedef struct { uint8_t* p; int w, h, bgra; } ps3_ui_canvas;
+void  ps3_ui_fill(const ps3_ui_canvas* c, int x0, int y0, int x1, int y1, uint32_t rgb, int a);
+void  ps3_ui_rrect(const ps3_ui_canvas* c, float x0, float y0, float x1, float y1, float r, uint32_t rgb, int a);
+void  ps3_ui_rrect_outline(const ps3_ui_canvas* c, float x0, float y0, float x1, float y1, float r, float t,
+                           uint32_t rgb, int a);
+float ps3_ui_text(const ps3_ui_canvas* c, float x, float y, const char* s, int px, uint32_t rgb, int a, float maxw);
+float ps3_ui_text_width(const char* s, int px);
+float ps3_ui_button(const ps3_ui_canvas* c, int style, int button, float x, float cy, float size);
 /* The minute the screen's clock shows (it is recomposed when this changes). */
 long ps3_osd_saves_clock(void);
 /* A screen closed: the next one starts at its first rows. */
@@ -380,6 +391,31 @@ void ps3_osd_saves_reset(void);
 PS3_OSD_SHARED volatile uint32_t g_ps3_osd_presents = 0;
 PS3_OSD_SHARED int (*g_ps3_osd_present_again)(void) = 0;
 
+/* A port's own full-window menu (its in-game settings, M10): the port composes the whole picture at the window's
+ * size (want_w x want_h, BGRA when bgra -- both the backend's) and posts it; the backend copies it over the game's
+ * picture in every present while `open`. The frame under it: the port sets snap_want, the backend reads the game's
+ * last frame (RGBA, snap_w x snap_h) into `snap` and sets snap_ready. `lock` guards px/w/h/rev against the copy. */
+typedef struct {
+    volatile char  lock;
+    int            open;
+    uint32_t       rev, w, h;
+    const uint8_t* px;
+    uint32_t       want_w, want_h, drawn;
+    int            bgra;
+    int            snap_want, snap_ready;
+    uint32_t       snap_w, snap_h;
+    uint8_t*       snap;
+} ps3_osd_menu_state;
+
+PS3_OSD_SHARED ps3_osd_menu_state g_ps3_osd_menu = { 0 };
+
+/* A port that asks before the game closes: the window's close button (why 0) and Escape (why 1) go to it first;
+ * it returns 1 when it has taken the request (its own question), 0 to let the game close as before. */
+PS3_OSD_SHARED int (*g_ps3_host_close_request)(int why) = 0;
+
+static inline void ps3_osd_menu_lock(void)   { while (__atomic_test_and_set(&g_ps3_osd_menu.lock, __ATOMIC_ACQUIRE)) { } }
+static inline void ps3_osd_menu_unlock(void) { __atomic_clear(&g_ps3_osd_menu.lock, __ATOMIC_RELEASE); }
+
 #ifdef __cplusplus
 }
 #endif
