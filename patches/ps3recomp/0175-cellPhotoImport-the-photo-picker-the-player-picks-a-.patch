+}
+
+/* A picture's thumbnail for the picker's row, as a PNG the screen can read (osd_saves.c reads PNG only):
+ * <PS3_HDD1_ROOT>/photo_thumbnails/<name>.png (the system's cache), made again when the picture is newer.
+ * 0 when there is none: the row shows a neutral tile. */
+#define THUMB_W 480
+#define THUMB_H 270
+static int photo_thumbnail(const PhotoItem* it, char* out, size_t cap)
+{
+    const char* root = getenv("PS3_HDD1_ROOT");
+    if (!root || !*root) return 0;
+    char dir[1100];
+    snprintf(dir, sizeof dir, "%s/photo_thumbnails", root);
+    for (char* c = dir; *c; c++) if (*c == '\\') *c = '/';
+    snprintf(out, cap, "%s/%s.png", dir, it->name);
+    struct stat st;
+    if (stat(out, &st) == 0 && (long long)st.st_mtime >= it->mtime) return 1;
+    int w = 0, h = 0, comp = 0;
+    unsigned char* px = stbi_load(it->path, &w, &h, &comp, 3);
+    if (!px || w < 1 || h < 1) { if (px) stbi_image_free(px); return 0; }
+    /* fitted inside THUMB_W x THUMB_H, its aspect kept; each pixel the mean of the pixels it covers */
+    int tw = w, th = h;
+    if (tw > THUMB_W || th > THUMB_H) {
+        if ((long long)w * THUMB_H > (long long)h * THUMB_W) { tw = THUMB_W; th = (int)((long long)h * THUMB_W / w); }
+        else { th = THUMB_H; tw = (int)((long long)w * THUMB_H / h); }
+        if (tw < 1) tw = 1;
+        if (th < 1) th = 1;
+    }
+    unsigned char* t = (unsigned char*)malloc((size_t)tw * th * 3);
+    if (!t) { stbi_image_free(px); return 0; }
+    for (int y = 0; y < th; y++) {
+        const int y0 = (int)((long long)y * h / th), y1 = (int)((long long)(y + 1) * h / th);
+        for (int x = 0; x < tw; x++) {
+            const int x0 = (int)((long long)x * w / tw), x1 = (int)((long long)(x + 1) * w / tw);
+            unsigned long sum[3] = { 0, 0, 0 }, cnt = 0;
+            for (int sy = y0; sy < (y1 > y0 ? y1 : y0 + 1); sy++)
+                for (int sx = x0; sx < (x1 > x0 ? x1 : x0 + 1); sx++) {
+                    const unsigned char* s = px + ((size_t)sy * w + sx) * 3;
+                    sum[0] += s[0]; sum[1] += s[1]; sum[2] += s[2]; cnt++;
+                }
+            unsigned char* d = t + ((size_t)y * tw + x) * 3;
+            for (int c = 0; c < 3; c++) d[c] = (unsigned char)((sum[c] + cnt / 2) / cnt);
+        }
+    }
+    stbi_image_free(px);
+    photo_mkdirs(dir);
+    const int ok = stbi_write_png(out, tw, th, 3, t, tw * 3) != 0;
+    free(t);
+    return ok;
+}
+
+/* ---- the picker ---------------------------------------------------------- */
+
+extern void cellPad_ui_intercept(int on);
+extern u32  cellPad_ui_state(u32* ly);
+extern u32  cellPad_ui_keys(void);
+extern int  cellPad_ui_device(void);
+extern s32  cellPadGetData(u32 port_no, CellPadData* data_guest);
+
+/* guest memory for the picker's own pad reads (the title may not be polling while it waits): the runtime's window,
+ * after the import's file data */
+#define PHOTO_IMPORT_PAD_EA (VM_HLE_INJECT_BASE + 0x00F00000u + 0xA00u)
+
+static char s_last_pick[256];   /* the picture picked last: the picker comes back to it */
+
+static int photo_prompt_style(void)
+{
+    const char* e = getenv("PS3_UI_PROMPTS");
+    if (e && *e) {
+        if (!strcmp(e, "keyboard")) return PS3_UI_PROMPTS_KEYBOARD;
+        if (!strcmp(e, "playstation")) return PS3_UI_PROMPTS_PLAYSTATION;
+        if (!strcmp(e, "xbox")) return PS3_UI_PROMPTS_XBOX;
+        if (!strcmp(e, "switch")) return PS3_UI_PROMPTS_SWITCH;
+        if (!strcmp(e, "steam")) return PS3_UI_PROMPTS_STEAM;
+        if (!strcmp(e, "generic")) return PS3_UI_PROMPTS_GENERIC;
+    }
+    const int d = cellPad_ui_device();
+    return d >= 0 && d < PS3_UI_PROMPTS_N ? d : PS3_UI_PROMPTS_KEYBOARD;
+}
+
+static void photo_row(const PhotoItem* it, int number, ps3_osd_save_entry* r)
+{
+    memset(r, 0, sizeof *r);
+    snprintf(r->title, sizeof r->title, "Snapshot %d", number);
+    const time_t t = (time_t)it->mtime;
+    struct tm* lt = localtime(&t);
+    if (lt) strftime(r->date, sizeof r->date, "%a %b %d %H:%M:%S %Y", lt);
+    snprintf(r->size, sizeof r->size, "%llu KB", ((unsigned long long)it->size + 999) / 1000);
+    if (it->w && it->h) snprintf(r->lines[0], sizeof r->lines[0], "%d x %d", it->w, it->h);
+    char thumb[1200];
+    if (photo_thumbnail(it, thumb, sizeof thumb)) snprintf(r->icon, sizeof r->icon, "%s", thumb);
+}
+
+/* The screen at `cur`: the full-screen picture (a window of up to PS3_OSD_SAVES_MAX rows around `cur`) and the
+ * text panel beside it, drawn when the picture cannot be (no font). */
+static ps3_osd_saves_state s_screen;
+static ps3_osd_save_entry* s_rows;   /* the rows, made once each time the picker opens */
+
+static void photo_show(int n, int cur, int* top)
+{
+    /* the text panel */
+    const int page = PS3_OSD_LIST_ROWS / 3;
+    if (cur < *top) *top = cur;
+    if (cur >= *top + page) *top = cur - page + 1;
+    char rows[PS3_OSD_LIST_ROWS][PS3_OSD_LIST_COLS];
+    uint32_t r = 0;
+    int sel0 = 0;
+    for (int i = *top; i < n && i < *top + page; i++) {
+        if (i == cur) sel0 = (int)r;
+        snprintf(rows[r++], PS3_OSD_LIST_COLS, "%c %s", i == cur ? '>' : ' ', s_rows[i].title);
+        snprintf(rows[r++], PS3_OSD_LIST_COLS, "  %s", s_rows[i].date);
+        rows[r++][0] = 0;
+    }
+    char title[PS3_OSD_LIST_COLS];
+    snprintf(title, sizeof title, "ALBUM   (%d/%d)", cur + 1, n);
+    ps3_osd_list_post(title, "UP/DOWN: CHOOSE   CROSS (Z, ENTER): VIEW   CIRCLE (X): BACK", rows, r,
+                      (uint32_t)sel0, (uint32_t)sel0 + 1);
+    /* the picture */
+    ps3_osd_saves_state* S = &s_screen;
+    memset(S, 0, sizeof *S);
+    snprintf(S->heading, sizeof S->heading, "Album");
+    snprintf(S->empty, sizeof S->empty, "There are no snapshots.");
+    snprintf(S->ok_label, sizeof S->ok_label, "View");
+    snprintf(S->back_label, sizeof S->back_label, "Back");
+    S->prompts = (uint32_t)photo_prompt_style();
+    int first = 0;
+    if (n > PS3_OSD_SAVES_MAX) {
+        first = cur - PS3_OSD_SAVES_MAX / 2;
+        if (first < 0) first = 0;
+        if (first > n - PS3_OSD_SAVES_MAX) first = n - PS3_OSD_SAVES_MAX;
+    }
+    S->n = (uint32_t)(n - first < PS3_OSD_SAVES_MAX ? n - first : PS3_OSD_SAVES_MAX);
+    S->cur = (uint32_t)(cur - first);
+    for (uint32_t i = 0; i < S->n; i++) S->e[i] = s_rows[first + (int)i];
+    ps3_osd_saves_post(S);
+}
+
+/* a monotonic clock in milliseconds: the no-window rule counts real time (a 15 ms sleep lasts 15.0 ms on Linux,
+ * 15.6 ms or more on Windows -- counting the sleeps made the rule's length differ between them) */
+static unsigned long long photo_now_ms(void)
+{
+#ifdef _WIN32
+    return (unsigned long long)GetTickCount64();
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000ull + (unsigned long long)(ts.tv_nsec / 1000000);
+#endif
+}
+
+static void photo_sleep_ms(int ms)
+{
+#ifdef _WIN32
+    Sleep((DWORD)ms);
+#else
+    struct timespec ts = { 0, (long)ms * 1000000L };
+    nanosleep(&ts, NULL);
+#endif
+}
+
+/* 1: picked (*cur); 0: backed out; -1: not shown (no window draws it). Blocks the calling thread, as the
+ * save list does; the picker presents its own picture while the title presents nothing. */
+static int photo_pick(const PhotoItem* list, int n, int* cur)
+{
+    s_rows = (ps3_osd_save_entry*)calloc((size_t)n, sizeof *s_rows);
+    if (!s_rows) return -1;
+    for (int i = 0; i < n; i++) photo_row(&list[i], n - i, &s_rows[i]);   /* the oldest is Snapshot 1 */
+    int top = 0, result = -2;
+    ps3_osd_saves_reset();
+    photo_show(n, *cur, &top);
+    const uint32_t first_rev = __atomic_load_n(&g_ps3_osd_list.rev, __ATOMIC_ACQUIRE);
+    const uint32_t first_screen = __atomic_load_n(&g_ps3_osd_saves.rev, __ATOMIC_ACQUIRE);
+    cellPad_ui_intercept(1);
+    printf("[cellPhotoImport] picker: %d picture(s), focus %d (%s)\n", n, *cur, list[*cur].name);
+    fflush(stdout);
+    u32 last = 0xFFFFFFFFu;   /* a button held as the picker opens (the one that left the picture) is released first */
+    unsigned held_ms = 0, still_ms = 0;
+    const unsigned long long opened = photo_now_ms();
+    const char* pad_file = getenv("PAD_FILE");
+    const unsigned long long headless_ms = pad_file && *pad_file ? 30000ull : 4000ull;
+    uint32_t seen_presents = __atomic_load_n(&g_ps3_osd_presents, __ATOMIC_ACQUIRE);
+    for (;;) {
+        photo_sleep_ms(15);
+        /* the title presenting nothing meanwhile, the picker presents its picture itself (cellSaveData.c) */
+        const uint32_t pc = __atomic_load_n(&g_ps3_osd_presents, __ATOMIC_ACQUIRE);
+        if (pc != seen_presents) { seen_presents = pc; still_ms = 0; }
+        else if ((still_ms += 15) >= 45 && g_ps3_osd_present_again) {
+            g_ps3_osd_present_again();
+            seen_presents = __atomic_load_n(&g_ps3_osd_presents, __ATOMIC_ACQUIRE);
+            still_ms = 0;
+        }
+        /* headless: nothing can draw the picker and no player can pick -- back out, never a loop */
+        if (!g_ps3_osd_present_again && photo_now_ms() - opened >= headless_ms &&
+            __atomic_load_n(&g_ps3_osd_list.drawn, __ATOMIC_ACQUIRE) < first_rev &&
+            __atomic_load_n(&g_ps3_osd_saves.drawn, __ATOMIC_ACQUIRE) < first_screen) { result = -1; break; }
+        cellPadGetData(0, (CellPadData*)(uintptr_t)PHOTO_IMPORT_PAD_EA);   /* feeds cellPad_ui_state */
+        u32 ly = 128;
+        u32 b = cellPad_ui_state(&ly) | cellPad_ui_keys();   /* the keyboard's Esc and Backspace: back */
+        if (ly < 64) b |= CELL_PAD_CTRL_UP;
+        if (ly > 192) b |= CELL_PAD_CTRL_DOWN;
+        if (last == 0xFFFFFFFFu) { if (b == 0) last = 0; continue; }
+        const u32 edge = b & ~last;
+        const u32 dir = b & (CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN);
+        if (dir && dir == (last & (CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN))) held_ms += 15; else held_ms = 0;
+        int step = 0;
+        if (edge & CELL_PAD_CTRL_UP) step = -1;
+        else if (edge & CELL_PAD_CTRL_DOWN) step = 1;
+        else if (held_ms >= 400 && (held_ms - 400) % 120 < 15) step = (b & CELL_PAD_CTRL_UP) ? -1 : 1;
+        last = b;
+        if (step) {
+            *cur = (*cur + step + n) % n;
+            photo_show(n, *cur, &top);
+        }
+        if (edge & (CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_START)) { result = 1; break; }
+        if (edge & CELL_PAD_CTRL_CIRCLE) { result = 0; break; }
+    }
+    ps3_osd_saves_close();
+    ps3_osd_list_close();
+    cellPad_ui_intercept(0);
+    free(s_rows);
+    s_rows = NULL;
+    printf("[cellPhotoImport] picker: %s\n", result == 1 ? list[*cur].name : result == 0 ? "backed out (cancel)"
+                                                        : "not shown (nothing draws it): cancel");
+    fflush(stdout);
+    return result;
 }
 
 s32 cellPhotoImport(u32 version, u32 dstHddPath, u32 param, u32 container, u32 funcFinish, u32 userdata)
@@ -84,8 +368,21 @@ s32 cellPhotoImport(u32 version, u32 dstHddPath, u32 param, u32 container, u32 f
     char dst_dir[1024], host_dir[1400], pick[1400] = "";
     photo_guest_str(dst_dir, sizeof dst_dir, dstHddPath);
     const char* forced = getenv("PS3_PHOTO_IMPORT");
-    if (forced && *forced) snprintf(pick, sizeof pick, "%s", forced);
-    else newest_photo(pick, sizeof pick);
+    if (forced && *forced) {
+        snprintf(pick, sizeof pick, "%s", forced);
+    } else {
+        PhotoItem* list = (PhotoItem*)calloc(PHOTO_LIST_MAX, sizeof(PhotoItem));
+        const int n = list ? list_photos(list) : 0;
+        if (n > 0) {
+            int cur = 0;
+            for (int i = 0; i < n; i++) if (s_last_pick[0] && !strcmp(list[i].name, s_last_pick)) cur = i;
+            if (photo_pick(list, n, &cur) == 1) {
+                snprintf(pick, sizeof pick, "%s", list[cur].path);
+                snprintf(s_last_pick, sizeof s_last_pick, "%s", list[cur].name);
+            }
+        }
+        free(list);
+    }
 
     s32 result = CELL_PHOTO_IMPORT_RET_CANCEL;
     if (pick[0]) {
