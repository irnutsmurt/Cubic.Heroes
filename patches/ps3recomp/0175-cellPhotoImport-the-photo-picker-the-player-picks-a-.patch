-static int newest_photo(char* out, size_t cap)
+/* The photo column's pictures. */
+typedef struct {
+    char      name[256];     /* the file's name */
+    char      path[1400];    /* host path */
+    long long mtime;         /* seconds */
+    long long size;          /* bytes */
+    int       w, h;          /* 0 when the header cannot be read */
+} PhotoItem;
+
+#define PHOTO_LIST_MAX 4096
+
+static void photo_add(PhotoItem* list, int* n, const char* dir, const char* name, long long mtime, long long size)
+{
+    if (*n >= PHOTO_LIST_MAX) return;
+    PhotoItem* it = &list[*n];
+    memset(it, 0, sizeof *it);
+    snprintf(it->name, sizeof it->name, "%s", name);
+    snprintf(it->path, sizeof it->path, "%s/%s", dir, name);
+    it->mtime = mtime;
+    it->size = size;
+    int comp = 0;
+    if (!stbi_info(it->path, &it->w, &it->h, &comp)) it->w = it->h = 0;
+    (*n)++;
+}
+
+/* Newest first; at the same second the longer, then the higher name first (Capture_10 before Capture_9). */
+static int photo_cmp(const void* a, const void* b)
+{
+    const PhotoItem* x = (const PhotoItem*)a;
+    const PhotoItem* y = (const PhotoItem*)b;
+    if (x->mtime != y->mtime) return x->mtime > y->mtime ? -1 : 1;
+    const size_t lx = strlen(x->name), ly = strlen(y->name);
+    if (lx != ly) return lx > ly ? -1 : 1;
+    return -strcmp(x->name, y->name);
+}
+
+/* Every picture in the photo column's folder, newest first; the count (0: none, or no folder). */
+static int list_photos(PhotoItem* list)
 {
     char dir[1024];
     if (!photo_library_dir(dir, sizeof dir)) return 0;
-    long long best = -1;
+    int n = 0;
 #ifdef _WIN32
     char pat[1100];
     snprintf(pat, sizeof pat, "%s/*", dir);
@@ -50,8 +106,12 @@ static int newest_photo(char* out, size_t cap)
     if (h == INVALID_HANDLE_VALUE) return 0;
     do {
         if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || !is_picture(fd.cFileName)) continue;
-        const long long t = (long long)fd.ftLastWriteTime.dwHighDateTime << 32 | fd.ftLastWriteTime.dwLowDateTime;
-        if (t > best) { best = t; snprintf(out, cap, "%s/%s", dir, fd.cFileName); }
+        /* FILETIME (100 ns since 1601) to seconds since 1970 */
+        const unsigned long long ft = (unsigned long long)fd.ftLastWriteTime.dwHighDateTime << 32 |
+                                      fd.ftLastWriteTime.dwLowDateTime;
+        const long long t = (long long)(ft / 10000000ULL) - 11644473600LL;
+        const long long sz = (long long)fd.nFileSizeHigh << 32 | fd.nFileSizeLow;
+        photo_add(list, &n, dir, fd.cFileName, t, sz);
     } while (FindNextFileA(h, &fd));
     FindClose(h);
