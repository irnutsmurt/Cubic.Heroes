@@ -62,14 +122,238 @@ static int newest_photo(char* out, size_t cap)
         char p[1400];
         struct stat st;
         snprintf(p, sizeof p, "%s/%s", dir, e->d_name);
-        if (stat(p, &st) == 0 && S_ISREG(st.st_mode) && (long long)st.st_mtime > best) {
-            best = (long long)st.st_mtime;
-            snprintf(out, cap, "%s", p);
-        }
+        if (stat(p, &st) == 0 && S_ISREG(st.st_mode))
+            photo_add(list, &n, dir, e->d_name, (long long)st.st_mtime, (long long)st.st_size);
     }
     closedir(d);
 #endif
-    return best >= 0;
+    qsort(list, (size_t)n, sizeof *list, photo_cmp);
