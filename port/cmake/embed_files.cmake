# cmake -DOUT=<file.c> -DDIR=<dir> -DFILES="a|b|c" -P embed_files.cmake
# Writes a C source with each file's bytes as an array, and a table of them:
#   const struct embedded_file embedded_files[]  { name, data, size }
#   const unsigned embedded_files_count
# (port/ui_assets.cpp registers the UI's font and prompt images from it.)
string(REPLACE "|" ";" FILES "${FILES}")
set(_c "/* Generated by port/cmake/embed_files.cmake. Do not edit. */\n")
string(APPEND _c "#include <stddef.h>\nstruct embedded_file { const char* name; const unsigned char* data; size_t size; };\n")
set(_table "")
set(_i 0)
foreach(_f IN LISTS FILES)
  file(READ "${DIR}/${_f}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _size "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  # a line break every 32 bytes keeps the file readable by tools
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
  string(APPEND _c "static const unsigned char f${_i}[${_size}] = {\n${_bytes}\n};\n")
  string(APPEND _table "  { \"${_f}\", f${_i}, ${_size} },\n")
  math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _c "const struct embedded_file embedded_files[] = {\n${_table}};\n")
string(APPEND _c "const unsigned embedded_files_count = ${_i};\n")
file(WRITE "${OUT}.tmp" "${_c}")
file(RENAME "${OUT}.tmp" "${OUT}")
