# Scenario: the way to the first dungeon and its first minute
# (SCENARIO=dungeon1_approach tests/boot_smoke.py).
#
# Starts from: build/checkpoints/before-dungeon1 -- the owner's save at the
#   castle (field area 17) before the session's dungeon trip (2026-11-02,
#   build/sessions/boot-20261102-134835-owner-play: area 17 -> 16 -> 15 -> the
#   dungeon, area 37, at 985 s; its boss in area 38 at ~1,580 s).
# Settings: the validated 60 fps configuration, the state probes, marks, the
#   frame log, on screen with the readout; normal damage.
# Reaching it: CONTINUE -- which puts the hero in front of the town's inn,
#   field area 16 at (96.8, -186.4), not where the save was made -- then the
#   owner's own route as positions (tests/route_from_record.py --from 900 --to
#   1000: `goto` waypoints, each area change walked on across the edge and
#   confirmed): out of town west into 15, north through the dungeon's door
#   into 37.
# Started when: in area 37, alive.
# Completed when: the owner's first ~25 s inside 37 walked -- two dialogues
#   paged and a floor switch that opens the next door, the owner's own button
#   presses replayed where they were made -- alive, in 37, and more than 8 units
#   north of where the segment began.
# Reset / retry: a failure (death, a stage not reached, the wrong area) is
#   recorded; the way back is the system menu's TITLE and CONTINUE (after a
#   death, "Continue?" YES first); two tries at most.
# Cycles: RUNS of them (default 1).
#! saves build/checkpoints/before-dungeon1
#! env DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=4,5,6 GCM_WRAP_LAP=1 DOTHEROES_PRESENT_ONCE=1
#! env DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_KEYS=1 DIAG_FRAMES=frames.log PS3_VERBOSE=0
#! env WINDOW=1 VISIBLE=1 TOPMOST=1 GRAB_EVERY=20 PS3_OSD_FPS=2 DUMP=0 SHOT_EVERY=0
#! secs 900
include common.drive

include dungeon1_route.drive

log TitleMovie 120
sleep 5
call continue
state life>0 90
sleep 3

loop ${RUNS:-1}
  attempt 2 back_to_start
    expect life>0
    segment route castle-to-dungeon
    call route_to_dungeon
    endseg
    expect life>0,area==37
    segment explore dungeon-entry
    goto 89.9 -133.6 0.25 10 soft   # just inside the door
    call dungeon_entry
    endseg hz>+8              # past the dialogues and the switch, ~10 units north of the door: a hero stuck there does not pass
    expect
    segment menu back-to-start
    call to_title_and_continue
    state life>0 60
    endseg
  end
end
