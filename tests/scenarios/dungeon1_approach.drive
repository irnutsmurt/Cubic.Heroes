# Scenario: the way to the first dungeon and its first minute
# (SCENARIO=dungeon1_approach tests/boot_smoke.py).
#
# Starts from: build/checkpoints/before-dungeon1 -- the owner's save at the
#   castle (field area 17) before the session's dungeon trip (2026-11-02,
#   build/sessions/boot-20261102-134835-owner-play: area 17 -> 16 -> 15 -> the
#   dungeon, area 37, at 985 s; its boss in area 38 at ~1,580 s).
# Settings: the validated 60 fps configuration, the state probes, marks, the
#   frame log, on screen with the readout; normal damage.
# Reaching it: CONTINUE -- which puts the hero in front of the town's inn,
#   field area 16 at (96.8, -186.4), not where the save was made -- then the
#   owner's own route as positions (tests/route_from_record.py --from 900 --to
#   1000: `goto` waypoints, each area change walked on across the edge and
#   confirmed): out of town west into 15, north through the dungeon's door
#   into 37.
# Started when: in area 37, alive.
# Completed when: the owner's first ~25 s inside 37 walked -- two dialogues
#   paged and a floor switch that opens the next door, the owner's own button
#   presses replayed where they were made -- alive, in 37, and more than 8 units
#   north of where the segment began.
# Reset / retry: a failure (death, a stage not reached, the wrong area) is
#   recorded; the way back is the system menu's TITLE and CONTINUE (after a
#   death, "Continue?" YES first); two tries at most.
# Cycles: RUNS of them (default 1).
#! saves build/checkpoints/before-dungeon1
#! env DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=4,5,6 GCM_WRAP_LAP=1 DOTHEROES_PRESENT_ONCE=1
#! env DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_KEYS=1 DIAG_FRAMES=frames.log PS3_VERBOSE=0
#! env WINDOW=1 VISIBLE=1 TOPMOST=1 GRAB_EVERY=20 PS3_OSD_FPS=2 DUMP=0 SHOT_EVERY=0
#! secs 900
include common.drive

block route_to_dungeon      # from the inn: the owner's way out of town (west), across 15, into the dungeon
  # tests/route_from_record.py <the session> --from 924 --to 986 --eps 1
  state area==16,life>0 60
  goto 108.3 -189.6 2 25
  goto 111.6 -190.0 2 25
  goto 70.7 -190.0 2 25
  goto 67.6 -193.3 2 25
  goto 62.4 -192.8 2 25
  goto 62.4 -183.2 2 25
  goto 58.2 -166.3 2 25
  goto 57.5 -138.8 2 25
  goto 56.7 -134.8 2 25
  goto 53.3 -141.9 2 25
  cross LEFT 15 20           # on across the town's west edge
  goto 147.7 -141.9 2 25
  goto 141.1 -140.4 2 25
  goto 139.6 -137.8 2 25
  goto 147.7 -136.6 2 25
  goto 147.7 -133.9 2 25
  goto 146.1 -133.6 2 25
  goto 147.5 -129.0 2 25
  goto 147.1 -120.6 2 25
  goto 147.1 -122.8 2 25
  goto 141.8 -130.1 2 25
  goto 141.0 -154.0 2 25
  goto 143.4 -159.7 2 25
  goto 146.1 -161.5 2 25
  goto 145.9 -171.0 2 25
  goto 142.8 -175.4 2 25
  goto 139.9 -175.3 2 25
  goto 138.1 -169.5 2 25
  goto 129.7 -168.8 2 25
  goto 126.8 -166.1 2 25
  goto 126.0 -160.8 2 25
  goto 122.7 -158.1 2 25
  goto 112.5 -158.3 2 25
  goto 111.2 -161.0 2 25
  goto 117.1 -156.8 2 25
  goto 117.1 -128.5 2 25
  cross UP 37 20             # through the dungeon's door
end

block dungeon_entry          # the owner's first ~25 s inside (986-1010 s): tight waypoints, the owner's buttons where pressed
  # tests/route_from_record.py <the session> --from 986 --to 1010 --eps 0.5 --tol 0.25 --timeout 10 --soft --buttons
  # (two dialogues paged with CROSS; a floor switch opens the next door). Further on the room has a
  # fight the replayed presses do not get through (the hero stuck near (89, -116)): not yet a test.
  goto 89.9 -133.6 0.25 10 soft
  goto 89.9 -128.8 0.25 10 soft
  unstick LEFT 8            # the first dialogue ("The door leading further in is closed.") closed
  sleep 0.16
  press CROSS   # 991.8 s
  sleep 1.50
  press CROSS   # 993.6 s
  sleep 0.45
  press CROSS   # 994.1 s
  sleep 0.91
  press CROSS   # 995.0 s
  goto 84.0 -125.6 0.25 10 soft
  sleep 1.50
  press CROSS   # 999.3 s
  sleep 1.40
  press CROSS   # 1000.7 s
  sleep 0.63
  press CROSS   # 1001.3 s
  sleep 1.50
  press CROSS   # 1003.5 s
  sleep 0.62
  press CROSS   # 1004.1 s
  sleep 1.50
  press CROSS   # 1005.9 s
  unstick UP 8              # the switch's dialogue closed, whenever it opened
  goto 84.5 -120.8 0.25 10 soft
  goto 89.4 -118.4 0.25 10 soft
end

log TitleMovie 120
sleep 5
call continue
state life>0 90
sleep 3

loop ${RUNS:-1}
  attempt 2 back_to_start
    expect life>0
    segment route castle-to-dungeon
    call route_to_dungeon
    endseg
    expect life>0,area==37
    segment explore dungeon-entry
    call dungeon_entry
    endseg hz>+8              # past the dialogues and the switch, ~10 units north of the door: a hero stuck there does not pass
    expect
    segment menu back-to-start
    call to_title_and_continue
    state life>0 60
    endseg
  end
end
