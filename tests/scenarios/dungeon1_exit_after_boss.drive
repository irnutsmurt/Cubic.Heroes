# Scenario: out of the first dungeon onto field 15 with its boss beaten
# (SCENARIO=dungeon1_exit_after_boss tests/boot_smoke.py) -- the transition
# where both of the owner's R4 boss sessions had one PPFX draw sample a
# display buffer the native renderer has no copy of (docs/NATIVE_R4.md
# section 6); dungeon1_exit.drive, the same walk before the boss, has none.
#
# Starts from: build/checkpoints/dungeon1-boss-beaten (saved in area 38, the
#   boss beaten, life 12; CONTINUE places the hero at the dungeon's
#   entrance in area 37, as for dungeon1-boss-door -- the state check says
#   if it does not).
# Route: south through the entrance into field 15, then standing there.
# Completed when: in field 15, 8 s after arriving.
#! saves build/checkpoints/dungeon1-boss-beaten
#! env DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=4,5,6 GCM_WRAP_LAP=1 DOTHEROES_PRESENT_ONCE=1
#! env DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_KEYS=1 DIAG_FRAMES=frames.log PS3_VERBOSE=0
#! env WINDOW=1 VISIBLE=1 TOPMOST=1 PS3_OSD_FPS=0 DUMP=0 SHOT_EVERY=0
#! secs 150
include common.drive

log TitleMovie 120
sleep 5
call continue
state area==37,life>0 90
sleep 3
cross DOWN 15 20
sleep 8
