# Scenario: what a save inside the first dungeon keeps (SCENARIO=dungeon1_persist).
#
# Starts from: build/checkpoints/dungeon1-entrance (CONTINUE: just inside the
#   dungeon's door, area 37 at (88.8, -130.4)).
# Then: the first room, the north room's fight, the east room's fight, chest
#   and key, through the locked door (dungeon1_route.drive) -- then the system
#   menu's SAVE (into the run's own copy), TITLE and CONTINUE, and the way back
#   to the locked door with no fight and no chest: the first room's switch
#   door, the north room, west, the locked door.
# What it shows: where CONTINUE restores this save (the `state` after the
#   menu segment); whether the doors stayed open -- the hero north of the
#   locked door (z > -95) at the end means the switch, the key and the door
#   were kept; stopped at a door says which was not; the `actors` lines say
#   whether the rooms' enemies came back.
# Exploratory; run it with DOTHEROES_DEV_CANT_DIE=1 (the rooms may refill).
#! saves build/checkpoints/dungeon1-entrance
#! env DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=4,5,6 GCM_WRAP_LAP=1 DOTHEROES_PRESENT_ONCE=1
#! env DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_KEYS=1 DIAG_FRAMES=frames.log PS3_VERBOSE=0
#! env WINDOW=1 VISIBLE=1 TOPMOST=1 GRAB_EVERY=10 PS3_OSD_FPS=2 DUMP=0 SHOT_EVERY=0
#! secs 700
include common.drive
include dungeon1_route.drive

log TitleMovie 120
sleep 5
call continue
state area==37,life>0 90
sleep 3

attempt 2 back_to_start
  expect life>0,area==37
  segment explore dungeon-room1
  call dungeon_entry
  endseg
  segment explore dungeon-room2
  call room2
  endseg
  segment explore dungeon-east-key
  call east_key
  endseg hz>+8
end
expect
state area==37,life>0 10      # where the save is made
press START                   # SAVE (saves at once), then RESUME
sleep 2
state menu==1 5
press DOWN
sleep 1
press CROSS
sleep 6
press UP
sleep 1
press CROSS
sleep 2
state menu==3 10
segment menu save-title-continue
call to_title_and_continue
state area==37,life>0 60
endseg
sleep 3
state life>0 5                # where CONTINUE restored the hero
segment explore persist-walk  # back to the locked door, nothing fought, nothing opened
  goto 89.9 -128.8 0.25 10 soft
  unstick LEFT 8              # the first room's dialogue, if it comes again
  goto 89.9 -120.0 0.4 10 soft
  goto 89.4 -114.3 0.5 10 soft   # the switch's door
  state life>0 1
  goto 90.3 -108.7 0.5 10 soft
  goto 90.0 -101.0 0.5 10 soft   # the north room
  actors
  goto 83.4 -98.4 0.5 10 soft
  goto 76.8 -104.7 0.5 10 soft
  goto 65.8 -103.2 0.5 10 soft
  goto 64.2 -97.0 0.5 10 soft    # the locked door
  hold UP 1.2
  unstick DOWN 4
  state life>0 1                 # north of -95: through it
endseg
