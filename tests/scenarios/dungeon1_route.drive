# The first dungeon's route blocks, shared by dungeon1_approach.drive and
# dungeon1_save_continue.drive, dungeon1_room2.drive and dungeon1_persist.drive
# (`include dungeon1_route.drive`): the owner's way
# from the inn into the dungeon, and its first room up to past the floor switch.

block route_to_dungeon      # from the inn: the owner's way out of town (west), across 15, into the dungeon
  # tests/route_from_record.py <the session> --from 924 --to 986 --eps 1
  state area==16,life>0 60
  goto 108.3 -189.6 2 25
  goto 111.6 -190.0 2 25
  goto 70.7 -190.0 2 25
  goto 67.6 -193.3 2 25
  goto 62.4 -192.8 2 25
  goto 62.4 -183.2 2 25
  goto 58.2 -166.3 2 25
  goto 57.5 -138.8 2 25
  goto 56.7 -134.8 2 25
  goto 53.3 -141.9 2 25
  # The gap in the cliff is south of z -140: from -140.0 the hero walked into
  # the cliff's corner for 20 s (3 of 10 cycles, 2026-11-02 dungeon-mem10).
  goto 56.0 -142.6 0.4 10 soft
  cross LEFT 15 20           # on across the town's west edge
  goto 147.7 -141.9 2 25
  goto 141.1 -140.4 2 25
  goto 139.6 -137.8 2 25
  goto 147.7 -136.6 2 25
  goto 147.7 -133.9 2 25
  goto 146.1 -133.6 2 25
  goto 147.5 -129.0 2 25
  goto 147.1 -120.6 2 25
  goto 147.1 -122.8 2 25
  goto 141.8 -130.1 2 25
  goto 141.0 -154.0 2 25
  goto 143.4 -159.7 2 25
  goto 146.1 -161.5 2 25
  goto 145.9 -171.0 2 25
  goto 142.8 -175.4 2 25
  goto 139.9 -175.3 2 25
  goto 138.1 -169.5 2 25
  goto 129.7 -168.8 2 25
  goto 126.8 -166.1 2 25
  goto 126.0 -160.8 2 25
  goto 122.7 -158.1 2 25
  goto 112.5 -158.3 2 25
  goto 111.2 -161.0 2 25
  goto 117.1 -156.8 2 25
  goto 117.1 -128.5 2 25
  cross UP 37 20             # through the dungeon's door
end

block dungeon_entry          # the owner's first ~25 s inside (986-1010 s): tight waypoints, the owner's buttons where pressed
  # tests/route_from_record.py <the session> --from 986 --to 1010 --eps 0.5 --tol 0.25 --timeout 10 --soft --buttons
  # (two dialogues paged with CROSS; a floor switch opens the next door). Further on the room has a
  # fight the replayed presses do not get through (the hero stuck near (89, -116)): not yet a test.
  # (from the door: callers that walked in step to 89.9 -133.6 first; from the
  # dungeon1-entrance checkpoint the hero starts inside it, and that step walks out)
  goto 89.9 -128.8 0.25 10 soft
  unstick LEFT 8            # the first dialogue ("The door leading further in is closed.") closed
  sleep 0.16
  press CROSS   # 991.8 s
  sleep 1.50
  press CROSS   # 993.6 s
  sleep 0.45
  press CROSS   # 994.1 s
  sleep 0.91
  press CROSS   # 995.0 s
  goto 84.0 -125.6 0.25 10 soft
  sleep 1.50
  press CROSS   # 999.3 s
  sleep 1.40
  press CROSS   # 1000.7 s
  sleep 0.63
  press CROSS   # 1001.3 s
  sleep 1.50
  press CROSS   # 1003.5 s
  sleep 0.62
  press CROSS   # 1004.1 s
  sleep 1.50
  press CROSS   # 1005.9 s
  unstick UP 8              # the switch's dialogue closed, whenever it opened
  goto 84.5 -120.8 0.25 10 soft
  goto 89.4 -118.4 0.25 10 soft
end


block room2                    # north through the opened door, the room's fight, its locked door
  # The owner's way (record 1,006-1,045 s; tests/route_from_record.py --from 1006.5 --to 1045):
  # north through the door the switch opened, the room's enemies (class FE4500,
  # the river's) fought, then west to the locked north door at (63.3, -97). The
  # replayed presses alone left the enemies alive and the hero at that door
  # with "You need a key." open (room2-cantdie, 2026-11-02): now `fight`.
  goto 89.4 -114.3 0.5 10 soft
  goto 90.3 -108.7 0.5 10 soft
  goto 90.0 -101.0 0.5 10 soft
  fight FE4500 90
  sleep 2
  actors
  goto 87.0 -98.4 0.5 10 soft    # the owner's way after the fight: east and back
  goto 82.6 -98.4 0.5 10 soft    # (what the fight drops -- the key? -- picked up)
  goto 99.4 -98.4 0.5 15 soft
  goto 83.4 -98.4 0.5 15 soft
  # (the owner went west to the locked door next and was turned away: the key
  # is in the east room -- see east_key)
end

block east_key                 # the owner's 1,044-1,091 s: the east room's fight, the key, the locked door, through it
  # tests/route_from_record.py <the session> --from 1043 --to 1092 --eps 0.4 --tol 0.5 --soft --buttons
  # (its item-menu presses left out). The owner swung through the east room
  # (x 104-119), opened its chest at the north-west corner, walked back west
  # to the locked door and through it at 1,087 s.
  goto 94.3 -108.8 0.5 10 soft
  goto 100.5 -106.5 0.5 10 soft
  goto 104.3 -106.5 0.5 10 soft
  goto 108.5 -106.5 0.5 10 soft  # straight in through its doorway (aimed diagonally, the hero stuck in it)
  goto 111.3 -110.0 0.5 10 soft
  fight any 90
  sleep 2
  actors list
  # The chest, then the door: whether the key was had shows only at the door,
  # so a door that stays shut sends the hero back to the chest.
  attempt 3 back_to_chest
    call chest
    call locked_door
  end
  goto 63.4 -90.4 0.5 10 soft
  goto 66.7 -87.2 0.5 10 soft
end

block chest                    # the east room's chest, against its north wall, centred near x 105.8
  # (pushing up from x 106.6-106.9 the hero slid east round it, from 107.8 nothing
  # stopped it: persist8's moves)
  # The owner pushed up into it from (106.7, -101.6) and pressed CROSS once to
  # open it and twice for the key's message (record 1,067.8-1,069.2 s, the
  # analog stick up). Up against it from across its width, CROSS at each (a
  # press at an opened chest only swings the sword).
  goto 105.8 -103.6 0.2 8 soft
  hold UP 0.4
  sleep 0.4
  press CROSS
  sleep 2.5
  press CROSS
  sleep 1.2
  press CROSS
  sleep 0.8
  goto 105.3 -103.6 0.2 8 soft
  hold UP 0.4
  sleep 0.4
  press CROSS
  sleep 2.5
  press CROSS
  sleep 1.2
  press CROSS
  sleep 0.8
  goto 106.3 -103.6 0.2 8 soft
  hold UP 0.4
  sleep 0.4
  press CROSS
  sleep 2.5
  press CROSS
  sleep 1.2
  press CROSS
  sleep 0.8
  unstick DOWN 8
end

block locked_door              # west to the locked door, centred, and through it
  goto 99.3 -106.4 0.5 15 soft
  goto 91.6 -107.4 0.5 10 soft
  goto 84.0 -102.9 0.5 10 soft
  goto 76.8 -104.7 0.5 10 soft
  goto 65.8 -103.2 0.5 10 soft
  goto 64.0 -98.2 0.2 10 soft    # the door is narrow: from x 64.4-64.8 it stayed shut
  hold UP 0.3
  press CROSS                    # open it with the key
  sleep 1.5
  hold UP 1.2
  state hz>@-96.3 2              # through it: the door line is at -97 (fails: no key -- back to the chest)
end

block back_to_chest
  unstick DOWN 4
  goto 65.8 -103.2 0.5 10 soft
  goto 76.8 -104.7 0.5 10 soft
  goto 84.0 -102.9 0.5 10 soft
  goto 91.6 -107.4 0.5 10 soft
  goto 99.3 -106.4 0.5 15 soft
  goto 104.3 -106.5 0.5 10 soft
  goto 108.5 -106.5 0.5 10 soft
end


block past_key_door            # from CONTINUE at the dungeon's door (switch and key doors kept open) through the key's door
  goto 89.9 -128.8 0.25 10 soft
  unstick LEFT 8               # the first room's dialogue, if it comes again
  goto 89.9 -120.0 0.4 10 soft
  goto 89.4 -114.3 0.5 10 soft
  goto 90.3 -108.7 0.5 10 soft
  goto 90.0 -101.0 0.5 10 soft
  fight FE4500 60              # its enemies come back after CONTINUE and block the way west
  goto 83.4 -98.4 0.5 10 soft
  goto 76.8 -104.7 0.5 10 soft
  goto 65.8 -103.2 0.5 10 soft
  goto 64.0 -98.2 0.2 10 soft
  hold UP 1.2
  state hz>@-96.3 3            # through the key's door
  goto 63.4 -90.4 0.5 10 soft
end

block west_rooms               # the owner's 1,088-1,146 s: the west room's enclosure -- its switch, its chest -- and back to (64.5, -76.6)
  # tests/route_from_record.py <the session> --from 1088 --to 1146 --eps 0.6 --tol 0.5 --soft --buttons
  # (map and L2 presses left out). The owner circled the walled enclosure, swung at a bat on its
  # north side, pushed a block of its south wall in at x ~39 and opened its chest facing up from
  # (39.1, -87.0).
  goto 66.7 -87.2 0.5 10 soft
  goto 64.7 -82.4 0.3 6 soft   # where it was pressed
  press LEFT 1                # face left
  press CROSS   # 1089.2 s
  goto 64.7 -82.4 0.5 10 soft
  goto 59.2 -80.0 0.5 10 soft
  goto 56.8 -82.7 0.5 10 soft
  goto 49.6 -86.0 0.5 10 soft
  fight any 40 soft            # the doorway's bats (the owner swung four times from here)
  press DOWN 1                # face down
  sleep 0.40
  press CROSS   # 1096.0 s
  sleep 0.95
  press CROSS   # 1097.0 s
  sleep 0.46
  press CROSS   # 1097.4 s
  sleep 1.50
  press CROSS   # 1099.5 s
  goto 47.2 -86.0 0.5 10 soft
  goto 46.5 -80.8 0.3 6 soft   # where it was pressed
  press LEFT 1                # face left
  press CROSS   # 1102.6 s
  goto 46.0 -79.2 0.5 10 soft
  goto 35.7 -79.2 0.3 6 soft   # where it was pressed
  press LEFT 1                # face left
  press CROSS   # 1104.3 s
  goto 32.0 -79.2 0.5 10 soft
  goto 29.7 -79.8 0.3 6 soft   # where it was pressed
  press DOWN 1                # face down
  press CROSS   # 1105.8 s
  goto 28.0 -80.2 0.5 10 soft
  goto 28.5 -85.2 0.5 10 soft
  goto 29.7 -87.3 0.5 10 soft
  goto 29.7 -83.4 0.5 10 soft
  goto 31.9 -80.9 0.5 10 soft
  goto 43.6 -81.0 0.3 6 soft   # where it was pressed
  press DOWN 1                # face down
  press CROSS   # 1119.4 s
  goto 47.2 -81.2 0.5 10 soft
  goto 47.2 -89.9 0.5 10 soft
  goto 44.1 -92.9 0.5 10 soft
  goto 44.1 -92.3 0.3 6 soft   # where it was pressed
  press UP 1                # face up
  goto 44.0 -92.0 0.5 10 soft
  goto 39.7 -92.0 0.5 10 soft
  goto 39.2 -92.2 0.25 8 soft    # under the notch in the enclosure's south wall
  hold UP 3.0                    # push its block in (the owner moved 3 units north in 2 s here)
  state hz>@-89.5 2              # in: the block went
  goto 39.1 -87.0 0.5 10 soft
  press UP 1                # face up
  sleep 0.68
  press CROSS   # 1132.3 s
  goto 37.6 -87.0 0.3 6 soft   # where it was pressed
  press CROSS   # 1133.5 s
  goto 37.2 -87.0 0.5 10 soft
  press UP 1                # face up
  sleep 0.43
  press CROSS   # 1134.2 s
  sleep 0.41
  press CROSS   # 1134.6 s
  goto 41.2 -92.8 0.5 10 soft
  goto 48.0 -89.8 0.5 10 soft
  goto 51.3 -86.8 0.5 10 soft
  goto 54.4 -86.4 0.5 10 soft
  goto 60.9 -82.7 0.5 10 soft
  goto 64.5 -79.4 0.5 10 soft
  press UP 1                # face up
  sleep 0.30
  goto 64.5 -78.4 0.3 6 soft   # where it was pressed
  goto 64.5 -76.6 0.5 10 soft
end
