block west_chest               # the chest inside the west room's enclosure, west of the pushed block
  # The owner pressed CROSS below it at x 37.6 and 37.2 (z -87.0), facing up (record
  # 1,132-1,135 s). It holds the key to the door north-west of the bat room
  # (deeper9: "OPEN", "Got a ...", and the door opened). Up into it from x 37.6
  # the hero slides west round it, from the west holding east slides it south;
  # from x 38.0 it slid to 37.7 and stopped under it, and that try opened it.
  # Up against it from across its width, CROSS at each (at an opened chest it
  # only swings the sword).
  goto 38.0 -87.4 0.2 8 soft
  hold UP 0.25
  sleep 0.4
  press CROSS
  sleep 2.5
  press CROSS
  sleep 1.2
  press CROSS
  sleep 0.8
  goto 37.6 -87.4 0.2 8 soft
