  sleep 0.49
  press CROSS   # 2269.5 s
  sleep 0.36
  press CROSS   # 2269.8 s
  sleep 0.35
  press CROSS   # 2270.2 s
  sleep 0.33
  press CROSS   # 2270.5 s
  sleep 0.68
  press CROSS   # 2271.2 s
  sleep 0.48
  press CROSS   # 2271.7 s
  sleep 0.46
  press CROSS   # 2272.1 s
  press DOWN 1                # face down
  sleep 0.96
  press CROSS   # 2273.1 s
  sleep 1.50
  press CROSS   # 2274.7 s
  sleep 0.37
  press CROSS   # 2275.0 s
  goto 14.2 -29.4 1.0 10 soft
  goto 21.6 -24.9 1.0 10 soft
  goto 19.3 -16.2 1.0 10 soft
  goto 16.9 -15.5 0.3 6 soft   # where it was pressed
  press UP 1                # face up
  press CROSS   # 2279.9 s
  goto 15.4 -15.1 0.3 6 soft   # where it was pressed
  press CROSS   # 2280.3 s
  goto 15.2 -15.1 1.0 10 soft
  press UP 1                # face up
  sleep 0.43
  press CROSS   # 2280.8 s
  sleep 0.88
  press CROSS   # 2281.7 s
  goto 16.8 -15.8 0.3 6 soft   # where it was pressed
  press CROSS   # 2282.9 s
  goto 17.9 -15.2 0.3 6 soft   # where it was pressed
  press CROSS   # 2283.4 s
  goto 18.3 -14.9 1.0 10 soft
  press UP 1                # face up
  press CROSS   # 2283.6 s
  sleep 0.75
  press CROSS   # 2284.4 s
  sleep 0.45
  press CROSS   # 2284.8 s
  sleep 0.68
  press CROSS   # 2285.5 s
  sleep 0.36
  press CROSS   # 2285.8 s
  sleep 0.67
  press CROSS   # 2286.5 s
  sleep 1.17
  press CROSS   # 2287.7 s
  sleep 0.61
  press CROSS   # 2288.3 s
  sleep 0.74
