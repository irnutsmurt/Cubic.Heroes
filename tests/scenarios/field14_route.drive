# One arrow from the shopkeeper by the forge, the short way (the owner's 45 s
# of presses talk to whoever is nearest). Facing him, CROSS pages whatever he
# says, then talks again: the shop's "TAKE A LOOK!", the list on Arrow(1) 2 G,
# "You BUYIN'?", yes. Spare presses are safe: the quiver holds 15 (14 in the
# area-14 save), so only one arrow is ever bought ("You can't hold that!").
# The HUD's wallet and arrow count show whether it was.
block buy_arrow
  goto 13.7 -26.4 0.25 8 soft  # just below him (he stands by the forge)
  hold UP 0.4               # face him (a tap leaves the hero facing the way it walked)
  sleep 0.5
  repeat 12 CROSS 1.2
  repeat 3 CIRCLE 0.8       # out of the list and the talk
  sleep 1.0
end

block leave_100             # out of the shop's door, back in area 14
  unstick DOWN 6
  goto 16.8 -36.5 0.4 10 soft  # the doorway (in at (16.8, -40.8))
  hold DOWN 2.5
end
