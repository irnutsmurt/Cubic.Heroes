# Field area 14's shop (building 100): shared by field14_building and the
# installed-build save test (installed_save, installed_continue).

block door_of_100             # from where CONTINUE puts the hero (87.2, -119.2), in at its door
  goto 88.5 -114.2 0.4 10 soft
  press UP 1
  sleep 0.3
  repeat 6 CROSS 0.8             # whoever is there, as the owner paged it
  unstick DOWN 6
  goto 85.2 -114.0 0.25 8 soft   # under the door (the owner went in from (85.5, -112.7))
  hold UP 0.8                   # up to the door: "OPEN" shows only there
  sleep 0.4
  press CROSS                   # open it (the owner's 2,245.6 s)
  sleep 1.5
  hold UP 2.0
end

block building100              # building 100 is the arrow shop: the owner's 2,250-2,295 s inside, then out
  # Their presses where they made them open the shop at its counter: Arrow(1) 2 G, Arrow(10)
  # 18 G, Arrow(30) 40 G; one arrow bought (b100d, 2026-11-02: wallet 224 -> 222), a full
  # quiver gets "You can't hold that!".
  goto 16.8 -34.4 1.0 10 soft
  goto 13.7 -26.3 0.3 6 soft   # where it was pressed
  press UP 1                # face up
  press CROSS   # 2251.3 s
  sleep 0.46
  press CROSS   # 2251.7 s
  goto 13.7 -26.2 1.0 10 soft
  press UP 1                # face up
  sleep 0.43
  press CROSS   # 2252.2 s
  sleep 1.50
  press CROSS   # 2255.1 s
  sleep 0.66
  press CROSS   # 2255.7 s
  sleep 1.06
  press CROSS   # 2256.8 s
  press DOWN 1                # face down
