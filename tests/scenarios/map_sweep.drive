# Scenario: the map sweep (M9.2g, docs/M92_SHADER_PLAN.md section 2h; tests/map_sweep.py runs it): CONTINUE into
# play, then stand still while the build's map sweep (DOTHEROES_MAP_SWEEP=LIST, port/native/render/
# ppfx_recorder.cpp) moves the game through every map of LIST with the game's own map change, one every few seconds.
# Starts from: the kept checkpoint castle-front (field area 17). Nothing is pressed after CONTINUE; can't-die keeps
# the hero alive among the maps' enemies.
#! saves build/checkpoints/castle-front
#! env DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=1,2,4,5,6 GCM_WRAP_LAP=1 DOTHEROES_PRESENT_ONCE=1
#! env DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_KEYS=1 DIAG_FRAMES=frames.log PS3_VERBOSE=0 DOTHEROES_DEV_CANT_DIE=1
#! env DUMP=0 SHOT_EVERY=0
#! secs 3600

include common.drive

log TitleMovie 120
sleep 5
call continue
state life>0 60
sleep 100000
