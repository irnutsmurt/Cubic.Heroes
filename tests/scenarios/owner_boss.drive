# A play session for the owner at the first dungeon's boss (SCENARIO=owner_boss
# tests/boot_smoke.py): owner_play.drive's game and recording (the validated
# 60 fps settings, sound, fullscreen, normal damage; frames.log, record.log,
# hitch/, memory.csv), on a save root of its own so the regular playthrough's
# (build/play-route/gamedata) is not touched:
#   build/play-boss/gamedata   seeded with a copy of checkpoint
#                              dungeon1-boss-door (a test's save before the
#                              boss's portal, the dungeon's doors opened;
#                              CONTINUE starts at the dungeon's door)
#   build/play-boss/cache      its shader cache
#   build/checkpoints/owner-boss/<n>-area<area>/  a copy of each save the game
#                              writes (the special key, before the boss, after)
# The run lasts until the game is closed; its directory is
# build/sessions/boot-<time>-<tag>.
#! env GAMEDATA=build/play-boss/gamedata RUNS_IN=build/sessions KEEP_RUNS=1000 PREEMPT_TESTS=1
#! env DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=4,5,6 GCM_WRAP_LAP=1 DOTHEROES_PRESENT_ONCE=1
#! env WINDOW=1 PS3RECOMP_VK_FULLSCREEN=1 AUDIO=1 PS3_OSD_FPS=2 DUMP=0 SHOT_EVERY=0 PS3_VERBOSE=0
#! env DOTHEROES_DEV_KEYS=1 DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_RECORD=1 DIAG_FRAMES=frames.log
#! env PS3_FTRACE_ROLL=hitch PS3_FTRACE_ROLL_FROM=60 DOTHEROES_PHYS_STATS=1 VK_GPU_TIME=1
#! env PS3RECOMP_SPIRV_CACHE=build/play-boss/cache VK_COMPILE_LOG=1 DOTHEROES_INFLATE_LOG=1
#! secs 14400
until_exit build/checkpoints/owner-boss
