press DOWN
sleep 1
press CROSS                   # EDITOR -> LOAD / NEW DATA
sleep 4
press DOWN
sleep 1
press CROSS                   # NEW DATA
sleep 3
press CROSS                   # MALE
sleep 3
press CROSS                   # HERO -> the editor, on EDIT
sleep 5
press CROSS                   # EDIT -> EDIT POSE
sleep 3
press CROSS                   # EDIT POSE -> select a pose, on Stand
sleep 3
press CROSS                   # Stand -> the block grid
sleep 3
press CROSS                   # a block at the cursor
sleep 1
press RIGHT
sleep 1
press CROSS
sleep 1
press UP
sleep 1
press CROSS
sleep 4
touch describe.trigger
