sleep 12
endseg
dev respawn @150
sleep 3
dev spawn MageGray 8 0
segment explore enemy-MageGray
sleep 12
endseg
dev spawn Mummy 8 0
segment explore enemy-Mummy
sleep 12
endseg
dev spawn Rabbit 8 0
segment explore enemy-Rabbit
sleep 12
endseg
dev spawn Rock 8 0
segment explore enemy-Rock
sleep 12
endseg
dev respawn @150
sleep 3
dev spawn RoperBlue 8 0
segment explore enemy-RoperBlue
sleep 12
endseg
dev spawn RoperRed 8 0
segment explore enemy-RoperRed
sleep 12
endseg
dev spawn ScorpionBlue 8 0
segment explore enemy-ScorpionBlue
sleep 12
endseg
dev spawn ScorpionRed 8 0
segment explore enemy-ScorpionRed
sleep 12
endseg
dev respawn @150
sleep 3
dev spawn Shadow 8 0
segment explore enemy-Shadow
sleep 12
endseg
dev spawn SilverKnight 8 0
