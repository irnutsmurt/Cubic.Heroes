dev spawn Squid 8 0
segment explore enemy-Squid
sleep 12
endseg
dev respawn @150
sleep 3
dev spawn Succubus1 8 0
segment explore enemy-Succubus1
sleep 12
endseg
dev spawn Succubus2 8 0
segment explore enemy-Succubus2
sleep 12
endseg
dev spawn Togetoge 8 0
segment explore enemy-Togetoge
sleep 12
