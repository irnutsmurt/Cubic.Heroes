# Frame-rate independence of the characters (M11.1b, docs/M11_PLAN.md section 23; tests/fps_actors.py): the same
# drive at different frame rates (DOTHEROES_FPS), each character's movement logged (DOTHEROES_DEV_ACTOR_LOG: every
# 4 ms, on the trace's clock) and the drive cut into segments by marks (DOTHEROES_DEV_KEYS). Every enemy type outside
# the minigames created in turn on field 14 by the tools' `spawn` (the game's own Event:CreateNpc; every enemy is one
# class, 0x00FE4500, so each type has a segment of its own: 12 s, the map entered again every four types), then
# the temples' bosses and the last one, each entered the game's way (`boss`, the story set to the step before it),
# its introduction answered, 40 s with the hero standing at the door -- invulnerable, no death (the tools'), the
# sword never swung (`devpage ... ifany` answers only a running event: the companion's lines stop a fight).
# tests/fps_actors.py compares each segment's characters across the runs.
#   DOTHEROES_FPS=144 DRIVE=tests/scripts/fps_actors.drive SAVES=build/checkpoints/castle-front ... boot_smoke.py
#! saves build/checkpoints/castle-front
#! env DOTHEROES_DEVELOPER_MODE=1 DOTHEROES_NATIVE_CD=1 DOTHEROES_NATIVE_SOLVER=1,2,4,5,6 GCM_WRAP_LAP=1
#! env DOTHEROES_PRESENT_ONCE=1 DOTHEROES_DEV_STATE=1 DOTHEROES_DEV_KEYS=1 DOTHEROES_DEV_ACTOR_LOG=1
#! env DIAG_FRAMES=frames.log PS3_VERBOSE=0 SHOT_EVERY=0 DUMP=0
#! secs 1800

include ../scenarios/common.drive

log TitleMovie 120
sleep 5
call continue
state life>0,area==17 90
sleep 3
dev nodeath on
dev invulnerable on
dev warp Field_14 -gDebug @150
sleep 3
dev spawn Bat 8 0
segment explore enemy-Bat
sleep 12
endseg
dev spawn Bee 8 0
segment explore enemy-Bee
sleep 12
endseg
dev spawn BlackKnight 8 0
segment explore enemy-BlackKnight
sleep 12
endseg
dev spawn BlueDragon 8 0
segment explore enemy-BlueDragon
sleep 12
endseg
dev respawn @150
sleep 3
dev spawn CentaurusBlue 8 0
segment explore enemy-CentaurusBlue
sleep 12
endseg
dev spawn CentaurusRed 8 0
segment explore enemy-CentaurusRed
sleep 12
endseg
dev spawn Cyclops 8 0
segment explore enemy-Cyclops
sleep 12
endseg
dev spawn DarkEye 8 0
segment explore enemy-DarkEye
sleep 12
endseg
dev respawn @150
sleep 3
dev spawn Ghost 8 0
segment explore enemy-Ghost
sleep 12
endseg
dev spawn GoblinBlue 8 0
segment explore enemy-GoblinBlue
sleep 12
endseg
dev spawn GoblinRed 8 0
segment explore enemy-GoblinRed
sleep 12
endseg
dev spawn GolemChild 8 0
segment explore enemy-GolemChild
sleep 12
endseg
dev respawn @150
sleep 3
dev spawn Golem 8 0
segment explore enemy-Golem
sleep 12
endseg
dev spawn HagureSlime 8 0
segment explore enemy-HagureSlime
sleep 12
endseg
dev spawn Jyugemu 8 0
