# Frame-rate independence: play to free movement, then walk for fixed wall times.
# Compare the shots of a DIAG_VBLANK_MS=25 DOTHEROES_FPS=30 run (20 fps) with a default
# run (60 cap): the character must end up in the same places.
# Every press waits for the screen to react before the next one.
log TitleMovie 120          # the title's background movie is open
sleep 5
press START                 # "PRESS START BUTTON"
sleep 3
press START                 # -> main menu
change
sleep 3
shot menu
press CROSS                 # NEW GAME
change
sleep 4
shot characters
press CROSS                 # first character
change
sleep 2
shot confirm
press CROSS                 # "Is this okay?" YES
change
sleep 3
shot name
press START                 # cursor to END
sleep 2
press CROSS                 # END
change
sleep 2
shot name-confirm
press CROSS                 # "Is this name okay?" YES
log OpeningMovie 90
sleep 6
shot opening
press START                 # skip the opening
log LFQueueInitialize 120   # the game is loading the first area
sleep 12
shot ingame
repeat 40 CROSS 2           # page through the opening dialogue
sleep 3
shot start
hold RIGHT 1.5              # walk for a fixed wall time: the distance must
sleep 2                     # not depend on the frame rate
shot right
hold LEFT 1.5
sleep 2
shot left
hold DOWN 1.0
sleep 2
shot down
