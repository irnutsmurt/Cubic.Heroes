// FMOD Ex's SPU mixer as native code (fmod_mixer.h).
//
// GENERATED by gen_spu_native.py from the lift (build/gen/spu/spu_0005_at_00F86A80/spu_recomp.c), the image
// (build/gen/spu/images/spu_0005_at_00F86A80.elf: its jump tables), fmod_mixer_config.py and
// fmod_mixer.cpp.in: edit those, not this file. Checked against the lifted mixer on the game's channel
// traces (tests/fmod_mixer_check.cpp).
//
// One C++ function per SPU function (f_<entry>), each of the lift's functions a labelled block in it
// (L_<address>), every statement the lift's own, in its order: the instruction helpers of spu_helpers.h on
// registers r0-r127 (word 0 the preferred slot), lsr / lsw the local store as spu_ls_read128 /
// spu_ls_write128 address it. A function holds the registers it uses in locals: loaded from the register file
// at entry and after each call (LOAD), stored back before each call, callback, return and exit (SAVE), so the
// file is always what the lift leaves in ctx->gpr. A comment before each function says what reaches it.
#include "fmod_mixer.h"

#include <cstring>

#include "spu_helpers.h"   // the runtime's exact SPU semantics (the lifted mixer's own)

namespace fmod_mixer {

constexpr int kBlockCount = @BLOCK_COUNT@;
constexpr int kEntryCount = @ENTRY_COUNT@;
unsigned long long g_block_hits[kBlockCount];

#ifdef FMOD_MIXER_COVERAGE
#define COV(k) (++g_block_hits[(k)])
#else
#define COV(k) ((void)0)
#endif

// A jump to another function's entry: a tail call that keeps the host stack flat (the main loop and others
// pass through them).
#if defined(__clang__)
#define TAIL [[clang::musttail]] return
#else
#define TAIL return
#endif

static_assert(kCodeBegin == @CODE_BEGIN@ && kCodeEnd == @CODE_END@, "fmod_mixer.h and the configuration disagree");

namespace {

using Q = u128;

enum Exit : uint32_t { kNone = 0, kHalted, kStopped, kEnded, kBadReturn };

struct Run {
    uint8_t* ls;
    u128* g;              // the register file
    const Host* h;
    uint32_t ret = 0;     // the pc the last return went to (gpr[0] word 0 at the bi $r0: the lift's SPU_RET)
    uint32_t exit = kNone, exit_pc = 0, exit_code = 0;
    uint32_t jt = 0, js = 0;   // an indirect jump's target and site, for jump_to
};

inline uint32_t be32(const uint8_t* p)
{
    return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
}
inline void put_be32(uint8_t* p, uint32_t v)
{
    p[0] = (uint8_t)(v >> 24);
    p[1] = (uint8_t)(v >> 16);
    p[2] = (uint8_t)(v >> 8);
    p[3] = (uint8_t)v;
}

// Local store, as spu_ls_read128/spu_ls_write128 address it: the quadword at (address & 0x3FFF0), big-endian
// words, word 0 first.
inline Q lsr(const Run& c, uint32_t a)
{
    const uint8_t* p = c.ls + (a & 0x3FFF0u);
    Q v;
    v._u32[0] = be32(p);
    v._u32[1] = be32(p + 4);
    v._u32[2] = be32(p + 8);
    v._u32[3] = be32(p + 12);
    return v;
}
inline void lsw(Run& c, uint32_t a, const Q& v)
{
    uint8_t* p = c.ls + (a & 0x3FFF0u);
    put_be32(p, v._u32[0]);
    put_be32(p + 4, v._u32[1]);
    put_be32(p + 8, v._u32[2]);
    put_be32(p + 12, v._u32[3]);
}

// Channels: the runtime takes word 0 of a written register and returns a read value or a count in word 0 of
// an otherwise zero register.
inline Q rdch(Run& c, uint32_t channel) { return spu_pref_u32(c.h->rdch(c.h->user, channel)); }
inline uint32_t rchcnt(Run& c, uint32_t channel) { return c.h->rchcnt(c.h->user, channel); }
inline void wrch(Run& c, uint32_t channel, const Q& v) { c.h->wrch(c.h->user, channel, v._u32[0]); }

// heqi: the lift's HALT-ASSERT.
inline void halt(Run& c, uint32_t pc)
{
    c.exit = kHalted;
    c.exit_pc = pc;
}
// A stop the lift goes on past when the host services it (the 0x110 receive).
inline bool stop(Run& c, uint32_t code, uint32_t pc, uint32_t block)
{
    if (c.h->stop(c.h->user, code, pc, block)) return true;
    c.exit = kEnded;
    c.exit_pc = pc;
    c.exit_code = code;
    return false;
}
// A stop the lift returns after, whatever the host does.
inline void stop_end(Run& c, uint32_t code, uint32_t pc, uint32_t block)
{
    c.h->stop(c.h->user, code, pc, block);
    c.exit = kStopped;
    c.exit_pc = pc;
    c.exit_code = code;
}
// The lift's drain after a call: the callee went back somewhere other than the link.
inline void bad_return(Run& c, uint32_t link)
{
    (void)link;
    c.exit = kBadReturn;
    c.exit_pc = c.ret;
}
inline void unsupported(Run& c, uint32_t pc)
{
    if (c.h->unsupported) c.h->unsupported(c.h->user, pc);
}

// @DECLS@

// A branch to code the port does not have: the host (Branch). False when the run ends.
bool host_branch(Run& c, uint32_t t, uint32_t site, bool call)
{
    const bool inside = t >= kCodeBegin && t < kCodeEnd;
    const Branch k = call ? (inside ? Branch::unresolved_call : Branch::overlay_call)
                          : (inside ? Branch::unresolved_jump : Branch::overlay_jump);
    uint32_t ret = 0;
    if (!c.h->branch(c.h->user, k, t, site, &ret)) {
        c.exit = kEnded;
        c.exit_pc = site;
        return false;
    }
    c.ret = ret;
    return true;
}

// An indirect call (bisl) to `t`: a function the port has, else the host. False when the run ends.
bool branch(Run& c, uint32_t t, uint32_t site, bool call)
{
    switch (t) {
// @DISPATCH@
    default: return host_branch(c, t, site, call);
    }
    return !c.exit;
}

// An indirect jump (bi) to c.jt from c.js: a function the port has, as a tail call (the lift's trampoline keeps
// the host stack flat; so does this), else the host.
void jump_to(Run& c)
{
    switch (c.jt) {
// @JUMPS@
    default: host_branch(c, c.jt, c.js, false); return;
    }
}

// @FUNCTIONS@

struct BlockInfo { uint32_t address, function; };
const BlockInfo kBlocks[kBlockCount] = {
// @BLOCKS@
};

const uint32_t kEntries[kEntryCount] = {
// @ENTRIES@
};

}  // namespace

Result call(uint8_t* ls, u128* gpr, uint32_t entry, const Host& host, Outcome* out)
{
    Run c{ ls, gpr, &host };
    switch (entry & 0x3FFFFu) {
// @DISPATCH@
    default: return Result::declined;
    }
    Outcome o;
    o.ret_pc = c.ret;
    o.pc = c.exit_pc;
    o.code = c.exit_code;
    if (out) *out = o;
    switch (c.exit) {
    case kHalted: return Result::halted;
    case kStopped: return Result::stopped;
    case kEnded: return Result::ended;
    case kBadReturn: return Result::bad_return;
    default: return Result::handled;
    }
}

int entry_count() { return kEntryCount; }
uint32_t entry_address(int k) { return k >= 0 && k < kEntryCount ? kEntries[k] : 0; }
bool has_entry(uint32_t lsa)
{
    int lo = 0, hi = kEntryCount;
    while (lo < hi) {
        const int m = (lo + hi) / 2;
        if (kEntries[m] < lsa) lo = m + 1; else hi = m;
    }
    return lo < kEntryCount && kEntries[lo] == lsa;
}

int block_count() { return kBlockCount; }
uint32_t block_address(int k) { return k >= 0 && k < kBlockCount ? kBlocks[k].address : 0; }
uint32_t block_function(int k) { return k >= 0 && k < kBlockCount ? kBlocks[k].function : 0; }

}  // namespace fmod_mixer
