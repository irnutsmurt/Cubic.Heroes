// FMOD Ex's sfxreverb SPU plugin as native code (fmod_sfxreverb.h).
//
// GENERATED by gen_sfxreverb.py from the lifted overlay
// (build/gen/spu/spu_0024_at_00FC7180/spu_recomp.c) and fmod_sfxreverb.cpp.in:
// edit those, not this file. Checked offline against the lifted overlay itself
// (tests/native/fmod_sfxreverb_check.cpp).
//
// One C++ function per SPU function (f_<entry>), each of the lift's functions
// a labelled block in it (L_<link address>), every statement the lift's own,
// in its order: the instruction helpers of spu_helpers.h on registers r0-r127
// (word 0 the preferred slot), lsr / lsw the local store as
// spu_ls_read128 / spu_ls_write128 address it, `d` the relocation delta (the
// lift's SPU_RELOC). A function holds the registers it uses in locals: loaded
// from the register file at entry and after each call (LOAD), stored back
// before each call, return and halt (SAVE), so the file is always what the
// lift leaves in ctx->gpr. A comment before a block says what it does ([C]
// read in the code, the names [H]; fmod_sfxreverb.h has the overview).
#include "fmod_sfxreverb.h"

#include <cstring>

#include "spu_helpers.h"   // the runtime's exact SPU semantics (the lifted overlay's own)

namespace fmod_sfxreverb {

constexpr int kBlockCount = @BLOCK_COUNT@;
unsigned long long g_block_hits[kBlockCount];

#ifdef FMOD_SFXREVERB_COVERAGE
#define COV(k) (++g_block_hits[(k)])
#else
#define COV(k) ((void)0)
#endif

namespace {

using Q = u128;

struct Run {
    uint8_t* ls;
    u128* g;              // the register file
    uint32_t d;           // the relocation delta (the lift's _rl)
    const Channels* ch;
    uint32_t halt = 0;    // the link PC of a halt (heqi), else 0
};

inline uint32_t be32(const uint8_t* p)
{
    return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
}
inline void put_be32(uint8_t* p, uint32_t v)
{
    p[0] = (uint8_t)(v >> 24);
    p[1] = (uint8_t)(v >> 16);
    p[2] = (uint8_t)(v >> 8);
    p[3] = (uint8_t)v;
}

// Local store, as spu_ls_read128/spu_ls_write128 address it: the quadword at
// (address & 0x3FFF0), big-endian words, word 0 first.
inline Q lsr(const Run& c, uint32_t a)
{
    const uint8_t* p = c.ls + (a & 0x3FFF0u);
    Q v;
    v._u32[0] = be32(p);
    v._u32[1] = be32(p + 4);
    v._u32[2] = be32(p + 8);
    v._u32[3] = be32(p + 12);
    return v;
}
inline void lsw(Run& c, uint32_t a, const Q& v)
{
    uint8_t* p = c.ls + (a & 0x3FFF0u);
    put_be32(p, v._u32[0]);
    put_be32(p + 4, v._u32[1]);
    put_be32(p + 8, v._u32[2]);
    put_be32(p + 12, v._u32[3]);
}

// Channels: the runtime takes word 0 of a written register and returns a read
// value in word 0 of an otherwise zero register.
inline Q rdch(Run& c, uint32_t channel) { return spu_pref_u32(c.ch->rdch(c.ch->user, channel)); }
inline void wrch(Run& c, uint32_t channel, const Q& v) { c.ch->wrch(c.ch->user, channel, v._u32[0]); }

// heqi: the lift's HALT-ASSERT.
inline void halt(Run& c, uint32_t pc) { c.halt = pc; }

// @DECLS@

// @FUNCTIONS@

struct BlockInfo { uint32_t address, function; };
const BlockInfo kBlocks[kBlockCount] = {
// @BLOCKS@
};

}  // namespace

Result call(uint8_t* ls, u128* gpr, uint32_t entry_lsa, uint32_t reloc_delta, const Channels& ch, uint32_t* halt_pc)
{
    Run c{ ls, gpr, reloc_delta, &ch };
    switch (entry_lsa - reloc_delta) {
    case kEntryDescriptor: f_2CA8(c); break;
    case kEntryDescriptorBody: f_2C70(c); break;
    case kEntryRead: f_2D88(c); break;
    case kEntryReadThis: f_2D30(c); break;
    case kEntryProcess: f_0820(c); break;
    case kEntrySampleLoop: f_0090(c); break;
    case kEntryDma: f_2D98(c); break;
    case kEntryConstructor: f_2D20(c); break;
    case kEntryStaticInit: f_2CB0(c); break;
    default: return Result::declined;
    }
    if (c.halt) {
        if (halt_pc) *halt_pc = c.halt;
        return Result::halted;
    }
    return Result::handled;
}

int block_count() { return kBlockCount; }
uint32_t block_address(int k) { return k >= 0 && k < kBlockCount ? kBlocks[k].address : 0; }
uint32_t block_function(int k) { return k >= 0 && k < kBlockCount ? kBlocks[k].function : 0; }

}  // namespace fmod_sfxreverb
