#!/bin/sh
# Every push is checked first (tools/push_guard.py): no Claude session links, personal email addresses,
# account names or local home-directory paths in the outgoing commit messages, added lines or tag messages.
top=$(git rev-parse --show-toplevel)
py="$top/build/venv/Scripts/python.exe"
[ -x "$py" ] || py=$(command -v python3 || command -v python || echo py)
exec "$py" "$top/tools/push_guard.py" pre-push "$@"
